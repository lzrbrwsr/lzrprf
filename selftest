            $buf = $held{$one};
        }
        if ($stage{$one} == 1) {
            next if length $buf < 2;
            my $ul = ord substr($buf, 1, 1);
            next if length $buf < 3 + $ul;
            my $pl = ord substr($buf, 2 + $ul, 1);
            next if length $buf < 3 + $ul + $pl;
            ($user{$one}, $pass{$one}) = (substr($buf, 2, $ul), substr($buf, 3 + $ul, $pl));
            syswrite($one, "\x01\x00");
            ($held{$one}, $stage{$one}) = (substr($buf, 3 + $ul + $pl), 2);
            $buf = $held{$one};
        }
        if ($stage{$one} == 2) {
            next if length $buf < 5;
            my $hl = ord substr($buf, 4, 1);
            next if length $buf < 7 + $hl;
            print $noted "socks user=$user{$one} pass=$pass{$one} head=", unpack('H*', substr($buf, 0, 4)), " host=", substr($buf, 5, $hl), " port=", unpack('n', substr($buf, 5 + $hl, 2)), "\n";
