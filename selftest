#!/usr/bin/perl
# selftest: plays a hostile application inside lzrprf, in all three of its
# containers, and says what it managed to do. Run it from the folder that
# holds lzrprf:
#
#   perl selftest            a minute or two
#   perl selftest limits     also checks the time limits; about three minutes more
#   perl selftest windows    also opens lzrprf's real windows, and tells you what to press
#
# It uses nothing outside this computer and, unless you ask for the windows,
# opens no window and asks you nothing:
# it starts lzrprf with "try", which keeps its state in a folder of its own,
# gives every window one fixed answer after one second, and leads every name
# to a test site on this computer, whose certificate is signed by an authority
# made here a moment ago. Everything else is the code "run" uses.
#
# Four kinds of line are printed. "works" is an attack tried outside every
# container first, where it must succeed: so a refusal inside means the
# container refused it, not that the attempt was broken. "held" is an attack
# that failed, or a promise that was checked. "limit" is something the
# application can do, that the README names as a limit, and that is measured
# here so the README cannot understate it. "UNTESTED" is an attack this
# computer gave no way to try, with the reason. The test site keeps its own
# record of every connection and every byte it received, and what lzrprf says
# it did is compared with that record. Any other word is a failure.
#
# When nothing failed, the mark of what was tested (this build of macOS, this
# lzrprf) is written to ~/.lzrprf/proven: "lzrprf run" starts nothing without
# it. Nothing else is left behind.
use strict;
use warnings;
use Cwd 'abs_path';
use Fcntl ':flock';
use File::Basename 'dirname';
use File::Path qw(make_path remove_tree);
use IO::Select;
use IO::Socket::IP;
use POSIX ();

exec '/usr/bin/perl', $0, @ARGV if $^X ne '/usr/bin/perl' && !$ENV{LZRPRF_SELFTEST_PERL}++;    # the system's own perl, which has what the test site needs
require IO::Socket::SSL;

my $lzrprf = dirname(abs_path($0)) . '/lzrprf';
my $home = abs_path((getpwuid $<)[7]);
my $secret = "$home/.lzrprf-selftest-secret";
my $mode = shift // '';
my $limits = $mode eq 'limits' ? 1 : 0;
my ($failures, $untested) = (0, 0);
sub check($$$);                           # each of the three is taken as one value. Without this, a comparison that
sub works($$$);                           # fails where a list is expected gives no value at all, the two after it
sub untested($$);                         # move up, and the line of a failed attack reads "held"
our ($probe_source, $other_application);  # the texts are at the end of this file
my $outside = $$;
my $made = mkdir "$home/.lzrprf", 0700; # lzrprf keeps its state here; what is already there is left as it is
my $base = "$home/.lzrprf/selftest.$outside";
my $site_folder = "$base.site";
mkdir $site_folder or die "selftest: cannot make $site_folder: $!\n";

# The test site's two certificates, both for the name site.test. lzrprf is
# told to trust the first as its authority; nothing trusts the second.
for my $name ('trusted', 'untrusted') {
    system("/usr/bin/openssl req -x509 -newkey rsa:2048 -nodes -keyout '$site_folder/$name.key' -out '$site_folder/$name.pem' -subj /CN=site.test -days 2 -addext subjectAltName=DNS:site.test -batch 2>/dev/null") == 0
        or die "selftest: cannot make a certificate\n";
}

# The test site: four listeners on this computer.
#   trusted     https, with the certificate lzrprf is told to trust
#   untrusted   https, with a certificate nothing trusts
#   plain       no encryption at all: it takes whatever arrives
#   echo        no encryption: answers what it is sent, preceded by "echo:"
# Each connection adds one line to the site's record: which listener, and
# every byte that arrived there, or that no secure connection came about.
my (%listener, %port);
for my $kind (qw(trusted untrusted plain echo)) {
    $listener{$kind} = IO::Socket::IP->new(LocalHost => '127.0.0.1', LocalPort => 0, Listen => 16, ReuseAddr => 1) or die "selftest: cannot listen: $!\n";
    $port{$kind} = $listener{$kind}->sockport;
}
sub answer_for {                          # what the test site answers on its https listeners
    my ($path) = @_;
    my $body = $path eq '/large' ? 'x' x (7 * 1024 * 1024) : "the page of the test site\n";
    return "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n4\r\nthe \r\n16\r\npage of the test site\n\r\n0\r\n\r\n" if $path eq '/pieces';
    my $head = $path eq '/elsewhere' ? "HTTP/1.1 302 Found\r\nLocation: https://elsewhere.test/moved\r\n" : "HTTP/1.1 200 OK\r\n";
    return $head . "Content-Type: text/html\r\nSet-Cookie: kept=never\r\nContent-Length: " . length($body) . "\r\nConnection: close\r\n\r\n$body";
}
my $site = fork // die "selftest: cannot fork: $!\n";
if (!$site) {
    $SIG{CHLD} = 'IGNORE';
    $SIG{PIPE} = 'IGNORE';
    my $waiting = IO::Select->new(values %listener);
    while (1) {
        for my $ready ($waiting->can_read) {
            my ($kind) = grep { $listener{$_} == $ready } keys %listener;
            my $client = $ready->accept or next;
            next if fork;                 # one process for each connection, so a silent one holds up nobody
            my $got = '';
            if ($kind eq 'echo') {
                syswrite($client, "echo:$got") if sysread($client, $got, 100);
                sysread($client, my $rest, 1);
            }
            elsif ($kind eq 'plain') {
                my $until = time + 3;
                while (time < $until && IO::Select->new($client)->can_read(1)) { sysread($client, $got, 65536, length $got) or last }
            }
            elsif (!IO::Socket::SSL->start_SSL($client, SSL_server => 1, SSL_cert_file => "$site_folder/$kind.pem", SSL_key_file => "$site_folder/$kind.key", Timeout => 10)) {
                seen($kind, 'no secure connection came about');
                exit 0;
            }
            else {
                while ($got !~ /\r\n\r\n/ && length $got < 65536) { $client->sysread($got, 65536, length $got) or last }
                my ($path) = $got =~ m{^GET (\S+)};
                $path //= '';
                if ($path eq '/slow') { seen($kind, 'bytes ' . unpack 'H*', $got); sleep 600 }
                $client->print(answer_for($path));
                $client->close;
            }
            seen($kind, 'bytes ' . unpack 'H*', $got);
            exit 0;
        }
    }
}
sub seen {                                # one line, written in one piece, so two connections cannot mix
    open my $out, '>>', "$site_folder/seen" or return;
    syswrite($out, "$_[0]\t$_[1]\n");
}
close $_ for values %listener;
open my $file, '>', $secret or die "selftest: cannot write $secret: $!\n";
print $file "a file in the home folder\n";
close $file;
unlink "$secret.written";
open my $left_open, '<', $secret or die "selftest: cannot read $secret: $!\n";
POSIX::dup2(fileno $left_open, 19) // die "selftest: cannot keep a file open: $!\n";    # every program started from here on inherits this open file as descriptor 19
$ENV{LZRPRF_SELFTEST_MARK} = 'a variable of the user';
my $computer = (POSIX::uname())[1] // '';

# The hostile application. lzrprf starts it in the main container, and once
# more in a page container for every address that was fetched. In one run it
# also stands in curl's place, in the fetch container. Before all that it is
# run here, outside every container, where each of its attempts must succeed.
# Each attempt prints its name and what happened.
my $hostile = <<'END';
use IO::Socket::IP; use IO::Socket::UNIX; use Socket; use POSIX (); use Time::HiRes ();
my ($port, $secret, $home, $outside, $lzrprf, $folder, $computer, $part, $main) = @ARGV;
$| = 1; $SIG{PIPE} = 'IGNORE';
my $address = $ENV{LZRPRF_CONTAINED};
my $where = $part eq 'outside' ? 'outside' : $part eq 'in curl\'s place' ? 'fetch container' : defined $address ? 'page container' : 'main container';
sub report { print "$where: $_[0]\t$_[1]\n" }
sub direct { IO::Socket::IP->new(PeerHost => $_[0], PeerPort => $_[1], Timeout => 5) ? 'reached' : 'refused' }
sub computer_name { my $name = eval { (POSIX::uname())[1] } // ''; return $name }
sub process_list {                        # asks the system for the table of all processes
    my ($names, $size) = (pack('i4', 1, 14, 0, 0), pack('Q', 0));
    return eval { syscall(202, $names, 4, 0, $size, 0, 0) } == 0 && unpack('Q', $size) > 0;
}
sub attempts {
    report 'use a file that was open in whoever started lzrprf', POSIX::fstat(19) ? 'open' : 'closed';
    report 'connect straight to a listener on this computer', direct('127.0.0.1', $port);
    report 'connect straight to a server on the internet', direct('1.1.1.1', 443) unless $part eq 'outside';
    report 'look up a name', gethostbyname('localhost') ? 'resolved' : 'refused';
    socket(my $udp, PF_INET, SOCK_DGRAM, 0);
    report 'send a datagram', $udp && send($udp, 'x', 0, pack_sockaddr_in($port, inet_aton('127.0.0.1'))) ? 'sent' : 'refused';
    report 'listen for connections', IO::Socket::IP->new(LocalHost => '127.0.0.1', LocalPort => 0, Listen => 1) ? 'listening' : 'refused';
    report 'read a file in the home folder', open(my $in, '<', $secret) ? 'read' : 'refused';
    report 'read the same file by its other path, through the data volume', open(my $by, '<', "/System/Volumes/Data$secret") ? 'read' : 'refused';
    report 'learn whether a file exists in the home folder', -e $secret ? 'found' : 'hidden';
    report 'list the home folder', opendir(my $dir, $home) ? 'listed' : 'refused';
    report 'list the folder of all users', opendir(my $users, '/System/Volumes/Data/Users') || opendir($users, '/Users') ? 'listed' : 'refused';
    report 'read the log', open(my $log, '<', "$folder/log") ? 'read' : 'refused';
    report 'change the log', open(my $add, '>>', "$folder/log") ? 'opened' : 'refused';
    report 'empty the log', open(my $empty, '+<', "$folder/log") ? 'opened' : 'refused';
    report 'change lzrprf itself', open(my $self, '>>', $lzrprf) ? 'opened' : 'refused';
    report 'write a file in the home folder', open(my $out, '>', "$secret.written") ? 'written' : 'refused';
    report 'write a file in the temporary folder', open(my $tmp, '>', "/tmp/lzrprf-selftest.$outside") ? 'written' : 'refused';
    report 'signal another process', kill(0, $outside) ? 'allowed' : 'refused';
    report 'see a variable of the user', exists $ENV{LZRPRF_SELFTEST_MARK} ? 'seen' : 'hidden';
    report 'read the computer\'s name', length $computer && computer_name() eq $computer ? 'read' : 'hidden';
    report 'read the list of processes', process_list() ? 'read' : 'refused';
    report 'start a second process', defined(my $pid = fork) ? 'started' : 'refused';
    exit 0 if defined $pid && !$pid;
    { no warnings; exec '/bin/sh', '-c', "printf '$where: start another program\tstarted\n'"; }
    report 'start another program', 'refused';
    exit 0;
}
attempts() if $part eq 'outside';
if ($part eq 'in curl\'s place') {        # in the fetch container: one socket file was given, and lzrprf's parent process made it
    my $way = IO::Socket::UNIX->new(Peer => "$folder/way." . getppid());
    my $back = '';
    if ($way) { syswrite($way, 'hello'); sysread($way, $back, 100) }
    report 'talk through the one socket it was given', $back || 'nothing';
    report 'reach the gateway', IO::Socket::UNIX->new(Peer => "$folder/gate.$main") ? 'reached' : 'refused';
    report 'signal the application', kill(0, $main) ? 'allowed' : 'refused';
    attempts();
}
if (defined $address) {                   # in a page container: descriptor 0 holds the answer, descriptor 1 leads to the main container
    if ($address =~ m{/watch$}) {         # a page container that lives for some seconds, and listens whether it ran all the time
        listen_for_silence();
        my $until = Time::HiRes::time() + 9;
        select(undef, undef, undef, 0.2) while Time::HiRes::time() < $until;
        report 'keep running while a window of lzrprf is open', longest_silence();
        exit 0;
    }
    if ($address =~ m{/spin$}) { 1 while 1 }
    if ($address =~ m{/sleep$}) { sleep 1000 }
    my $answer = do { local $/; <STDIN> } // '';
    if ($part eq 'fetcher' || $part eq 'inplace') { print $answer; exit 0 }
    if ($part eq 'elsewhere') { report 'the answer to an address that sends on to another', $answer =~ m{^HTTP/1\.1 302 Found\r\nLocation: https://elsewhere\.test/moved\r\n} ? 'the sending-on itself, not followed' : 'something else'; exit 0 }
    if ($part eq 'pieces') { report 'an answer the site sent in pieces', $answer =~ m{\r\n\r\n4\r\nthe \r\n16\r\npage of the test site\n\r\n0\r\n\r\n$} ? 'handed over as the site sent it' : 'changed on the way'; exit 0 }
    exit 0 unless $part eq 'yes';
    report 'what it is given', -p STDIN ? 'a pipe that holds a finished answer' : -S STDIN ? 'a socket' : 'something else';
    report 'the answer of the site', $answer =~ m{^HTTP/1\.1 200 OK\r\n.*\r\n\r\nthe page of the test site\n$}s ? 'whole' : 'not whole';
    report 'what leads to the main container', -p STDOUT ? 'a pipe, which cannot hand over a connection' : -S STDOUT ? 'a socket' : 'something else';
    report 'reach the gateway', IO::Socket::UNIX->new(Peer => "$folder/gate.$main") ? 'reached' : 'refused';
    report 'signal the application', kill(0, $main) ? 'allowed' : 'refused';
    attempts();
}
sub take { my $n; do { $n = sysread($_[0], $_[1], $_[2], length $_[1]) } while !defined $n && $!{EINTR}; return $n }
sub say_to { my $gate = IO::Socket::UNIX->new(Peer => $ENV{LZRPRF}) or return; syswrite($gate, $_[0]); shutdown($gate, 1); return $gate }
sub hear {                                # the gateway's answer, and what a page container then sent
    my ($gate) = @_;
    my ($all, $more) = ('');
    return ('no gateway', '') unless $gate;
    1 while take($gate, $all, 65536);
    my ($answer, $page) = split /\n/, $all, 2;
    return ($answer // 'nothing', $page // '');
}
sub gateway { my ($answer, $page) = hear(say_to($_[1])); report "gateway: $_[0]", $answer; print $page }
# Whether this process ran all the time: a clock rings every twentieth of a second, and the longest silence is kept.
sub listen_for_silence;
sub longest_silence;
my ($rang, $silence) = (0, 0);
sub listen_for_silence {
    ($rang, $silence) = (Time::HiRes::time(), 0);
    $SIG{ALRM} = sub { my $now = Time::HiRes::time(); $silence = $now - $rang if $now - $rang > $silence; $rang = $now };
    Time::HiRes::ualarm(50_000, 50_000);
}
sub longest_silence { Time::HiRes::ualarm(0); return $silence > 0.8 ? 'stopped' : 'ran' }
if ($part eq 'watch') {                   # this run: a page container is alive when the next window opens
    my $gate = say_to("address\n");
    my $first = '';
    1 while $first !~ /\n/ && take($gate, $first, 1);
    report 'gateway: ask for the address window (watch)', $first =~ s/\n//r;
    gateway 'ask for the log window straight after an address was fetched', "show log\n";
    sleep 4;
    listen_for_silence();
    gateway 'ask for the log window some seconds later', "show log\n";
    report 'keep running while the log window is open', longest_silence();
    my $rest = '';
    1 while take($gate, $rest, 65536);
    print $rest;
    exit 0;
}
if ($part eq 'no') {                      # this run: the user says no to a host inside the own network
    gateway 'ask for the address window; the user types an address that leads into the own network, and says no', "address\n";
    gateway 'ask again straight after the no', "address\n";
    gateway 'ask for the log window straight after the no', "show log\n";
    exit 0;
}
if ($part =~ /^(?:closed|unfit|certificate|untrusted|plain|large|unwritable|slow|elsewhere|pieces|fetcher|inplace|biglog|spin|sleep|ask)$/) {
    my $start = time;
    gateway "ask for the address window ($part)", "address\n";
    report "a page that never stops ($part)", time - $start if $part =~ /^(?:spin|sleep)$/;
    exit 0;
}
if ($part =~ /^(?:keep|clear|clearbusy|asklog)$/) { gateway "ask for the log window ($part)", "show log\n"; exit 0 }
# This run: the user types https://site.test/selftest?q=1 and says yes.
gateway 'name an address itself, the way the first version allowed', "https://hidden-$outside.example/\n";
gateway 'name an address after the sentence', "address https://hidden-$outside.example/\n";
gateway 'allow itself a host', "rule hidden-$outside.example always\n";
gateway 'ask what the user allowed', "rules\n";
gateway 'the sentence in capital letters', "ADDRESS\n";
gateway 'a line of control characters', "\e[2J\raddress\n";
gateway 'a sentence that never ends', "address";
gateway 'a very long line', ("hidden-$outside " x 400) . "\n";
report 'what its input is', -c STDIN && (stat STDIN)[6] == (stat '/dev/null')[6] ? 'nothing' : 'something that was open in whoever started lzrprf';
listen_for_silence();
my $until = Time::HiRes::time() + 1.5;
select(undef, undef, undef, 0.2) while Time::HiRes::time() < $until;
report 'the clock of this process, while no window is open', longest_silence();
listen_for_silence();
my @two = map { say_to("address\nhttps://hidden-$outside.example/ bytes after the sentence\n") } 1, 2;    # two at once, each with more behind it
my @heard = map { [hear($_)] } @two;
report 'keep running while lzrprf\'s windows are open', longest_silence();
report 'gateway: two address windows asked for at once', join ' / ', sort map { $_->[0] } @heard;
print $_->[1] for @heard;
for my $flood (1 .. 100) { hear(say_to("flood-$flood.hidden-$outside.example\n")) }
report 'gateway: 100 lines that are no sentence, each different', 'made';
my @held = grep { defined } map { IO::Socket::UNIX->new(Peer => $ENV{LZRPRF}) } 1 .. 14;    # connections that say nothing
my $turned_away = 0;
sleep 2;
for my $one (@held) {
    my $ready = '';
    vec($ready, fileno $one, 1) = 1;
    my $said = ''; $turned_away++ if select($ready, undef, undef, 0) > 0 && sysread($one, $said, 100) && $said =~ /^no too many at once/;
}
close $_ for @held;
report 'gateway: 14 connections held open at the same time', $turned_away >= 4 ? 'turned away beyond the limit' : "only $turned_away turned away";
sleep 2;
attempts();
END

my @attempts = ('use a file that was open in whoever started lzrprf', 'connect straight to a listener on this computer', 'look up a name', 'send a datagram', 'listen for connections', 'read a file in the home folder',
    'read the same file by its other path, through the data volume', 'learn whether a file exists in the home folder', 'list the home folder', 'list the folder of all users',
    'read the log', 'change the log', 'empty the log', 'change lzrprf itself', 'write a file in the home folder', 'write a file in the temporary folder',
    'signal another process', 'see a variable of the user', 'read the computer\'s name', 'read the list of processes', 'start a second process', 'start another program');
my %hidden = map { $_ => 1 } 'see a variable of the user', 'read the computer\'s name', 'learn whether a file exists in the home folder';
my %refused = map { ("$_: connect straight to a server on the internet" => 'refused') } 'main container', 'page container', 'fetch container';
for my $where ('main container', 'page container', 'fetch container') { $refused{"$where: $_"} = $hidden{$_} ? 'hidden' : /^use a file/ ? 'closed' : 'refused' for @attempts }
sub contained { my ($where) = @_; return map { $_ => $refused{$_} } grep { /^\Q$where\E: / } keys %refused }

my $no_sentence = 'no not a sentence lzrprf knows';
my $busy = 'no a window of lzrprf is open, or was closed a moment ago';
my $typed = 'https://site.test/selftest?q=1';
my (%folder, %prepare, %program, %limit, %told);

# One run of lzrprf with the hostile application in it. $peer is the listener
# every name leads to, $types what the user types into the address window,
# $answer what the user says to every question after that.
sub attack {
    my ($part, $peer, $types, $answer, $expected, $within) = @_;
    $folder{$part} //= "$base.$part";
    mkdir $folder{$part};
    system('/bin/cp', "$site_folder/trusted.pem", "$folder{$part}/authority.pem");
    my $pid = open(my $run, '-|') // die "selftest: cannot fork: $!\n";
    if (!$pid) {
        $prepare{$part}->($$) if $prepare{$part};    # this process becomes lzrprf and then the application, so $$ is the application's number
        exec '/usr/bin/perl', $lzrprf, 'try', $folder{$part}, "127.0.0.1:$port{$peer}", $types, $answer, $program{$part} ? @{$program{$part}} : ('/usr/bin/perl', '-e', $hostile,
            $port{echo}, $secret, $home, $outside, $lzrprf, $folder{$part}, $computer, $part, $$);
        exit 1;
    }
    my %seen;
    while (<$run>) {
        chomp;
        my ($attempt, $result) = split /\t/;
        $result //= '';
        if ($told{$part}) { $told{$part}{$attempt} = $result }    # this run's lines are judged by whoever asked for the run
        elsif ($seen{$attempt}++) { check(0, $attempt, 'reported twice') }
        elsif (my $seconds = $within->{$attempt}) { check($result =~ /^\d+$/ && $result <= $seconds, $attempt, "ended after $result seconds") }
        elsif ($limit{$attempt} && $result eq ($expected->{$attempt} // '')) { printf "%-6s %s (%s)\n", 'limit', $attempt, $result }
        else { check($result eq ($expected->{$attempt} // 'nothing is expected under this name'), $attempt, $result) }
    }
    close $run;
    check($seen{$_}, "$_: was attempted", $seen{$_} ? 'yes' : 'no report') for sort grep { !$seen{$_} } keys %$expected, keys %$within;
}
sub kept { open my $in, '<', "$folder{$_[0]}/$_[1]" or return ''; local $/; return <$in> // '' }
my $read_so_far = 0;
sub site_saw {                            # what the test site recorded since this was last asked
    select undef, undef, undef, 0.5;      # a connection that just ended has its line by now
    open my $in, '<', "$site_folder/seen" or return ();
    seek $in, $read_so_far, 0;
    my @lines = <$in>;
    $read_so_far = tell $in;
    chomp @lines;
    return @lines;
}
sub what_happened { my $log = kept($_[0], 'log'); return join ' | ', map { (split /\t/, $_, 3)[2] } split /\n/, $log }
my $asks = sub { ("main container: gateway: ask for the address window ($_[0])" => $_[1]) };

# 1. Outside every container each attempt must succeed.
$folder{outside} = "$base.outside";
mkdir $folder{outside};
open my $empty_log, '>', "$folder{outside}/log";
close $empty_log;
my %works = ('use a file that was open in whoever started lzrprf' => 'open', 'connect straight to a listener on this computer' => 'reached', 'look up a name' => 'resolved', 'send a datagram' => 'sent', 'listen for connections' => 'listening',
    'read a file in the home folder' => 'read', 'read the same file by its other path, through the data volume' => 'read', 'learn whether a file exists in the home folder' => 'found',
    'list the home folder' => 'listed', 'list the folder of all users' => 'listed', 'read the log' => 'read', 'change the log' => 'opened', 'empty the log' => 'opened',
    'change lzrprf itself' => 'opened', 'write a file in the home folder' => 'written', 'write a file in the temporary folder' => 'written', 'signal another process' => 'allowed',
    'see a variable of the user' => 'seen', 'read the computer\'s name' => 'read', 'read the list of processes' => 'read', 'start a second process' => 'started', 'start another program' => 'started');
my %did;
open my $free, '-|', '/usr/bin/perl', '-e', $hostile, $port{echo}, $secret, $home, $outside, $lzrprf, $folder{outside}, $computer, 'outside', 0 or die "selftest: cannot run perl: $!\n";
while (<$free>) {
    chomp;
    my ($attempt, $result) = split /\t/;
    $attempt =~ s/^outside: //;
    $did{$attempt} = $result;
}
for (@attempts) { works(($did{$_} // 'no report') eq $works{$_}, "outside every container: $_", $did{$_} // 'no report') }
unlink "$secret.written", "/tmp/lzrprf-selftest.$outside";
site_saw();

# 2. The user types an address and says yes: what the application can do meanwhile, and after.
attack('yes', 'trusted', $typed, 'allow', {
    'main container: gateway: name an address itself, the way the first version allowed' => $no_sentence,
    'main container: gateway: name an address after the sentence' => $no_sentence,
    'main container: gateway: allow itself a host' => $no_sentence,
    'main container: gateway: ask what the user allowed' => $no_sentence,
    'main container: gateway: the sentence in capital letters' => $no_sentence,
    'main container: gateway: a line of control characters' => $no_sentence,
    'main container: gateway: a sentence that never ends' => 'nothing',
    'main container: gateway: a very long line' => $no_sentence,
    'main container: what its input is' => 'nothing',
    'main container: the clock of this process, while no window is open' => 'ran',
    'main container: keep running while lzrprf\'s windows are open' => 'stopped',
    'main container: gateway: two address windows asked for at once' => "$busy / ok $typed",
    'main container: gateway: 100 lines that are no sentence, each different' => 'made',
    'main container: gateway: 14 connections held open at the same time' => 'turned away beyond the limit',
    'page container: what it is given' => 'a pipe that holds a finished answer',
    'page container: the answer of the site' => 'whole',
    'page container: what leads to the main container' => 'a pipe, which cannot hand over a connection',
    'page container: reach the gateway' => 'refused',
    'page container: signal the application' => 'refused',
    contained('main container'), contained('page container'),
}, {});
my @saw = site_saw();
my $request = "GET /selftest?q=1 HTTP/1.1\r\nHost: site.test\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n";
check(@saw == 1 && $saw[0] eq "trusted\tbytes " . unpack('H*', $request), 'the test site received one connection, and on it these bytes and no other: the address that was typed, its host, and two fixed lines', @saw == 1 ? 'compared every byte' : scalar(@saw) . ' connections');
my $log = kept('yes', 'log');
my @lines = split /\n/, $log;
my %numbers = map { (split /\t/)[1] => 1 } @lines;
check(what_happened('yes') eq "you typed $typed | you allowed site.test, which is inside your own network (127.0.0.1), this once | $typed -> lzrprf connects to the first that answers of: 127.0.0.1 | $typed answered: " . length(answer_for('/selftest?q=1')) . ' bytes from 127.0.0.1',
    'the log holds, in this order: what was typed, the yes to a host inside the own network, where lzrprf connects, how it ended; and no other line', what_happened('yes'));
check(keys %numbers == 1, 'the four lines carry the number of one request', join ' ', sort keys %numbers);
for (1 .. 100) { my @open = glob "$folder{yes}/gate.*"; last unless @open; select undef, undef, undef, 0.1 }    # the gateway ends within a second of the application; a busy computer is given ten
my @left = sort map { m{([^/]+)$} } glob "$folder{yes}/*";
my $all_kept = join '', map { kept('yes', $_) } grep { $_ ne 'authority.pem' } @left;
check(!!($all_kept !~ /hidden-|flood-|\e/), 'what the application sent, 107 refused lines among it, is written nowhere: not in the log and in no other file of lzrprf', length($all_kept) . ' bytes kept, looked through all of them');
check("@left" eq 'asking authority.pem busy lock log quiet', 'lzrprf keeps no list of allowed hosts, no rule and no address: its folder holds the log, three empty files it locks, the clock time before which no window opens, and nothing the application can come back for', "@left");
check(!-e "$secret.written" && !-e "/tmp/lzrprf-selftest.$outside", 'no file was written anywhere', 'looked for them');

# 3. A host inside the own network, and the user says no.
attack('no', 'trusted', $typed, 'deny', {
    'main container: gateway: ask for the address window; the user types an address that leads into the own network, and says no' => 'no you said no to a host inside your own network',
    'main container: gateway: ask again straight after the no' => $busy,
    'main container: gateway: ask for the log window straight after the no' => $busy,
}, {});
@saw = site_saw();
check(!@saw, 'after the no the test site received no connection', scalar(@saw) . ' connections');
check(what_happened('no') eq "you typed $typed | you refused site.test, which is inside your own network (127.0.0.1) | $typed failed: you said no to a host inside your own network", 'the log holds what was typed, the no, and that nothing was fetched', what_happened('no'));

# 4. The window is closed, or what is typed is not an address lzrprf fetches.
attack('closed', 'trusted', '-', 'allow', { $asks->('closed', 'no you closed the window') }, {});
attack('unfit', 'trusted', 'http://site.test/selftest', 'allow', { $asks->('unfit', 'no what was typed is not an address lzrprf fetches') }, {});
@saw = site_saw();
check(!@saw && kept('closed', 'log') eq '' && kept('unfit', 'log') eq '', 'in both cases nothing was looked up, connected or written down', scalar(@saw) . ' connections');

# 5. https, checked: the certificate must prove the host that was typed, to an authority lzrprf trusts.
attack('certificate', 'trusted', 'https://other.test/selftest?secret=1', 'allow', { $asks->('certificate', 'no the certificate does not prove the host') }, {});
@saw = site_saw();
check(@saw == 1 && $saw[0] !~ /\tbytes [0-9a-f]/, 'a site whose certificate is for another name received no request', "@saw");
attack('untrusted', 'untrusted', 'https://site.test/selftest?secret=1', 'allow', { $asks->('untrusted', 'no the certificate does not prove the host') }, {});
@saw = site_saw();
check(@saw == 1 && $saw[0] !~ /\tbytes [0-9a-f]/, 'a site whose certificate no authority signed received no request', "@saw");
attack('plain', 'plain', 'https://site.test/selftest?secret=1', 'allow', { $asks->('plain', 'no no secure connection could be made') }, {});
@saw = site_saw();
my $in_the_clear = @saw == 1 && $saw[0] =~ /^plain\tbytes ([0-9a-f]*)$/ ? pack('H*', $1) : 'selftest';
check($in_the_clear !~ /selftest|secret|GET/, 'a site that speaks no https received no part of the address in the clear', length($in_the_clear) . ' bytes of a greeting it could not answer');
attack('elsewhere', 'trusted', 'https://site.test/elsewhere', 'allow', { $asks->('elsewhere', 'ok https://site.test/elsewhere'), 'page container: the answer to an address that sends on to another' => 'the sending-on itself, not followed' }, {});
@saw = site_saw();
check(@saw == 1, 'an answer that sends on to another address is not followed: one connection, one request', scalar(@saw) . ' connections');
attack('pieces', 'trusted', 'https://site.test/pieces', 'allow', { $asks->('pieces', 'ok https://site.test/pieces'), 'page container: an answer the site sent in pieces' => 'handed over as the site sent it' }, {});
attack('large', 'trusted', 'https://site.test/large', 'allow', { $asks->('large', 'no the answer is larger than lzrprf takes') }, {});
site_saw();

# 6. The log. A line that cannot be written means nothing is looked up or connected.
mkdir "$base.unwritable";
open my $locked, '>', "$base.unwritable/log";
close $locked;
chmod 0400, "$base.unwritable/log";
attack('unwritable', 'trusted', $typed, 'allow', { $asks->('unwritable', 'no the log could not be written') }, {});
@saw = site_saw();
check(!@saw, 'when the log cannot be written, the test site receives no connection', scalar(@saw) . ' connections');
chmod 0600, "$base.unwritable/log";
# A log larger than 10 MB: nothing is dropped, the fetch still happens, and the application is told so it can show the flag.
mkdir "$base.biglog";
open my $fill, '>', "$base.biglog/log" or die "selftest: cannot write the log: $!\n";
print $fill "2026-01-01T00:00:00Z\t1\tan old line that must stay\n", ("2026-01-01T00:00:01Z\t1\t" . 'x' x 1000 . "\n") x 11000;
close $fill;
my $before = -s "$base.biglog/log";
attack('biglog', 'trusted', $typed, 'allow', { $asks->('biglog', "ok $typed the log is large") }, {});
check(-s "$base.biglog/log" > $before && kept('biglog', 'log') =~ /^2026-01-01T00:00:00Z\t1\tan old line that must stay\n/, 'a log of 11 MB lost no line and took the new ones', 'compared it');
site_saw();
# The log window: the application can ask for it, and nothing more. Only the user's press clears the log.
$folder{keep} = $folder{clear} = $folder{yes};
attack('keep', 'trusted', '-', 'deny', { 'main container: gateway: ask for the log window (keep)' => 'ok' }, {});
check(kept('yes', 'log') eq $log, 'the log window was opened and closed: the log is as it was', 'compared it');
$folder{clearbusy} = $folder{yes};
sleep 4;                                  # a window was just closed: no new one for some seconds
open my $between, '>>', "$folder{yes}/busy" or die "selftest: cannot open: $!\n";
flock $between, LOCK_SH;                  # what a request holds from "you typed" until its last line is written
attack('clearbusy', 'trusted', '-', 'allow', { 'main container: gateway: ask for the log window (clearbusy)' => 'ok' }, {});
check(kept('yes', 'log') eq $log, 'the user pressed "Clear the log" while a request was between its first line and its last: nothing was cleared', 'compared it');
close $between;
sleep 4;
attack('clear', 'trusted', '-', 'allow', { 'main container: gateway: ask for the log window (clear)' => 'ok' }, {});
check(what_happened('yes') =~ /^you cleared the log: it held 4 lines, 0\.0 MB, from \S+ to \S+$/, 'the user pressed "Clear the log", twice: the new log begins by saying so', what_happened('yes'));

# A window stops every process of the application: the main container and a page container that is alive then.
attack('watch', 'trusted', 'https://site.test/watch', 'allow', {
    'main container: gateway: ask for the address window (watch)' => 'ok https://site.test/watch',
    'main container: gateway: ask for the log window straight after an address was fetched' => $busy,
    'main container: gateway: ask for the log window some seconds later' => 'ok',
    'main container: keep running while the log window is open' => 'stopped',
    'page container: keep running while a window of lzrprf is open' => 'stopped',
}, {});
site_saw();

# 7. curl's container. The hostile application stands in curl's place.
$prepare{fetcher} = sub {
    my ($application) = @_;
    (my $in_one_line = $hostile) =~ s/(?:^|\s+)# [^\n]*//mg;    # "lzrprf try" reads one argument from each line
    open my $instead, '>', "$base.fetcher/fetcher" or die "selftest: cannot write: $!\n";
    print $instead map { s/\n/ /gr . "\n" } '/usr/bin/perl', '-e', $in_one_line, $port{echo}, $secret, $home, $outside, $lzrprf, "$base.fetcher", $computer, 'in curl\'s place', $application;
};
attack('fetcher', 'echo', 'https://site.test/fetcher', 'allow', {
    $asks->('fetcher', 'ok https://site.test/fetcher'),
    'fetch container: talk through the one socket it was given' => 'echo:hello',
    'fetch container: reach the gateway' => 'refused',
    'fetch container: signal the application' => 'refused',
    contained('fetch container'),
}, {});
@saw = site_saw();
check(@saw == 1 && $saw[0] eq "echo\tbytes " . unpack('H*', 'hello'), 'whatever stands in curl\'s place reaches one place only: the connection lzrprf made for the address that was typed and written down', "@saw");

# 8. Ways out that need no socket.
my $try = "/usr/bin/perl \"$lzrprf\" try \"$folder{no}\" 127.0.0.1:$port{trusted} - allow";
my $opened = system("$try /usr/bin/open -g https://site.test/ 2>/dev/null");
check($opened != 0, 'ask the system to open an address in another program', $opened ? 'refused' : 'opened');
# The clipboard holds whatever you copied last, in any program. The system's own tool for reading it
# is run outside and inside the container; only the number of bytes is looked at.
my $copied = length(qx{/usr/bin/pbpaste 2>/dev/null} // '');
my $read = length(qx{$try /usr/bin/pbpaste 2>/dev/null} // '');
if ($copied || $read) { check($read == 0, 'read the clipboard with the system\'s own tool', $read ? "read $read bytes" : "refused; outside the container the same tool read $copied bytes") }
else { untested('read the clipboard with the system\'s own tool', 'the clipboard is empty: copy something and run again') }
@saw = site_saw();
check(!@saw, 'neither reached the test site', scalar(@saw) . ' connections');

# 9. The two judgements lzrprf makes about text, asked of lzrprf itself.
my %leads = (
    '127.0.0.1' => 0, '10.1.2.3' => 0, '172.20.0.1' => 0, '192.168.1.1' => 0, '169.254.169.254' => 0, '100.64.0.1' => 0, '0.0.0.0' => 0, '192.0.0.8' => 0, '198.18.0.1' => 0,
    '192.0.2.1' => 0, '224.0.0.1' => 0, '240.0.0.1' => 0, '255.255.255.255' => 0, '::1' => 0, '::' => 0, 'fe80::1' => 0, 'fd00::1' => 0, 'ff02::1' => 0, '::ffff:127.0.0.1' => 0,
    '::ffff:192.168.1.1' => 0, '64:ff9b::7f00:1' => 0, '64:ff9b::a00:1' => 0, '2002:7f00:1::' => 0, '2001::1' => 0, '2001:db8::1' => 0, '3fff::1' => 0, 'fe80::1%lo0' => 0, 'nonsense' => 0,
    '1.1.1.1' => 1, '8.8.8.8' => 1, '2606:4700:4700::1111' => 1, '::ffff:1.1.1.1' => 1, '64:ff9b::808:808' => 1,
);
my (%said, %sent_by);
for (qx{/usr/bin/perl "$lzrprf" public @{[map { "'$_'" } sort keys %leads]}}) {
    chomp;
    my ($address, $verdict, $way) = split /\t/;
    ($said{$address}, $sent_by{$address}) = ($verdict =~ /^on the public internet/ ? 1 : 0, $way // '');
}
my @wrong = grep { ($said{$_} // -1) != $leads{$_} } sort keys %leads;
check(!@wrong, 'an address on this computer or in a network of your own is told apart from one on the public internet', @wrong ? "wrong for @wrong" : scalar(keys %leads) . ' addresses');
check($sent_by{'127.0.0.1'} eq 'sent by a route of its own', 'an address this computer reaches by a route of its own is told apart from one it sends the way the internet at large is, whatever range it is in', "127.0.0.1 is $sent_by{'127.0.0.1'}");
if ($sent_by{'1.1.1.1'} eq 'sent the way the internet at large is') { check(1, 'an address on the internet is seen as sent that way', "1.1.1.1 is $sent_by{'1.1.1.1'}") }
else { untested('an address on the internet is seen as sent that way', "this computer says of 1.1.1.1: $sent_by{'1.1.1.1'}") }
my %sent = (
    'site.test' => 'https://site.test/', 'Site.Test/A?b=C#d' => 'https://site.test/A?b=C', 'https://site.test:443/x' => 'https://site.test/x', 'site.test?q=1' => 'https://site.test/?q=1',
    'https://site.test/a/../b' => 'https://site.test/a/../b', '  https://site.test/  ' => 'https://site.test/',
    'http://site.test/' => '', 'ftp://site.test/' => '', 'file:///etc/passwd' => '', 'https://127.0.0.1/' => '', 'https://[::1]/' => '', 'localhost' => '', 'https://2130706433/' => '',
    'https://site.test:8443/' => '', 'https://user@site.test/' => '', 'https://site.test@other.test/' => '', 'https://site.test\\@other.test/' => '', 'https://site.test./' => '',
    'https://site.test/a b' => '', "https://site.test/\tx" => '', "https://site.test/\nHost: other.test" => '', "https://site.test/\x{e4}" => '', 'https://s\x{e4}te.test/' => '',
    'https:site.test' => '', 'https://' => '', '' => '', 'javascript:alert(1)' => '', 'https://site.test:443:443/' => '', 'https://site.test/' . 'a' x 2000 => '',
);
my @unfit;
for my $text (sort keys %sent) {
    open my $ask, '-|', '/usr/bin/perl', $lzrprf, 'address', $text or die "selftest: cannot run lzrprf: $!\n";
    my $says = do { local $/; <$ask> } // '';
    my ($would) = $says =~ /\t(https:\S*)\n\z/;
    push @unfit, $text unless ($would // '') eq $sent{$text} && ($sent{$text} ne '' || $says =~ /\tnot sent: not an address lzrprf fetches\n\z/);
}
check(!@unfit, 'what is typed is sent as typed, or not at all: https only, a host by its name, port 443, no name and password, no space, no control character', @unfit ? 'wrong for ' . join(' ', map { s/[^\x21-\x7e]/?/gr } @unfit) : scalar(keys %sent) . ' texts');

# 10. Time limits, when asked for.
if ($limits) {
    attack('spin', 'trusted', 'https://site.test/spin', 'allow', { $asks->('spin', 'ok https://site.test/spin') }, { 'main container: a page that never stops (spin)' => 45 });
    attack('sleep', 'trusted', 'https://site.test/sleep', 'allow', { $asks->('sleep', 'ok https://site.test/sleep') }, { 'main container: a page that never stops (sleep)' => 45 });
    my $start = time;
    attack('slow', 'trusted', 'https://site.test/slow', 'allow', { $asks->('slow', 'no the site did not answer in time') }, {});
    check(time - $start < 60, 'a site that never answers is given up on', 'after ' . (time - $start) . ' seconds');
}

# 11. macOS itself, asked the way a native application asks. A small C program
# is compiled here and run outside, as the application (main container, then
# page container) and in curl's place (fetch container).
my ($app, $tools) = ("$base.probe/Probe.app", qx{/usr/bin/xcode-select -p 2>/dev/null} // '');
chomp $tools;
my ($probe, $other, $started) = ("$app/Contents/MacOS/probe", "$app/Contents/Other.app", "$base.probe/started");
my @native = ('reach services of the system by their name', 'list the windows of other applications', 'list the running applications',
    'read the clipboard the way an application does', 'have the system start another application',
    "take a picture of another application's window", 'give a command to another application');
if ($? || !-d $tools || !-x '/usr/bin/cc') { untested($_, 'this Mac has no C compiler; "xcode-select --install" gives one') for @native }
else {
    make_path("$app/Contents/MacOS", "$other/Contents/MacOS");
    my %file = ("$base.probe/probe.c" => $probe_source, "$other/Contents/MacOS/other" => "#!/bin/sh\necho started >> \"$started\"\n",
        "$other/Contents/Info.plist" => $other_application);
    for my $name (keys %file) { open my $out, '>', $name or die "selftest: cannot write $name: $!\n"; print $out $file{$name}; close $out }
    chmod 0755, "$other/Contents/MacOS/other";
    my $built = system("/usr/bin/cc -o \"$probe\" \"$base.probe/probe.c\" -framework ApplicationServices -framework AppKit 2>/dev/null") == 0;
    if (!$built) { untested($_, 'the C compiler of this Mac did not build the probe') for @native }
    else {
        my %out = map { chomp; split /\t/, $_, 2 } qx{"$probe" "$other"};
        for (1 .. 50) { last if -e $started; select undef, undef, undef, 0.1 }
        my %control = (
            $native[0] => scalar(() = ($out{"outside: $native[0]"} // '') =~ /com\./g) >= 10,
            $native[1] => ($out{"outside: $native[1]"} // '') =~ /^\d+ windows/,
            $native[2] => ($out{"outside: $native[2]"} // '') =~ /^\d+ applications/,
            $native[3] => ($out{"outside: $native[3]"} // '') =~ /^sees \d+ kinds/,
            $native[4] => -e $started,
            $native[5] => ($out{"outside: $native[5]"} // '') =~ /^a picture of \d+/,
            $native[6] => ($out{"outside: $native[6]"} // '') =~ /^the system answered (?:0|-1708|-1744)$/,    # it arrived, or only your own yes was missing
        );
        for (@native) {
            my $saw = $out{"outside: $_"} // 'no report';
            $saw = (() = $saw =~ /com\./g) . ' of the ' . (() = $probe_source =~ /"com\.apple\./g) . ' it asks for' if $_ eq $native[0];
            if ($control{$_}) { works(1, "outside every container: $_", $saw) }
            elsif ($_ eq $native[5]) { untested($_, "outside every container it gave: $saw; the program that started this test may not record the screen, so there is nothing to compare with. That permission is macOS's own, in System Settings") }
            else { untested($_, $_ eq $native[3] ? 'the clipboard is empty: copy something and run again' : "outside every container it gave: $saw") }
        }
        unlink $started;
        $told{probe} = {};
        $program{probe} = [$probe, $other];
        attack('probe', 'trusted', 'https://site.test/probe', 'allow');
        $told{inplace} = {};
        $prepare{inplace} = sub {
            open my $instead, '>', "$base.inplace/fetcher" or die "selftest: cannot write: $!\n";
            print $instead map { "$_\n" } $probe, $other, 'fetch', "$base.inplace";
        };
        attack('inplace', 'echo', 'https://site.test/inplace', 'allow');
        site_saw();
        sleep 3;                              # the system starts an application a moment after it was asked
        my %inside = (%{$told{probe}}, %{$told{inplace}});
        my %allowed = map { $_ => 1 } 'com.apple.windowserver.active', 'com.apple.CARenderServer', 'com.apple.windowmanager.server', 'com.apple.coreservices.launchservicesd',
            'com.apple.hiservices-xpcservice', 'com.apple.coreservices.appleevents';
        for my $where ('main container', 'page container', 'fetch container') {
            for (grep { $control{$_} } @native) {
                my $saw = $inside{"$where: $_"} // 'no report';
                if ($_ eq $native[0] && $where eq 'main container') {
                    my @reached = $saw =~ /(com\.[\w.\-\@]+)/g;
                    check($saw ne 'no report' && !grep({ !$allowed{$_} } @reached) && @reached == keys %allowed, "$where: $_: the six its window needs, and no other", $saw);
                }
                elsif ($where eq 'main container' && /^list the / && $saw =~ /^\d+ /) { printf "%-6s %s (%s)\n", 'limit', "$where: $_", "$saw: their names" }
                elsif ($where eq 'main container' && $_ eq $native[5] && $saw =~ /^a picture of \d+/) { printf "%-6s %s (%s)\n", 'limit', "$where: $_", "$saw: the program that started this test may record the screen, and macOS extends that to what it starts. Started from its icon, the application has no such permission unless you give it one in System Settings" }
                elsif ($_ eq $native[6]) { check($saw =~ /^the system answered -?\d+$/ && $saw !~ /answered (?:0|-1708|-1744|-1712)$/, "$where: $_", "$saw: it did not arrive") }
                elsif ($_ eq $native[4]) { check(!-e $started && $saw ne 'no report', "$where: $_", -e $started ? 'it was started' : "$saw; nothing was started") }
                else { check($saw =~ /^(?:none|refused|sees nothing|no window to try)$/, "$where: $_", $saw) }
            }
        }
    }
}

# 12. Your part, when asked for: lzrprf's real windows.
if ($mode eq 'windows') {
    print "\nNow your part. A window of lzrprf opens: type  site.test/hello  into it and press Go. In the next window press \"Yes, this once\".\n";
    attack('ask', 'trusted', '-', 'ask', { $asks->('ask', 'ok https://site.test/hello') }, {});
    @saw = site_saw();
    check(@saw == 1 && what_happened('ask') =~ m{^you typed https://site\.test/hello \| you allowed site\.test, }, 'what you typed into the real window is what the test site received and what the log says', what_happened('ask'));
    my $held = kept('ask', 'log');
    $folder{asklog} = $folder{ask};
    print "\nThe log window opens after four seconds: look at it, and press Close.\n";
    sleep 4;
    attack('asklog', 'trusted', '-', 'ask', { 'main container: gateway: ask for the log window (asklog)' => 'ok' }, {});
    check(kept('ask', 'log') eq $held, 'the real log window was opened and closed: the log is as it was', 'compared it');
}

kill 'TERM', $site;
kill 'TERM', map { /^\s*(\d+)\s+$site\s*$/ ? $1 : () } qx{/bin/ps -axo pid=,ppid=};    # the site's own helpers, if one is still waiting
unlink $secret;
close $left_open;
POSIX::close(19);
remove_tree("$base.probe");
for my $one (glob "$base.*") { chmod 0600, glob "$one/*"; unlink glob "$one/*"; rmdir $one }
if ($failures) {
    rmdir "$home/.lzrprf" if $made;
    print "\n$failures FAILED. Do not trust this copy of lzrprf on this computer.\n";
    exit 1;
}
# The mark of what was just tested. "lzrprf run" starts an application only when this is the mark of now.
chomp(my $mark = qx{/usr/bin/perl "$lzrprf" mark} // '');
unlink "$home/.lzrprf/proven";
open my $proven, '>', "$home/.lzrprf/proven" or die "selftest: cannot write $home/.lzrprf/proven: $!\n";
print $proven "$mark\n";
close $proven or die "selftest: cannot write $home/.lzrprf/proven: $!\n";
print "\nAll held", ($untested ? ", $untested untested (see above)" : ''), ".\nTested and marked: $mark\n";
exit 0;

BEGIN {
$other_application = <<'END';
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>test.lzrprf.selftest.other</string>
<key>CFBundleExecutable</key><string>other</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>LSUIElement</key><true/>
</dict></plist>
END
# probe OTHER.app [fetch FOLDER]: what a program can reach of macOS itself.
$probe_source = <<'END';
#include <ApplicationServices/ApplicationServices.h>
#include <servers/bootstrap.h>
#include <objc/message.h>
#include <objc/runtime.h>
#include <sys/socket.h>
#include <sys/un.h>
#include <dlfcn.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

static const char *where;
static void report(const char *what, const char *result) { printf("%s: %s\t%s\n", where, what, result); fflush(stdout); }
static long count_of(const char *class, const char *one, const char *list) {    // [[Class one] list].count, or -1
    id first = ((id (*)(id, SEL))objc_msgSend)((id)objc_getClass(class), sel_registerName(one));
    id all = first ? ((id (*)(id, SEL))objc_msgSend)(first, sel_registerName(list)) : 0;
    return all ? (long)((unsigned long (*)(id, SEL))objc_msgSend)(all, sel_registerName("count")) : -1;
}

int main(int argc, char **argv) {
    static const char *names[] = {    // the six the main container is allowed come first; the rest is what an application would ask for next
        "com.apple.windowserver.active", "com.apple.CARenderServer", "com.apple.windowmanager.server", "com.apple.coreservices.launchservicesd",
        "com.apple.hiservices-xpcservice", "com.apple.coreservices.appleevents",
        "com.apple.pasteboard.1", "com.apple.lsd.open", "com.apple.lsd.mapdb", "com.apple.window_proxies", "com.apple.tccd",
        "com.apple.tccd.system", "com.apple.cfprefsd.daemon", "com.apple.cfprefsd.agent", "com.apple.distributed_notifications@Uv3",
        "com.apple.dnssd.service", "com.apple.SystemConfiguration.configd", "com.apple.system.opendirectoryd.libinfo",
        "com.apple.coreservices.quarantine-resolver", "com.apple.audio.audiohald", "com.apple.cmio.registerassistantservice",
        "com.apple.screencapture.interactive", "com.apple.dock.server", "com.apple.system.notification_center", "com.apple.fonts",
        "com.apple.FontObjectsServer", "com.apple.logd", "com.apple.diagnosticd", "com.apple.iohideventsystem", "com.apple.axserver",
        "com.apple.inputmethodkit.launchagent", "com.apple.tsm.uiserver", "com.apple.dock.fullscreen"};
    char text[4096] = "", line[200];
    int fetch = argc > 3 && !strcmp(argv[2], "fetch"), gate = socket(AF_UNIX, SOCK_STREAM, 0);
    struct sockaddr_un to = {.sun_family = AF_UNIX};
    where = fetch ? "fetch container" : getenv("LZRPRF_CONTAINED") ? "page container" : getenv("LZRPRF") ? "main container" : "outside";
    if (fetch) {                          // in curl's place: lzrprf waits on this socket file for what curl would send
        snprintf(to.sun_path, sizeof to.sun_path, "%s/way.%d", argv[3], (int)getppid());
        if (connect(gate, (struct sockaddr *)&to, sizeof to) == 0) write(gate, "hello", 5);
    }

    for (unsigned i = 0; i < sizeof names / sizeof *names; i++) {
        mach_port_t port = MACH_PORT_NULL;
        if (bootstrap_look_up(bootstrap_port, names[i], &port) != KERN_SUCCESS) continue;
        if (*text) strlcat(text, ", ", sizeof text);
        strlcat(text, names[i], sizeof text);
    }
    report("reach services of the system by their name", *text ? text : "none");

    CFArrayRef windows = CGWindowListCopyWindowInfo(kCGWindowListOptionAll, kCGNullWindowID);
    long count = windows ? CFArrayGetCount(windows) : 0, titled = 0;
    for (long i = 0; i < count; i++) if (CFDictionaryGetValue(CFArrayGetValueAtIndex(windows, i), kCGWindowName)) titled++;
    snprintf(line, sizeof line, "%ld windows, %ld with their title", count, titled);
    report("list the windows of other applications", count > 0 ? line : "refused");

    // A picture of what another application shows: of up to eight windows that are not this program's.
    // The call is looked up by name, because newer versions of macOS no longer offer it to a program that is being built.
    typedef CGImageRef (*picture_of)(CGRect, uint32_t, uint32_t, uint32_t);
    picture_of picture = (picture_of)dlsym(RTLD_DEFAULT, "CGWindowListCreateImage");
    long tried = 0, got = 0;
    for (long i = 0; picture && i < count && tried < 8; i++) {
        CFDictionaryRef window = CFArrayGetValueAtIndex(windows, i);
        CFNumberRef owner = CFDictionaryGetValue(window, kCGWindowOwnerPID), level = CFDictionaryGetValue(window, kCGWindowLayer),
            number = CFDictionaryGetValue(window, kCGWindowNumber);
        CFDictionaryRef bounds = CFDictionaryGetValue(window, kCGWindowBounds);
        int pid = 0, layer = 1, id = 0;
        CGRect box = CGRectZero;
        if (!owner || !level || !number || !bounds || !CGRectMakeWithDictionaryRepresentation(bounds, &box)) continue;
        CFNumberGetValue(owner, kCFNumberIntType, &pid);
        CFNumberGetValue(level, kCFNumberIntType, &layer);
        CFNumberGetValue(number, kCFNumberIntType, &id);
        if (pid == getpid() || layer != 0 || box.size.width < 200 || box.size.height < 200) continue;
        tried++;
        CGImageRef image = picture(CGRectNull, 1 << 3, (uint32_t)id, 1);    // this window only, as large as it is
        if (!image) continue;
        unsigned char dots[32 * 32 * 4] = {0};    // drawn small: a picture that holds something is not one colour
        CGColorSpaceRef colours = CGColorSpaceCreateDeviceRGB();
        CGContextRef small = CGBitmapContextCreate(dots, 32, 32, 8, 32 * 4, colours, kCGImageAlphaPremultipliedLast);
        if (small) CGContextDrawImage(small, CGRectMake(0, 0, 32, 32), image);
        for (unsigned at = 4; small && at < sizeof dots; at += 4) if (memcmp(dots, dots + at, 4)) { got++; break; }
        if (small) CGContextRelease(small);
        CGColorSpaceRelease(colours);
        CGImageRelease(image);
    }
    snprintf(line, sizeof line, "a picture of %ld of the %ld windows it tried", got, tried);
    report("take a picture of another application's window", !picture ? "this macOS has no such call" : !tried ? "no window to try" : got ? line : "refused");

    count = count_of("NSWorkspace", "sharedWorkspace", "runningApplications");
    snprintf(line, sizeof line, "%ld applications", count);
    report("list the running applications", count > 0 ? line : "refused");

    count = count_of("NSPasteboard", "generalPasteboard", "types");
    snprintf(line, sizeof line, "sees %ld kinds of content", count);
    report("read the clipboard the way an application does", count > 0 ? line : count ? "refused" : "sees nothing");

    CFURLRef other = CFURLCreateFromFileSystemRepresentation(0, (const UInt8 *)argv[1], strlen(argv[1]), 1);
    snprintf(line, sizeof line, "the system answered %d", (int)LSOpenCFURLRef(other, 0));
    report("have the system start another application", line);

    // A command to another application, the way a script gives one: an event the Finder does not know.
    // macOS is told never to ask the user about it, so no window opens here.
    AEAddressDesc finder;
    AppleEvent event, reply;
    OSStatus sent = -1;
    if (AECreateDesc(typeApplicationBundleID, "com.apple.finder", 16, &finder) == noErr) {
        if (AECreateAppleEvent('LZRP', 'ping', &finder, kAutoGenerateReturnID, kAnyTransactionID, &event) == noErr) {
            sent = AESendMessage(&event, &reply, kAEWaitReply | 0x00020000, 120);    // waits two seconds at most
            if (sent == noErr) AEDisposeDesc(&reply);
            AEDisposeDesc(&event);
        }
        AEDisposeDesc(&finder);
    }
    snprintf(line, sizeof line, "the system answered %d", (int)sent);
    report("give a command to another application", line);

    if (!strcmp(where, "main container")) {    // ask for an address, so that a page container is started: it runs this program too
        strlcpy(to.sun_path, getenv("LZRPRF"), sizeof to.sun_path);
        if (connect(gate, (struct sockaddr *)&to, sizeof to) == 0 && write(gate, "address\n", 8) == 8) {
            shutdown(gate, SHUT_WR);
            for (ssize_t n; (n = read(gate, text, sizeof text)) > 0;) fwrite(text, 1, n, stdout);
        }
    }
    return 0;
}
END
}

sub check($$$) {
    my ($held, $what, $saw) = @_;
    $failures++ unless $held;
    printf "%-6s %s (%s)\n", $held ? 'held' : 'FAILED', $what, $saw;
}

sub untested($$) {
    my ($what, $why) = @_;
    $untested++;
    printf "%-6s %s (%s)\n", 'UNTESTED', $what, $why;
}

sub works($$$) {
    my ($did, $what, $saw) = @_;
    $failures++ unless $did;
    printf "%-6s %s (%s)\n", $did ? 'works' : 'FAILED', $what, $saw;
}
