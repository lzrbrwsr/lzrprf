# What is kept after a window closes.
sub holding {                             # the files under a folder that hold any of these words: every file is searched
    my ($folder, @words) = @_;
    my @found;
    find({ no_chdir => 1, wanted => sub { return unless -f $_; my $all = slurp($_); push @found, s{^\Q$folder\E/}{}r if grep { index($all, $_) >= 0 } @words } }, $folder);
    return @found;
