# The bytes that open an encryption, with the values that must differ from one
# connection to the next set to zero: the random number, the session number,
# the key that is offered. And whether an earlier connection is taken up again.
sub offered {                            # the ciphers and curves the first message of a connection offers, as hex
    my ($hello) = @_;
    return unless length $hello > 48 && ord($hello) == 22 && ord(substr $hello, 5, 1) == 1;
    my $at = 9 + 2 + 32;
    $at += 1 + ord substr $hello, $at, 1;
    my $long = unpack 'n', substr $hello, $at, 2;
    my @ciphers = map { sprintf '%04x', $_ } unpack 'n*', substr $hello, $at + 2, $long;
    $at += 2 + $long;
    $at += 1 + ord substr $hello, $at, 1;
    my $end = $at + 2 + unpack 'n', substr $hello, $at, 2;
    $at += 2;
    my @curves;
    while ($at + 4 <= $end) {
        my ($type, $size) = unpack 'nn', substr $hello, $at, 4;
        @curves = map { sprintf '%04x', $_ } unpack 'n*', substr $hello, $at + 6, $size - 2 if $type == 10;
        $at += 4 + $size;
    }
    return ('ciphers', @ciphers, 'curves', @curves);
}
sub steady {
    my ($hello) = @_;
    return unless length $hello > 48 && ord($hello) == 22 && ord(substr $hello, 5, 1) == 1;
    my $at = 11;
    substr($hello, $at, 32) = "\0" x 32;
    $at += 32;
    my $n = ord substr $hello, $at, 1;
    substr($hello, $at + 1, $n) = "\0" x $n;
    $at += 1 + $n;
    $at += 2 + unpack 'n', substr $hello, $at, 2;
    $at += 1 + ord substr $hello, $at, 1;
    return ($hello, 0) if $at + 2 > length $hello;
    my $end = $at + 2 + unpack 'n', substr $hello, $at, 2;
    my $head = substr $hello, 0, $at;     # all that stands before the extensions
    $at += 2;
    my ($resumes, $rest) = (0, '');
    while ($at + 4 <= $end && $end <= length $hello) {
        my ($type, $size) = unpack 'nn', substr $hello, $at, 4;
        my $body = substr $hello, $at + 4, $size;
        $body = "\0" x $size if $type == 51;
        $body = '' if $type == 0 || $type == 21;    # the name of the host asked for, and the padding that fills the bytes up to one length whatever that name is: a picture's request names the picture's host
        $resumes = 1 if $type == 41 || $type == 35 && $size;
        $rest .= pack('nn', $type, length $body) . $body;
        $at += 4 + $size;
    }
    substr($head, 3, 2) = "\0\0";         # the two lengths before them count the name in
    substr($head, 6, 3) = "\0\0\0";
    $hello = $head . $rest;
    return ($hello, $resumes);
}

# What the test put on this computer is taken away again: its site with the
