my $window_tries = <<'END';
function tries(port, file, secret, keep) {
    ObjC.import('Foundation');
    ObjC.bindFunction('socket', ['int', ['int', 'int', 'int']]);
    ObjC.bindFunction('connect', ['int', ['int', 'void *', 'int']]);
    ObjC.bindFunction('sandbox_check', ['int', ['int', 'char *', 'int']]);
    var to = $.NSData.alloc.initWithBase64EncodedStringOptions($(port), 0), s = $.socket(2, 1, 0);
    var network = s >= 0 && $.connect(s, to.bytes, 16) == 0 ? 'reached' : 'refused';
    var written = $('x').writeToFileAtomicallyEncodingError($(file), false, 4, null) ? 'written' : 'refused';
