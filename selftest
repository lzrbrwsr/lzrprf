    my $pid = fork // return;
    if (!$pid) {
        open STDIN, '<', '/dev/null';
        open STDOUT, '|-', '/bin/sh', '-c', 'exec /bin/cat > "$0"', "$site_folder/$name.out" or POSIX::_exit(126);
        open STDERR, '|-', '/bin/sh', '-c', 'exec /bin/cat > "$0"', "$site_folder/$name.err" or POSIX::_exit(126);
        { no warnings; exec { $run{$name}{command}[0] } @{ $run{$name}{command} }; }
        POSIX::_exit(127);
    }
    my $until = Time::HiRes::time() + ($run{$name}{limit} // 90);
    while (waitpid($pid, POSIX::WNOHANG()) == 0) {
        if (Time::HiRes::time() > $until) { kill 'KILL', $pid; waitpid $pid, 0; last }
        select undef, undef, undef, 0.05;
    }
