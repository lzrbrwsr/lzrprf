sub tor_stand_in {                       # a stand-in for the Tor client: it says the client's own first lines, writes its port, and relays SOCKS5 to the test site, noting what each connection asked; "fail" cannot bootstrap and waits to be ended
    my ($mode) = @_;
    return sub {
        my ($folder) = @_;
        my $script = <<'END';
use strict; use warnings; use IO::Socket::INET; use IO::Select; use Time::HiRes 'sleep';
my ($mode, $site, $note) = ('@MODE@', @SITE@, '@NOTE@');
$| = 1;
my %cfg = do { open my $in, '<', $ARGV[2] or die "no config\n"; map { /^(\w+) = "([^"]*)"/ ? ($1, $2) : () } <$in> };
open my $noted, '>>', $note or die "no note\n";
