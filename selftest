        main.push(CLOCK ? Math.round(($.clock_gettime_nsec_np(16) - mainBegan) / 1e6) : -1);
    }
    return 'cpu_ms=' + spent.join(',') + ' main_ms=' + main.join(',') + ' wall_ms=' + (Date.now() - at) + ' timers=' + (torTimer ? 1 : 0) + (flight ? 1 : 0) + (shot ? 1 : 0) + ' place=' + counted.place + ' redrawn=' + counted.redrawn + ' ticks=' + counted.ticks;
