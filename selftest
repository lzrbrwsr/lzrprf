print "INFO tor_dirmgr: Downloading microdescriptors.\n"; sleep 0.1;
print "INFO tor_dirmgr: Marked consensus usable.\n"; sleep 0.1;
my $listen = IO::Socket::INET->new(Listen => 8, LocalAddr => '127.0.0.1', LocalPort => 0, ReuseAddr => 1) or die "no listen\n";
open my $port, '>', $cfg{port_info_file} or die "no port file\n";
print $port '{"ports":[{"protocol":"socks","address":"127.0.0.1:' . $listen->sockport . '"}]}';
close $port;
print "INFO arti::subcommands::proxy: Sufficiently bootstrapped; proxy now functional.\n";
my $select = IO::Select->new($listen);
my (%peer, %held, %stage, %user, %pass);
sub gone { for my $one (@_) { $select->remove($one); delete $_->{$one} for \%peer, \%held, \%stage; close $one } }
while (1) {
    for my $one ($select->can_read) {
        if ($one == $listen) { my $new = $listen->accept or next; $select->add($new); ($held{$new}, $stage{$new}) = ('', 0); next }
        my $got = sysread($one, my $chunk, 65536);
        if (!$got) { gone($one, $peer{$one} // ()); next }
        if (my $other = $peer{$one}) { syswrite($other, $chunk); next }
