print exists $list{$kind} ? $list{$kind} : $good;
print STDERR "answer\t$address\t", unpack('H*', $answer), "\n" if $part eq 'echo';
exit 0 if $part ne 'page' || $kind;
report 'what it is given', -p STDIN ? 'a pipe that holds a finished answer' : 'something else';
report 'the answer of the site', $answer =~ m{^HTTP/1\.1 200 OK\r\n.*\r\n\r\nthe page of the test site\n$}s ? 'whole' : 'not whole';
report 'what it writes to', -p STDOUT ? 'a pipe, which cannot hand over a connection' : 'something else';
