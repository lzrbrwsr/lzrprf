    var started; try { $.NSTask.launchedTaskWithLaunchPathArguments($('/usr/bin/true'), $([])); started = 'started'; } catch (e) { started = 'refused'; }
    var read = $.NSString.stringWithContentsOfFileEncodingError($(secret), 4, null).isNil() ? 'refused' : 'read';
    var shared = $.NSFileManager.defaultManager.contentsOfDirectoryAtPathError($('/Users/Shared'), null).isNil() ? 'refused' : 'listed';
    var pid = $.NSProcessInfo.processInfo.processIdentifier;
    return 'network=' + network + ' file=' + written + ' program=' + started + ' home=' + read + ' shared=' + shared + ' system=' + ['network-outbound', 'file-write-create', 'process-fork', 'lsopen', 'appleevent-send', 'user-preference-write'].map(function (what) { return $.sandbox_check(pid, what, 0); }).join('') + ' keep=' + kept;
}
END
