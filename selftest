#!/usr/bin/perl
# selftest: probes lzrprf with a hostile application, in each of lzrprf's
# three containers, and says what the application managed to do. Run it from
# the folder that holds lzrprf:
#
#   perl selftest            about half a minute
#
# It uses no host outside this computer, shows no window and asks you
# nothing. Its tries at an address outside go to 192.0.2.1, an address kept for
# documentation that no host answers: inside a container the try counts as
# refused only when the sandbox itself refuses it, and outside every container
# it must not be refused. So the tries made outside every container can put the
# opening packet of a connection to 192.0.2.1 on your network: it holds
# nothing of yours, and nothing answers it. It starts lzrprf with "try": the same program, with its state in a
# folder of its own, every name leading to a test site on this computer whose
# certificate is signed by an authority made here a moment ago, and the
# window's part played by the test. One run uses lzrprf's real window, kept
# off the screen. Everything else is the code "lzrprf run" uses.
#
# The hostile application is the text "$hostile" below. It is the published
# probe: read it, add to it, run it again.
#
# Five kinds of line are printed under eleven numbered headings, and after
# them a count and a verdict. A line that begins "selftest:" says why the
# test could not run at all.
#   now       what the test is doing at this moment. It is printed while the
#             test runs, so that whoever started it can show where it is.
#   works     a probe tried outside every container first, where it must
#             succeed: so a refusal inside is the container's, not a try that
#             could never have worked.
#   held      a probe that failed, or a promise that was checked.
#   FAILED    a probe that succeeded, or a promise that did not hold.
#   UNTESTED  something this computer gave no way to try, with the reason.
# The test site keeps its own record of every connection and every byte it
# received, and what lzrprf says it did is compared with that record.
#
# At its start the test takes out of ~/.lzrprf/proven the mark of what it
# tests (this build of macOS, this lzrprf, this selftest), and when nothing
# failed it writes that mark again: "lzrprf run" shows no page without it, so
# a run that fails takes back the proof of an earlier run that held. When a
# check could not be tried on this computer, the mark is followed by
# ", untested: " and the checks that could not be tried, and "lzrprf run"
# shows no page before you said yes to starting without exactly those. Nothing else is left behind but the empty file ~/.lzrprf/selftest.lock,
# which keeps two tests from running at once. A test that is stopped from
# outside ends every process it started and takes its files away.
use strict;
use warnings;
use Cwd 'abs_path';
use Digest::SHA;
use Fcntl qw(:flock O_WRONLY O_CREAT O_EXCL O_NOFOLLOW);
use File::Basename 'dirname';
use File::Find 'find';
use File::Path qw(make_path remove_tree);
use IO::Select;
use IO::Socket::IP;
use MIME::Base64 'encode_base64';
use MIME::Base64 'encode_base64';
use POSIX ();
use Socket qw(MSG_PEEK inet_aton);
use Time::HiRes;

exec '/usr/bin/perl', $0, @ARGV if $^X ne '/usr/bin/perl' && !$ENV{LZRPRF_SELFTEST_PERL}++;    # the system's own perl, which has what the test site needs

my $here = dirname(abs_path($0));
my $lzrprf = "$here/lzrprf";
my $home = abs_path((getpwuid $<)[7]);
my $secret = "$home/.lzrprf-selftest-secret";
my $secret_made = 0;                      # only a file this run made is ever removed
my ($failures, $untested, $held) = (0, 0, 0);
my @not_tried;                            # each check the test could not try, as "what (why)": named in the mark this run writes
sub check($$$);                           # each of the three is taken as one value. Without this, a comparison that
sub works($$$);                           # fails where a list is expected gives no value at all, the two after it
sub untested($$);                         # move up, and the line of a failed probe reads "held"
my $outside = $$;
$| = 1;                                   # each line is printed when it is made: whoever started the test can show where it is
print "now    A test site is built on this computer: no host outside this computer is used.\n";
my $made = mkdir "$home/.lzrprf", 0700;   # lzrprf keeps its state here; what is already there is left as it is
open my $alone, '>>', "$home/.lzrprf/selftest.lock" or die "selftest: cannot write in $home/.lzrprf: $!\n";
flock $alone, LOCK_EX | LOCK_NB or do {   # another test is running on this Mac (an installer's, or one by hand): this one waits for it, and never runs beside it
    print "now    Another selftest runs on this Mac: this one waits until it has ended.\n";
    flock $alone, LOCK_EX or die "selftest: cannot wait for the other selftest: $!\n";
};
# The order: the lock first, so two tests never write the file of marks at
# once; then the mark of what is tested is taken out, before anything else
# can stop the test. Only a test that cannot say what it tests, or that is
# not the selftest beside lzrprf, stops before that, and then no mark of
# its own stands to be taken out. What the test site needs and perl does not
# bring itself (IO::Socket::SSL) is loaded after the mark is out, so a Mac
# that lacks it ends with the mark taken out too; the lines "use" above name
# only what comes with perl itself.
chomp(my $mark = qx{/usr/bin/perl "$lzrprf" mark} // '');    # what is tested: this build of macOS, this lzrprf, and this selftest
length $mark or die "selftest: lzrprf could not say what is tested (the build of macOS, its own SHA-256 and that of the selftest beside it)\n";
my $own = Digest::SHA->new(256)->addfile(abs_path($0))->hexdigest;
$mark =~ /, selftest \Q$own\E$/ or die "selftest: the selftest beside lzrprf is not this file, so a mark written by this run would name another test. Run the selftest that stands beside lzrprf.\n";
unmark();                                 # a run that fails must not leave standing the mark an earlier run wrote for this same copy
require IO::Socket::SSL;
my ($paired) = $mark =~ /, lzrprf ([0-9a-f]{64}),/ or die "selftest: the mark does not name lzrprf's SHA-256\n";    # the SHA-256 of the lzrprf under test, as the release file of an application names it
# The file in the home folder that the probes try to read. It is made here,
# while the lock is held and before anything of the test is made or started,
# so a refusal leaves nothing behind. A run that was killed leaves its file:
# a plain file of yours, no link, that holds the test's own line and nothing
# else, is that one and is removed. Anything else at the name is not the
# test's: it is left as it is and the test does not run.
my $secret_line = "a file in the home folder\n";
if (my @there = lstat $secret) {
    -f _ && $there[4] == $< && $there[7] == length $secret_line && slurp($secret) eq $secret_line && unlink $secret
        or die "selftest: $secret is there already. It is not the test's, so the test leaves it as it is and does not run. Move it away, then start the test again.\n";
}
sysopen(my $file, $secret, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) or die "selftest: cannot make $secret: $!\n";    # made here and now, never a file or a link that was there
$secret_made = 1;
print $file $secret_line;
close $file;
my $base = "$home/.lzrprf/selftest.$outside";
my $site_folder = "$base.site";
mkdir $site_folder or die "selftest: cannot make $site_folder: $!\n";
$SIG{$_} = sub { tidy() if $$ == $outside; exit 130 } for 'INT', 'TERM', 'HUP';    # stopped from outside: nothing of the test stays running
my $text_of_lzrprf = slurp($lzrprf);
length $text_of_lzrprf or die "selftest: there is no lzrprf beside selftest\n";

# The test site's two certificates, both for the name site.test. lzrprf is
# told to trust the first as its authority; nothing trusts the second.
for my $name ('trusted', 'untrusted') {
    system("/usr/bin/openssl req -x509 -newkey rsa:2048 -nodes -keyout '$site_folder/$name.key' -out '$site_folder/$name.pem' -subj /CN=site.test -days 2 -addext subjectAltName=DNS:site.test -batch 2>/dev/null") == 0
        or die "selftest: cannot make a certificate\n";
}

# The test site: four listeners on this computer.
#   trusted     https, with the certificate lzrprf is told to trust
#   untrusted   https, with a certificate nothing trusts
#   plain       no encryption at all: it takes whatever arrives
#   echo        no encryption: answers what it is sent, preceded by "echo:"
# Each connection adds one line to the site's record: which listener, every
# byte that arrived there in the request, the bytes that opened the
# encryption, and whether lzrprf's log already held the line for this
# request at the moment the request arrived.
my (%listener, %port);
for my $kind (qw(trusted untrusted plain echo closed)) {
    $listener{$kind} = IO::Socket::IP->new(LocalHost => '127.0.0.1', LocalPort => 0, Listen => 64, ReuseAddr => 1) or die "selftest: cannot listen: $!\n";
    $port{$kind} = $listener{$kind}->sockport;
}
close delete $listener{closed};           # a port where nothing listens
sub answer_for {                          # what the test site answers on its https listeners
    my ($path) = @_;
    my $body = $path eq '/large' ? 'x' x (7 * 1024 * 1024) : $path =~ m{^/latest-(?:yes|same)(?:\?(?:quote|two|bad))?$} ? "7\n" : $path =~ m{^/report} ? "received\n" : "the page of the test site\n";
    return "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n4\r\nthe \r\n16\r\npage of the test site\n\r\n0\r\n\r\n" if $path eq '/pieces';
    my $head = $path eq '/elsewhere' ? "HTTP/1.1 302 Found\r\nLocation: https://elsewhere.test/moved\r\n" : "HTTP/1.1 200 OK\r\n";
    return $head . "Content-Type: text/html\r\nSet-Cookie: kept=never\r\nContent-Length: " . length($body) . "\r\nConnection: close\r\n\r\n$body";
}
sub logged {                              # lzrprf's log on the disk holds "connects to" for this address, and does not yet hold how it ended
    my ($path) = @_;
    for my $log (glob "$base.*/log") {
        my $all = slurp($log);
        return 1 if index($all, "https://site.test$path -> lzrprf connects to") >= 0 && index($all, "https://site.test$path answered") < 0;
    }
    my $short = slurp("$base.hosts/log");    # the run that keeps hosts only: its one request, by its host alone
    return 1 if $path =~ m{^/hosts/} && index($short, "https://site.test -> lzrprf connects to") >= 0 && index($short, "https://site.test answered") < 0;
    return 0;
}
my $site = fork // die "selftest: cannot fork: $!\n";
if (!$site) {
    close $alone;
    $SIG{CHLD} = 'IGNORE';
    $SIG{PIPE} = 'IGNORE';
    my $waiting = IO::Select->new(values %listener);
    while (1) {
        for my $ready ($waiting->can_read) {
            my ($kind) = grep { $listener{$_} == $ready } keys %listener;
            my $client = $ready->accept or next;
            next if fork;                 # one process for each connection, so a silent one holds up nobody
            my ($got, $hello) = ('', '');
            if ($kind eq 'echo') {
                syswrite($client, "echo:$got") if sysread($client, $got, 100);
                sysread($client, my $rest, 1);
                seen($kind, $got, '', 0);
                exit 0;
            }
            if ($kind eq 'plain') {
                my $until = time + 3;
                while (time < $until && IO::Select->new($client)->can_read(1)) { sysread($client, $got, 65536, length $got) or last }
                seen($kind, $got, '', 0);
                exit 0;
            }
            my $until = Time::HiRes::time() + 5;    # the bytes that open the encryption, looked at before they are used
            while (Time::HiRes::time() < $until) {
                recv($client, $hello, 16384, MSG_PEEK);
                last if length $hello >= 5 && length $hello >= 5 + unpack 'n', substr $hello, 3, 2;
                select undef, undef, undef, 0.01;
            }
            if (!IO::Socket::SSL->start_SSL($client, SSL_server => 1, SSL_cert_file => "$site_folder/$kind.pem", SSL_key_file => "$site_folder/$kind.key", Timeout => 10)) {
                seen($kind, '', $hello, 0);
                exit 0;
            }
            while ($got !~ /\r\n\r\n/ && length $got < 65536) { $client->sysread($got, 65536, length $got) or last }
            my ($path) = $got =~ m{^GET (\S+)};
            $path //= '';
            seen($kind, $got, $hello, logged($path));
            sleep 600 if $path eq '/slow';
            chmod 0400, "$base.logend/log" if $path eq '/logend';    # the log loses its permission between the line "connects to" and the line of how it ended
            rename "$base.$1app/other", "$base.$1app/Test.app/Contents/MacOS/app" if $path =~ m{^/out/shown\?(swapped|lostswap|lostlook)2$};    # the program of that run's application becomes another file while its window is open, between its first page and its second
            $client->print(answer_for($path));
            $client->close;
            exit 0;
        }
    }
}
sub seen {                                # one line, written in one piece, so two connections cannot mix
    open my $out, '>>', "$site_folder/seen" or return;
    syswrite($out, join("\t", $_[0], unpack('H*', $_[1]), unpack('H*', $_[2]), $_[3]) . "\n");
}
close $_ for values %listener;
chomp(my $temp_dir = qx{/usr/bin/getconf DARWIN_USER_TEMP_DIR 2>/dev/null} // '');    # your temporary folder, outside the home folder
my $temp_file = length $temp_dir ? "${temp_dir}lzrprf-selftest.$outside" : '';
my $settings_file = "$home/Library/Preferences/lzrprf-selftest.$outside";    # a file of the test's own among your settings: the window's container lets its process read that folder, the page and fetch containers do not
if (sysopen(my $set, $settings_file, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600)) { print $set "a file among the settings\n"; close $set } else { print "now    The test could not make its file among your settings ($!): each try that reads it will say refused.\n"; $settings_file = '' }
if (length $temp_file && sysopen(my $spare, $temp_file, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600)) { print $spare "a file in the temporary folder\n"; close $spare } else { $temp_file = '' }
END { if (defined $outside && $$ == $outside) { unlink $settings_file if length($settings_file // ''); unlink $temp_file if length($temp_file // '') } }    # a run that stops at a fault of its own takes its two files outside ~/.lzrprf with it; one that is killed outright leaves them
{ my $made = syscall(266, "/lzrprf-st.$outside", 0x202, 0600); POSIX::close($made) if $made >= 0 }    # memory with a name (shm_open, call 266), made here by the test itself and closed again, so that nothing started from here inherits it open and only its name is left: the hostile application asks to open it, and a container must refuse what another program made as it refuses the making
END { syscall(267, "/lzrprf-st.$outside") if defined $outside && $$ == $outside }    # and taken away again (shm_unlink, call 267) when the test ends
my @numbered = stat $secret;
my $by_number = @numbered ? "/.vol/$numbered[0]/$numbered[1]" : '';    # the same file by its number on the disk, a name that holds no folder
open my $left_open, '<', $secret or die "selftest: cannot read $secret: $!\n";
POSIX::dup2(fileno $left_open, 19) // die "selftest: cannot keep a file open: $!\n";    # every program started from here on inherits this open file as descriptor 19
my $files = pack('QQ', 0, 0);             # this test's own limit of open files (getrlimit, call 194; setrlimit, call 195; the limit of open files is number 8) is raised to 1024 when the system lets it: so a file can be left open under a high number, and what the test starts outside every container is not held to 256 by the test itself
syscall(194, 8, $files);
my ($soft_files, $hard_files) = unpack('QQ', $files);
my $more_files = pack('QQ', $hard_files < 1024 ? $hard_files : 1024, $hard_files);
syscall(195, 8, $more_files) if $soft_files < 1024;
my $few_files = $hard_files < 300;        # this test was itself started with a limit no process may raise: then nothing it starts can allow itself 300 open files, with or without a container, and the limit of 256 cannot be shown here
my $high = POSIX::dup2(fileno $left_open, 700) // 19;    # and as descriptor 700, a number above the 255 a careless closing would stop at; where the system gives no such number, this try repeats the one with 19
$ENV{LZRPRF_SELFTEST_MARK} = 'a variable of the user';
my $computer = (POSIX::uname())[1] // '';

# The hostile application. lzrprf starts it in a page container, once for
# every answer that was fetched. In one run it also stands in curl's place,
# in the fetch container. Before all that it is run here, outside every
# container, where each of its attempts must succeed. Each attempt says its
# name and what happened: on its error output, which only a test is given;
# and in curl's place on its output, which lzrprf takes for a site's answer.
# What it does in a page container depends on the address: it tries
# everything, or it writes one of the lists that lzrprf must refuse.
# Its try at an address outside this computer ("sub nowhere") goes to
# 192.0.2.1, kept for documentation (RFC 5737), which no host answers. It
# does not wait: outside a sandbox the try is left pending, and pending is
# not refused. Only the sandbox's own refusal counts as refused, and the same
# try is made outside every container, where it must not be refused: so a
# firewall of yours that refuses it is not taken for the sandbox.
# Its try at memory asks the system for 3 GiB of addresses (mmap, call 197
# on macOS) and touches none of it: the answer is yes or no at once, and no
# memory of the tester's Mac is filled outside the containers. A string that
# large would be filled, and would end the program where eval cannot catch it.
# No comment stands in its text before the part for curl's place: there its
# lines are joined into one, and a comment would take the rest with it.
# In it the limit of processor time is number 0 and the limit of memory number 5 (setrlimit, call 195): outside every container neither try is a raise, in a container both are.
my $hostile = <<'END';
use IO::Socket::IP; use IO::Socket::UNIX; use Socket; use POSIX (); use MIME::Base64 ();
my ($port, $secret, $home, $outside, $lzrprf, $folder, $computer, $part, $spare, $numbered, $high, $settings) = @ARGV;
$| = 1; $SIG{PIPE} = 'IGNORE';
my $address = $ENV{LZRPRF_CONTAINED} // '';
exit 0 if $part eq 'page' && $address =~ m{/out/quick};
my $where = $part eq 'outside' || $part eq 'link' ? 'outside' : $part eq 'curl' ? 'fetch container' : 'page container';
my $to = $part eq 'curl' ? \*STDOUT : \*STDERR;
sub report { print $to "tried\t$where: $_[0]\t$_[1]\n" }
sub direct { IO::Socket::IP->new(PeerHost => $_[0], PeerPort => $_[1], Timeout => 3) ? 'reached' : 'refused' }
sub nowhere {
    socket(my $s, PF_INET, SOCK_STREAM, 0) or return $!{EPERM} ? 'refused' : "no socket: $!";
    fcntl($s, POSIX::F_SETFL(), POSIX::O_NONBLOCK());
    return connect($s, pack_sockaddr_in(443, inet_aton('192.0.2.1'))) ? 'connected' : $!{EPERM} ? 'refused' : $!{EINPROGRESS} ? 'pending' : "not refused: $!";
}
sub computer_name { my $name = eval { (POSIX::uname())[1] } // ''; return $name }
sub process_list {
    my ($names, $size) = (pack('i4', 1, 14, 0, 0), pack('Q', 0));
    return eval { syscall(202, $names, 4, 0, $size, 0, 0) } == 0 && unpack('Q', $size) > 0;
}
sub by_link {
    my ($own) = $^X =~ m{^(.*\.app)/Contents/MacOS/[^/]+$};
    report 'read a file of its own, beside that link', open(my $beside, '<', "$own/Contents/Resources/release") ? 'read' : 'refused' if defined $own;
    report 'read a file in the home folder through a link in its own folder', open(my $linked, '<', "$own/Contents/Resources/alias") ? 'read' : 'refused' if defined $own;
    report 'load code from another file of its own folder', eval { require DynaLoader; DynaLoader::dl_load_file("$own/Contents/Resources/code.bundle", 0) } ? 'loaded' : 'refused' if defined $own && -e "$own/Contents/Resources/code.bundle";
}
sub attempts {
    report 'use a file that was open in whoever started lzrprf', POSIX::fstat(19) ? 'open' : 'closed';
    report 'use a file that was open there under a high number', POSIX::fstat($high) ? 'open' : 'closed';
    report 'connect straight to a listener on this computer', direct('127.0.0.1', $port);
    report 'connect straight to an address outside this computer', nowhere();
    report 'look up a name', gethostbyname('localhost') ? 'resolved' : 'refused';
    socket(my $udp, PF_INET, SOCK_DGRAM, 0);
    report 'send a datagram', $udp && send($udp, 'x', 0, pack_sockaddr_in($port, inet_aton('127.0.0.1'))) ? 'sent' : 'refused';
    report 'listen for connections', IO::Socket::IP->new(LocalHost => '127.0.0.1', LocalPort => 0, Listen => 1) ? 'listening' : 'refused';
    report 'read a file in the home folder', open(my $in, '<', $secret) ? 'read' : 'refused';
    report 'read the same file by its other path, through the data volume', open(my $by, '<', "/System/Volumes/Data$secret") ? 'read' : 'refused';
    report 'read the same file by its number on the disk, a name that holds no folder', open(my $number, '<', $numbered // '') ? 'read' : 'refused';
    report 'learn whether a file exists in the home folder', -e $secret ? 'found' : 'hidden';
    report 'list the home folder', opendir(my $dir, $home) ? 'listed' : 'refused';
    report 'list the folder of all users', opendir(my $users, '/System/Volumes/Data/Users') || opendir($users, '/Users') ? 'listed' : 'refused';
    report 'read the log', open(my $log, '<', "$folder/log") ? 'read' : 'refused';
    report 'change the log', open(my $add, '>>', "$folder/log") ? 'opened' : 'refused';
    report 'empty the log', open(my $empty, '+<', "$folder/log") ? 'opened' : 'refused';
    report 'give the log another name', rename("$folder/log", "$folder/log.moved") ? (rename("$folder/log.moved", "$folder/log"), 'renamed')[1] : 'refused';
    report 'remove the log', do { my $held = open(my $whole, '<', "$folder/log") ? do { local $/; <$whole> } : undef; unlink("$folder/log") ? do { if (defined $held && open my $back, '>', "$folder/log") { print $back $held; close $back } 'removed' } : 'refused' };
    report 'change what is kept', open(my $keep, '>>', "$folder/keep") ? 'opened' : 'refused';
    report 'remove the setting of what is kept', unlink("$folder/keep") ? do { if (open my $back, '>', "$folder/keep") { print $back "all 0\n"; close $back } 'removed' } : 'refused';
    report 'put a setting of its own in its place', open(my $setting, '>', "$folder/keep.new") ? 'written' : 'refused';
    report 'change lzrprf itself', open(my $self, '>>', $lzrprf) ? 'opened' : 'refused';
    report 'write a file in the home folder', open(my $out, '>', "$secret.written.$part") ? 'written' : 'refused';
    report 'write a file in the temporary folder', open(my $tmp, '>', "/tmp/lzrprf-selftest.$outside") ? 'written' : 'refused';
    report 'read a file in your temporary folder, outside the home folder', open(my $spared, '<', $spare // '') ? 'read' : 'refused';
    report 'read a file among the settings in the home folder', open(my $set, '<', $settings // '') ? 'read' : 'refused';
    report 'signal another process', kill(0, $outside) ? 'allowed' : 'refused';
    report 'open a device of the terminals', open(my $terminal, '+<', '/dev/ptmx') ? 'opened' : 'refused';
    by_link();
    report 'see a variable of the user', exists $ENV{LZRPRF_SELFTEST_MARK} ? 'seen' : 'hidden';
    report 'read the computer\'s name', length $computer && computer_name() eq $computer ? 'read' : 'hidden';
    report 'read the list of processes', process_list() ? 'read' : 'refused';
    my $shared = eval { shmget(0, 4096, 01600) };
    report 'make memory that other programs can share', defined $shared ? 'made' : 'refused';
    eval { shmctl($shared, 0, 0) } if defined $shared;
    my $flag = eval { semget(0, 1, 01600) };
    report 'make a flag that other programs can wait on', defined $flag ? 'made' : 'refused';
    eval { semctl($flag, 0, 0, 0) } if defined $flag;
    my $queue = eval { msgget(0, 01600) };
    report 'make a queue that other programs can read', defined $queue ? 'made' : 'refused';
    eval { msgctl($queue, 0, 0) } if defined $queue;
    my $name = "/lzrprf-selftest-$$";
    report 'make memory with a name, for other programs to open', syscall(266, $name, 0x202, 0600) >= 0 ? 'made' : 'refused';
    syscall(267, $name);
    report 'open memory with a name that another program made', syscall(266, "/lzrprf-st.$outside", 0, 0) >= 0 ? 'opened' : 'refused';
    report 'make a flag with a name, for other programs to open', syscall(268, $name, 0x200, 0600, 0) != -1 ? 'made' : 'refused';
    syscall(270, $name);
    report 'take 3 GiB of memory', syscall(197, 0, 3 * 1024**3, 3, 0x1002, -1, 0) != -1 ? 'made' : 'refused';
