sub run_of {
    my ($name, %how) = @_;
    defined $about{$name} or die "selftest: the run $name has no line that says what it tries\n";
    my $folder = "$base.$name";
    mkdir $folder or die "selftest: cannot make $folder: $!\n";
    system('/bin/cp', "$site_folder/trusted.pem", "$folder/authority.pem");
    my $keep = exists $how{keep} ? $how{keep} : 'all 0';    # what is kept: a full log until it is cleared, as before there was a choice, unless the run says otherwise
    if (defined $keep) { open my $out, '>', "$folder/keep" or die "selftest: cannot write $folder/keep: $!\n"; print $out "$keep\n"; close $out }
    $how{prepare}->($folder) if $how{prepare};
    my @program = ($how{app} // '/usr/bin/perl', '-e', $hostile, hostile_args($folder, $how{part} // 'page'));
    $run{$name} = { folder => $folder, ends => $how{ends}, crash => $how{crash}, after => $how{after}, limit => $how{limit}, command => $how{command} // ['/usr/bin/perl', $how{lzrprf} // $lzrprf, 'try', $folder,
        '127.0.0.1:' . $port{ $how{peer} // 'trusted' }, $how{typed} // '-', $how{answer} // 'allow', @program] };
    return if $how{late};                 # a run started by itself after the others (sub ran_alone): not in their order, and what it fetches is not counted with theirs
    push @order, $name;
    push @expected, @{ $how{fetches} // [] };
}
