# The bytes that open an encryption, with the values that must differ from one
# connection to the next set to zero: the random number, the session number,
# the key that is offered. And whether an earlier connection is taken up again.
sub steady {
    my ($hello) = @_;
    return unless length $hello > 48 && ord($hello) == 22 && ord(substr $hello, 5, 1) == 1;
    my $at = 11;
    substr($hello, $at, 32) = "\0" x 32;
    $at += 32;
    my $n = ord substr $hello, $at, 1;
    substr($hello, $at + 1, $n) = "\0" x $n;
    $at += 1 + $n;
    $at += 2 + unpack 'n', substr $hello, $at, 2;
    $at += 1 + ord substr $hello, $at, 1;
    return ($hello, 0) if $at + 2 > length $hello;
    my $end = $at + 2 + unpack 'n', substr $hello, $at, 2;
    $at += 2;
    my $resumes = 0;
    while ($at + 4 <= $end && $end <= length $hello) {
        my ($type, $size) = unpack 'nn', substr $hello, $at, 4;
        substr($hello, $at + 4, $size) = "\0" x $size if $type == 51;
        $resumes = 1 if $type == 41 || $type == 35 && $size;
        $at += 4 + $size;
    }
    return ($hello, $resumes);
}

# What the test put on this computer is taken away again: its site with the
# helpers the site started, the runs it started itself, its files. Also when
# the test is stopped from outside. Only processes this test started itself
# are ever ended: each by the number "fork" returned for it, or as a child of
# the site by that number. No list of other processes is ever walked.
sub tidy {
    my @helpers = $site && $site > 1 ? map { /^\s*(\d+)\s+\Q$site\E\s*$/ ? $1 : () } qx{/bin/ps -axo pid=,ppid=} : ();
    kill 'KILL', grep { /^\d+$/ && $_ > 1 && $_ != $$ } keys %pid;
    kill 'TERM', grep { /^\d+$/ && $_ > 1 && $_ != $$ } $site && $site > 1 ? $site : (), @helpers;
    unlink $secret if $secret_made;
    unlink $temp_file if length($temp_file // '');
    unlink $settings_file if length($settings_file // '');
    for my $one (glob "$base.*") { chmod 0600, glob "$one/*"; remove_tree($one) }
}

sub unmark {                              # the mark of this copy is taken out of the file of marks; the marks of other copies stay
    open my $in, '<', "$home/.lzrprf/proven" or return;
    my @all = map { scalar(<$in>) // () } 1 .. 8;
    close $in;
    my @kept = grep { plain_mark($_) ne "$mark\n" } @all;    # in either form: the mark alone, or with the checks that could not be tried
    return if @kept == @all;
    open my $out, '>', "$home/.lzrprf/proven.new" or die "selftest: cannot write $home/.lzrprf/proven.new: $!\n";
    print $out @kept;
    close $out && rename "$home/.lzrprf/proven.new", "$home/.lzrprf/proven" or die "selftest: cannot write $home/.lzrprf/proven: $!\n";
}

sub plain_mark { $_[0] =~ s/, untested: [^\n]*//r }    # a line of the file of marks without the checks that could not be tried: the mark of its copy

sub hears {                               # "sub hear" of lzrprf, taken out and run here against a pipe: what it returns when nothing is said in time, then when the other end is gone
    my ($text) = $text_of_lzrprf =~ /^(sub hear \{.*?^\})/ms;
    defined $text && pipe(my $from, my $to) or return ('x', 'x');
    my @got = eval "package Heard; no warnings; my \$FROM = \$from; my \@EVENTS; my \$TRY = 0; $text; my \$quiet = hear(0.2); close \$to; (\$quiet, scalar hear(0.2))";
    return @got == 2 ? @got : ('x', 'x');
}

sub check($$$) {
    my ($did, $what, $saw) = @_;
    $did ? $held++ : $failures++;
    printf "%-6s %s (%s)\n", $did ? 'held' : 'FAILED', $what, $saw // '';
}

sub untested($$) {
    my ($what, $why) = @_;
    $untested++;
    push @not_tried, "$what ($why)";
    printf "%-6s %s (%s)\n", 'UNTESTED', $what, $why;
}

sub works($$$) {
    my ($did, $what, $saw) = @_;
    $did ? $held++ : $failures++;
    printf "%-6s %s (%s)\n", $did ? 'works' : 'FAILED', $what, $saw // '';
}
