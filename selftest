}
sub unfit_judged {                        # [failed], [untested], each "page (what was said)", and how many were refused as "not a page"; a page refused for the load is visited once more, by itself, in a run of its own
    my ($run, $more, @names) = @_;
    my (@failed, @untested, $held);
    for my $name (@names) {
        my ($verdict, $words) = unfit_one($run, $more, $name);
        if ($verdict eq 'load') {
            my $again = 'again' . ++$again_count;
            $about{$again} = "The page $name once more by itself: it was refused for the load before";
            run_of($again, typed => "$t/out/$name", late => 1);
            ran_alone($again);
            my ($second, $then) = unfit_one($again, $more, $name);
            ($verdict, $words) = ($second, "$words; once more by itself: $then");
        }
        push @failed, "$name ($words)" if $verdict eq 'failed';
        push @untested, "$name ($words)" if $verdict eq 'load';
        $held++ if $verdict eq 'held';
    }
    return (\@failed, \@untested, $held // 0);
}
