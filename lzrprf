#!/usr/bin/perl
# lzrprf: owns the one window of an application, runs the application inside a
# container that this file defines, and does for it the one thing it may have
# done: fetch the https address that you typed into the bar of that window.
#
#   lzrprf run /path/to/program [arguments]     open the window, with the program contained behind it
#   lzrprf log                                  print every address that was fetched
#   lzrprf address TEXT...                      say what would be fetched if TEXT were typed into the bar
#   lzrprf request TEXT...                      print the exact bytes a site is sent for TEXT
#   lzrprf public NUMBER...                     say whether a numeric address is on the public internet, and how this computer would send to it
#   lzrprf mark                                 this version of macOS and this file, as one line
#
# The application is treated as hostile. It has no window, no network, no
# file and no service of the system: it is started once for each answer
# lzrprf has already fetched, reads that answer, and writes a list of what to
# draw. lzrprf checks every line of the list and draws it. The window, its
# address bar, its buttons and its words are lzrprf's, made by the text at the
# end of this file.
#
# Three kinds of process are started here, each inside a container:
#   the PAGE container holds the application, once for each answer;
#   the FETCH container holds the system's own curl, once for each request;
#   the WINDOW container holds the window.
# What is outside every container is this file: it looks up the name, makes
# the one connection, writes the log, and checks what crosses.
#
# THE CONDITIONS. Each promise lzrprf makes is a condition in this file, and
# the line that holds it carries its mark. The README says the same in words
# and cites these marks, and selftest fails when a mark is cited that is not
# here, or the other way round.
#
#   [C1]  The application is started in one place only, and only inside the page container.
#   [C2]  At every start lzrprf tries, from inside that same container, what the container must refuse, and starts nothing unless all of it was refused and the same tries worked outside.
#   [C3]  No process is handed a byte before the system itself says that this process is contained.
#   [C4]  A request is made only for an address that came from the window's bar, or for one of two fixed addresses after you said yes. There is no third way to a request.
#   [C5]  Nothing is looked up or fetched before its line is in the log, on the disk.
#   [C6]  There is one place that connects to a site, and it connects to a numeric address that was checked and written down.
#   [C7]  What a site is sent is made from the address alone: the same bytes from every computer, with nothing kept from an earlier request.
#   [C8]  A host inside your own network is fetched only after you said yes to exactly that, once.
#   [C9]  Every line the application writes is checked before the window is given it, and what is not one of four kinds of line is not drawn at all.
#   [C10] The window's process has no network, writes no file, starts no program, and reads nothing in your home folder but your settings and fonts.
#   [C11] Nothing is shown before selftest held on this build of macOS with this file.
#   [C12] The log is only added to. It is cleared by your button and by nothing else.
#
# This file is the whole program. Its parts, in order: the containers, the
# proof that they hold, one visit, the fetch, the window's side, the log, the
# window itself.
use strict;
use warnings;
use Cwd 'abs_path';
use Digest::SHA;
use Fcntl qw(:flock O_RDWR O_WRONLY O_APPEND O_CREAT O_EXCL O_NOFOLLOW);
use File::Basename 'dirname';
use File::Glob 'bsd_glob';
use IO::Handle;
use IO::Socket::INET;
use IO::Socket::UNIX;
use POSIX 'strftime';
use Socket qw(AF_INET AF_INET6 SOCK_STREAM SOL_SOCKET SO_ERROR NI_NUMERICHOST NI_NUMERICSERV AI_NUMERICHOST inet_aton inet_pton pack_sockaddr_in getaddrinfo getnameinfo);
use Time::HiRes;

$^X eq '/usr/bin/perl' or exec '/usr/bin/perl', $0, @ARGV or die "lzrprf: the system's own perl is missing\n";
umask 0077;                               # what lzrprf writes is readable by you alone
{ my $number; do { $number = POSIX::open('/dev/null', O_RDWR) } while defined $number && $number < 3; POSIX::close($number) if defined $number }    # descriptors 0, 1 and 2 exist from here on
%ENV = (PATH => '/usr/bin:/bin:/usr/sbin:/sbin', map { defined $ENV{$_} ? ($_ => $ENV{$_}) : () } qw(LANG TMPDIR __CF_USER_TEXT_ENCODING));    # nothing lzrprf starts is found through, or told, a variable of whoever started lzrprf

my $SELF = abs_path($0);
my $HOME = abs_path((getpwuid $<)[7]);    # from the account, not from the environment
my $DIR = "$HOME/.lzrprf";                # no container can read or write this folder
my $CURL = '/usr/bin/curl';               # the system's own; it does the https, lzrprf holds no code for it
my $SCRIPT = '/usr/bin/osascript';        # the system's own; it runs the window's text and the question to the system
my $ROOTS = '/private/etc/ssl/cert.pem';  # the system's list of certificate authorities
my $FETCH_BYTES = 6 * 1024 * 1024;        # the most that is taken from a site for one address
my $FETCH_SECONDS = 30;                   # the most one request may take, from the first connection to the last byte
my $WIRE_BYTES = $FETCH_BYTES + 1024 * 1024;    # the most that is carried from the site to curl: the answer, and what encryption adds
my $SENT_BYTES = 64 * 1024;               # the most that is carried from curl to the site: one request is far smaller
my $FIND_SECONDS = 10;                    # the most a name lookup may take
my $FOUND = 8;                            # the most addresses of one name that are looked at
my $PAGE_BYTES = 6 * 1024 * 1024;         # the most one page container may write
my $PAGE_SECONDS = 30;                    # a page container is ended after this, whatever it is doing
my $PIECES = 200_000;                     # the most lines one page may have
my $BOXES = 2000;                         # the most grey boxes among them
my $ANSWER_SECONDS = 600;                 # a question that is still open then counts as answered with its first button
my $NAME = qr/(?:[A-Za-z0-9-]{1,63}\.)+[A-Za-z][A-Za-z0-9-]{0,62}/;    # a host name: never a bare number, never one word
my $UNWRITTEN = 'Nothing was fetched: the log could not be written.';

# "lzrprf try" is the same program for tests (selftest, and nothing else):
# its state is in a folder of its own, every name leads to one listener on
# this computer, whose certificate must be signed by the test's own
# authority, and with "allow" or "deny" there is no window: what the window
# would be told is printed, what would be typed is the test's text, and every
# question gets that one answer. With "ask" the real window runs, and the
# test may add text of its own to the window's. A test that puts a file
# "prove" into its folder gets the question of [C11] as well, against a mark
# in that folder. "lzrprf run" has none of this.
my ($TRY, $PEER, $TYPED, $ANSWER, $RUN, $APP, $PROGRAM, @ARGUMENTS) = (0, '-', '-', 'ask', 0, 'the application', '');
my ($FROM, @EVENTS);                      # what the window says; or, without a window, what a test has typed

sub now { Time::HiRes::clock_gettime(Time::HiRes::CLOCK_MONOTONIC()) }    # a clock nobody can set: seconds since the computer started

# What the operating system allows inside the page container and the fetch
# container. Every line is an allowance; what is not listed is refused: every
# network use, writing any file, reading any file outside the system's own
# folders, starting any other program, starting a second process, signalling
# another process, asking another program to open something, every system
# service (so: no window, no key, no clipboard, no other application), and
# every fact about the computer that is not in the short list of names below
# (so: not its name, not its other processes, not its network).
# One thing macOS does not refuse by itself inside a container: making (not
# using) memory, flags and queues of the old "System V" kind, of which the
# whole computer has only a few. The three calls that make them are refused
# by name, so a contained program cannot use them up for other programs.
my $CONTAINER = <<'END';
(version 1)
(deny default)
(deny syscall-unix (syscall-number SYS_shmget SYS_semget SYS_msgget))
(allow process-exec (literal (param "APP")))
(allow file-map-executable (subpath "/System") (subpath "/usr/lib") (subpath (param "OWN")))
(allow sysctl-read
  (sysctl-name-prefix "hw.") (sysctl-name-prefix "machdep.cpu.") (sysctl-name-prefix "kern.osvariant")
  (sysctl-name "kern.ostype") (sysctl-name "kern.osrelease") (sysctl-name "kern.osversion")
  (sysctl-name "kern.osproductversion") (sysctl-name "kern.osproductversioncompat") (sysctl-name "kern.version")
  (sysctl-name "kern.maxfilesperproc") (sysctl-name "kern.argmax") (sysctl-name "kern.ngroups")
  (sysctl-name "kern.usrstack64") (sysctl-name "kern.secure_kernel") (sysctl-name "kern.willshutdown")
  (sysctl-name "kern.hv_vmm_present") (sysctl-name "vm.footprint_suspend")
  (sysctl-name "sysctl.proc_native") (sysctl-name "sysctl.proc_cputype") (sysctl-name "sysctl.proc_translated"))
(allow file-read*
  (subpath "/System") (subpath "/usr/lib") (subpath "/usr/share") (subpath "/private/etc/ssl")
  (literal "/") (literal "/dev/null") (literal "/dev/random") (literal "/dev/urandom")
  (subpath (param "OWN")))
(deny file-read* (subpath "/System/Volumes"))
(allow file-read* (subpath "/System/Volumes/Preboot/Cryptexes"))
(allow file-read-metadata
  (literal "/") (literal "/usr") (literal "/Library") (literal "/dev") (literal "/private")
  (literal "/private/etc") (literal "/private/var") (literal "/private/var/db") (literal "/etc") (literal "/var")
  (literal "/System/Volumes") (literal "/System/Volumes/Preboot")
END

# The page container is allowed nothing on top of that. It also gets at most
# 30 seconds of processor time, may create no file and no memory dump, and
# is told one thing: the address it lays out. It sees no other variable.
my $PAGE_LIMITS = 'ulimit -t 30 -f 0 -c 0 && exec /usr/bin/env -i "LZRPRF_CONTAINED=$LZRPRF_CONTAINED" "$@"';

# What curl's container is allowed on top of it: one socket file, behind which
# lzrprf holds the connection to the site, and the list of certificate
# authorities. It has no network of its own. So whatever a site sends it, curl
# can reach no other place, read no file of yours, write nothing and start
# nothing.
my $FETCH = <<'END';
(allow network-outbound (literal (param "WAY")))
(allow file-read* (literal (param "ROOTS")))
END

# The window's container. A window needs the system's services, so this one
# is written the other way round: what a program of yours may do, without
# four things. No network of any kind, so the process that draws a site's
# text can send nothing anywhere. No writing of any file. No starting of any
# program. No reading in your home folder, apart from your settings, your
# fonts and keyboard layouts, and the application's own folder for its
# icon: so it holds nothing of yours that it could put into the bar. What it
# reads on descriptor 0 and writes on descriptor 1 is its talk with lzrprf,
# and nothing else leaves it.                                          # [C10]
my $WINDOW_CONTAINER = <<'END';
(version 1)
(allow default)
(deny network*)
(deny file-write*)
(allow file-write* (literal "/dev/null"))
(deny process-fork)
(deny process-exec)
(allow process-exec (literal "/usr/bin/osascript"))
(deny file-read* (subpath (param "HOME")))
(allow file-read*
  (subpath (string-append (param "HOME") "/Library/Preferences")) (subpath (string-append (param "HOME") "/Library/Fonts"))
  (subpath (string-append (param "HOME") "/Library/Keyboard Layouts")) (subpath (string-append (param "HOME") "/Library/Input Methods"))
  (subpath (param "OWN")))
(allow file-read-metadata (literal (param "HOME")) (literal (string-append (param "HOME") "/Library")))
END

sub contain {
    my ($more, $program, @rest) = @_;
    my $own = $program =~ m{^(.*\.app)/Contents/MacOS/[^/]+$} ? $1 : $program;
    my @above;                            # the folders above the program: it may know they exist, and no more
    for (my $up = $own; $up =~ s{/[^/]+$}{} && length $up;) { push @above, qq{(literal "$up")} }
    die "lzrprf: the program's path holds a character lzrprf does not pass on\n" if $own =~ /["\\\n]/;
    return ('/usr/bin/sandbox-exec', '-D', "APP=$program", '-D', "OWN=$own", @rest, '-p', "$CONTAINER  @above)\n$more", $program);
}

# Starting a program. Whatever lzrprf starts is handed three descriptors that
# lzrprf chose, and no other: not a file, a socket or a terminal that was open
# in lzrprf or in whoever started lzrprf.
sub seal {
    opendir(my $open, '/dev/fd') or POSIX::_exit(127);
    my @numbers = grep { /^\d+$/ && $_ > 2 } readdir $open;
    closedir $open;
    POSIX::close($_) for @numbers;
}

sub become {                              # this process turns into @command; a descriptor that is not given leads nowhere
    my ($in, $out, $err, @command) = @_;
    my $nowhere = POSIX::open('/dev/null', O_RDWR) // POSIX::_exit(127);
    my @given = map { POSIX::dup(defined $_ ? fileno $_ : $nowhere) // POSIX::_exit(127) } $in, $out, $err;
    POSIX::dup2($given[$_], $_) // POSIX::_exit(127) for 0 .. 2;
    seal();
    { no warnings; exec { $command[0] } @command; }
    POSIX::_exit(127);
}

# What a program printed within some seconds; and whether it ended by itself,
# without an error, in that time. When the time is over it is ended.
sub said {
    my ($seconds, @command) = @_;
    pipe(my $from, my $to) or return ('', 0);
    my $child = fork // return ('', 0);
    if (!$child) {
        close $from;
        become(undef, $to, undef, @command);
    }
    close $to;
    my ($text, $until, $whole) = ('', now() + $seconds, 0);
    while ((my $left = $until - now()) > 0 && length $text < 4 * 1024 * 1024) {
        my $ready = '';
        vec($ready, fileno $from, 1) = 1;
        select($ready, undef, undef, $left > 1 ? 1 : $left) > 0 or next;
        my $got = sysread($from, $text, 65536, length $text);
        next if !defined $got && $!{EINTR};
        $whole = 1 if defined $got && !$got;
        last unless $got;
    }
    return ($text, ended($child, $whole ? 2 : 0) == 0 && $whole);
}

sub ended {                               # waits this long for a process to end, then ends it; returns how it ended
    my ($pid, $patience) = @_;
    my $until = now() + $patience;
    while (1) {
        my $gone = waitpid $pid, POSIX::WNOHANG();
        return $? if $gone == $pid;
        return -1 if $gone < 0;
        last if now() >= $until;
        select undef, undef, undef, 0.02;
    }
    kill 'KILL', $pid;
    waitpid $pid, 0;
    return $? || -1;
}

# The proof that the containers hold, in two parts. Neither rests on what the
# application says about itself.
#
# The first part is made at every start. A small program, the text below, is
# run inside the page container: the same container text, the same way of
# starting. It tries six things the container must refuse, each against
# something that is really there (a listener lzrprf opened a moment ago, a
# file lzrprf wrote a moment ago, lzrprf's own process). Then the same
# program is run outside every container, where each of the six must work:
# so a refusal inside is the container's, not a try that could never have
# worked. Unless both runs say exactly that, nothing is started.         # [C2]
my $TRIES = <<'END';
use Socket;
my ($port, $folder, $pid) = @ARGV;
$| = 1;
socket(my $s, AF_INET, SOCK_STREAM, 0);
print 'network ', (connect($s, pack_sockaddr_in($port, inet_aton('127.0.0.1'))) ? 'done' : 'refused'), "\n";
print 'read ', (open(my $in, '<', "$folder/here") ? 'done' : 'refused'), "\n";
print 'write ', (open(my $out, '>', "$folder/made") ? 'done' : 'refused'), "\n";
print 'signal ', (kill(0, $pid) ? 'done' : 'refused'), "\n";
my $child = fork;
exit 0 if defined $child && !$child;
print 'second process ', (defined $child ? 'done' : 'refused'), "\n";
{ no warnings; exec '/usr/bin/true'; }
print "other program refused\n";
END

sub holds {
    my $listen = IO::Socket::INET->new(Listen => 4, LocalAddr => '127.0.0.1', LocalPort => 0) or return 0;
    my $folder = "$DIR/tries.$$";
    mkdir $folder or return 0;
    put("$folder/here", O_EXCL, 'a file of yours') or return 0;
    my @tries = ('-e', $TRIES, $listen->sockport, $folder, $$);
    my ($inside) = said(10, contain('', '/usr/bin/perl'), @tries);
    my ($outside) = said(10, '/usr/bin/perl', @tries);
    unlink "$folder/here", "$folder/made";
    rmdir $folder;
    my @what = ('network', 'read', 'write', 'signal', 'second process');
    return $inside eq join('', map { "$_ refused\n" } @what, 'other program') && $outside eq join('', map { "$_ done\n" } @what);    # outside, the last try turns the program into another one, which says nothing
}

# The second part is made for every process. The system keeps, for each
# process, the container it was put in, and answers questions about it. One
# small process, the text below, asks the system: may this process use the
# network, create a file, start a second process, reach a system service?
# Only when the system says no to all four is the process handed anything:
# a page container the site's answer, curl the connection to the site. The
# question is put to the system, by number of the process. Nothing is asked
# of the process itself.                                                 # [C3]
my $WITNESS = <<'END';
ObjC.import('Foundation');
ObjC.bindFunction('sandbox_check', ['int', ['int', 'char *', 'int']]);
function run() {
    var from = $.NSFileHandle.fileHandleWithStandardInput, to = $.NSFileHandle.fileHandleWithStandardOutput, held = '';
    while (true) {
        var data = from.availableData;
        if (data.length == 0) return;
        held += $.NSString.alloc.initWithDataEncoding(data, 4).js;
        for (var at; (at = held.indexOf('\n')) >= 0; held = held.slice(at + 1)) {
            var pid = parseInt(held.slice(0, at), 10);
            var refused = ['network-outbound', 'file-write-create', 'process-fork', 'mach-lookup'].map(function (what) { return $.sandbox_check(pid, what, 0); });
            to.writeData($(pid + ' ' + refused.join(' ') + '\n').dataUsingEncoding(4));
        }
    }
}
END
my ($witness, $to_witness, $from_witness);

sub inside {                              # true when the system says that this process is contained; it is asked for two seconds, and then the answer is no
    my ($pid) = @_;
    if (!$witness) {
        pipe(my $asked, $to_witness) && pipe($from_witness, my $told) or return 0;
        $witness = fork // return 0;
        become($asked, $told, undef, $SCRIPT, '-l', 'JavaScript', '-e', $WITNESS) unless $witness;
        close $_ for $asked, $told;
        $to_witness->autoflush(1);
    }
    my $until = now() + 2;
    while (now() < $until) {
        print $to_witness "$pid\n" or return 0;
        my $ready = '';
        vec($ready, fileno $from_witness, 1) = 1;
        select($ready, undef, undef, $until - now() + 0.5) > 0 or return 0;
        my $says = readline($from_witness) // return 0;
        return 1 if $says eq "$pid 1 1 1 1\n";
        select undef, undef, undef, 0.01; # not yet: the process is still being put into its container
    }
    return 0;
}

# The start. The process that was started becomes the window, so that the
# system shows it under the application's name. Its child is a fresh copy of
# this file, outside every container, and the two talk over two pipes.
sub run {
    my ($program, @arguments) = @_;
    seal();
    $program = abs_path($program // '') // '';
    die "lzrprf: no such program\n" unless -f $program && -x _;
    named($program, @arguments);
    mkdir $DIR;
    my @folder = lstat $DIR;
    die "lzrprf: $DIR is not a folder of yours\n" unless @folder && -d _ && $folder[4] == $<;
    chmod 0700, $DIR;
    for my $old (bsd_glob("$DIR/way.*"), bsd_glob("$DIR/tries.*")) {    # left by runs that have ended
        next if $old =~ /\.(\d+)$/ && kill 0, $1;
        unlink bsd_glob("$old/*"), $old;
        rmdir $old;
    }
    $SIG{PIPE} = 'IGNORE';
    if ($TRY && $ANSWER ne 'ask') {       # "lzrprf try" only: no window
        @EVENTS = ('ready', $TYPED eq '-' ? () : map { /^=(.+)/ ? $1 : "go $_" } split /,,/, $TYPED);
        return behind();
    }
    pipe(my $window_in, my $to) && pipe(my $from, my $window_out) or die "lzrprf: cannot make a pipe: $!\n";
    my $window = $$;
    my $behind = fork // die "lzrprf: cannot fork: $!\n";
    become($from, $to, $TRY ? \*STDOUT : undef, '/usr/bin/perl', $SELF, 'behind', $TRY, $DIR, $PEER, $ANSWER, $window, $program, @arguments) unless $behind;    # descriptor 0 is what the window says, descriptor 1 what it is told
    close $_ for $to, $from;
    my $more = '';
    if ($TRY && open my $test, '<', "$DIR/window") { local $/; $more = <$test> }    # "lzrprf try" only: the test's own text after the window's, so a test can keep the window off the screen and read what it holds
    my $own = $program =~ m{^(.*\.app)/Contents/MacOS/} ? $1 : $program;
    my ($icon) = bsd_glob("$own/Contents/Resources/*.icns");
    die "lzrprf: the program's path holds a character lzrprf does not pass on\n" if "$own$HOME" =~ /["\\\n]/;
    become($window_in, $window_out, $TRY ? \*STDERR : undef, '/usr/bin/sandbox-exec', '-D', "HOME=$HOME", '-D', "OWN=$own", '-p', $WINDOW_CONTAINER, $SCRIPT, '-l', 'JavaScript', '-e', window_text() . $more, $APP, $icon // '');
}

sub named {                               # the program of this run, and the name it is called by in the window
    ($PROGRAM, @ARGUMENTS) = @_;
    ($APP) = $PROGRAM =~ m{([^/]+?)(?:\.app/Contents/MacOS/[^/]+)?$};
    $APP = 'the application' unless defined $APP && $APP =~ /^[A-Za-z0-9 ._-]{1,40}$/;
}

# Behind the window: everything lzrprf does for one run, one thing at a time.
sub behind {
    leave() unless (hear(60) // '') eq 'ready';
    return closed("lzrprf was not tested on this Mac as it is now, or did not hold, so $APP shows no page. What the test found: $DIR/selftest.txt") unless ($TRY && !-e "$DIR/prove") || proven();    # [C11]
    return closed("The container did not hold on this Mac a moment ago, so $APP was not started. Run selftest, which is beside lzrprf, to see what was not refused.") unless holds();    # [C2]
    newer();
    idle("$APP is contained: no network, no file, no other program. lzrprf fetches what you type above, and writes it in the log first.");
    while (defined(my $event = hear())) {
        if ($event =~ /^go ([\x20-\x7f]{1,2100})$/) { visit($1) }    # [C4] the one place an address comes from: the bar of lzrprf's own window
        elsif ($event eq 'log') { log_shown() }
        elsif ($event =~ /^fault /) { fault('undrawn') }    # the window could not draw a list that "checked" let through: it shows nothing of it
    }
    leave();
}

sub leave {
    kill 'KILL', $witness if $witness;
    unlink "$DIR/way.$$";
    exit 0;
}

sub closed {                              # nothing more is done in this run: the window says why, and its bar takes nothing
    busy($_[0]);
    1 while defined hear();
    leave();
}

# One visit: what happens after Return was pressed in the bar, as a chain of
# conditions. Each "return" below is a place where the chain ends and nothing
# is fetched. There is no other way to the fetch.
sub visit {
    my ($typed) = @_;
    my ($url, $host) = address($typed);
    return idle('lzrprf does not fetch that. An address must be https, a host by its name, port 443, in plain characters without a space.') unless $url;
    window("address $url");                 # the bar shows what will be sent, exactly
    open my $request, '>>', "$DIR/busy" or return idle($UNWRITTEN);
    flock $request, LOCK_SH or return idle($UNWRITTEN);    # from "you typed" until its last line is written, a request keeps the log from being cleared under it
    record("you typed $url") or return idle($UNWRITTEN);  # [C5] before the name is even looked up
    busy("Looking up $host.");
    my ($where, $why) = find($host);
    $why = own_network($host, $where) if $where && grep { $_->{own} } @$where;    # [C8]
    my ($got, $from);
    if (!$why) {
        record("$url -> lzrprf connects to the first that answers of: " . join ', ', map { $_->{text} } @$where) or return idle($UNWRITTEN);    # [C5] written down first, connected second
        busy("Fetching $url");
        ($got, $why, $from) = fetch($url, $where);
    }
    record("$url " . ($why ? "failed: $why" : 'answered: ' . length($got) . " bytes from $from")) or return idle($UNWRITTEN);    # an answer whose line is not on the disk is not shown
    close $request;
    return idle("Nothing is shown: $why.") if $why;
    busy("$APP lays the page out, in its container.");
    my ($lines, $hosts) = laid_out($url, $got);
    return fault($hosts) unless $lines;
    window('page', @$lines, '.');
    idle("$host answered " . length($got) . ' bytes. ' . (@$hosts ? 'The page names ' . @$hosts . (@$hosts == 1 ? ' other host' : ' other hosts') . ' (' . join(', ', @$hosts > 4 ? (@$hosts[0 .. 3], '...') : @$hosts) . '). lzrprf asked none of them.' : 'The page names no other host.'));
}

# The request is over and the connection to the site is closed. Only now does
# the application see the answer, in a page container, and only after the
# system said that this very process is contained. Returns the checked lines
# and the other hosts the page names; or nothing, and one word for what went
# wrong.
sub laid_out {
    my ($url, $got) = @_;
    pipe(my $answer_out, my $answer_in) && pipe(my $from_page, my $to_lzrprf) or return (undef, 'unstarted');
    my $page = fork // return (undef, 'unstarted');
    if (!$page) {
        %ENV = (LZRPRF_CONTAINED => $url);    # the application is told the address it lays out, and sees no other variable
        chdir '/';
        become($answer_out, $to_lzrprf, $TRY ? \*STDERR : undef, '/bin/sh', '-c', $PAGE_LIMITS, 'lzrprf', contain('', $PROGRAM), @ARGUMENTS);    # [C1]
    }
    close $_ for $answer_out, $to_lzrprf;
    if (!inside($page)) {                 # [C3] the system did not say so: the answer stays here
        kill 'KILL', $page;
        waitpid $page, 0;
        return (undef, 'uncontained');
    }
    my $feeder = fork // return (undef, 'unstarted');
    if (!$feeder) {                       # hands the answer over and ends; an application that does not read it changes nothing
        close $from_page;
        answer($answer_in, $got);
        exit 0;
    }
    close $answer_in;
    my ($wrote, $until, $open) = ('', now() + $PAGE_SECONDS, 1);
    while ($open && now() < $until && length $wrote <= $PAGE_BYTES && alive()) {
        my $ready = '';
        vec($ready, fileno $from_page, 1) = 1;
        select($ready, undef, undef, 1) > 0 or next;
        $open = sysread($from_page, $wrote, 65536, length $wrote) // $!{EINTR};
    }
    kill 'KILL', $page, $feeder;
    waitpid $_, 0 for $page, $feeder;
    return (undef, 'late') if $open && length $wrote <= $PAGE_BYTES;
    return (undef, 'large') if length $wrote > $PAGE_BYTES;
    my ($lines, $hosts) = checked($wrote) or return (undef, 'unfit');    # [C9]
    return ($lines, $hosts);
}

# What the application may write, and nothing else: a first line that names
# the other hosts the page asks for, and then lines of four kinds.
#
#   P<style><depth>    a paragraph begins: plain, heading 1 2 3, list item, quote, code, rule; how far it is set in, 0 to 9
#   T<looks><text>     text in that paragraph; one letter says bold, italic, fixed width, and coloured as a link
#   B                  a line ends
#   I<wide>x<high>     a grey box where a picture would stand, 8 to 640 wide and 8 to 480 high
#
# None of the four can carry an address to fetch, a program, a picture or a
# command: a link is a colour, a picture is a size. A list with any other
# line in it is not drawn at all. In the text, every character that would
# act on the display instead of being displayed (a control code, an invisible
# mark, a mark that turns the reading direction) is replaced by the
# replacement mark before the window is given it.                        # [C9]
sub checked {
    my ($wrote) = @_;
    no warnings 'utf8';
    return unless utf8::decode($wrote) && $wrote =~ s/\n\z//;
    my ($first, @lines) = split /\n/, $wrote, -1;
    return unless defined $first && $first =~ /^=page((?: $NAME){0,200})$/ && @lines <= $PIECES;
    my @hosts = split ' ', $1;
    my $boxes = 0;
    for (@lines) {
        if (/^T[\@-O]./s) { s/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\x{fffe}\x{ffff}]/\x{fffd}/g }
        elsif (/^I(\d{1,3})x(\d{1,3})$/) { return unless $1 >= 8 && $1 <= 640 && $2 >= 8 && $2 <= 480 && ++$boxes <= $BOXES }
        else { return unless /^(?:P[p123lqcr][0-9]|B)$/ }
    }
    utf8::encode($_) for @lines;
    return (\@lines, \@hosts);
}

# The application did not give a page. What is said is one of the fixed
# phrases below. And when the application's maker named an address for
# reports, you are asked whether to send one, shown every byte of it first:
# which of the phrases it was, the release, the build of macOS. Not the
# address you typed, and nothing of the page. It is sent the way a typed
# address is, and written in the log the same way.
my %FAULT = (
    unstarted => 'its container could not be started',
    uncontained => 'the system did not say that it was in its container, so the answer was not handed to it',
    late => 'it did not finish in time',
    large => 'it wrote more than lzrprf takes',
    unfit => 'what it wrote is not a page',
    undrawn => 'the window could not draw what it wrote',
);

sub fault {
    my ($which) = @_;
    my $says = "$APP did not show this page: $FAULT{$which}.";
    my ($release, undef, $to) = beside();
    my ($build) = mark() =~ /^macOS build (\w+)/;
    my ($url, $host) = $to && $build ? address("$to?fault=$which&release=$release&macos=$build") : ();
    return idle($says) unless $url;
    return idle($says) unless ask("$says Send an anonymous report to its developer? This is all of it, and it is written in the log: $url", "Don't send", 'Send') == 2;    # [C4]
    idle("$says " . (fixed("you sent a report: $url", $url, $host) ? 'The report was sent.' : 'The report could not be sent.'));
}

# Where a host is. The name is looked up outside every container, after the
# address is in the log, by a fresh copy of this file that is given ten seconds.
# Returns the addresses the name leads to, at most eight, each with whether
# it is "own": not on the public internet, or reached by a route of its own.
sub find {
    my ($host) = @_;
    if ($PEER ne '-') {                   # "lzrprf try" only: every name leads to the test's listener
        my ($to, $port) = split /:/, $PEER;
        return [{ family => AF_INET, addr => pack_sockaddr_in($port, inet_aton($to)), text => $to, own => !public($to) }];
    }
    my ($found) = said($FIND_SECONDS, '/usr/bin/perl', $SELF, 'lookup', $host);
    my (@where, %had);
    for my $text (grep { /^[0-9A-Fa-f:.]+(?:%[A-Za-z0-9]+)?$/ && !$had{$_}++ } split /\n/, $found) {
        last if @where >= $FOUND;
        my ($failed, $one) = getaddrinfo($text, 443, { socktype => SOCK_STREAM, flags => AI_NUMERICHOST });    # a number is turned into a number: nothing is looked up
        next if $failed || !$one;
        my $route = route($one->{family}, $text) or next;    # this computer has no way there at all
        push @where, { %$one, text => $text, own => $route eq 'own' || !public($text) };
    }
    return (undef, %had ? 'this computer has no way to that host' : 'no such host') unless @where;
    return \@where;
}

# How this computer would send to an address: "internet" by the way it uses
# for the internet at large, "own" by a route of its own (a network this
# computer is in, another computer's network behind a VPN, this computer
# itself), nothing when there is no way. The address being in a public range
# does not make it public for you: a route can lead it into a network of
# your own, and then you are asked.
sub route {
    my ($family, $text) = @_;
    my ($says) = said(5, '/sbin/route', '-n', 'get', ($family == AF_INET6 ? '-inet6' : ()), $text =~ s/%.*//r);
    my ($to) = $says =~ /^\s*destination: (\S+)/m or return;
    return 'internet' if $to eq 'default';
    if ($says =~ /^\s*flags: <[^>]*\bWASCLONED\b/m && $text ne 'default') {
        # macOS keeps a route of its own for every address it spoke to a moment ago, a copy of the route
        # that led there. It is the internet's when it leaves by the same door as the default route.
        my ($usual) = said(5, '/sbin/route', '-n', 'get', ($family == AF_INET6 ? '-inet6' : ()), 'default');
        my @door = map { my $all = $_; join ' ', map { $all =~ /^\s*$_: (\S+)/m ? $1 : '?' } 'gateway', 'interface' } $says, $usual // '';
        return 'internet' if $door[0] eq $door[1] && $door[0] !~ /\?/ && ($usual // '') =~ /^\s*destination: default\s*$/m;
    }
    my ($mask) = $says =~ /^\s*mask: (\S+)/m or return 'own';
    my $bits = inet_pton($family, $mask) // return 'own';
    return unpack('%32b*', $bits) < 8 ? 'internet' : 'own';    # a route for half of all addresses is how some VPNs carry the whole internet
}

# The one connection to the site, made by lzrprf: to an address that was just
# checked and written down, never to the name again. This is the only place
# in this file that connects to anything outside this computer.          # [C6]
sub reach {
    my ($where, $until) = @_;
    for my $one (@$where) {
        my $left = $until - now();
        last if $left <= 0;
        socket(my $site, $one->{family}, SOCK_STREAM, 0) or next;
        $site->blocking(0);
        connect($site, $one->{addr});     # [C6]
        my $ready = '';
        vec($ready, fileno $site, 1) = 1;
        return ($site, $one->{text}) if select(undef, $ready, undef, $left < 10 ? $left : 10) > 0 && !unpack 'i', getsockopt($site, SOL_SOCKET, SO_ERROR);
    }
    return;
}

# What a site is sent, inside the encryption, for an address: these bytes,
# made from the address and from nothing else. No cookie, no name of a
# browser, no language, no page you came from, no number of this computer or
# of this copy. Every computer that runs lzrprf sends the same bytes for the
# same address, so they tell a site nothing about which one you are. curl is
# told to send exactly this (the switches in "fetch"), and selftest compares
# these bytes with the bytes its test site really received.              # [C7]
sub request {
    my ($url) = @_;
    my ($host, $rest) = $url =~ m{^https://([^/]+)(/.*)$} or return '';
    return "GET $rest HTTP/1.1\r\nHost: $host\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n";
}

# The request. curl does the https, and it is told the address and nothing
# else: the bytes above. It has no network. It gets one socket file; when it
# comes there, and the system says that it is contained, lzrprf connects to
# the site and carries the bytes both ways, which are encrypted between curl
# and the site. curl is held to https, follows no redirect, tries once, takes
# no setting from a file or a variable, and the certificate must prove the
# host to the system's list of authorities. It keeps nothing for a later
# request, because it can write nothing: each request is a new curl with an
# empty memory, so no cookie, no stored answer and no earlier connection
# comes back to a site.                                                  # [C7]
# One clock runs for the whole request, and no more is carried either way
# than one request and one answer need. Returns the answer, or why there is
# none, and the address that answered.
sub fetch {
    my ($url, $where) = @_;
    my ($way, $roots) = ("$DIR/way.$$", $PEER ne '-' ? "$DIR/authority.pem" : $ROOTS);
    my $none = 'the request could not be made';
    unlink $way;
    my $listen = IO::Socket::UNIX->new(Local => $way, Listen => 1) or return (undef, $none);
    pipe(my $from_curl, my $out) or return (undef, $none);
    my $curl = fork // return (undef, $none);
    if (!$curl) {
        %ENV = ();                        # curl takes no setting from the environment
        my @curl = ($CURL, '-q', '-g', '-s', '-i', '--raw', '--path-as-is', '--proto', '=https', '--tlsv1.2', '--http1.1', '--noproxy', '*', '--no-sessionid',
            '--cacert', $roots, '--max-time', $FETCH_SECONDS, '--max-filesize', $FETCH_BYTES,
            '-H', 'User-Agent:', '-H', 'Accept:', '-H', 'Accept-Encoding: identity', '-H', 'Connection: close',
            '--unix-socket', $way, '--', $url);
        if ($PEER ne '-' && open my $instead, '<', "$DIR/fetcher") { chomp(@curl = <$instead>) }    # "lzrprf try" only: the test's own program in curl's place, to attack this container too
        become(undef, $out, undef, contain($FETCH, shift @curl, '-D', "WAY=$way", '-D', "ROOTS=$roots"), @curl);
    }
    close $out;
    my ($got, $until, $unreached, $loose, $done, $peer, @links) = ('', now() + $FETCH_SECONDS, 0, 0, 0);    # a link: from, to, bytes held, 1 while "from" is open, bytes carried
    while (now() < $until && length $got <= $FETCH_BYTES && alive() && !grep { $_->[4] > $_->[5] } @links) {
        my ($read, $write) = ('', '');
        vec($read, fileno $from_curl, 1) = 1;
        vec($read, fileno $listen, 1) = 1 unless @links;
        for (@links) {
            vec($read, fileno $_->[0], 1) = 1 if $_->[3] == 1 && length $_->[2] < 262144;
            vec($write, fileno $_->[1], 1) = 1 if length $_->[2];
        }
        select($read, $write, undef, 1) > 0 or next;
        if (!@links && vec($read, fileno $listen, 1)) {
            my $in = $listen->accept or last;
            if (!inside($curl)) { $loose = 1; last }    # [C3] the system did not say that curl is contained: no connection is made for it
            (my $site, $peer) = reach($where, $until);
            if (!$site) { $unreached = 1; last }
            $in->blocking(0);
            @links = ([$in, $site, '', 1, 0, $SENT_BYTES], [$site, $in, '', 1, 0, $WIRE_BYTES]);
            next;
        }
        for my $link (@links) {
            my ($from, $to) = @$link;
            if ($link->[3] == 1 && vec($read, fileno $from, 1)) {
                my $n = sysread($from, $link->[2], 65536, length $link->[2]);
                $link->[3] = 0 if defined $n ? !$n : !$!{EAGAIN};
                $link->[4] += $n // 0;
            }
            if (length $link->[2] && vec($write, fileno $to, 1)) {
                my $sent = syswrite($to, $link->[2]);
                substr($link->[2], 0, $sent, '') if $sent;
                @$link[2, 3] = ('', 0) unless defined $sent || $!{EAGAIN};
            }
            if (!$link->[3] && !length $link->[2]) {    # one side has ended and all it sent is passed on
                shutdown($to, 1);
                $link->[3] = 2;
            }
        }
        if (vec($read, fileno $from_curl, 1)) { sysread($from_curl, $got, 65536, length $got) or ($done = 1, last) }
    }
    my $late = now() >= $until;
    unlink $way;
    my $how = ended($curl, $done ? 2 : 0);    # curl is gone, whatever it was doing, before anything is said about the answer
    my $exit = $how >> 8;
    return (undef, 'the system did not say that curl was in its container') if $loose;
    return (undef, 'the answer is larger than lzrprf takes') if length $got > $FETCH_BYTES || $exit == 63 || @links && $links[1][4] > $WIRE_BYTES;
    return (undef, $none) if @links && $links[0][4] > $SENT_BYTES;
    return (undef, 'could not connect') if $unreached;
    return (undef, 'the site did not answer in time') if $late || $exit == 28;
    return ($got, undef, $peer) if $how == 0 && length $got && defined $peer;
    return (undef, 'the certificate does not prove the host') if grep { $exit == $_ } 51, 53, 54, 58, 59, 60, 66, 77, 80, 82, 83, 90, 91;
    return (undef, 'no secure connection could be made') if $exit == 35;
    return (undef, $none);
}

sub alive { !$RUN || getppid() == $RUN }  # the window is still there; without it nothing is carried on

sub public {
    my ($address) = @_;
    if (my $four = inet_pton(AF_INET, $address)) { return public4(unpack 'N', $four) }
    my $six = inet_pton(AF_INET6, $address) or return 0;
    my @part = unpack 'n8', $six;
    my $inside = ($part[6] << 16) | $part[7];                                    # where an address of the older kind is carried
    return public4($inside) if !grep({ $_ } @part[0 .. 4]) && $part[5] == 0xffff;
    return public4($inside) if $part[0] == 0x64 && $part[1] == 0xff9b && !grep { $_ } @part[2 .. 5];
    return 0 unless ($part[0] & 0xe000) == 0x2000;                               # only the block the public internet uses
    return 0 if $part[0] == 0x2002 || $part[0] == 0x2001 && ($part[1] < 0x200 || $part[1] == 0xdb8) || ($part[0] & 0xfff0) == 0x3ff0;    # tunnels, special uses, examples
    return 1;
}

sub public4 {
    my ($number) = @_;
    for (qw(0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24
            192.88.99.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/3)) {
        my ($net, $bits) = split m{/};
        return 0 if ($number & (0xffffffff << (32 - $bits) & 0xffffffff)) == unpack 'N', inet_aton($net);
    }
    return 1;
}

sub answer {
    my ($to, $data) = @_;
    my $sent = 0;
    while ($sent < length $data) {
        $sent += syswrite($to, $data, length($data) - $sent, $sent) // return 0;
    }
    return 1;
}

# The two fixed addresses. Besides what you type, lzrprf fetches two things,
# each only after you said yes in the window, each written in the log first,
# each sent the way a typed address is: the newest release number (below),
# and a report you chose to send (above). An address that is not on the
# public internet is not fetched for either. A third address, the
# installer's, is never fetched by lzrprf: after "Install it" it is written
# into a file that runs in Terminal, in front of you.                    # [C4]
sub fixed {
    my ($line, $url, $host) = @_;
    open my $request, '>>', "$DIR/busy" or return;
    flock $request, LOCK_SH or return;
    record($line) or return;              # [C5]
    my ($where, $why) = find($host);
    $why = 'that host is not on the public internet' if $where && $PEER eq '-' && grep { $_->{own} } @$where;
    my ($got, $from);
    if (!$why) {
        record("$url -> lzrprf connects to the first that answers of: " . join ', ', map { $_->{text} } @$where) or return;    # [C5]
        ($got, $why, $from) = fetch($url, $where);
    }
    record("$url " . ($why ? "failed: $why" : 'answered: ' . length($got) . " bytes from $from")) or return;
    return $why ? undef : $got;
}

# What the application's maker put beside the program, in a file "release":
# the number of this release, and up to three addresses. Where the newest
# release number is published, where the installer is, where reports go. A
# program without that file is never checked for a newer one, and is never
# asked about in a report.
sub beside {
    my $file = $PROGRAM =~ m{^(.*\.app)/Contents/MacOS/} ? "$1/Contents/Resources/release" : dirname($PROGRAM) . '/release';
    open my $in, '<', $file or return;
    my %is = map { /^(release|newest|installer|report) (\S+)$/ ? ($1 => $2) : () } <$in>;
    return unless ($is{release} // '') =~ /^\d{1,6}$/;
    return ($is{release}, map { my ($url) = address($is{$_} // ''); $url } 'newest', 'report', 'installer');
}

# A newer release. The first time, you are asked whether lzrprf may look at
# each start, and your answer is kept in a file. With a yes, lzrprf fetches
# one fixed address at each start, where the newest release number is
# published and nothing else. The request holds what "request" above holds:
# the same bytes from every computer, so it says nothing about you or about
# which release you run, and it is written in the log like any other. When
# the number there is larger than the one beside the program, the window says
# so and offers the installer. The installer then runs in Terminal, in front
# of you, and asks before it prints itself and before it changes anything.
sub newer {
    my ($release, $newest, undef, $installer) = beside();
    return unless $newest && $installer;
    my $may = '';
    if (open my $in, '<', "$DIR/look") { $may = <$in> // '' }
    if ($may !~ /^(?:yes|no)$/) {
        $may = ask("May lzrprf look for a newer release of $APP at each start? It fetches one fixed address, $newest, with the same bytes from every computer, and writes it in the log like every other. It tells nobody who you are or what you read.", 'No', 'Yes, look') == 2 ? 'yes' : 'no';
        unlink "$DIR/look";
        if (sysopen my $out, "$DIR/look", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) { print $out $may }
    }
    return unless $may eq 'yes';
    busy('Looking for a newer release.');
    my ($host) = $newest =~ m{^https://([^/]+)};
    my $got = fixed("lzrprf looks for a newer release: $newest", $newest, $host) // return;
    my ($there) = $got =~ m{\AHTTP/1\.1 200 .*?\r\n\r\n(?:[0-9a-f]{1,4}\r\n)?(\d{1,6})\s*(?:0\r\n\r\n)?\z}s or return;    # one number and nothing else, or the answer counts for nothing
    return unless $there > $release;
    return unless ask("A newer release of $APP is published: $there. You run $release. The installer runs in Terminal, where you see every step, and it asks before it changes anything.", 'Later', 'Install it') == 2;
    my ($file, $text) = ("$DIR/install.command", installer_file($installer));
    return unless length $text;
    unlink $file;
    sysopen(my $out, $file, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0700) or return;
    print $out $text;
    close $out;
    said(20, '/usr/bin/open', $file) unless $TRY;    # "lzrprf try" only: the file is written and nothing is opened
    closed("The installer is in Terminal. Close $APP now, and start it again when the installer is done.");
}

# What "Install it" runs, in Terminal. The installer is fetched into a file,
# not into a shell: the file stays where you can read it, its SHA-256 is
# shown, and it runs only after you pressed Return. lzrprf itself replaces
# nothing: not the application, and not this file. Whatever is replaced is
# replaced by that installer, in front of you, after it asked.
sub installer_file {
    my ($installer) = @_;
    return '' unless $installer =~ m{^https://[A-Za-z0-9./_~%?=&+:-]+$};    # the address stands between quotes in the file below: one that could end the quote is not written at all
    return <<"END";
#!/bin/sh
# Written by lzrprf when you pressed "Install it".
cd "\$(/usr/bin/mktemp -d)" || exit 1
/usr/bin/curl -fsSL --proto =https -o install.sh '$installer' || { echo 'The installer could not be fetched. Nothing was changed.'; exit 1; }
echo "The installer is in this file, to read before it runs: \$PWD/install.sh"
echo "Its SHA-256: \$(/usr/bin/shasum -a 256 install.sh | /usr/bin/cut -d' ' -f1)"
printf 'Press Return to run it, or close this window and nothing is changed. '
read answer || exit 1
exec /bin/sh install.sh
END
}

# The window's side. The window is lzrprf's: the text at the end of this file,
# run by the system's own osascript in the window container. It is told what
# to show in lines, and says what you did in lines. Four things can come from
# it, and nothing the application wrote is among them: that it is ready, what
# you typed into the bar when you pressed Return, which of two buttons you
# pressed, and that you asked for the log. The words lzrprf says are in a
# strip of their own between the bar and the page, where no page can write.
sub window {
    for my $line (@_) {
        print "$line\n" or leave();       # without a window ("lzrprf try" only) this is printed for the test to read
    }
}

sub busy { window('busy ' . $_[0] =~ s/\s+/ /gr) }
sub idle { window('idle ' . $_[0] =~ s/\s+/ /gr); return }

sub hear {                                # the next thing the window says; nothing when the window is gone, or said nothing in time
    my ($seconds) = @_;
    return shift @EVENTS unless $FROM;
    my $ready = '';
    vec($ready, fileno $FROM, 1) = 1;
    return if defined $seconds && select($ready, undef, undef, $seconds) <= 0;
    my $line = readline($FROM) // return;
    chomp $line;
    print STDERR "$line\n" if $TRY && $line =~ /^(?:test|fault) /;    # "lzrprf try" only: what a test's own text in the window reports
    return $line;
}

# A question, in lzrprf's strip of the window, with two buttons. The first
# button is always the one that changes nothing, and it is the answer when
# the window closes or the time is over. Returns 1 or 2.
sub ask {
    my ($words, @buttons) = @_;
    window(join "\t", 'ask ' . $words =~ s/\s+/ /gr, @buttons);
    if (!$FROM) {
        window('answered ' . ($ANSWER eq 'allow' ? 2 : 1));
        return $ANSWER eq 'allow' ? 2 : 1;
    }
    my $until = now() + $ANSWER_SECONDS;
    while ((my $left = $until - now()) > 0) {
        my $event = hear($left) // leave();
        return $1 if $event =~ /^button ([12])$/;
    }
    return 1;
}

# What is fetched for a text that was typed. An address is https, a host by its
# name, port 443, and plain characters without a space. lzrprf adds https://
# when no scheme was typed, writes the host in small letters, and leaves out
# what follows a #, which is never sent to a site. Everything else is sent
# exactly as typed, or, when it is not such an address, not at all.
sub address {
    my ($text) = @_;
    $text =~ s/^[ \t]+|[ \t\r\n]+$//g;
    $text =~ s/#.*//s;
    $text = "https://$text" unless $text =~ m{^[A-Za-z][A-Za-z0-9+.-]*://};
    return unless $text =~ m{^https://($NAME)(?::443)?([/?][\x21-\x7e]*)?$}i && length $1 <= 253 && length $text <= 2000;
    my ($host, $rest) = (lc $1, $2 // '/');
    $rest = "/$rest" if $rest =~ /^\?/;
    return ("https://$host$rest", $host);
}

# A host that leads to this computer, into a network of your own, or to a
# place this computer reaches by a route of its own is not the public
# internet. It is fetched only after you said yes to exactly that, in
# lzrprf's strip of the window, and the yes holds for that one request.
# Returns nothing after a yes, and the reason after a no.                # [C8]
sub own_network {
    my ($host, $where) = @_;
    my $there = join ', ', map { $_->{text} } @$where;
    my $yes = ask("$host is not on the public internet. It leads to $there: this computer, a network of your own, or a place this computer reaches by a route of its own, such as a VPN. What answers there can be a device of yours, such as a router. Fetch it this once?", 'No', 'Yes, this once') == 2;
    record('you ' . ($yes ? 'allowed' : 'refused') . " $host, which is inside your own network ($there)" . ($yes ? ', this once' : '')) or return 'the log could not be written';
    return $yes ? undef : 'you said no to a host inside your own network';
}

# The log in the window: its last lines where a page stands, how much it
# holds, and the one button that clears it. The log is cleared by that button
# and by nothing else, and that it was cleared is the first line of the new
# log.                                                                   # [C12]
sub log_shown {
    my ($holds, $count, @lines) = holds_log();
    window('page', 'Pc0', (map { ('T@' . (length > 300 ? substr($_, 0, 300) . ' ...' : $_), 'B') } map { s/\t/   /gr =~ s/[^\x20-\x7e]/?/gr } @lines ? @lines : '(nothing yet)'), '.');
    my $says = "Every address lzrprf fetched for $APP. The log holds $holds." . ($count > @lines ? ' Below are its last ' . @lines . ' lines.' : '') . " The whole of it: $DIR/log";
    return idle($says) unless $count && ask($says, 'Close', 'Clear the log') == 2;
    return idle('The log was kept.') unless ask("Clear the log? It holds $holds. This cannot be undone.", 'Keep', 'Clear') == 2;
    my $cleared = clear_log();
    window('page', '.');
    idle($cleared ? 'The log was cleared. Its first line now says so.' : 'The log was not cleared: an address is being fetched right now, or the log could not be written. Nothing was removed.');
}

sub holds_log {                           # what the log holds, in words; the number of its lines; the last 200 of them
    my ($count, $first, $last, @tail) = (0, '', '');
    if (open my $in, '<', "$DIR/log") {
        while (my $line = <$in>) {
            chomp $line;
            $first = $line unless $count++;
            $last = $line;
            push @tail, $line;
            shift @tail if @tail > 200;
        }
    }
    return ('nothing yet', 0) unless $count;
    return (sprintf('%d lines, %.1f MB, from %s to %s', $count, (-s "$DIR/log") / 1048576, map { /^(\S+)/ ? $1 : '?' } $first, $last), $count, @tail);
}

# The log. A line is added at the end, and this returns true only when the
# system says the line is on the disk. Nothing in this file changes or removes
# a line, and the log has no size at which anything is dropped; only you can
# clear it, in the window. Nothing is looked up or fetched whose line could
# not be written, and no answer is shown whose line could not.
# Each line: the time, the number of the run it belongs to, what happened.
# The log stays on this computer. Nothing in this file sends it, or any part
# of it, anywhere.                                                       # [C12]
sub record {
    my ($what) = @_;
    open my $lock, '>>', "$DIR/lock" or return 0;
    flock $lock, LOCK_EX or return 0;
    return put("$DIR/log", O_APPEND, $what);
}

sub put {                                 # one line into a plain file of yours that no link leads elsewhere, and through to the disk
    my ($file, $how, $what) = @_;
    sysopen(my $out, $file, O_WRONLY | O_CREAT | O_NOFOLLOW | $how, 0600) or return 0;
    my @is = stat $out;
    return 0 unless -f _ && $is[3] == 1 && $is[4] == $<;
    print($out strftime('%Y-%m-%dT%H:%M:%SZ', gmtime) . "\t$$\t$what\n") && $out->flush or return 0;
    return 0 unless $^O eq 'darwin' ? defined fcntl($out, 51, 0) : $out->sync;    # 51 is F_FULLFSYNC: through the disk's own cache
    return close $out;
}

# Clearing: the new log, whose first line says what the old one held, is
# written beside the old one and through to the disk, and then takes its
# name in one step. So at no moment is there a log that was emptied without
# saying so. It is not cleared while a request is between its first line and
# its last.
sub clear_log {
    open my $requests, '>>', "$DIR/busy" or return 0;
    flock $requests, LOCK_EX | LOCK_NB or return 0;
    open my $lock, '>>', "$DIR/lock" or return 0;
    flock $lock, LOCK_EX or return 0;
    my ($holds) = holds_log();
    unlink "$DIR/log.new";
    put("$DIR/log.new", O_EXCL, "you cleared the log: it held $holds") or return 0;
    rename "$DIR/log.new", "$DIR/log" or return 0;
    if (open my $folder, '<', $DIR) { $^O eq 'darwin' ? fcntl($folder, 51, 0) : $folder->sync }    # the change of name, through to the disk too
    return 1;
}

sub show {
    print "when (UTC)\trun\twhat you typed, where lzrprf connected for it, and how it ended\n";
    if (open my $in, '<', "$DIR/log") { print <$in> } else { print "(nothing yet)\n" }
}

# The proof for this computer. "selftest" attacks this file on this Mac and,
# when every attack was held, writes down the mark of what it tested: the
# build of macOS and the SHA-256 of this file. Nothing is shown unless that
# mark is the mark of now. So after macOS was updated, or this file changed,
# no page is shown before the attacks were made again.                   # [C11]
sub mark {
    my ($build) = said(5, '/usr/sbin/sysctl', '-n', 'kern.osversion');
    open my $self, '<', $SELF or return '';
    binmode $self;
    return $build =~ /^(\w+)$/ ? "macOS build $1, lzrprf " . Digest::SHA->new(256)->addfile($self)->hexdigest : '';
}

sub proven {
    my $mark = mark();
    my $is = sub { open my $in, '<', "$DIR/proven" or return 0; return length $mark && (<$in> // '') eq "$mark\n" };
    return 1 if $is->();
    my $test = dirname($SELF) . '/selftest';
    if (ask("lzrprf has not been tested on this Mac as it is now: macOS was updated, or lzrprf is new. The test attacks lzrprf with a hostile application and takes about half a minute. $APP shows a page only when every attack was held. Test now?", 'Not now', 'Test now') != 2) {
        window('quit');
        leave();
    }
    busy('lzrprf is being attacked with a hostile application. This takes about half a minute.');
    my ($report) = -f $test ? said(900, '/usr/bin/perl', $test) : ("there is no selftest beside $SELF\n");
    unlink "$DIR/selftest.txt";
    if (sysopen my $out, "$DIR/selftest.txt", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) { print $out $report }
    return 1 if $is->();
    my @failed = grep { /^(?:FAILED|UNTESTED|selftest:)/ } split /\n/, $report;
    @failed = (split /\n/, $report)[-20 .. -1] unless @failed;
    window('page', 'Pc0', (map { ('T@' . substr(s/\t/   /gr =~ s/[^\x20-\x7e]/?/gr, 0, 300), 'B') } grep { length } @failed[0 .. (@failed > 200 ? 199 : $#failed)]), '.');
    return 0;
}

sub lookup {                              # every address a name leads to, as numbers, one on a line
    my ($failed, @all) = getaddrinfo($_[0], 443, { socktype => SOCK_STREAM });
    print map { (getnameinfo($_->{addr}, NI_NUMERICHOST | NI_NUMERICSERV))[1] . "\n" } $failed ? () : @all;
}

