// The page: the lines lzrprf let through, as characters with a look.
function draw(lines) {
    var first = 0;
    while (first < lines.length && lines[first].charAt(0) == 'U') first++;
    if (first < lines.length && lines[first].charAt(0) == 'L') return laid(lines, first);
