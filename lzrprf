}

my $command = shift // '';
die "lzrprf: this macOS has no /usr/bin/sandbox-exec. lzrprf contains with that command and with nothing else, so nothing was started.\n" if $command =~ /^(?:run|try)\z/ && !-x '/usr/bin/sandbox-exec';
if ($command eq 'run') { run(@ARGV) }
elsif ($command eq 'try' && @ARGV > 4 && $ARGV[0] =~ m{^\Q$DIR\E/[A-Za-z0-9][A-Za-z0-9.]*\z} && $ARGV[1] =~ /^(?:-|127\.0\.0\.1:\d+)$/ && $ARGV[3] =~ /^(?:allow|deny|ask|[12]{1,9})$/) {
    ($TRY, $DIR, $PEER, $TYPED, $ANSWER) = (1, splice @ARGV, 0, 4);    # for tests: lzrprf try FOLDER PEER|- TYPED|- allow|deny|ask|DIGITS /path/to/program
    run(@ARGV);
}
elsif ($command eq 'log' && !@ARGV) { show() }
elsif ($command eq 'keep' && @ARGV <= 2) { keep_command(@ARGV) }
elsif ($command eq 'address' && @ARGV) { print "$_\t", (address($_))[0] // 'not fetched: not an address lzrprf fetches', "\n" for @ARGV }
elsif ($command eq 'request' && @ARGV) { print request((address($_))[0] // '') for @ARGV }
elsif ($command eq 'public' && @ARGV) {
    for my $number (@ARGV) {
        my ($failed, $one) = getaddrinfo($number, 443, { socktype => SOCK_STREAM, flags => AI_NUMERICHOST });
        my $route = $failed || !$one ? '' : route($one->{family}, $number) // 'none';
        print "$number\t", public($number) ? 'on the public internet' : 'not public: this computer or a network of your own',
            "\t", { internet => 'sent the way the internet at large is', own => 'sent by a route of its own', none => 'no way there from this computer', '' => 'not a numeric address' }->{$route}, "\n";
    }
}
elsif ($command eq 'mark' && !@ARGV) { print mark(), "\n" }
elsif ($command eq 'behind' && @ARGV > 5 && $ARGV[0] =~ /^[01]$/ && $ARGV[2] =~ /^(?:-|127\.0\.0\.1:\d+)$/ && $ARGV[3] =~ /^(?:allow|deny|ask)$/ && $ARGV[4] =~ /^\d+$/) {    # started by run, not by hand: the same five things "try" sets, handed on
    ($TRY, $DIR, $PEER, $ANSWER, $RUN) = splice @ARGV, 0, 5;
    named(@ARGV);
    open $FROM, '<&=', 0 or exit 1;
    $SIG{PIPE} = 'IGNORE';
    $| = 1;
    behind();
}
elsif ($command eq 'lookup' && @ARGV == 1 && $ARGV[0] =~ /^$NAME$/) { lookup(@ARGV) }    # started for one address that was typed, not by hand
else { die "usage: lzrprf run /path/to/program [arguments]\n       lzrprf log\n       lzrprf keep [nothing|hosts|all [DAYS]]\n       lzrprf address TEXT...\n       lzrprf request TEXT...\n       lzrprf public NUMBER...\n       lzrprf mark\n" }
