}

function place() {
    var all = win.contentView.frame, wide = all.size.width, high = all.size.height, tall = asking ? 96 : 24;
    var room = high - 48 - tall, low = Math.round(Math.min(room / 2, Math.max(96, Math.min(190, room * 0.3))));    // the pane under the page, set whenever the strip changes: three tenths of what the bar and the strip leave, between 96 and 190, and never more than half
    bar.frame = $.NSMakeRect(10, high - 34, wide - 92, 24);
    logs.frame = $.NSMakeRect(wide - 78, high - 37, 72, 30);
    words.frame = $.NSMakeRect(12, high - 42 - tall, wide - (asking ? 300 : 24), tall);
    first.frame = $.NSMakeRect(wide - 284, high - 42 - 62, 132, 30);
    second.frame = $.NSMakeRect(wide - 148, high - 42 - 62, 138, 30);
    scroll.frame = $.NSMakeRect(0, low, wide, high - 48 - tall - low);
