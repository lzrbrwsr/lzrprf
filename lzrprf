}

// lzrprf's strip: its words, and for a question two buttons. While a question
// is open, or lzrprf is busy, the bar takes nothing.
function strip(parts, free, question) {
    asking = question;
    words.stringValue = $(parts[0] || '');
    first.title = $(parts[1] || '');
    second.title = $(parts[2] || '');
    first.hidden = !question;
    second.hidden = !question || !parts[2];
    bar.enabled = free;
    logs.enabled = free;
    place();
