elsif ($command eq 'mark' && !@ARGV) { print mark(), "\n" }
elsif ($command eq 'behind' && @ARGV > 6 && $ARGV[0] =~ /^[01]$/ && $ARGV[2] =~ /^(?:-|127\.0\.0\.1:\d+)$/ && $ARGV[3] =~ /^(?:allow|deny|ask)$/ && $ARGV[4] =~ /^\d+$/ && ($ARGV[5] eq '-' || $ARGV[1] =~ m{/lzrprf-i\.\d+\.[0-9a-f]{12}\z})) {    # started by run, not by hand: the same five things "try" sets, handed on, and for an incognito window the folder its settings are read from
