sub contain {
    my ($more, $program, @rest) = @_;
    my $own = $program =~ m{^(.*\.app)/Contents/MacOS/[^/]+$} ? $1 : $program;
    my @above;                            # the folders above the program: it may know they exist, and no more
    for (my $up = $own; $up =~ s{/[^/]+$}{} && length $up;) { push @above, qq{(literal "$up")} }
    die "lzrprf: the program's path holds a character lzrprf does not pass on\n" if $own =~ /["\\\n]/;
    return ('/usr/bin/sandbox-exec', '-D', "APP=$program", '-D', "OWN=$own", @rest, '-p', "$CONTAINER  @above)\n$more", $program);
}

# Starting a program. Whatever lzrprf starts is handed three descriptors that
# lzrprf chose, and no other: not a file, a socket or a terminal that was open
# in lzrprf or in whoever started lzrprf.
sub seal {
    opendir(my $open, '/dev/fd') or POSIX::_exit(127);
    my @numbers = grep { /^\d+$/ && $_ > 2 } readdir $open;
    closedir $open;
    POSIX::close($_) for @numbers;
}

sub become {                              # this process turns into @command; a descriptor that is not given leads nowhere
    my ($in, $out, $err, @command) = @_;
    my $nowhere = POSIX::open('/dev/null', O_RDWR) // POSIX::_exit(127);
    my @given = map { POSIX::dup(defined $_ ? fileno $_ : $nowhere) // POSIX::_exit(127) } $in, $out, $err;
    POSIX::dup2($given[$_], $_) // POSIX::_exit(127) for 0 .. 2;
    seal();
    { no warnings; exec { $command[0] } @command; }
    POSIX::_exit(127);
}

# What a program printed within some seconds; and whether it ended by itself,
# without an error, in that time. When the time is over it is ended.
sub said {
    my ($seconds, @command) = @_;
    pipe(my $from, my $to) or return ('', 0);
    my $child = fork // return ('', 0);
    if (!$child) {
        close $from;
        become(undef, $to, undef, @command);
    }
    close $to;
    my ($text, $until, $whole) = ('', now() + $seconds, 0);
    while ((my $left = $until - now()) > 0 && length $text < 4 * 1024 * 1024) {
        my $ready = '';
        vec($ready, fileno $from, 1) = 1;
        select($ready, undef, undef, $left > 1 ? 1 : $left) > 0 or next;
        my $got = sysread($from, $text, 65536, length $text);
        next if !defined $got && $!{EINTR};
        $whole = 1 if defined $got && !$got;
        last unless $got;
    }
    return ($text, ended($child, $whole ? 2 : 0) == 0 && $whole);
}

# What several programs printed, each within the same seconds, all of them
# started at once and read side by side: one answer each, in the order asked.
sub said_all {
    my ($seconds, @commands) = @_;
    my (@from, @child);
    for my $at (0 .. $#commands) {
        pipe(my $from, my $to) or next;
        my $child = fork // next;
        if (!$child) {
            close $_ for $from, grep { defined } @from;
            become(undef, $to, undef, @{ $commands[$at] });
        }
        close $to;
        ($from[$at], $child[$at]) = ($from, $child);
    }
    my @text = map { '' } @commands;
    my $until = now() + $seconds;
    while ((my $left = $until - now()) > 0 && grep { defined } @from) {
        my $ready = '';
        vec($ready, fileno $_, 1) = 1 for grep { defined } @from;
        select($ready, undef, undef, $left > 1 ? 1 : $left) > 0 or next;
        for my $at (grep { defined $from[$_] && vec($ready, fileno $from[$_], 1) } 0 .. $#from) {
            my $got = sysread($from[$at], $text[$at], 65536, length $text[$at]);
            next if !defined $got && $!{EINTR};
            undef $from[$at] if !$got || length $text[$at] > 1024 * 1024;
        }
    }
    ended($_, 0) for grep { defined } @child;
    return @text;
}

sub ended {                               # waits this long for a process to end, then ends it; returns how it ended
    my ($pid, $patience) = @_;
    my $until = now() + $patience;
    while (1) {
        my $gone = waitpid $pid, POSIX::WNOHANG();
        return $? if $gone == $pid;
        return -1 if $gone < 0;
        last if now() >= $until;
        select undef, undef, undef, 0.02;
    }
    kill 'KILL', $pid;
    waitpid $pid, 0;
    return $? || -1;
}

# The proof that the containers hold, in two parts. Neither rests on what the
# application says about itself.
#
# The first part is made at every start. A small program, the text below, is
# run inside the page container: the same container text, the same way of
# starting, with the same limits. It tries seven things the container must
# refuse, each against something that is really there (a listener lzrprf
# opened a moment ago, a file lzrprf wrote a moment ago, lzrprf's own
# process, 3 GiB of memory). Then the same program is run outside every
# container and without the limits, where each of the seven must work:
# so a refusal inside is the container's, not a try that could never have
# worked. Unless both runs say exactly that, nothing is started.         # [C2]
my $TRIES = <<'END';
use Socket;
my ($port, $folder, $pid) = @ARGV;
$| = 1;
socket(my $s, AF_INET, SOCK_STREAM, 0);
print 'network ', (connect($s, pack_sockaddr_in($port, inet_aton('127.0.0.1'))) ? 'done' : 'refused'), "\n";
print 'read ', (open(my $in, '<', "$folder/here") ? 'done' : 'refused'), "\n";
print 'write ', (open(my $out, '>', "$folder/made") ? 'done' : 'refused'), "\n";
print 'signal ', (kill(0, $pid) ? 'done' : 'refused'), "\n";
print 'memory ', (syscall(197, 0, 3 * 1024**3, 3, 0x1002, -1, 0) != -1 ? 'done' : 'refused'), "\n";    # asks for 3 GiB of addresses (mmap) and touches none of it
my $child = fork;
exit 0 if defined $child && !$child;
print 'second process ', (defined $child ? 'done' : 'refused'), "\n";
{ no warnings; exec '/usr/bin/true'; }
print "other program refused\n";
END

sub holds {
    my $listen = IO::Socket::INET->new(Listen => 4, LocalAddr => '127.0.0.1', LocalPort => 0) or return 0;
    my $folder = "$DIR/tries.$$";
    mkdir $folder or return 0;
    put("$folder/here", O_EXCL, 'a file of yours') or return 0;
    my @tries = ('-e', $TRIES, $listen->sockport, $folder, $$);
    my ($inside) = said(10, '/bin/sh', '-c', $PAGE_LIMITS, 'lzrprf', contain('', '/usr/bin/perl'), @tries);    # started as a page is started, limits and all
    my ($outside) = said(10, '/usr/bin/perl', @tries);
    unlink "$folder/here", "$folder/made";
    rmdir $folder;
    my @what = ('network', 'read', 'write', 'signal', 'memory', 'second process');
    return $inside eq join('', map { "$_ refused\n" } @what, 'other program') && $outside eq join('', map { "$_ done\n" } @what);    # outside, the last try turns the program into another one, which says nothing
}

# The second part is made for every process. The system keeps, for each
# process, the container it was put in, and answers questions about it. One
# small process, the text below, asks the system: may this process use the
# network, create a file, start a second process, reach a system service?
# Only when the system says no to all four is the process handed anything:
# a page container the site's answer, curl the connection to the site. The
# question is put to the system, by number of the process. Nothing is asked
# of the process itself. The window's process is asked about in the same
# way before it takes an address: no to the same four, and no to opening
# something through the system, to commanding another program, to writing
# your settings and to a signal. For the window the fourth question names
# no service: the no says that its container refuses a system service by
# default, and nothing of which names its list lets through. selftest
# asks for six by name from the real window.                              # [C3]
my $WITNESS = <<'END';
ObjC.import('Foundation');
ObjC.bindFunction('sandbox_check', ['int', ['int', 'char *', 'int']]);
function run() {
    var from = $.NSFileHandle.fileHandleWithStandardInput, to = $.NSFileHandle.fileHandleWithStandardOutput, held = '';
    while (true) {
        var data = from.availableData;
        if (data.length == 0) return;
        held += $.NSString.alloc.initWithDataEncoding(data, 4).js;
        for (var at; (at = held.indexOf('\n')) >= 0; held = held.slice(at + 1)) {
            var pid = parseInt(held.slice(0, at), 10);
            var refused = ['network-outbound', 'file-write-create', 'process-fork', 'mach-lookup', 'lsopen', 'appleevent-send', 'user-preference-write', 'signal'].map(function (what) { return $.sandbox_check(pid, what, 0); });
            to.writeData($(pid + ' ' + refused.join(' ') + '\n').dataUsingEncoding(4));
        }
    }
}
END
my ($witness, $to_witness, $from_witness, $witness_of) = (undef, undef, undef, 0);

sub witnessed {                           # the one that answers is running, started now when it was not: true when it is
    return 1 if $witness;
    pipe(my $asked, $to_witness) && pipe($from_witness, my $told) or return 0;
    $witness = fork // return 0;
    become($asked, $told, undef, $SCRIPT, '-l', 'JavaScript', '-e', $WITNESS) unless $witness;
    $witness_of = $$;
    close $_ for $asked, $told;
    $to_witness->autoflush(1);
    return 1;
}

sub inside {                              # true when the system says that this process is contained; it is asked for two seconds, and then the answer is no
    my ($pid, $window) = @_;
    my $contained = $window ? qr/^\Q$pid\E 1 1 1 1 1 1 1 1\n\z/ : qr/^\Q$pid\E 1 1 1 1 [01] [01] [01] [01]\n\z/;    # the page and fetch containers refuse everything; what the last four say of them is not what holds them
    my $lost = sub {                      # the one that answers did not answer: it is ended, so that no late answer of its is ever read as the answer to a later question
        return 0 if $witness_of != $$;    # by the process that started it alone: a picture's run beside others asks lzrprf's and ends nothing of lzrprf's
        kill 'KILL', $witness;
        waitpid $witness, 0;
        close $_ for $to_witness, $from_witness;
        undef $witness;
        return 0;
    };
    witnessed() or return 0;
    my $until = now() + 2;
    open my $turn, '<', $SELF or return 0;    # one question at a time: the runs that fetch a page's pictures side by side ask the same one, and each must read the answer to its own question, not another's
    while (now() < $until) {
        flock $turn, LOCK_EX or return 0;
        print $to_witness "$pid\n" or return $lost->();
        my $ready = '';
        vec($ready, fileno $from_witness, 1) = 1;
        select($ready, undef, undef, $until - now() + 0.5) > 0 or return $lost->();
        my $says = readline($from_witness) // return $lost->();
        flock $turn, LOCK_UN;
        return 1 if $says =~ $contained;
        select undef, undef, undef, 0.01; # not yet: the process is still being put into its container
    }
    return 0;
}

# The start. The process that was started becomes the window, so that the
# system shows it under the application's name. Its child is a fresh copy of
# this file, outside every container, and the two talk over two pipes.
sub run {
    my ($program, @arguments) = @_;
    seal();
    $ROOT = $DIR;
    $TIMED = $TRY && -e "$ROOT/times";
    timed('perl');
    $program = abs_path($program // '') // '';
    die "lzrprf: no such program\n" unless -f $program && -x _;
    named($program, @arguments);
    mkdir $DIR;
    my @folder = lstat $DIR;
    die "lzrprf: $DIR is not a folder of yours\n" unless @folder && -d _ && $folder[4] == $<;
    chmod 0700, $DIR;
    runs_swept($DIR);
    swept();                              # [C16] the folder of an incognito run that ended without removing it, at every start
    $INCOGNITO ||= $TRY && -e "$ROOT/incognito";    # "lzrprf try" only: a file "incognito" in the test's folder makes the run an incognito one, the test's folder standing for ~/.lzrprf
    if ($TRY && open my $named, '<', "$ROOT/profile") { $PROFILE = <$named> // ''; chomp $PROFILE }    # "lzrprf try" only: a file "profile" in the test's folder holds the id the run opens, as --profile does
    profile_entered() if defined $PROFILE;    # a profile's window: its own folder from here on, and the state folder for what belongs to the installation
    incognito_begun() if $INCOGNITO;      # opened from a profile's window, its settings are read from that profile's folder alone
    $SIG{PIPE} = 'IGNORE';
    if ($TRY && open my $pull, '<', "$ROOT/open") { ($OPEN) = opened_with($pull, '--open', '0 0 400 300', $program) }    # "lzrprf try" only: a file "open" in the test's folder holds the line a pulled tab's window reads on standard input
    if ($TRY && $ANSWER ne 'ask') {       # "lzrprf try" only: no window
        @EVENTS = ('start ' . ($OPEN // '-'), 'ready', $TYPED eq '-' ? () : map { /^=(.+)/ ? $1 : "go $_" } split /,,/, $TYPED);
        return behind();
    }
    pipe(my $window_in, my $to) && pipe(my $from, my $window_out) or die "lzrprf: cannot make a pipe: $!\n";
    my $window = $$;
    my $behind = fork // die "lzrprf: cannot fork: $!\n";
    become($from, $to, $TRY ? \*STDOUT : undef, '/usr/bin/perl', $SELF, 'behind', $TRY, defined $PROFILE && !$INCOGNITO ? $ROOT : $DIR, $PEER, $ANSWER, $window, $INCOGNITO ? $ROOT : '-', $PROFILE // '-', $program, @arguments) unless $behind;    # descriptor 0 is what the window says, descriptor 1 what it is told; a profile by its id alone, never by its name, and behind finds its folder from the state folder
    close $_ for $to, $from;
    my $more = '';
    if ($TRY && open my $test, '<', "$ROOT/window") { local $/; $more = <$test> }    # "lzrprf try" only: the test's own text after the window's, so a test can keep the window off the screen and read what it holds
    die "lzrprf: the home folder's path holds a character lzrprf does not pass on\n" if $HOME =~ /["\\\n]/;
    syswrite $window_out, 'start ' . ($OPEN // '-') . "\n";    # the first line behind hears, written here before the window is made, so the window can neither say it nor read it: the address a pulled tab's window opens (sub started)
    become($window_in, $window_out, $TRY ? \*STDERR : undef, '/usr/bin/sandbox-exec', '-D', "HOME=$HOME", '-p', $WINDOW_CONTAINER, $SCRIPT, '-l', 'JavaScript', '-e', window_text() . $more, $APP, $INCOGNITO ? 'incognito' : 'window', $OPEN_FRAME // frame_kept());    # the size and place the last window was left at (sub frame_kept), so it opens there and does not jump; a pulled tab's window opens where the tab was let go
}

sub runs_swept {                          # what runs that have ended left in a folder: a request's socket, the folder of the tries at the start
    my ($folder) = @_;
    for my $old (bsd_glob("$folder/way.*"), bsd_glob("$folder/tries.*")) {
        next if $old =~ /\.(\d+)$/ && kill 0, $1;
        unlink bsd_glob("$old/*"), $old;
        rmdir $old;
    }
}

# An incognito window [C16]. Its folder is made the way mkdtemp makes one: a
# name with 12 random hex digits, made by one mkdir that fails when the name is
# taken, readable by you alone, in your own temporary folder. Its name holds the
# number of the window's process, so a later start can tell a folder whose run
# has ended. A third process, the sweeper, outlives the window and the process
# behind it: it ignores the signals a terminal sends, waits for both to be gone
# and removes the folder. The process behind the window removes it too when it
# leaves, on a signal among them. A run killed whole, the sweeper with it,
# leaves the folder to the next start (sub swept).
sub temp_folder {                         # your own temporary folder: TMPDIR when it is a folder of yours that nobody else may read, else the one of yours under /private/var/folders
    my @found = grep { defined && m{^/[\x21-\x7e]+\z} } map { abs_path($_) } grep { defined && length } $ENV{TMPDIR}, bsd_glob('/private/var/folders/*/*/T');
    for my $temp (@found) {
        my @is = lstat $temp;
        return $temp if @is && -d _ && $is[4] == $< && !($is[2] & 0077);
    }
    return;
}

sub swept {                               # [C16] incognito folders of runs whose window process is gone
    my $temp = temp_folder() // return;
    for my $old (bsd_glob("$temp/lzrprf-i.*")) {
        my ($pid) = $old =~ m{/lzrprf-i\.(\d+)\.[0-9a-f]{12}\z} or next;
        my @is = lstat $old;
        next unless @is && -d _ && $is[4] == $<;
        next if kill(0, $pid) || $!{EPERM};    # its window, or a process of that number, is still there
        removed($old);
    }
}

sub removed {                             # an incognito folder, whole; nothing else is ever removed by this
    my ($folder) = @_;
    return unless $folder =~ m{/lzrprf-i\.\d+\.[0-9a-f]{12}\z} && -d $folder && !-l $folder;
    remove_tree($folder, { safe => 0, keep_root => 0 });
}

sub incognito_begun {
    my $temp = temp_folder() // die "lzrprf: no temporary folder of yours was found that nobody else may read, so no incognito window was started\n";
    my $folder;
    for (1 .. 8) {
        open my $random, '<:raw', '/dev/urandom' or last;
        read($random, my $bytes, 6) == 6 or last;
        my $try = "$temp/lzrprf-i.$$." . unpack('H*', $bytes);
        if (mkdir $try, 0700) { $folder = $try; last }
    }
    die "lzrprf: the incognito window's folder could not be made in $temp, so nothing was started\n" unless $folder;
    ($BASE, $DIR, $INCOGNITO) = ($DIR, $folder, 1);
    my $window = $$;
    my $sweeper = fork // do { removed($folder); die "lzrprf: cannot fork: $!\n" };
    return if $sweeper;
    $SIG{$_} = 'IGNORE' for qw(INT TERM HUP QUIT PIPE);    # a terminal's Ctrl-C or its closing ends the window, not the one that cleans after it
    POSIX::setsid();
    my $nowhere = POSIX::open('/dev/null', O_RDWR);
    POSIX::dup2($nowhere, $_) for 0 .. 2;
    seal();
    put("$folder/sweeper", O_EXCL, $$);    # its number, for a test that ends it too
    select undef, undef, undef, 0.25 while getppid() == $window;    # the window is this process's parent until it is gone
    if (open my $held, '<', "$folder/held") { flock $held, LOCK_EX }    # the process behind the window holds this while it lives
    removed($folder);
    POSIX::_exit(0);
}

sub incognito_opened {                    # "New Incognito Window": a second lzrprf, of its own, in incognito
    return idle($GONE) if defined $PROFILE && !profile_folder($PROFILE);    # the profile it reads was removed while this window was open: a window started now would end at its first check, so none is started and that is said
    return idle('A new incognito window was asked for: "lzrprf try" starts none.') if $TRY;
    return idle('No incognito window was started: lzrprf could not start a process.') unless apart(undef, '/usr/bin/perl', $SELF, 'incognito', defined $PROFILE ? ('--profile', $PROFILE) : (), $PROGRAM, @ARGUMENTS);    # it reads the settings of this window's profile, named by its id alone
    return idle('An incognito window is opening. It writes nothing: when it closes, it leaves nothing behind.');
}

sub apart {                               # a second lzrprf, of its own, that goes through every start check itself; true when it was started. A line given is its standard input, then closed
    my ($line, @command) = @_;
    my ($from, $to);
    pipe($from, $to) or return 0 if defined $line;
    my $child = fork // return 0;
    if (!$child) {
        POSIX::setsid();
        my $grandchild = fork // POSIX::_exit(1);
        POSIX::_exit(0) if $grandchild;   # so the window started is nobody's child here, and leaves nothing to wait for
        become($from, undef, undef, @command);
    }
    if ($to) {                            # one line, at most 2101 bytes, fits in the pipe at once: nothing waits on the reader
        close $from;
        local $SIG{PIPE} = 'IGNORE';
        syswrite $to, "$line\n";
        close $to;
    }
    waitpid $child, 0;
    return $? == 0;
}

# A tab pulled out of the strip and let go away from it: "tab out N X Y W H", N a tab that is
# there and the rest the frame of its new window, in the form of a kept frame. A second lzrprf
# is started for it as "New Incognito Window" starts one, and goes through every start check of
# its own: it is handed the frame as an argument and the tab's address as one line on its
# standard input, nothing else; the address is never an argument, which every user of the
# computer can read in the list of processes for as long as the window lives. A tab of an incognito window opens an incognito
# window, and a tab of a profile's window a window of the same profile. The tab then closes here;
# it is not one of the closed tabs to reopen, since it still shows. The last tab is never pulled
# out: its window moves instead. One window opens at most $PULLED_MOST windows this way and from
# the Profiles list together in its life.
sub tab_out {
    my ($n, $frame) = @_;
    return if $n >= @TABS || @TABS < 2;
    my ($url) = address($TABS[$n]{url} // '');
    my $stays = $PULLED >= $PULLED_MOST ? "The tab stays here: this window has opened $PULLED_MOST windows from its tabs and profiles, the most one window may. Open a new window for more."
        : defined $PROFILE && !profile_folder($PROFILE) ? "The tab stays here. $GONE"
        : !$TRY && !apart($url // '', pulled_command($frame)) ? 'The tab stays here: lzrprf could not start a process for its new window.' : '';
    if (length $stays) {
        window('tabs ' . @TABS . " $TAB", map { "title $_ $TABS[$_]{title}" } 0 .. $#TABS);    # the strip shows the tab again
        return idle($stays);
    }
    $PULLED++;
    tabbed('close', $n, undef, 1);
    idle('A tab pulled out opens a new window: "lzrprf try" starts none.') if $TRY;
}

sub pulled_command { my ($frame) = @_; return ('/usr/bin/perl', $SELF, $INCOGNITO ? 'incognito' : 'run', defined $PROFILE ? ('--profile', $PROFILE) : (), '--open', $frame, $PROGRAM, @ARGUMENTS) }    # the new window's lzrprf, started as this one was, in this window's profile by its id, and no address in it

# "--open FRAME" before the program (sub pulled_command), the frame in the form of a kept frame,
# and one line read from $in (standard input): an address checked as a typed one, or an empty
# line for none, at most 2100 characters. Returns the address (undef for none), the frame and the
# program with its arguments; anything else ends the start here.
sub opened_with {
    my ($in, undef, $frame, @rest) = @_;
    my $url = '';
    my $one;
    while (length $url <= 2100) { (read($in, $one, 1) // 0) == 1 && $one ne "\n" or last; $url .= $one }
    die "lzrprf: --open takes a frame \"X Y W H\", then the program, and an address lzrprf fetches or an empty line on standard input\n"
        unless defined $frame && @rest && length $url <= 2100 && (!length $url || (address($url))[0]) && $frame =~ /\A-?[0-9]{1,5} -?[0-9]{1,5} [1-9][0-9]{1,4} [1-9][0-9]{1,4}\z/;
    return (length $url ? (address($url))[0] : undef, $frame, @rest);
}

# Profiles. A profile is a browser of its own inside this one, for one person or one part of a
# life: its own bookmarks and their bar, home page, search address, log and what is kept of it,
# and Tor's folder, on the disk; its own history, closed tabs and zoom, in the memory of its
# window's process. The first profile is the state folder itself, ~/.lzrprf, as it always was:
# nothing is moved, and an installed browser sees no change, and gets no new file, until a second
# profile is made or the first is renamed. Every other profile is a folder of its own,
# ~/.lzrprf/profiles/ID, readable by you alone (mode 700), ID being 12 hex digits lzrprf drew from
# /dev/urandom and never anything typed. A profile's name is the one plain file "name" in its
# folder; the first profile's, once you gave it one, is the file profiles/first. What belongs to
# the installation and to no profile stays in the state folder and is the same for every profile:
# the self-test's result, the look for a newer release and its answer, an installer and its lines,
# the welcome, the licence code, the support request kept, and the jobs the application's tool
# switched off. A profile's window is a process of its own, started as a pulled tab's window is
# (sub profile_window): the id is its one word of a profile on a command line, since every user
# of the computer can read the list of processes, and the name never is. It holds a shared lock on
# the file "inuse" in its folder for as long as it lives (sub profile_held), and a profile is
# removed only while nobody holds it; a window of the first profile does the same in the state
# folder, once there are profiles. One window at a time counts, makes, renames or removes
# profiles, under a lock on the folder of the profiles (sub profiles_locked). An incognito window
# opened from a profile's window reads that profile's settings, by its id on its command line,
# and writes nothing there; it is told no profile, and lzrprf refuses every word of a profile from
# it. A profile's name is shown in the strip and kept in the memory of the window that said it,
# and written in no file but its own "name": no file on the disk names another profile.
#
# The window's words, each checked here as the words of a hostile window are: "profile list";
# "profile open ID", a window of that profile; "profile new<TAB>NAME", a profile made and opened;
# "profile rename<TAB>ID<TAB>NAME"; "profile remove ID", asked once and then removed. ID is
# "first" or 12 hex digits, and only the id of a profile lzrprf finds in its folder names a folder;
# a name is at most $PROFILE_NAME characters of plain text. lzrprf answers with "profiles begin",
# a line "profiles one ID this|open|shut NAME" for each profile, the first one first and the others
# by name, and "profiles end"; and with "profiles refused WORDS" when it did not do what was asked.
my $FIRST_NAME = 'First profile';         # the first profile's name until you give it one
my $INUSE;                                # in a profile's window, the shared lock on its file "inuse": held while the window lives

sub profiles_root { "$ROOT/profiles" }
sub profiles_folder {                     # the folder of the profiles when it is a folder of yours and no link; nothing when it is not there or is something else
    my @is = lstat profiles_root();
    return @is && -d _ && $is[4] == $< ? profiles_root() : undef;
}

sub profile_folder {                      # the folder of a profile lzrprf knows, by its id; nothing for any other word, so no word of the window names a folder outside
    my ($id) = @_;
    $id //= '';
    return $ROOT if $id eq 'first';
    return unless $id =~ /\A[0-9a-f]{12}\z/;
    my $all = profiles_folder() // return;
    my @is = lstat "$all/$id";
    return @is && -d _ && $is[4] == $< ? "$all/$id" : undef;
}

sub profile_ids {                         # the ids of the profiles there are, the first one first
    my $all = profiles_folder();
    my @ids;
    if ($all && opendir my $in, $all) { @ids = sort grep { /\A[0-9a-f]{12}\z/ && profile_folder($_) } readdir $in }
    return ('first', @ids);
}

sub profile_fit {                         # a name as it was typed: its bytes as they are kept, or nothing and why in plain words
    my ($typed) = @_;
    my $name = $typed // '';
    return (undef, 'A profile name is plain text, and that was not.') unless utf8::decode($name);
    return (undef, 'A profile name holds no control or format character.') if $name =~ /[\p{C}\p{Zl}\p{Zp}]/;
    $name =~ s/\s+/ /g;
    $name =~ s/\A | \z//g;
    return (undef, 'Type a name for the profile first.') unless length $name;
    return (undef, "A profile name is at most $PROFILE_NAME characters. That one has " . length($name) . '.') if length $name > $PROFILE_NAME;
    utf8::encode($name);
    return ($name);
}

sub profile_name {                        # a profile's name, as kept; one that is not there, or not a name lzrprf takes, reads as a name made from its id
    my ($id) = @_;
    my ($all, $bytes) = (profiles_folder(), '');
    if ($all && sysopen my $in, $id eq 'first' ? "$all/first" : "$all/$id/name", O_RDONLY | O_NOFOLLOW | O_NONBLOCK) { sysread $in, $bytes, 400 if -f $in }    # a plain file and no link; a pipe put in its place is not waited for
    my ($name) = profile_fit($bytes =~ s/\n.*//sr);
    return $name // ($id eq 'first' ? $FIRST_NAME : "Profile $id");
}

sub profile_open {                        # true while a window of the profile in this folder is open: that window holds the lock on its file "inuse"
    my ($folder) = @_;
    sysopen(my $lock, "$folder/inuse", O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return 0;
    return !flock $lock, LOCK_EX | LOCK_NB;    # the lock, taken now, ends with the handle
}

sub profiles_told {                       # the list, for the Profiles icon: nothing in an incognito window
    return if $INCOGNITO;
    first_held();                         # the list names the profiles, so from here on this window is listed as open in the others too
    my ($first, @others) = profile_ids();
    my %name = map { $_ => profile_name($_) } $first, @others;
    @others = sort { lc $name{$a} cmp lc $name{$b} || $a cmp $b } @others;
    window('profiles begin', (map { "profiles one $_ " . (($PROFILE // 'first') eq $_ ? 'this' : profile_open(profile_folder($_)) ? 'open' : 'shut') . " $name{$_}" } $first, @others), 'profiles end');
}

sub profiles_refused { my ($says) = @_; window("profiles refused $says"); return idle($says) }

sub profiles_locked {                     # one window at a time counts, makes, renames or removes profiles: an exclusive lock on the folder of the profiles, held while the handle lives
    my $all = profiles_folder() // return;
    sysopen(my $lock, $all, O_RDONLY | O_NOFOLLOW) or return;
    flock($lock, LOCK_EX) or return;      # each holder only reads names and makes, renames or removes one folder, so the wait is short
    return $lock;
}

sub profiles_swept {                      # what a removal that failed part way left: only names of exactly the form ".removed.ID.PID", of a process that is gone; a link is removed itself, never followed. Under profiles_locked
    my $all = profiles_folder() // return;
    opendir(my $in, $all) or return;
    for my $left (grep { /\A\.removed\.[0-9a-f]{12}\.(\d+)\z/ && ($1 == $$ || !kill 0, $1) } readdir $in) {
        my @is = lstat "$all/$left";
        if (-l _) { unlink "$all/$left" }
        elsif (@is && -d _ && $is[4] == $<) { remove_tree("$all/$left", { safe => 0 }) }
    }
}

sub profile_taken {                       # a profile name another profile has already, capitals aside; nothing when none has
    my ($name, $but) = @_;
    return scalar grep { $_ ne ($but // '') && lc profile_name($_) eq lc $name } profile_ids();
}

sub profile_entered {                     # a profile's window, at its start: the profile named is one lzrprf knows, and its folder is this window's folder from here on; anything else ends the start here
    my $folder = ($PROFILE // '') =~ /\A[0-9a-f]{12}\z/ ? profile_folder($PROFILE) : undef;
    die "lzrprf: there is no such profile: it may have been removed. Open another from the Profiles icon of a window.\n" unless $folder;
    $DIR = $folder;
    return if $INCOGNITO;                 # an incognito window reads that folder and changes nothing in it [C16]
    chmod 0700, $folder;
    runs_swept($DIR);
}

sub profile_held {                        # behind a profile's window: the shared lock on its file "inuse", taken for as long as this process lives; false when the profile was removed meanwhile
    return 1 if $INCOGNITO;               # it writes nothing there, so it holds no lock there either: it does not count as an open window of the profile
    return 1 if !defined $PROFILE && !profiles_folder();    # the first profile takes the lock only once there are profiles, so an installation with one gets no new file
    sysopen($INUSE, "$DIR/inuse", O_RDWR | O_CREAT | O_NOFOLLOW, 0600) or return 0;
    flock $INUSE, LOCK_SH or return 0;    # waits while a removal holds it
    return (stat $INUSE)[3] && -f _;      # its name is still there: the profile was not removed while the lock was waited for
}

sub first_held { profile_held() unless defined $PROFILE || $INUSE || $INCOGNITO }    # the first profile's window, once it knows there are profiles: its lock, taken once. A window opened before the folder of the profiles was made takes it here, when its list is told or a profile word reaches it

sub profile_command { my ($id) = @_; return ('/usr/bin/perl', $SELF, 'run', $id eq 'first' ? () : ('--profile', $id), $PROGRAM, @ARGUMENTS) }    # a profile's window: its id, and nothing typed

sub profile_window {                      # a new window of a profile lzrprf knows, by its id alone, started as a pulled tab's window is, with no address
    my ($id) = @_;
    return profiles_refused('An incognito window has no profile, and opens none.') if $INCOGNITO;
    first_held();
    profile_folder($id) or return profiles_refused('That is not a profile lzrprf knows. No window was opened.');
    return profiles_refused("No window was opened: this window has opened $PULLED_MOST windows from its tabs and profiles, the most one window may. Open it from another window.") if $PULLED >= $PULLED_MOST;
    return profiles_refused('No window was opened: lzrprf could not start a process for it.') unless $TRY || apart(undef, profile_command($id));
    $PULLED++;
    return idle($TRY ? 'A profile\'s window was asked for: "lzrprf try" starts none.' : 'The profile ' . profile_name($id) . ' opens in a new window.');
}

sub profile_new {                         # "profile new<TAB>NAME": a profile made, with a folder of its own, and opened in a new window
    my ($typed) = @_;
    return profiles_refused("$UNKEPT, so it makes no profile.") if $INCOGNITO;
    my ($name, $why) = profile_fit($typed);
    return profiles_refused($why) unless defined $name;
    my $most = "There are $PROFILES_MOST profiles, the most there may be. Remove one to make another.";
    my $taken = "There is a profile called $name already. Choose another name.";
    return profiles_refused($most) if (() = profile_ids()) >= $PROFILES_MOST;    # said before anything is made: a refused name makes no folder of profiles
    return profiles_refused($taken) if profile_taken($name);
    mkdir profiles_root(), 0700 unless -e profiles_root() || -l profiles_root();
    my $all = profiles_folder() // return profiles_refused('No profile was made: ' . profiles_root() . ' is not a folder of yours.');
    chmod 0700, $all;
    my $lock = profiles_locked() // return profiles_refused('No profile was made: the folder of the profiles could not be locked.');
    profiles_swept();
    return profiles_refused($most) if (() = profile_ids()) >= $PROFILES_MOST;    # counted again under the lock: another window may have made one meanwhile
    return profiles_refused($taken) if profile_taken($name);
    first_held();    # the first profile's window takes its lock now that there are profiles, so it is listed as open
    my $id;
    for (1 .. 8) {
        open my $random, '<:raw', '/dev/urandom' or last;
        read($random, my $bytes, 6) == 6 or last;
        my $try = unpack 'H*', $bytes;
        if (mkdir "$all/$try", 0700) { $id = $try; last }
    }
    return profiles_refused('No profile was made: its folder could not be made.') unless defined $id;
    unless (put("$all/$id/name", O_EXCL, $name)) { remove_tree("$all/$id", { safe => 0 }); return profiles_refused('No profile was made: its name could not be written.') }
    synced($all);
    undef $lock;
    noted('you made a profile');          # in this window's memory alone. A profile's name is shown in this window's strip and kept in its memory (the lines its Log button shows), never written to any file but its own "name" and never shown to a page: no file on the disk names another profile
    profiles_told();
    return profile_window($id);
}

sub profile_renamed {                     # "profile rename<TAB>ID<TAB>NAME"
    my ($id, $typed) = @_;
    return profiles_refused("$UNKEPT, so it renames no profile.") if $INCOGNITO;
    profile_folder($id) or return profiles_refused('That is not a profile lzrprf knows. Nothing was renamed.');
    my ($name, $why) = profile_fit($typed);
    return profiles_refused($why) unless defined $name;
    my $taken = "There is a profile called $name already. Choose another name.";
    return profiles_refused($taken) if profile_taken($name, $id);
    mkdir profiles_root(), 0700 unless -e profiles_root() || -l profiles_root();    # the first profile's name is the one thing of it kept there
    my $all = profiles_folder() // return profiles_refused('Nothing was renamed: ' . profiles_root() . ' is not a folder of yours.');
    my $lock = profiles_locked() // return profiles_refused('Nothing was renamed: the folder of the profiles could not be locked.');
    return profiles_refused($taken) if profile_taken($name, $id);    # again under the lock
    profile_folder($id) or return profiles_refused('That is not a profile lzrprf knows. Nothing was renamed.');
    my $was = profile_name($id);
    first_held();
    my $file = $id eq 'first' ? "$all/first" : "$all/$id/name";
    unlink "$file.new";
    return profiles_refused('Nothing was renamed: the name could not be written.') unless put("$file.new", O_EXCL, $name) && rename("$file.new", $file);
    synced($id eq 'first' ? $all : "$all/$id");
    undef $lock;
    noted('you renamed a profile');       # the names, old and new, in this window's strip and memory alone (sub profile_new)
    profiles_told();
    return idle("The profile $was is now called $name.");
}

sub profile_removed {                     # "profile remove ID": asked once, then the profile's folder and nothing else is deleted
    my ($id) = @_;
    return profiles_refused("$UNKEPT, so it removes no profile.") if $INCOGNITO;
    first_held();
    return profiles_refused('The first profile is never removed: its folder is the state folder itself, which also holds what belongs to the whole installation.') if $id eq 'first';
    my $folder = profile_folder($id) // return profiles_refused('That is not a profile lzrprf knows. Nothing was removed.');
    my $name = profile_name($id);
    return profiles_refused("The profile $name is this window's own. Remove it from a window of another profile, once this one is closed.") if ($PROFILE // '') eq $id;
    my $open = "The profile $name has a window open. Close its windows first, then remove it.";
    return profiles_refused($open) if profile_open($folder);
    return idle("The profile $name was not removed.") unless ask("Remove the profile $name? Its bookmarks, history, log, home page, search address and all that is kept for it are deleted from this Mac. This cannot be undone.", 'Cancel', 'Remove') == 2;
    my $all = profiles_locked() // return profiles_refused("The profile $name was not removed: the folder of the profiles could not be locked. Nothing was deleted.");
    $folder = profile_folder($id) // return profiles_refused('That is not a profile lzrprf knows. Nothing was removed.');    # looked at again under the lock: the question can stand open for minutes
    my $lock;                             # held while it is removed: no window of it starts meanwhile
    sysopen($lock, "$folder/inuse", O_RDWR | O_CREAT | O_NOFOLLOW, 0600) && flock($lock, LOCK_EX | LOCK_NB) or return profiles_refused($open);
    my $gone = profiles_root() . "/.removed.$id.$$";    # out of the list in one step; a name no profile can have
    return profiles_refused("The profile $name was not removed: its folder could not be moved aside. Nothing was deleted.") unless rename $folder, $gone;
    remove_tree($gone, { safe => 0 });    # a link inside is removed, never followed
    profiles_swept();                     # and what an earlier removal could not finish
    synced(profiles_root());
    undef $all;
    noted('you removed a profile');
    profiles_told();
    return idle(-e $gone ? "The profile $name was taken off the list, but part of its folder could not be deleted: $gone" : "The profile $name was removed, and its folder with it.");
}

# The first line behind hears is lzrprf's own, written before the window was made (sub run):
# "start ADDRESS" in the window of a pulled tab, else "start -". Then the window's first words,
# "ready". Returns that address, '' for none, or nothing when the run did not begin so.
sub started {
    my ($pulled) = (hear(60) // '') =~ /^start (-|[\x20-\x7f]{1,2100})$/ or return;
    return (hear(60) // '') eq 'ready' ? ($pulled eq '-' ? '' : $pulled) : undef;
}

sub named {                               # the program of this run, and the name it is called by in the window
    ($PROGRAM, @ARGUMENTS) = @_;
    ($APP) = $PROGRAM =~ m{([^/]+?)(?:\.app/Contents/MacOS/[^/]+)?$};
    $APP = 'the application' unless defined $APP && $APP =~ /^[A-Za-z0-9 ._-]{1,40}$/;
}

# Behind the window: everything lzrprf does for one run, one thing at a time.
my $HELD;                                  # in an incognito window, the lock on its folder's file "held" that the sweeper waits for
sub behind {
    if ($INCOGNITO) {                     # [C16] every way out removes the folder
        open $HELD, '>>', "$DIR/held" and flock $HELD, LOCK_EX;
        put("$DIR/behind", O_EXCL, $$);    # its number, for a test that kills it outright, as a crash would
        $SIG{$_} = sub { leave() } for qw(INT TERM HUP QUIT);
    }
    timed('behind');
    witnessed();                          # the one that answers whether a process is contained is started now, while the window is still being made, so it is ready when the window is asked about [C10]
    my $held = holds();                   # [C2] tried now too, beside the window being made: it starts nothing but its own small program, and its answer is waited on below before anything else is done
    timed('holds');
    $BEGAN = sum_of($PROGRAM);            # read before it is compared below, so the program that is compared is the one every page is held to
    my $pulled = started() // leave();
    timed('ready');
    return closed('That profile is no longer there: it was removed as this window started. Open another from the Profiles icon of a window.') unless profile_held();    # held from here until the window ends
    paired();                             # before anything else: an application and an lzrprf that were not installed together are noticed
    return closed($INCOGNITO ? "lzrprf was not tested on this Mac as it is now, or did not hold, so $APP shows no page. An incognito window does not run the self-test, because the test writes its result: open a normal window once to test this Mac." : "lzrprf was not tested on this Mac as it is now, or did not hold, so $APP shows no page. What the test found: $ROOT/selftest.txt") unless ($TRY && !-e "$ROOT/prove") || proven();    # [C11]
    timed('proven');
    return closed("The container did not hold on this Mac a moment ago, so $APP was not started. Run selftest, which is beside lzrprf, to see what was not refused.") unless $held;    # [C2] the tries made at the start of this sub
    return closed("The system did not say that this window is in its container, so $APP shows no page. Run selftest, which is beside lzrprf, to see what was not refused.") unless !$RUN || inside($RUN, 1);    # [C10] the window is a process too, and the system is asked about it by its number
    timed('window-inside');
    $UNEXPIRED = !expire_log();           # [C12] the days you chose, at the start of a window; when a request of another window is open just then, it is tried again before each request of this window and each press of Log, until it is done
    welcome() unless $INCOGNITO;          # once after each install or update: what is new, and what $APP does and does not do for you; an incognito window writes nothing, so it shows none
    window('incognito') if $INCOGNITO;
    idle(($INCOGNITO ? "$APP is contained, in an incognito window: its log, history and tabs are held in its memory and one folder of its own, removed when it closes. Nothing is written to ~/.lzrprf." : "$APP is contained: no network, no file of yours, no other program. lzrprf fetches what you type above, and writes it in the log first. " . kept_words(keeping()) . ((keeping())[0] eq 'nothing' && -s "$DIR/log" ? ' A log written earlier is still on this computer: the Log button offers to clear it.' : '')), $INCOGNITO ? 'Contained, incognito' : 'Contained');
    timed('idle-sent');
    said_noted();                         # the first line of this window's log: that it is contained, and what is kept
    marks_told();
    profiles_told();                      # the Profiles icon's list: told none in an incognito window
    window('marksbar ' . (marks_bar() ? 'on' : 'off'), 'search ' . (engine() ? 'set' : 'none'));
    nav_told();
    if (length $pulled) { go($pulled, 'you pulled a tab out into this window') }    # [C4] checked as a typed address is, and [C5] written before its name is looked up: the address of a tab pulled out of another window, handed on a pipe
    elsif (my $home = home()) { go($home, 'you opened your home page') }    # [C4] an address that came from the bar, kept when you made it the home page
    newer() unless $INCOGNITO;           # [C16] it would write its answer and an installer's lines. Only now, once the window is idle and its first page is drawn: a look for a newer release never stands before the first drawing
    window('checked ' . ($INCOGNITO ? 'none' : checked_kept()));    # when lzrprf last looked for a newer release, shown under Check for updates
    licence_told();                       # whether a licence code is kept, shown under Enter licence code
    support_told();                       # where a support request would go, and whether one is kept to read its answer
    tool_watch();                        # [C20] the jobs you switched off, looked at once as the window starts
    while (defined(my $event = hear(scalar(tool_due()), 1))) {
        if ($event =~ /^go ([\x20-\x7f]{1,2100})$/) { typed($1) }    # [C4] the one place an address comes from: the bar of lzrprf's own window; a size said while it was fetched and laid out is the size it is laid out again at
        elsif ($event eq 'live') { live_turn() }    # a page kept running with its tab answered, or is to end (sub live_answered)
        elsif ($event =~ /^page (click (?:0|[1-9][0-9]{0,5}) (?:0|[1-9][0-9]{0,5})|key (?:[\x21-\x7e]|Space|Escape|Enter|Tab|Backspace|Delete|ArrowUp|ArrowDown|ArrowLeft|ArrowRight|Home|End|PageUp|PageDown)(?: shift)?|text [^\x00-\x1f\x7f]{1,$LIVE_TEXT})$/) { live_input($1) }    # a click in the page, a key while it has the keyboard, text typed into its field: handed to the page kept running, and to nothing else
        elsif (viewing($event)) { relaid() }    # the window's page has a new size: the page shown is laid out again at its width, from what was kept, and nothing is fetched
        elsif ($event =~ /^tab move (0|[1-9][0-9]?) (0|[1-9][0-9]?)$/) { tab_moved($1, $2) }    # a tab dragged along the strip to another place among the tabs: the page shown stays as it is
        elsif ($event =~ /^tab (new|select|close)(?: (0|[1-9][0-9]?))?( kept)?$/) { tabbed($1, $2, $3); relaid() }    # a tab chosen in the strip: the window shows the drawing it kept of it ("kept"), or lzrprf sends the one it kept, and only a page kept at another width is laid out again; nothing is fetched, unless a new tab opens the home page
        elsif ($event eq 'tab reopen') { tab_reopened(); relaid() }    # Cmd-Shift-T: the tab closed last, at its place, from lzrprf's memory alone
        elsif ($event =~ /^tab out (0|[1-9][0-9]?) (-?[0-9]{1,5} -?[0-9]{1,5} [1-9][0-9]{1,4} [1-9][0-9]{1,4})$/) { tab_out($1, $2); relaid() }    # a tab pulled out of the strip: a window of its own
        elsif ($event =~ /^menu (clear-history|clear-sessions|home|bookmarks-bar)$/) { menu($1); said_noted() }
        elsif ($event =~ /^mark open (0|[1-9][0-9]{0,2})$/) { $MARKS[$1] ? go($MARKS[$1][2], 'you opened a bookmark', $1) : idle('That bookmark is no longer there.') }    # [C4] an address kept from the bar or typed into the window's own modal
        elsif ($event =~ /^mark remove (0|[1-9][0-9]{0,2})$/) { mark_removed($1); said_noted() }
        elsif ($event =~ /^mark save\t(-|0|[1-9][0-9]{0,2})\t([A-Za-z0-9 ._\/-]{0,300})\t([^\t\x00-\x1f\x7f]{1,800})\t([\x20-\x7f]{1,2100})$/) { mark_saved($1, $2, $3, $4); said_noted() }
        elsif ($event =~ /^nav (back|forward|reload)$/) { navigated($1) }    # [C4] an address this tab went to already, from its own list
        elsif ($event =~ /^search (brave|duckduckgo|google)$/) { search_set($ENGINES{$1}); said_noted() }
        elsif ($event =~ /^search custom\t([\x21-\x7e]{1,2000})$/) { search_set($1); said_noted() }
        elsif ($event eq 'log') { log_shown() }
        elsif ($event =~ /^tor (on|off)$/) { $1 eq 'on' ? tor_on() : tor_off('you turned Tor off') }    # Tor, from the onion icon of the bottom bar: started on this request only, ended on this one
        elsif ($event =~ /^tool (open|sense)$/) { tool_shown($1) }    # [C20] the application's tool, from its icon in the bottom bar: a look, which changes nothing
        elsif ($event =~ /^tool (act|undo) ((?:0|[1-9][0-9]{0,2})(?:,(?:0|[1-9][0-9]{0,2})){0,199})$/) { tool_done($1, $2) }    # [C20] the rows you ticked, and for a switching off confirmed
        elsif ($event eq '') { tool_watch() }    # [C20] nothing was said for a while: the jobs you switched off are looked at again
        elsif ($event eq 'update-check') { $INCOGNITO ? idle('An incognito window looks for no newer release; a window that is not incognito does, in its cogwheel menu.') : newer(1) }
        elsif ($event =~ /^frame (full|-?[0-9]{1,5} -?[0-9]{1,5} [1-9][0-9]{1,4} [1-9][0-9]{1,4})$/) { frame_said($1) }    # the window was moved, resized or made full screen: kept for the next window
        elsif ($event eq 'incognito') { incognito_opened(); said_noted() }
        elsif ($INCOGNITO && $event =~ /^profiles? /) { profiles_refused('An incognito window has no profile, and opens, makes or changes none.') }
        elsif ($event eq 'profile list') { profiles_told() }    # the Profiles icon was pressed: which profile has a window open is looked at now
        elsif ($event =~ /^profile open (first|[0-9a-f]{12})$/) { profile_window($1); said_noted() }    # a profile chosen in the list: a new window of it, by its id
        elsif ($event =~ /^profile new\t([^\t]{0,400})$/) { profile_new($1); said_noted() }    # "New profile": the name typed into the window's own field, checked here
        elsif ($event =~ /^profile rename\t(first|[0-9a-f]{12})\t([^\t]{0,400})$/) { profile_renamed($1, $2); said_noted() }
        elsif ($event =~ /^profile remove (first|[0-9a-f]{12})$/) { profile_removed($1); said_noted() }
        elsif ($event =~ /^profiles? /) { profiles_refused('That is not a profile lzrprf knows, or not a word it takes. Nothing was changed.') }    # a path, a dot, a slash, an id of another length or form: no folder is named
        elsif ($event =~ /^licence set ([0-9A-Za-z \-]{1,200})$/) { licence_set($1) }    # "Enter licence code": the code typed into the window's own field, checked here before anything is kept
        elsif ($event eq 'licence remove') { licence_removed() }
        elsif ($event =~ /^support send ([A-Za-z0-9+\/]+={0,2}) (-|[A-Za-z0-9+\/]+={0,2})$/) { support_sent($1, $2) }    # [C4] "Support request": your words and, when you ticked it, the window's picture of itself; the address is the release file's, never the window's
        elsif ($event eq 'support read') { support_read() }    # [C4] the answer to the request kept, read from the release file's support address
        elsif ($event eq 'support forget') { support_forgot() }
        elsif ($event =~ /^import (sources|go)$/) { $1 eq 'go' ? (import_go(), said_noted()) : import_sources() }    # [C15] "Import bookmarks..." in the window's wizard: nothing is read before a browser is chosen, nothing written before Import
        elsif ($event =~ /^import profiles (chrome|edge|brave|vivaldi|firefox|safari|file)$/) { import_profiles($1) }
        elsif ($event =~ /^import preview (chrome|edge|brave|vivaldi|firefox|safari|file) (0|[1-9][0-9]?)$/) { import_preview($1, $2) }
        elsif ($event =~ /^import path ([\x20-\x7e]{1,1000})$/) { import_path($1) }
        elsif ($event =~ /^fault / && $DRAWN) { $DRAWN = 0; fault('undrawn') }    # the window could not draw a list that "checked" let through: it shows nothing of it. Taken once for a page that was handed over, and never without one: the window's process cannot open the question about a report whenever it likes
    }
    leave();
}

# The pair. The installer puts the application and lzrprf in place together,
# and the application's "release" file names the SHA-256 of that lzrprf.
# When this file is another one, the application does not start: the window
# says why and what mends it, with one button, Quit, and there is no way on
# from there. An application whose file names no lzrprf, or that has no such
# file, does not start either: applications before release 12 named none.
# Only a program that stands in no application folder and has no "release"
# file beside it is not asked: the installer puts no such program in place,
# and the launcher starts none.
#
# The same file names, in lines "file NAME SHA-256", the files in the folder
# of the program: the program lzrprf starts in the page container, and the
# launcher. From release 16 on each named file must be the file that is
# there, and the program itself must be named, or the application does not
# start. From release 17 on nothing stands beside the program in an
# application folder that the file does not name: so the launcher must be
# named too, and a file that was put there later stops the start. A name that
# begins with a dot is passed over: the Finder writes such a file into a
# folder it showed, and nothing starts one. The named files are looked at
# once, at the start; the program is read again before every page (sub
# laid_out). All of it is measured by a file of the application's own: it
# finds a program that was changed and a file that was not, as a damaged disk
# or a copy that did not finish leaves them. Whoever can change both is not
# found by it. A name is one plain word of
# letters, digits, dot, hyphen and underscore, so a program of another name
# cannot be named and does not start from an application folder. Only a plain
# file is read: a folder, a pipe or a device of that name counts as another
# file. A line that begins with "file" and is not in this shape counts as a
# file that differs, so a damaged line does not pass for no line.
sub paired {
    my @lines = release_lines();
    my ($pair) = map { /^lzrprf\s+(\S+)/ ? $1 : () } @lines;    # read for itself: a file whose other lines are damaged still names its lzrprf
    return if !defined $pair && $PROGRAM !~ m{\.app/Contents/MacOS/} && !-e release_file() && !-l release_file();
    my @files = map { /^file ([A-Za-z0-9_][A-Za-z0-9._-]*) ([0-9a-f]{64})$/ ? [$1, $2] : () } @lines;    # a name is one plain word, so it is a file in the program's own folder and nowhere else
    my ($other) = map { $_->[0] } grep { my $file = dirname($PROGRAM) . "/$_->[0]"; !-f $file || $_->[1] ne (sum_of($file) // '') } @files;
    $other //= basename($PROGRAM) =~ s/[^A-Za-z0-9._-]/?/gr unless grep { $_->[0] eq basename($PROGRAM) } @files;
    $other //= unnamed(map { $_->[0] } @files) if $PROGRAM =~ m{\.app/Contents/MacOS/[^/]+$};
    my $what = @files < grep({ /^file\b/ } @lines) ? 'a line "file" there is not as the installer writes it' : defined $other ? "the file \"$other\" is another one than that file names, or is not named there" : undef;
    return if defined $pair && $pair eq (sum_of($SELF) // '') && !defined $what;
    ask(defined $pair && $pair eq (sum_of($SELF) // '') ? "$APP is not as it was installed, so it does not start. The installer writes the SHA-256 of the program and of the launcher into the application's release file: here $what. Installing again mends it." : defined $pair ? "$APP was installed together with another lzrprf than the one running now, so it does not start. The installer puts the two in place as a pair: a pair that differs was left by an install that did not finish, or lzrprf was replaced by hand. Installing again mends it." : "$APP does not say which lzrprf it was installed with, so it does not start. The installer puts the two in place as a pair and writes lzrprf's SHA-256 into the application's release file: here that line is missing, as in an application older than release 12 or one that was changed by hand. Installing again mends it.", 'Quit');    # whatever comes back, the run ends here
    window('quit');
    leave();
}

sub unnamed {                             # the first thing in the program's folder that is none of these names and does not begin with a dot; a folder that cannot be listed is itself the answer
    my %named = map { $_ => 1 } @_;
    opendir my $folder, dirname($PROGRAM) or return 'Contents/MacOS';
    my ($first) = sort grep { !/^\./ && !$named{$_} } readdir $folder;
    return defined $first ? $first =~ s/[^A-Za-z0-9._-]/?/gr : undef;
}

sub leave {
    my @live = @LIVE;
    live_end($_, 'the window closed', 1) for @live;    # no page kept running outlives its window
    kill 'KILL', $witness if $witness;
    tor_off();                            # the Tor client ends with the window that started it
    unlink "$DIR/way.$$";
    removed($DIR) if $INCOGNITO;          # [C16]
    exit 0;
}

sub closed {                              # nothing more is done in this run: the window says why, and its bar takes nothing
    busy($_[0]);
    1 while defined hear();
    leave();
}

# One visit: what happens after Return was pressed in the bar, as a chain of
# conditions. Each "return" below is a place where the chain ends and nothing
# is fetched. There is no other way to the fetch.
sub visit {
    my ($typed, $how, $mark, $auto) = @_;   # whether a redirect to the same site was followed already in this visit; what was typed, how its line in the log begins ("you typed", "you opened your home page", "you opened a bookmark", "you chose to follow a redirect to"), and the bookmark it came from
    $DRAWN = 0;
    undef $SHOWN;                         # a page asked for anew is laid out again only once it is shown
    my ($url, $host) = address($typed);
    return idle('lzrprf does not fetch that. An address must be https, a host by its name, port 443, in plain characters without a space.') unless $url;
    window("address $url");                 # the bar shows what will be sent, exactly
    my $tab = $TABS[$TAB];
    my @left = grep { $_->{tab} && $_->{tab} == $tab } @LIVE;
    live_end($_, 'its tab went elsewhere') for @left;    # the page this tab kept running is told "=end" and ended before anything else is asked
    @$tab{qw(url title)} = ($url, '');
    window("title $TAB ");                  # the tab's title is the page's, once it is shown
    if (($how // '') =~ /redirect to$/ && $tab->{at} >= 0) { $tab->{visited}[$tab->{at}] = $url }    # a redirect followed takes the place of the address that redirected, so back does not land on it again
    elsif (($how // '') !~ /^you (?:went (?:back|forward) to|reloaded)$/) {    # back, forward and reload stand where sub navigated put them
        splice @{ $tab->{visited} }, $tab->{at} + 1;
        push @{ $tab->{visited} }, $url;
        shift @{ $tab->{visited} } while @{ $tab->{visited} } > $VISITED;
        $tab->{at} = $#{ $tab->{visited} };
    }
    $tab->{secure} = undef;
    window('secure none');
    nav_told();
    return fault('changed') unless defined $BEGAN && $BEGAN eq (sum_of($PROGRAM) // '');    # before a site is asked: a program that is no longer the file this window began with is given no page, so none is fetched for it
    $UNEXPIRED = !expire_log() if $UNEXPIRED;
    open my $request, '>>', "$DIR/busy" or return idle($UNWRITTEN);
    flock $request, LOCK_SH or return idle($UNWRITTEN);    # from "you typed" until its last line is written, a request keeps the log from being cleared under it
    my ($kept) = keeping();                 # read once: no line of one request is kept at more than this, whatever is chosen while it runs; when less is chosen meanwhile, its later lines are kept at that (sub record)
    record(($how // 'you typed') . " $url", $kept) or return idle($UNWRITTEN);  # [C5] before the name is even looked up
    timed('logged');
    busy($TOR_WANTED ? "Asking Tor for $host." : "Looking up $host.");
    my ($where, $why) = $TOR_WANTED ? tor_where($host) : find($host);    # with Tor on, nothing is looked up on this computer: Tor's exit looks up the name
    timed('found');
    $why = own_network($host, $where, $kept) if $where && grep { $_->{own} } @$where;    # [C8]
    my ($got, $from, $tried, $certs);
    if (!$why) {
        record("$url -> lzrprf connects " . ($TOR_WANTED ? "through Tor, one circuit for $host" : 'to the first that answers of: ' . join(', ', map { $_->{text} } @$where)), $kept) or return idle($UNWRITTEN);    # [C5] written down first, connected second
        busy("Fetching $url");
        $tried = 1;
        ($got, $why, $from, $certs) = fetch($url, $where, undef, 1);    # the request of a page: the one that carries Accept
    }
    timed('fetched');
    record("$url " . ($why ? "failed: $why" : 'answered: ' . length($got) . " bytes from $from"), $kept) or return idle($tried ? $UNENDED : $UNWRITTEN);    # an answer whose line could not be recorded is not shown, and the window says the fetch was tried
    close $request;
    return idle("Nothing is shown: $why.") if $why;
    if (my ($status, $to) = redirected($got, $url)) {    # never shown as an answer, never followed blindly: you choose, in lzrprf's own modal (sub redirected)
        my ($fit) = defined $to ? address($to) : ();
        my ($there) = defined $fit ? $fit =~ m{^https://([^/]+)} : ();
        my $rest = sub { $_[0] =~ s{^https://[^/]+}{}r };
        if (defined $fit && !$auto && $rest->($fit) eq $rest->($url) && ($there eq "www.$host" || $host eq "www.$there")) {    # the same address with www. put in front of its host or taken off: followed once a visit, written down first
            record("$host redirected to $there ($status); followed, the same site", $kept) or return idle($UNWRITTEN);
            push @WAY, "$url answered $status, to $fit (followed by lzrprf: the same site)";
            $NEXT = [$fit, 'lzrprf follows that redirect to', $mark, 1];
            return idle("$host redirected to $there ($status): the same site, so lzrprf follows it.");
        }
        my $why = !defined $to ? 'The answer names no address to go to.' : defined $fit ? '' : unfit($to);
        my $press = asked("redirect $status\t$url\t" . ($to // '') . "\t$why", 'Cancel', defined $fit ? ('Proceed', defined $mark ? 'Proceed and update bookmark' : ()) : ());
        if ($press >= 2 && defined $fit) {
            push @WAY, "$url answered $status, to $fit (you chose to follow it)";
            my $moved = $press == 3 ? (mark_moved($mark, $fit) ? ' The bookmark now holds that address.' : ' The bookmark could not be changed.') : '';
            $NEXT = [$fit, 'you chose to follow a redirect to', undef];
            return idle("$url redirects to $fit ($status). lzrprf goes there as a new request.$moved");
        }
        window("page $TAB", '.');
        return idle("Nothing is shown: $url redirects " . (defined $to ? "to $to " : '') . "($status), and lzrprf did not go there." . (length $why ? " $why" : ''));
    }
    busy("$APP lays the page out, in its container.");
    timed('lay');
    my ($lines, $hosts, $paths, $said, $named, $live) = laid_out($url, $got, "=sheets\n", 1);    # [C14] a first run is told that no style sheet came with the answer; $live: the run, when the application keeps its page running (sub contained)
    return fault($hosts) unless $lines;
    my $styled = '';                        # what the bar says of the page's style sheets
    my ($with_sheets, $two) = ("=sheets\n", 0);    # the frame of style sheets the page shown was laid with, and whether that was a second run: what a new width lays it with again
    if (@$named) {                          # [C14] the page names style sheets on its own host: they are fetched, and the page is laid out once more with them
        $live = live_dropped($live);        # the first run is not the one kept running: a page shown as it was laid out first, because its second run is not shown, runs no more
        my ($frame, $with) = sheeted($named, $host, $where, $kept) or return idle($UNWRITTEN);
        busy("$APP lays the page out again with its style sheets, in its container.");
        my @again = laid_out($url, $got, $frame, 1);
        my ($n, $one) = (scalar @$named, @$named == 1);
        if ($again[0] && !@{ $again[4] }) {    # a second run that names style sheets again is not shown, and nothing starts a third
            ($lines, $hosts, $paths, $said) = @again;
            ($with_sheets, $two) = ($frame, 1);
            $live = $again[5];              # the run shown is the one kept running
            $styled = "$APP laid the page out again with $with of the $n " . ($one ? 'style sheet' : 'style sheets') . " it names on $host itself. ";
        } else {
            live_end($again[5], 'it is not shown', 1) if $again[5];
            $styled = "$APP did not use the $n " . ($one ? 'style sheet' : 'style sheets') . " the page names on $host itself: the page is shown as it was laid out first. ";
        }
    }
    timed('laid');
    my $title = $TITLED;                    # the title the run that is shown wrote
    my $first = grep { /^I\d/ } @$lines;    # the page draws pictures: it is shown at once with a grey box in the place of each, and drawn again with them once they came
    if ($first) {
        window("page $TAB", @{ (pictured($lines, $paths, $host, $where, $kept, {}))[0] }, '.');    # nothing is fetched for this one: no picture is decoded yet
        $DRAWN = 1;
        timed('list');
    }
    my ($shown, $fetched, $wanted, $decoded) = pictured($lines, $paths, $host, $where, $kept);
    window("page $TAB", '.') if !$shown && $first;    # a line of a picture could not be written: the page drawn at once is taken away again, as nothing of this answer would have been shown before
    return live_dropped($live, $UNWRITTEN) unless $shown;
    timed($first ? 'pictured' : 'list');
    window(($first ? 'relaid' : 'page') . " $TAB", @$shown, '.');    # the tab a list is for is named, so a list that arrives once another tab was chosen in the window goes to that tab's kept drawing; the second drawing keeps the place the page is read at
    $DRAWN = 1;
    $SHOWN = { url => $url, got => $got, frame => $with_sheets, two => $two, host => $host, pictures => $decoded, wide => $LAID_WIDE, list => $shown, used => ++$LIST_USED };    # list: what was sent, sent again from here when the tab is chosen again (sub tab_shown)
    lists_bounded();
    live_kept($live, $tab, $lines, $paths, $host, $decoded, $shown) if $live;    # the page goes on with this tab: clicks and keys in it reach it, and what it draws again is checked as this list was
    live_told();
    $tab->{secure} = secured($url, $from, $got, $certs);
    window('secure begin', (map { "secure line $_" } @{ $tab->{secure} }), 'secure end');
    $tab->{title} = $title;
    window("title $TAB $title");            # checked: plain characters, no control or format character, at most $TITLE (sub checked)
    window("history add $url\t$title");     # what the bar suggests while you type: the pages shown in this window, in its memory only, emptied by "Clear history" (function suggested)
    my $whole = "$host answered " . length($got) . ' bytes. ' . $styled . ($wanted ? "$fetched of the $wanted " . ($wanted == 1 ? 'picture' : 'pictures') . ' the page draws ' . (@PICTURED ? '' : "from $host itself ") . ($fetched == 1 ? 'was' : 'were') . ' fetched and shown' . (@PICTURED ? '; besides ' . $host . ', lzrprf asked ' . join(', ', @PICTURED > 4 ? (@PICTURED[0 .. 3], '...') : @PICTURED) . ' for them' : '') . '. ' : '') . (@$hosts ? 'The page names ' . @$hosts . (@$hosts == 1 ? ' other host' : ' other hosts') . ' (' . join(', ', @$hosts > 4 ? (@$hosts[0 .. 3], '...') : @$hosts) . '). lzrprf asked none of them' . (@PICTURED ? ' for anything but a picture.' : '.') : 'The page names no other host.') . (length $said ? " $said" : '');    # the application's own words why the page is in compatibility-statement mode, last and as plain text (sub stated)
    noted($whole);
    idle($whole, sprintf("%s \xc2\xb7 %d ms \xc2\xb7 %s", $got =~ m{\AHTTP/1\.[01] (\d{3})} ? $1 : '?', (now() - $WENT) * 1000, length($got) < 1000 ? length($got) . ' B' : sprintf('%d kB', length($got) / 1000)));    # the strip: how the site answered, how long all of it took, how much came
}

# The request is over and the connection to the site is closed. Only now does
# the application see the answer, in a page container, and only after the
# system said that this very process is contained, with the frame of style
# sheets it is given ("=sheets" and a line end on a first run). Returns the
# checked lines, the other hosts the page names, the paths of the pictures it
# names on its own host, its statement ('' for none) and the paths of the style
# sheets it names; or nothing, and one word for what went wrong. With $keep,
# the run is asked to keep its page running with the tab (sub contained), and
# the run that does so comes last; a first list that is unfit ends it.
sub laid_out {
    my ($url, $got, $sheets, $keep) = @_;
    $LAID_WIDE = $VIEW[0];                # the width contained asks for in its =view frame, and the one width sub laid takes
    my ($wrote, $why, $live) = contained($url, $got, $sheets, $keep);
    return (undef, $why) unless defined $wrote;
    my ($lines, $hosts, $paths, $said, $named) = checked($wrote) or return (live_dropped($live), 'unfit');    # [C9]
    return ($lines, $hosts, $paths, $said, $named, $live);
}

# The fonts a page is drawn with, as one frame in front of its answer:
# "=fonts", the length of each of the eight, a line end, then their bytes.
# The application opens no file of its own, so lzrprf reads them here, once
# in a window. A face that is a link, a pipe or anything but a plain file,
# is larger than $FACE_BYTES or does not begin as a font goes as length 0.
my $FRAME;
sub faces {                               # [C13]
    return $FRAME //= do {
        my @got = map {
            my ($in, $font) = (undef, '');
            sysopen($in, $_, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) && -f $in && binmode($in)
                && read($in, $font, $FACE_BYTES + 1) && length($font) <= $FACE_BYTES
                && $font =~ /\A\x00\x01\x00\x00/ ? $font : '';
        } @FACES;
        join(' ', '=fonts', map { length } @got) . "\n" . join('', @got);
    };
}

# One run of the application in a page container, for a page or for one
# picture: it is given what was fetched on descriptor 0, under the same
# limits, the same keeper and the same clock. Returns what it wrote, not yet
# checked; or nothing, and one word for what went wrong. A picture run is
# told one thing more, LZRPRF_PICTURE=1; a page run gets the size of the
# window's page first, "=view", its width and its height in points and a line
# end, then the fonts, then the frame of its style sheets, $sheets, none of
# which a picture run has.
#
# A page kept running with its tab. With $keep (a page run, never a picture
# run) the answer goes in the frame "=live", its length in bytes and a line
# end, then the answer; the application's half is src/page/scripted.rs.
# An application that keeps the page (an HTML page its engines read) writes
# its first list and then a line "=ready", and stays: its keeper keeps its
# input open and hands it the lines lzrprf writes into a third pipe, the
# relay, which only lzrprf and that keeper hold. lzrprf reads the first list
# up to "=ready", within the same $PAGE_SECONDS and $PAGE_BYTES, checks it as
# every first list, and returns the run with it: the page, its keeper, the
# relay, the pipe the page writes to and lzrprf's end of the keeper's pipe,
# which still ends the page when lzrprf ends by whatever way. An application
# that does not keep the page writes its list and ends, and is read to its end
# as before. Every line that reaches a page kept running is written by lzrprf
# from a line of the window it checked (sub live_input); every answer of the
# page is checked before anything of it is drawn (sub live_answered).
sub contained {
    my ($url, $got, $sheets, $keep, $tool) = @_;    # $tool: the run is the application's tool ([C20], sub tool_shown): handed lzrprf's look at this computer as a picture run is handed a picture, and read to its end
    return (undef, 'changed') unless defined $BEGAN && $BEGAN eq (sum_of($PROGRAM) // '');    # read again before every run: the program on the disk is the file this window began with, or nothing is laid out
    $keep = 0 unless defined $sheets;     # a picture run is never kept
    my $frame = defined $sheets ? "=view $VIEW[0] $VIEW[1]\n" . faces() . $sheets : '';    # the size first, numbers lzrprf holds to its bounds (sub viewing); [C13] [C14] the fonts read here, before the keeper is a copy of this process, so once in a window; handed over by the keeper alone, after the same word as the answer
    $frame .= '=live ' . length($got) . "\n" if $keep;
    my ($input, $relay);                  # the keeper's end of the relay and lzrprf's, for a page kept running
    if ($keep) { pipe($input, $relay) or return (undef, 'unstarted') }
    pipe(my $answer_out, my $answer_in) && pipe(my $from_page, my $to_lzrprf) && pipe(my $held, my $hold) or return (undef, 'unstarted');
    my $page = fork // return (undef, 'unstarted');
    if (!$page) {
        %ENV = (LZRPRF_CONTAINED => $url, $tool ? (LZRPRF_TOOL => '1') : defined $sheets ? () : (LZRPRF_PICTURE => '1'));    # the application is told the address it lays out, and for a picture that it is one, and sees no other variable: these it is given before the system is asked [C3]
        chdir '/';
        become($answer_out, $to_lzrprf, $TRY ? \*STDERR : undef, '/bin/sh', '-c', $PAGE_LIMITS, 'lzrprf', contain('', $PROGRAM), @ARGUMENTS);    # [C1]
    }
    close $_ for $answer_out, $to_lzrprf;
    my $feeder = fork;
    if (!defined $feeder) {               # no second process to be had: the application is running by now, so it is ended here and not left to end by itself
        kill 'KILL', $page;
        waitpid $page, 0;
        return (undef, 'unstarted');
    }
    if (!$feeder) {                       # the keeper of this page
        close $_ for $from_page, $hold, grep { defined } $relay, map { @$_{qw(relay from hold)} } @LIVE;    # and lzrprf's ends of every page kept running: the end of lzrprf is the end of each of their pipes, held by nobody else
        keeper($held, $answer_in, $frame . $got, $page, $input);
        POSIX::_exit(0);                  # the keeper never returns; were it ever to, it ends here and does not go on as a second lzrprf
    }
    close $_ for $answer_in, $held, grep { defined } $input;
    timed('page-forked');
    fcntl($relay, POSIX::F_SETFL(), O_NONBLOCK) if $relay;    # lzrprf never waits in a write to a page: a line it cannot write at once ends the page (sub live_input)
    if (!inside($page)) {                 # [C3] the system did not say so: the answer stays here; the application was told the address and nothing else
        kill 'STOP', $page;               # held still before anything else: the keeper's end closes the application's input, and an application the system does not call contained is not to go on at that while it waits to be ended
        kill 'KILL', $feeder;             # the keeper first, here and below: it acts on the application's number, and is gone before the system may give that number to another process
        waitpid $feeder, 0;
        my $gone = waitpid($page, POSIX::WNOHANG()) == $page;    # it ended by itself: of a process that is gone the system has nothing to say
        kill 'KILL', $page unless $gone;
        waitpid $page, 0 unless $gone;
        return (undef, $gone ? 'ended' : 'uncontained');    # only a process still running, of which the system does not say that it is contained, is the container's fault
    }
    timed('page-inside');
    if ((syswrite($hold, 'g') // 0) != 1) {    # the keeper cannot be told that the system said so: nothing is handed over
        kill 'KILL', $feeder, $page;
        waitpid $_, 0 for $feeder, $page;
        return (undef, 'unstarted');
    }
    my ($wrote, $until, $open, $looked, $ready_at, $early) = ('', now() + $PAGE_SECONDS, 1, 0, -1);
    while ($open && now() < $until && length $wrote <= $PAGE_BYTES && alive()) {
        my $ready = '';
        vec($ready, fileno $from_page, 1) = 1;
        select($ready, undef, undef, 1) > 0 or next;
        $open = sysread($from_page, $wrote, 65536, length $wrote) // $!{EINTR};
        next unless $keep;
        while (substr($wrote, 0, 7) eq '=fetch ') {    # [C19] a request of the page while it is read (an external script), before its first list: answered as one after it, within the same $PAGE_SECONDS, and counted in the same $LIVE_FETCH_MOST of its life
            $early //= { page => $page, keeper => $feeder, relay => $relay, from => $from_page, hold => $hold, looked => 0, url => $url, host => (address($url))[1] // '', fetches => 0 };
            $early->{held} = $wrote;
            my $asked = live_asked($early) or last;    # not all there yet
            live_fetched($early, $asked);
            return (undef, 'ended') if $early->{ended};    # a request of no form, or a reply the page did not take: it is ended as a page kept running is (sub live_end)
            ($wrote, $looked) = ($early->{held}, 0);
        }
        $ready_at = index($wrote, "\n=ready\n", $looked > 7 ? $looked - 7 : 0);    # a line no list holds: every line of a list begins with a letter, or is "=page" and the lines of its head
        $looked = length $wrote;
        last if $ready_at >= 0;
    }
    if ($ready_at >= 0 && length $wrote <= $PAGE_BYTES) {    # the page is kept running: its first list, and what it wrote after "=ready" is the beginning of its next answer
        return (substr($wrote, 0, $ready_at + 1), undef, { page => $page, keeper => $feeder, relay => $relay, from => $from_page, hold => $hold, held => substr($wrote, $ready_at + 8), looked => 0, wide => $VIEW[0], until => now() + $LIVE_SECONDS, bytes => length($wrote) - $ready_at - 8, waiting => 0, focus => 0, url => $url, fetches => $early ? $early->{fetches} : 0, heard => now() });
    }
    kill 'KILL', $feeder, $page;
    waitpid $_, 0 for $feeder, $page;
    return (undef, 'late') if $open && length $wrote <= $PAGE_BYTES;
    return (undef, 'large') if length $wrote > $PAGE_BYTES;
    return ($wrote);
}

# The keeper: the second process of a page, a copy of lzrprf itself. It
# waits for one byte, lzrprf's word that the system called the application
# contained, and only then hands the answer over. After that, and while it
# hands over, it waits for one thing more: the end of lzrprf. The pipe it
# reads has its other end in lzrprf alone, so it runs dry when lzrprf ends,
# by whatever way, also when lzrprf is killed and can end nothing itself.
# Then the keeper ends the application and itself. Without it an application
# that sleeps would stay, in its container, after lzrprf was killed. While
# lzrprf lives, lzrprf ends the keeper before it lets go of the application's
# number, so the keeper never acts on a number the system gave to another
# process; after lzrprf's end it acts at once, on a number the system gives
# away only once the application has ended and been cleared away, which is
# the one moment this cannot rule out. An application that does not read
# changes nothing: the keeper never waits in a write.
# The keeper of a page kept running has one pipe more, the relay ($input),
# whose other end only lzrprf holds: what lzrprf writes there it hands on
# after the answer, in the same way, and it keeps the application's input
# open until the relay ends. It holds at most $LIVE_HELD bytes that are not
# handed on yet and reads no more until they are, so lzrprf, which writes
# without waiting, finds the relay full and ends the page.
sub keeper {
    my ($held, $to, $data, $page, $input) = @_;
    $SIG{PIPE} = 'IGNORE';                # an application that closes what it reads does not end its keeper
    my $over = sub { kill 'KILL', $page; POSIX::_exit(0) };
    my ($word, $go, $sent) = ('', undef, 0);
    do { $go = sysread($held, $word, 1) } until defined $go || !$!{EINTR};
    $over->() unless $go;                 # lzrprf ended, or ended this page, before the system said that the application is contained
    fcntl($to, POSIX::F_SETFL(), O_NONBLOCK) or $over->();
    while (1) {
        if ($to && $sent >= length $data && !$input) { close $to; undef $to }    # all of the answer is handed over, and of a page kept running the relay has ended: what the application reads ends here
        my ($read, $write) = ('', '');
        vec($read, fileno $held, 1) = 1;
        vec($read, fileno $input, 1) = 1 if $input && length($data) - $sent < $LIVE_HELD;
        vec($write, fileno $to, 1) = 1 if $to && $sent < length $data;
        select($read, $write, undef, undef) > 0 or next;
        if (vec($read, fileno $held, 1)) {
            my $more = sysread($held, $word, 1);
            $over->() if defined $more ? !$more : !$!{EINTR};    # nothing more to read: lzrprf is gone
        }
        if ($input && vec($read, fileno $input, 1)) {
            my $more = sysread($input, my $lines, 4096);
            if ($more) { substr($data, 0, $sent, ''); $sent = 0; $data .= $lines }    # what was handed on already is let go
            elsif (defined $more || !$!{EINTR}) { undef $input }    # lzrprf closed the relay ("=end" is in it): what is held is handed on, then the input ends
        }
        next unless $to && vec($write, fileno $to, 1);
        my $left = length($data) - $sent;
        my $took = syswrite($to, $data, $left > 65536 ? 65536 : $left, $sent);
        if (defined $took) { $sent += $took } elsif (!$!{EINTR} && !$!{EAGAIN}) { $sent = length $data }    # the application reads no more: the rest is not handed over
    }
}

# What the application may write, and nothing else: a first line that names
# the other hosts the page asks for, its =pictures, =sheets and =statement lines (sub stated), and then lines of five kinds, or a laid page.
#
#   U<kind><s><name>   a thing the application says the page is made of; <s> is + when it says its own code supports the thing and - when not; a tab and a version may follow
#   P<style><depth>    a paragraph begins: plain, heading 1 2 3, list item, quote, code, rule; how far it is set in, 0 to 9
#   T<looks><text>     text in that paragraph; one letter says bold, italic, fixed width, and coloured as a link
#   B                  a line ends
#   I<wide>x<high>     a grey box where a picture would stand, 8 to 640 wide and 8 to 480 high
#
# None of the five can carry an address to fetch, a program, a picture or a
# command: a link is a colour, a picture is a size. A list with any other
# line in it is not drawn at all. The lines of the first kind stand before
# every other, at most 120 of them: one of eight letters for the kind
# (document, CSS, JavaScript, libraries, media and formats, web APIs,
# security and transport, metadata), a + or a - for whether the application
# says its own code supports the thing, a name of 1 to 60 plain characters,
# and after a tab a version of 1 to 30, neither with a space at either end.
# They come in the order of the kinds and by name within a kind, and no name
# twice in a kind, so a list has one form only. They are what the
# application says, of the page and of itself: lzrprf checks their form, not
# whether they are true, and the window shows them as text in a pane of
# their own under the page.
# Or, after the first kind, a laid page: one line L and then rectangles, runs
# of text, grey boxes and pictures where the application laid them out (see
# "sub laid"). A picture or a tile there is pixels, checked to be exactly as
# many bytes as it says; it carries no address and no command either.
# In the text, every character that would
# act on the display instead of being displayed (a control code, an invisible
# mark, a mark that turns the reading direction) is replaced by the
# replacement mark before the window is given it.                        # [C9]
# What the window is spared. The window lays text out with the system's own
# code, and that code is not linear: measured on the real window, unseen, one
# block of 100,000 characters outside the first font (an emoji, Devanagari,
# Arabic) kept it busy for more than a minute, and so did one letter under
# 20,000 marks, one chain of 10,000 letters joined by a joining sign, and
# words of 20,000 Devanagari letters. A list of 200,000 lines took 17
# seconds. So a page may hold $PIECES lines and $PAGE_BYTES bytes and a block
# $BLOCK characters as the application wrote them: more is not a page. And
# two things are changed in a text, as a control character in it is changed.
# No more than $HUNG characters in a row hang on the one before them: the next
# one becomes U+FFFD, which nothing joins, and the row begins again. What
# hangs is what Unicode joins to the character before it (a mark, a character
# that extends a cluster or is spaced like a mark, a Hangul vowel or final, a
# Hangul initial after another), what follows a character that comes before
# its letter, and what follows a sign that joins two letters into one (and a
# mark after that sign), which Unicode 13, the version this Perl knows, does
# not join and the system does. And no more than $WORD characters stand in a
# row with no place where a line may end: there lzrprf puts in a space of no
# width (U+200B), which shows nothing and lets a line end. A no-break space
# is no such place. The application cannot write U+200B itself, it is one of
# those replaced above. It is put after all the characters that hang on the
# last one; a word that ends in them keeps them, so no mark is parted from
# its letter and no joined letter from its sign. Both are counted over the end
# of a line of text, because the window sets one line after the other. A text
# you copy out of the window holds those spaces. selftest draws the heaviest
# pages of each kind that was measured slow in the real window and takes the
# time; that is a measurement, and a text of a kind nobody tried may be slow.
sub unhung {                              # (the row the text before ended with, and the character before it; a line of text): the line with no row longer than $HUNG, and the row it ends with
    my ($row, $line) = @_;
    my $both = $row . substr($line, 2);
    $both =~ s/((?:$HANGS){$HUNG})$HANGS/$1\x{fffd}/g;
    my ($ends) = (length($both) > $HUNG + 3 ? substr($both, -$HUNG - 3) : $both) =~ /(.(?:$HANGS)*|(?:$HANGS)*)\z/s;    # with the character before the row: whether the next one hangs can depend on it
    return (substr($line, 0, 2) . substr($both, length $row), $ends);
}

sub parted {                              # (how many characters the word before the line has, and its last two; a line of text): the line with no word longer than $WORD, and the same of its last word
    my ($had, $tail, $line) = @_;
    my $both = 'x' x ($had - length $tail) . $tail . substr($line, 2);    # the last two as they are: whether a character hangs can depend on them
    $both =~ s/(?:\G|(?<!$SOLID))((?:$SOLID){$WORD}(?:$HANGS){0,$HUNG})(?!$HANGS)(?=$SOLID)/$1\x{200b}/g if length($both) > $WORD;    # only from the beginning of a word or the last space put in, so every word is read once
    my ($ends) = reverse(length($both) > $WORD + $HUNG ? substr($both, -$WORD - $HUNG) : $both) =~ /^($SOLID*)/;    # read from the end: a search for the last word from the front would try every place
    my $word = length($ends) < $WORD ? length $ends : $WORD;    # a word that ended in what hangs may be longer: counted as $WORD, so a space put in later is never put into the stand-in above
    return (substr($line, 0, 2) . substr($both, $had), $word, $word < 2 ? substr($both, -$word, $word) : substr($both, -2));
}

sub checked {
    my ($wrote) = @_;
    no warnings 'utf8';
    return unless utf8::decode($wrote) && $wrote =~ s/\n\z//;
    my ($first, @lines) = split /\n/, $wrote, -1;
    return unless defined $first && $first =~ /^=page((?: $NAME){0,200})$/ && @lines <= $PIECES;
    my @hosts = split ' ', $1;
    $TITLED = '';
    if (@lines && $lines[0] =~ /^=title/) {    # the page's title, shown in its tab and nowhere else: one line of 1 to $TITLE characters; what would act on the display instead of being shown is taken out
        my ($title) = shift(@lines) =~ /^=title (.{1,$TITLE})\z/s or return;
        $title =~ s/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]//g;
        $title =~ s/^[ \p{M}]+| +$//g;    # and a mark with no letter before it, which would hang on the tab's own drawing
        utf8::encode($title);
        $TITLED = $title;
    }
    my @paths;
    if (@lines && $lines[0] =~ /^=pictures/) {    # the pictures the page names: on its own host by path alone, on a name under it as https://, a host by name and a path [C9]; of which host each may be is held where it is fetched (sub pictured)
        return unless shift(@lines) =~ m{^=pictures((?: (?:https://$NAME)?/[A-Za-z0-9._~/%?=&,-]{0,511}){1,$PICTURES})$};
        @paths = split ' ', $1;
    }
    my @sheets;
    if (@lines && $lines[0] =~ /^=sheets/) {    # [C14] the style sheets the page names on its own host, by path alone, as its pictures are
        return unless shift(@lines) =~ m{^=sheets((?: /[A-Za-z0-9._~/%?=&-]{0,511}){1,$SHEETS})$};
        @sheets = split ' ', $1;
    }
    my ($said, $boxes, $made, $block, $row, $word, $tail, $before, $begun) = ((stated(\@lines) // return), 0, 0, 0, '', 0, '');    # the words of the one =statement line, '' for none; a malformed one makes the page unfit
    for (@lines) {
        if (!$begun && /^U([dcjlmasx])[+-]([\x21-\x7e](?:[\x20-\x7e]{0,58}[\x21-\x7e])?)(?:\t[\x21-\x7e](?:[\x20-\x7e]{0,28}[\x21-\x7e])?)?$/) {    # only plain characters, so nothing in such a line acts on the display
            my $key = index('dcjlmasx', $1) . $2;
            return unless ++$made <= $MADE && (!defined $before || $before lt $key);    # in the one order there is, and none twice
            $before = $key;
            next;
        }
        return laid(\@lines, \@hosts, $made, \@paths, $said, \@sheets) if !$begun++ && /^L/;    # from the first line of another kind on, a line that begins with U is no line at all; and that first line says whether the page is laid
        if (/^T[\@-O]./s) {
            s/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]/\x{fffd}/g;    # the last: a number above every character there is, which Perl would pass on and the window could not read
            return unless ($block += length($_) - 2) <= $BLOCK;    # counted as the application wrote it, before anything is put in below
            ($_, $row) = unhung($row, $_) if $row ne '' || /$HANGS/;
            ($_, $word, $tail) = parted($word, $tail, $_);
            next;
        }
        ($row, $word, $tail) = ('', 0, '');   # a row of hanging characters and a word end with the text they are in: at a break, a box, a new block
        if (/^I([0-9]{1,3})x([0-9]{1,3})$/) { return unless $1 >= 8 && $1 <= 640 && $2 >= 8 && $2 <= 480 && ++$boxes <= $BOXES && ($block += $BOX) <= $BLOCK }
        elsif ($_ eq 'B') { return unless ++$block <= $BLOCK }
        else { return unless /^P[p123lqcr][0-9]$/; $block = 0 }
    }
    utf8::encode($_) for @lines;
    return (\@lines, \@hosts, \@paths, $said, \@sheets);
}

# A laid page. The application has laid the page out itself and says where
# everything stands, in CSS pixels, on a page of a width and a height it
# names in one line L<width>x<height> right after what the page is made of.
# Then, in the order they are painted:
#
#   R<x>,<y>,<w>,<h>,<rrggbbaa>             a filled rectangle in that colour
#   X<x>,<y>,<size>,<looks>,<rrggbb>,<text> a run of text whose baseline begins at x,y; <looks> as in T
#   G<x>,<y>,<w>,<h>                        a grey box where a picture would stand
#   M<x>,<y>,<w>,<h>,<pw>,<ph>              a picture of pw by ph pixels shown in that box, given by
#   m<base64>                               exactly ph lines after it, one row each: pw times four
#                                           bytes, red, green, blue and how opaque, as pixels already
#   I<x>,<y>,<w>,<h>,<n>                    the picture of the nth path in =pictures (from 0), scaled
#                                           into that box; lzrprf fetches it and gives the window an M
#                                           in its place, or a G when there is no picture (sub pictured)
#   K<n>,<x>,<y>,<w>,<h>                    tile n, 0 to 31, each once, at a corner of the grid of 256: w and h are
#                                           256, or what is left of the page there; exactly h lines follow, one row
#   n<base64>                               each: w times three bytes, red, green and blue, with no "=" at the end;
#                                           a tile is opaque, the application paints white under everything
#   J<n>,<x>,<y>                            tile n of a K above, placed again at a corner where it is cut the same
#
# Numbers are written in one way only, without a sign or a 0 in front, and
# everything stands inside the page. A page is laid or flowing, never both.
# A run of text gets the changes a text gets: a control or format character
# becomes U+FFFD, and so does the 31st character in a row that hangs on the
# one before it, counted in that run alone, since each run is set by itself.
# No space of no width is put in: a run is drawn on one line, where no line
# ends, and it is 2000 characters at most, a tenth of the word that was
# measured slow. A picture is bytes and no file: the window has no decoder
# to give it to, it puts the bytes into the pixels as they are. A row of a
# tile is not decoded here: w times three bytes are exactly 4w characters of
# base64 with no "=", and every text of that alphabet and that length is the
# one form of its bytes, so its length and its alphabet are its whole check.
my $N = qr/(0|[1-9][0-9]{0,5})/;          # a number in its one form
sub laid {
    my ($lines, $hosts, $from, $paths, $said, $sheets) = @_;
    no warnings 'utf8';
    my ($wide, $high) = $lines->[$from] =~ /^L${N}x$N$/ or return;
    return unless defined $LAID_WIDE && $wide == $LAID_WIDE && $high >= 1 && $high <= 200_000;    # laid at the width its =view frame asked for, and at no other
    my ($text, $pixels, $rows, $row_bytes, $row_chars, %count, %tile) = (0, 0, 0, 0, 0);    # $row_chars: how long a row of the tile above is, 0 under a picture
    my $inside = sub { my ($x, $y, $w, $h) = @_; return $w >= 1 && $h >= 1 && $x + $w <= $wide && $y + $h <= $high };
    my $cut = sub { my ($x, $y) = @_; return $x % 256 || $y % 256 || $x >= $wide || $y >= $high ? '' : ($wide - $x < 256 ? $wide - $x : 256) . ',' . ($high - $y < 256 ? $high - $y : 256) };    # the one size a tile has at a corner of the grid, or '' for no corner
    for (@$lines[$from + 1 .. $#$lines]) {
        if ($rows) {                      # a row of the picture or the tile above: in base64, exactly as long as it is wide
            if ($row_chars) { return unless length($_) == $row_chars && /\An[A-Za-z0-9+\/]+\z/ }    # a tile's row n, never m
            else {                        # a picture's row m, never n
                my ($code) = /^m([A-Za-z0-9+\/]+={0,2})$/ or return;
                my $bytes = decode_base64($code);
                return unless length($bytes) == $row_bytes && encode_base64($bytes, '') eq $code;    # written back the same: one form only, no byte more or less
            }
            $rows--;
            next;
        }
        my ($kind) = /^([RXGMIKJ])/ or return;
        return unless ++$count{$kind} <= $LAID{$kind};
        if ($kind eq 'R') { return unless /^R$N,$N,$N,$N,[0-9a-f]{8}$/ && $inside->($1, $2, $3, $4) }
        elsif ($kind eq 'G') { return unless /^G$N,$N,$N,$N$/ && $inside->($1, $2, $3, $4) }
        elsif ($kind eq 'I') { return unless /^I$N,$N,$N,$N,$N$/ && $inside->($1, $2, $3, $4) && $5 < @$paths }
        elsif ($kind eq 'M') {
            return unless /^M$N,$N,$N,$N,$N,$N$/ && $inside->($1, $2, $3, $4) && $5 >= 1 && $5 <= 1024 && $6 >= 1 && $6 <= 1024 && ($pixels += $5 * $6) <= $PIXELS;
            ($rows, $row_bytes, $row_chars) = ($6, $5 * 4, 0);
        } elsif ($kind eq 'K') { return unless /^K$N,$N,$N,$N,$N$/ && $1 < $LAID{K} && !exists $tile{$1} && ($tile{$1} = $cut->($2, $3)) eq "$4,$5"; ($rows, $row_chars) = ($5, 1 + 4 * $4) }    # a tile is not counted in $PIXELS: 32 at most is its bound
        elsif ($kind eq 'J') { return unless /^J$N,$N,$N$/ && defined $tile{$1} && $tile{$1} eq $cut->($2, $3) }
        else {
            my ($head, $x, $y, $size, $chars) = /^(X$N,$N,$N,[\@-O],[0-9a-f]{6},)(.{1,$RUN_TEXT})\z/s or return;
            return unless $x < $wide && $y <= $high && $size >= 6 && $size <= 96 && ($text += length $chars) <= $ALL_TEXT;
            $chars =~ s/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]/\x{fffd}/g if $chars =~ /[^\x20-\x7e]/;    # as in T; printable ASCII is never replaced, so it is not searched
            $chars = substr((unhung('', "  $chars"))[0], 2) if $chars =~ /[^\x20-\x7e]/ && $chars =~ /$HANGS/;    # no printable ASCII character hangs
            $_ = $head . $chars;
        }
    }
    return if $rows;                      # a picture with rows missing
    utf8::encode($_) for @$lines;
    return ($lines, $hosts, $paths, $said, $sheets);
}

# The pictures of a laid page. A page may name up to $PICTURES of them, each
# a path on its own host or a full address https://HOST/PATH on a name under
# that host (sub under): no other site is asked for a picture, whatever the page
# names, so a page cannot make lzrprf tell a third party that you are here; each
# one a place I of the page draws is fetched once, the way the page was: its
# line in the log first, then "fetch", so a site is sent "request" of the
# picture's address and nothing else. At most $PICTURES_AT_ONCE are fetched
# and decoded side by side, each in a process of its own that writes nothing
# to the log: lzrprf writes every line itself. A path goes to the same checked
# addresses the page came from. A name under the host is checked as a typed address is
# (sub address), its line is written before it is looked up, and a host that
# leads inside your own network is not fetched at all, with no question: a
# page cannot make lzrprf ask you about your router. The application decodes it, in a
# page container of its own started as a page's is, and writes pixels:
#
#   P<w>,<h>      then exactly h lines p<hex>, 8 times w lowercase hex characters each:
#                 red, green, blue and how opaque, a byte each, not multiplied by it;
#                 1 to 1024 wide and high, 200,000 pixels at most; or P0,0 for none
#
# Anything else is no picture, and so is a picture not begun within one clock
# of $PICTURE_SECONDS for them all. Each place I becomes, for the window, an M
# with its rows in base64, the form of a picture a laid page already has, or
# the G it would be without one. This does not widen what the window reads:
# the window has no decoder for a file of a site, and every byte of an M and
# its rows was written by lzrprf from numbers and hex it checked here, so the
# window is given nothing it was not given before. Returns the lines for the
# window, how many pictures were fetched and how many were asked for, and the
# pictures decoded, by number, which a new width places again; or nothing
# when a line of the log could not be written.
sub pictured {
    my ($lines, $paths, $host, $where, $kept, $decoded) = @_;    # $decoded: the pictures of this page decoded before, by their entry in =pictures; given when it is laid out again, and then nothing is fetched (sub relaid)
    my %wanted = map { /^I\d+,\d+,\d+,\d+,(\d+)$/ ? ($paths->[$1] => 1) : () } @$lines;    # by entry: at another width the page may choose other sources, and an entry decoded then is placed again
    @PICTURED = ();
    return ($lines, 0, 0, {}) unless %wanted;
    my %picture = $decoded ? %$decoded : ();
    if (!$decoded) {
        open my $request, '>>', "$DIR/busy" or return;
        flock $request, LOCK_SH or return;    # as in visit: no line of these requests falls into a clearing of the log
        my ($until, $n, $lost, %running) = (now() + $PICTURE_SECONDS, 0, 0);    # %running: each picture fetched now, by the number fork gave for it: its entry, its address, what it said so far, its pipe
        my @waiting = grep { $wanted{$_} } do { my %once; grep { !$once{$_}++ } @$paths };    # in the page's order
        while (!$lost && alive() && (%running || @waiting && now() < $until)) {
            while (!$lost && @waiting && keys(%running) < $PICTURES_AT_ONCE && now() < $until) {    # a picture not begun within the clock is not begun
                my $entry = shift @waiting;
                $n++;
                my ($url, $there) = $entry =~ m{^/} ? ("https://$host$entry") : address($entry);    # a name under the host: checked as a typed address is
                next unless defined $url;
                if (defined $there && $there ne $host && !under($there, $host)) { record("$url not fetched: $there is another site than $host, and a page's picture is fetched from its own host and the names under it alone", $kept) or $lost = 1; next }    # [C4] nothing is looked up, nothing is asked
                my $to = $where;
                if (defined $there && $there ne $host) {
                    record("the page $host names a picture on $there: $url", $kept) or ($lost = 1, last);    # [C5] before the name is even looked up
                    my $why;
                    ($to, $why) = $TOR_WANTED ? tor_where($there) : find($there);
                    if ($to && grep { $_->{own} } @$to) { ($to, $why) = (undef, "$there leads inside your own network (" . join(', ', map { $_->{text} } @$to) . '), where no picture is fetched') }    # [C8] never for a picture, and nothing is asked
                    if (!$to) { record("$url not fetched: $why", $kept) or $lost = 1; next }
                    push @PICTURED, $there unless grep { $_ eq $there } @PICTURED;
                }
                record("$url -> lzrprf connects " . ($TOR_WANTED ? 'through Tor, one circuit for ' . ($there // $host) : 'to the first that answers of: ' . join(', ', map { $_->{text} } @$to)), $kept) or ($lost = 1, last);    # [C5] written down first, connected second
                busy("Fetching picture $n of the page: $url");
                pipe(my $from_run, my $to_lzrprf) or next;
                my $run = fork // next;
                if (!$run) {                    # fetched and decoded beside up to three others; what it says goes to lzrprf alone, which writes the log
                    close $from_run;
                    $RUN = getppid();           # it goes on while lzrprf does, and lzrprf ends it when the window is gone
                    my ($got, $why, $from) = fetch($url, $to);    # [C6] [C7]
                    my ($wrote) = $why ? () : contained($url, $got);    # [C1] [C3] no frame of style sheets: a picture run
                    print $to_lzrprf join("\t", defined $wrote ? 1 : 0, length($got // ''), $from // '', $why // ''), "\n", $wrote // '';
                    close $to_lzrprf;
                    POSIX::_exit(0);
                }
                close $to_lzrprf;
                $running{$run} = [$entry, $url, '', $from_run];
            }
            last if $lost || !%running;
            my $read = '';
            vec($read, fileno $_->[3], 1) = 1 for values %running;
            select($read, undef, undef, 1) > 0 or next;
            for my $run (grep { vec($read, fileno $running{$_}[3], 1) } keys %running) {
                my $one = $running{$run};
                my $came = sysread($one->[3], $one->[2], 262144, length $one->[2]);
                next if defined $came ? $came && length $one->[2] <= $PAGE_BYTES + 1000 : $!{EINTR} || $!{EAGAIN};    # a read a signal broke off is tried again
                delete $running{$run};    # it has said all it says
                close $one->[3];
                waitpid $run, 0;
                my ($head, $wrote) = split /\n/, $one->[2], 2;
                my ($decoded, $length, $from, $why) = split /\t/, $head // '', 4;
                $why = 'the request could not be made' unless defined $from && ($length // '') =~ /^\d+$/;
                record("$one->[1] " . (length $why ? "failed: $why" : "answered: $length bytes from $from"), $kept) or ($lost = 1, last);
                $picture{ $one->[0] } = pixels($wrote) if !length $why && $decoded && defined $wrote;    # [C9]
            }
        }
        kill 'KILL', keys %running;     # the window is gone or a line could not be written: what still runs is ended, each by the number fork gave
        waitpid $_, 0 for keys %running;
        close $request;
        return if $lost;
    }
    my ($drawn, @shown) = (0);
    for (@$lines) {
        my ($x, $y, $w, $h, $n) = /^I(\d+),(\d+),(\d+),(\d+),(\d+)$/ or (push(@shown, $_), next);
        my $one = $picture{ $paths->[$n] };
        if ($one && ($drawn += $one->[0] * $one->[1]) <= $DRAWN_PIXELS) { push @shown, "M$x,$y,$w,$h,$one->[0],$one->[1]", map { "m$_" } @$one[2 .. $#$one] }
        else { push @shown, "G$x,$y,$w,$h" }
    }
    return (\@shown, scalar(grep { $picture{$_} } keys %wanted), scalar(keys %wanted), \%picture);
}

# Whether a host is a name under a page's host: the page's host with "www."
# taken off, a dot before it, and one name or more in front. Only who holds a
# name can give out the names under it, so a picture there comes from the site
# you visit and from no third party. [C4]
sub under {
    my ($there, $host) = @_;
    my $own = $host =~ s/^www\.//r;
    return $own =~ /\./ && length $there > length($own) + 1 && substr($there, -length($own) - 1) eq ".$own";
}

# A size of the window's page: "view", its width and its height in points,
# each a number in its one form. The page is never laid at the window's own
# size, which differs from one computer to the next and would tell a site who
# you are: the width is taken to the nearest step of 160 points and the height
# to the nearest step of 128, so every window of about that size lays every
# page at one of a few sizes, the same on every computer, and the window fits
# the laid page to itself (function fit). A size outside the bounds a page is
# laid in is taken as the nearer bound. Anything else is no size. Returns
# whether the line was one.
my @VIEW_STEP = (160, 128);
sub viewing {
    my ($event) = @_;
    my ($wide, $high) = $event =~ /^view ([1-9][0-9]{0,4}) ([1-9][0-9]{0,4})$/ or return;
    ($wide, $high) = map { my $step = $VIEW_STEP[$_]; $step * int(($_ ? $high : $wide) / $step + 0.5) } 0, 1;
    @VIEW = ($wide < $VIEW_WIDE[0] ? $VIEW_WIDE[0] : $wide > $VIEW_WIDE[1] ? $VIEW_WIDE[1] : $wide, $high < $VIEW_HIGH[0] ? $VIEW_HIGH[0] : $high > $VIEW_HIGH[1] ? $VIEW_HIGH[1] : $high);
    return 1;
}

# The page shown, laid out again at the width the window's page has now: the
# same answer and the same frame of style sheets that were kept when it was
# shown, in a page container as every run. Nothing is fetched and nothing is
# written to the log, since nothing reaches a site. Its pictures are the ones
# decoded then, placed where the new layout puts them; a place no picture was
# decoded for stays a grey box. One run at a time: what the window says while
# it runs waits in its pipe, and before each run every size said so far is
# read, the latest kept, and the rest of what was said is heard after, in its
# order. A run that is unfit, late or too large, or a second run that names
# style sheets again, leaves the page as it is shown, scaled by the window;
# that width is not tried again until another is said. The window keeps the
# place it was read at, as a share of the page's height ("relaid").
sub relaid {
    while ($SHOWN && $SHOWN->{wide} != $VIEW[0] && alive()) {
        if ($FROM) {
            my @later;
            while (defined(my $more = hear(0))) { last if $more eq ''; push @later, $more unless viewing($more) }
            push @HELD, @later;
            last if $SHOWN->{wide} == $VIEW[0];    # the latest size is the width shown already
        }
        $SHOWN->{wide} = $VIEW[0];
        my $kept = live_of($TABS[$TAB]);
        if ($kept && $kept->{wide} == $VIEW[0] && $kept->{shown}) { window("relaid $TAB", @{ $kept->{shown} }, '.'); $kept->{unsent} = 0; $DRAWN = 1; next }    # the page kept running was laid at this width: its last drawing, as its scripts left it, and nothing is laid out
        my @again = laid_out($SHOWN->{url}, $SHOWN->{got}, $SHOWN->{frame}, 1);
        if (!$again[0] || $SHOWN->{two} && @{ $again[4] }) { live_dropped($again[5]); next }    # not shown: the page as it is shown stays, and so does the run kept running with it
        my ($shown) = pictured($again[0], $again[2], $SHOWN->{host}, undef, undef, $SHOWN->{pictures});
        window("relaid $TAB", @$shown, '.');
        $SHOWN->{list} = $shown;
        $DRAWN = 1;
        live_end($kept, 'it was laid out anew at another width', 1) if $kept;    # the new run is the page kept running now, laid at the width shown
        live_kept($again[5], $TABS[$TAB], $again[0], $again[2], $SHOWN->{host}, $SHOWN->{pictures}, $shown) if $again[5];
    }
    live_told();
}

# The tabs. The window shows them in a strip of lzrprf's own above the bar,
# where no page draws, and says which you chose in one of three lines: "tab
# new", "tab select N" and "tab close N", N a tab that is there, in its one
# form; a fourth, "tab move FROM TO", moves a tab among the others (sub tab_moved). Each tab keeps its own page as $SHOWN keeps it (its address, its
# answer, the frame of style sheets it was laid with, its decoded pictures),
# its title, the addresses it went to, and lzrprf's last words in it. Only the
# selected tab's page is shown: choosing another clears the page and lays the
# chosen tab's page out again from what it kept, at the window's width (sub
# relaid), so nothing is fetched and nothing is written to the log. At most
# $TABS_MOST tabs; closing the last one leaves one empty tab. A new tab opens
# the home page when one is set, and is empty otherwise. After every such
# line lzrprf tells the window all the tabs again: "tabs COUNT SELECTED" and a
# line "title N TEXT" for each, the text checked by sub checked.
sub tabbed {
    my ($how, $n, $kept, $pulled) = @_;
    $TABS[$TAB]{shown} = $SHOWN;
    my $opened;
    if ($how eq 'new' && !defined $n && @TABS < $TABS_MOST) { push @TABS, fresh_tab(); $TAB = $#TABS; $opened = 1; noted('you opened a new tab') }
    elsif ($how eq 'select' && defined $n && $n < @TABS) { $TAB = $n }
    elsif ($how eq 'close' && defined $n && $n < @TABS) {
        my $live = live_of($TABS[$n]);
        live_end($live, 'its tab was closed') if $live;
        noted(($pulled ? 'you pulled a tab out into a new window' : 'you closed a tab') . (length($TABS[$n]{url} // '') ? ": $TABS[$n]{url}" : ''));
        my ($gone) = splice @TABS, $n, 1;
        closed_kept($gone, $n) unless $pulled;
        @TABS = (fresh_tab()) unless @TABS;
        $TAB-- if $TAB > $n || $TAB > $#TABS;
    }
    $SHOWN = $TABS[$TAB]{shown};
    tab_shown($how eq 'new' && !$opened ? "A window holds $TABS_MOST tabs at most: close one to open another." : undef, $how eq 'select' && $kept);
    my $home = $opened && home();
    go($home, 'you opened your home page') if $home;    # [C4] the address kept from the bar when you made it the home page
}

# A closed tab, kept for "Reopen Closed Tab" (Cmd-Shift-T) with its place: at most $CLOSED_MOST, the
# newest first, in the memory of this process and nowhere else, so an incognito window writes
# nothing for them either. Only the $CLOSED_DRAWN newest keep their page; an older one keeps its
# address, title and history, and is visited again when reopened. A tab with no address is not kept.
sub closed_kept {
    my ($tab, $at) = @_;
    return unless length($tab->{url} // '');
    unshift @CLOSED, [$at, $tab];
    splice @CLOSED, $CLOSED_MOST if @CLOSED > $CLOSED_MOST;
    $_->[1]{shown} = undef for @CLOSED[$CLOSED_DRAWN .. $#CLOSED];
}

# "tab reopen": the tab closed last, put in again at its old place (or last, when fewer tabs stand
# now) and chosen, with its page when lzrprf still has it, laid out again at the window's width
# when it was kept at another (sub relaid); else its address is visited, written in the log first.
sub tab_reopened {
    my $one = shift @CLOSED or return idle('No closed tab to reopen in this window.');
    if (@TABS >= $TABS_MOST) { unshift @CLOSED, $one; return idle("A window holds $TABS_MOST tabs at most: close one to reopen another.") }
    my ($at, $tab) = @$one;
    $TABS[$TAB]{shown} = $SHOWN;
    $at = @TABS if $at > @TABS;
    splice @TABS, $at, 0, $tab;
    $TAB = $at;
    $SHOWN = $tab->{shown};
    noted("you reopened a closed tab $tab->{url}") if $SHOWN;    # the same line "sub go" writes for one that is visited again
    tab_shown();
    go($tab->{url}, 'you reopened a closed tab') unless $SHOWN;    # [C4] an address this tab went to already
}

# The lists sent for the tabs' pages are kept for the $LISTS_KEPT tabs shown last, so a tab chosen
# again is sent its drawing and the application is not run; the others are laid out again when chosen.
# A list holds its pictures as text, so this bounds what lzrprf holds for tabs nobody looks at.
sub lists_bounded {
    my @kept = sort { $b->{used} <=> $a->{used} } grep { $_ && $_->{list} } map { $_ == $TAB ? $SHOWN : $TABS[$_]{shown} } 0 .. $#TABS;
    delete $_->{list} for @kept[$LISTS_KEPT .. $#kept];
}

# A tab dragged along the strip: "tab move FROM TO" takes the tab at FROM out and puts it in at TO,
# both tabs that are there. The selected tab stays the selected one, wherever it now stands, and its
# page stays shown: nothing is laid out again, nothing fetched, nothing written. The window is told
# the tabs again, as after every line of the strip.
sub tab_moved {
    my ($from, $to) = @_;
    return if $from >= @TABS || $to >= @TABS || $from == $to;
    my $chosen = $TABS[$TAB];
    my ($one) = splice @TABS, $from, 1;
    splice @TABS, $to, 0, $one;
    ($TAB) = grep { $TABS[$_] == $chosen } 0 .. $#TABS;
    window('tabs ' . @TABS . " $TAB", map { "title $_ $TABS[$_]{title}" } 0 .. $#TABS);
}

# A tab is shown at once, and the application is not run for it when its drawing was kept: the
# window shows the drawing it kept itself when it says "kept", and nothing of the page is sent; else
# lzrprf sends the list it kept, when it was laid at the width the window has now. Only a page kept
# at another width, or one whose list was let go (sub lists_bounded), is laid out again (sub relaid),
# with the page of the tab before cleared first. A page kept running that drew again while its tab
# was not shown is sent its new drawing.
sub tab_shown {
    my ($says, $kept) = @_;
    my $tab = $TABS[$TAB];
    window('tabs ' . @TABS . " $TAB", map { "title $_ $TABS[$_]{title}" } 0 .. $#TABS);
    window("address $tab->{url}");
    my $live = live_of($tab);
    my $list = $live && $live->{shown} && $live->{wide} == $VIEW[0] ? $live->{shown} : $SHOWN && $SHOWN->{list} && $SHOWN->{wide} == $VIEW[0] ? $SHOWN->{list} : undef;
    $DRAWN = 0;
    if ($kept && $SHOWN) { if ($live && $live->{unsent} && $list && $list == $live->{shown}) { window("relaid $TAB", @$list, '.'); $DRAWN = 1 } }    # the window's own drawing stands; a page kept running that drew meanwhile is sent, read where it was
    elsif ($list) { window("page $TAB", @$list, '.'); $DRAWN = 1 }
    else { window("page $TAB", '.'); $SHOWN->{wide} = 0 if $SHOWN }    # the page of the tab before is gone; no width: sub relaid lays this one out again at the window's
    $live->{unsent} = 0 if $live && $DRAWN;
    if ($SHOWN) { $SHOWN->{used} = ++$LIST_USED; lists_bounded() }
    window($tab->{secure} ? ('secure begin', (map { "secure line $_" } @{ $tab->{secure} }), 'secure end') : 'secure none');
    nav_told();
    idle($says // $tab->{says} // 'A new tab. Type an address above and press Return.', defined $says ? undef : $tab->{brief});
}

# The cogwheel's menu, each item one line of the window. "menu clear-history"
# empties the addresses every tab went to; the pages shown stay, and the log
# is cleared by its own button and by nothing else (sub log_shown).
# "menu clear-sessions" does that and also drops every page lzrprf keeps for a
# tab, its answer and its pictures: all that lzrprf holds of what a site sent.
# lzrprf sends no cookie and keeps none [C7], so no site knows you again
# through it either way; the window warns, as asked, that pages would need a
# new login. "menu home" makes the selected tab's address the home page, when
# it is one lzrprf fetches (sub address), in one plain file of yours, home,
# one line, written beside it and then given its name. The window asks before
# a clearing; what it could do by itself is clear, and keep one address that
# came from the bar.
sub menu {
    my ($what) = @_;
    if ($what eq 'bookmarks-bar') {        # shown or hidden, kept in one plain file of yours, marksbar
        my $on = !marks_bar();
        if ($INCOGNITO) { $HELD_BAR = $on ? 1 : 0; window('marksbar ' . ($on ? 'on' : 'off')); return idle(($on ? 'The bookmarks bar is shown' : 'The bookmarks bar is hidden') . ' in this incognito window only: it writes nothing.') }    # [C16]
        unlink "$DIR/marksbar.new";
        return idle('The bookmarks bar could not be changed: its setting could not be written.') unless put("$DIR/marksbar.new", O_EXCL, $on ? 'on' : 'off') && rename("$DIR/marksbar.new", "$DIR/marksbar");
        synced();
        window('marksbar ' . ($on ? 'on' : 'off'));
        return idle($on ? 'The bookmarks bar is shown.' : 'The bookmarks bar is hidden.');
    }
    if ($what eq 'home') {
        return idle("$UNKEPT, so the home page was not changed.") if $INCOGNITO;    # [C16]
        my ($url) = address($TABS[$TAB]{url});
        return idle('No home page was set: this tab shows no address lzrprf fetches.') unless $url && length $TABS[$TAB]{url};
        unlink "$DIR/home.new";
        return idle('The home page could not be kept: its file could not be written. Nothing was changed.') unless put("$DIR/home.new", O_EXCL, $url) && rename("$DIR/home.new", "$DIR/home");
        synced();
        return idle("The home page is set: $url. A new tab and the next window open it.");
    }
    my $count = 0;
    $count += @{ $_->{visited} } for @TABS;
    @CLOSED = ();                          # the closed tabs hold the addresses they went to, and their pages
    @$_{qw(visited at)} = ([], -1) for @TABS;
    nav_told();
    window('history clear');               # the pages the bar suggests go with the history
    return idle("The history was cleared: $count " . ($count == 1 ? 'address' : 'addresses') . ' that the tabs went to. The pages shown stay. The log is cleared by its own button.') if $what eq 'clear-history';
    @$_{qw(url title shown says secure)} = ('', '', undef, undef, undef) for @TABS;
    my @live = @LIVE;
    live_end($_, 'the sessions were cleared') for @live;    # a page kept running holds what its site sent, too
    undef $SHOWN;
    tab_shown("The history and the sessions were cleared: $count " . ($count == 1 ? 'address' : 'addresses') . ', and every page lzrprf kept for a tab. lzrprf sends no cookie to any site, so no login was kept by it. The log is cleared by its own button.');
}

# Back, forward and reload: the addresses this tab went to, as sub visit keeps
# them, and where in them the tab stands. Back and forward visit the address
# before or after, reload the address in the bar, each with the checks every
# typed address gets [C4] and written in the log first, as "you went back to",
# "you went forward to" or "you reloaded". The window is told what each would
# do now: "nav BACK FORWARD RELOAD", each 1 or 0.
sub nav_told {
    my $tab = $TABS[$TAB];
    window(join ' ', 'nav', $tab->{at} > 0 ? 1 : 0, $tab->{at} >= 0 && $tab->{at} < $#{ $tab->{visited} } ? 1 : 0, length $tab->{url} ? 1 : 0);
}

sub navigated {
    my ($way) = @_;
    my $tab = $TABS[$TAB];
    return length $tab->{url} ? go($tab->{url}, 'you reloaded') : idle('This tab shows no address to load again.') if $way eq 'reload';
    my $to = $tab->{at} + ($way eq 'back' ? -1 : 1);
    return idle("There is no page to go $way to in this tab.") unless $tab->{at} >= 0 && $to >= 0 && $to <= $#{ $tab->{visited} };
    $tab->{at} = $to;
    go($tab->{visited}[$to], "you went $way to");
}

# Search. Words typed into the bar that are no address (no "://", and a space
# or no dot) go to the search address you chose, kept in one plain file of
# yours, search, one line: an https address lzrprf fetches with %s once where
# the words go, percent-encoded. Three are offered by name; any other is typed
# into the window's own modal. Nothing is sent before one is chosen: the
# window is told "search ask" and asks. The address made is a visit like a
# typed one [C4], written in the log first as "you searched with".

sub engine_fit {                          # a search address lzrprf takes: https, a host by its name, port 443, plain characters, %s exactly once
    my ($text) = @_;
    return unless $text =~ /\A[\x21-\x7e]{1,2000}\z/ && $text =~ m{\Ahttps://}i && (() = $text =~ /%s/g) == 1;
    return (address($text =~ s/%s/x/r))[0] ? $text : undef;
}

sub engine {
    return $HELD_ENGINE if $INCOGNITO && $HELD_ENGINE;
    sysopen(my $in, kept_in() . '/search', O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return;
    my @is = stat $in;
    return unless -f _ && $is[4] == $<;
    defined sysread($in, my $text, 2002) or return;
    my ($line) = $text =~ /\A([\x21-\x7e]{1,2000})\n?\z/ or return;
    return engine_fit($line);
}

sub search_set {
    my ($text) = @_;
    my $fit = engine_fit($text) or return idle('That search address was not kept: it must be https, a host by its name, port 443, in plain characters, with %s exactly once where the words go.');
    if ($INCOGNITO) { $HELD_ENGINE = $fit; window('search set'); return idle('Searches go to ' . ($fit =~ m{^https://([^/?#]+)}i)[0] . " in this incognito window only: $UNKEPT.") }    # [C16]
    unlink "$DIR/search.new";
    return idle('The search address could not be kept: its file could not be written. Nothing was changed.') unless put("$DIR/search.new", O_EXCL, $fit) && rename("$DIR/search.new", "$DIR/search");
    synced();
    window('search set');
    idle('Searches go to ' . ($fit =~ m{^https://([^/?#]+)}i)[0] . ' now: words typed into the bar that are no address are sent there.');
}

sub typed {
    my ($text) = @_;
    my $words = $text =~ s/^[ \t]+|[ \t]+$//gr;
    return go($text) if (address($text))[0] || $words =~ m{://} || $words !~ /[ \t]/ && $words =~ /\./ || !length $words;
    my $engine = engine() or do { window('search ask'); return idle('Choose a search engine first, and the words are sent there. Nothing was sent.') };
    my $query = $words =~ s/([^A-Za-z0-9._~-])/sprintf('%%%02X', ord $1)/ger;
    return go($engine =~ s/%s/$query/r, 'you searched with');
}

# What the lock beside the bar tells of the page shown: the address, the
# server lzrprf connected to, the answer's first line, the redirects on the
# way, and the certificates curl checked, as curl wrote them after the answer
# ("--write-out", sub fetch), each field plain characters and cut, so nothing
# in them acts on the window. Lines "# HEADING" or "NAME: VALUE".
sub secured {
    my ($url, $from, $got, $certs) = @_;
    my $plain = sub { my $one = $_[0] // ''; $one =~ s/[^\x20-\x7e]/?/g; return substr($one, 0, $_[1] // 300) };
    my ($status) = ($got // '') =~ /\A(HTTP\/[0-9.]+ [0-9]{3}[^\r\n]{0,80})/;
    my @lines = ('# Connection', 'Address: ' . $plain->($url, 2100), 'Server: ' . $plain->($from // 'unknown'),
        'Encryption: TLS 1.2 or newer, HTTP/1.1; the certificate checked against the roots lzrprf holds', 'Answer: ' . $plain->($status // 'unknown'),
        'Cookies: none sent and none kept by lzrprf', '# Redirects on the way here');
    push @lines, @WAY ? map { ($_ + 1) . '. ' . $plain->($WAY[$_], 600) } 0 .. $#WAY : 'None: the address answered with the page itself.';
    my @chain = grep { /\S/ } split /-----END CERTIFICATE-----/, $certs // '';
    my %named = ('Subject' => 'Subject', 'Issuer' => 'Issuer', 'Start date' => 'Valid from', 'Expire date' => 'Valid until', 'Serial Number' => 'Serial number',
        'Signature Algorithm' => 'Signature', 'Public Key Algorithm' => 'Public key', 'X509v3 Subject Alternative Name' => 'Names it covers');
    for my $at (0 .. ($#chain < 5 ? $#chain : 5)) {
        push @lines, '# Certificate ' . ($at + 1) . ' of ' . @chain . ($at == 0 ? ': the site' : $at == $#chain ? ': the root side' : ': an issuer');
        for my $field ('Subject', 'Issuer', 'Start date', 'Expire date', 'Serial Number', 'Signature Algorithm', 'Public Key Algorithm', 'X509v3 Subject Alternative Name') {
            my ($value) = $chain[$at] =~ /^\Q$field\E:[ \t]*([^\r\n]*)/m or next;
            push @lines, "$named{$field}: " . $plain->($value, $field =~ /Alternative/ ? 500 : 300);
        }
    }
    push @lines, '# Certificate', 'curl wrote no certificate for this answer.' unless @chain;
    return \@lines;
}

sub home {                                # the home page you set, when it is still an address lzrprf fetches; a plain file of yours and no link
    sysopen(my $in, kept_in() . '/home', O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return;
    my @is = stat $in;
    return unless -f _ && $is[4] == $<;
    defined sysread($in, my $text, 2102) or return;
    my ($line) = $text =~ /\A([\x21-\x7e]{1,2100})\n?\z/ or return;
    return (address($line))[0];
}

# A visit and what follows from it: a redirect you chose to follow is a new
# visit, made here after the one before has ended, as if its address had been
# typed (sub visit checks it the same way). Every one of them needs your yes.
sub go {
    my @next = @_;
    @WAY = ();
    $WENT = now();                        # the strip says how long the whole of it took, redirects followed and pictures fetched
    while (@next) {
        undef $NEXT;
        visit(@next);
        @next = $NEXT ? @$NEXT : ();
        relaid();
    }
}

# A redirect. curl follows none [C7]: an answer 301, 302, 303, 307 or 308
# is never laid out as a page. lzrprf shows it in its own modal: the address
# you went to, and the address the answer names, resolved against the first,
# and nothing is fetched for it unless you say so. Proceed is a new visit to
# it, with the checks every typed address gets; an address lzrprf does not
# fetch gets Cancel alone, and the modal says why in plain words (sub
# unfit). One redirect a visit is followed without asking: to the same
# address with "www." put in front of its host or taken off, https, the same
# path and query, written in the log first. The Location is read here by
# lzrprf, before the application sees the answer, and only when it is plain
# characters (0x21 to 0x7e), so nothing in it acts on the window. Returns the
# status and the whole address (undef when the answer names none, or one too
# long), or nothing when the answer is no redirect.
sub redirected {
    my ($got, $url) = @_;
    my ($status, $head) = $got =~ m{\AHTTP/1\.[01] (30[12378])[^\r\n]*\r\n(.*?)(?:\r\n\r\n|\z)}s or return;
    my ($to) = $head =~ /^location:[ \t]*([\x21-\x7e]{1,2000})[ \t]*\r?$/mi or return ($status, undef);
    my $whole = resolved($url, $to);
    return ($status, length $whole <= 2100 ? $whole : undef);
}

sub unfit {                               # why lzrprf does not fetch an address a page redirects to, in plain words
    my ($to) = @_;
    my $rule = 'lzrprf does not open this address: an address must be https, a host by its name, port 443, in plain characters without a space.';
    my ($scheme, $host, $port) = $to =~ m{^([A-Za-z][A-Za-z0-9+.-]*)://(?:[^/?#\@]*\@)?(\[[^\]/]*\]|[^/?#:]*)(?::([0-9]*))?} or return $rule;
    my @why;
    push @why, lc $scheme eq 'http' ? 'This address is not encrypted (http), and lzrprf opens https addresses only, so it cannot be opened.' : "This address is $scheme, not https, and lzrprf opens https addresses only." if lc $scheme ne 'https';
    push @why, 'Its host is a bare number, not a site name: lzrprf opens a site by its name only.' if $host =~ /^\[|^[0-9.]+\z/;
    push @why, "It names port $port, and lzrprf opens port 443 only." if defined $port && length $port && $port ne '443';
    return @why ? join(' ', @why) : $rule;
}

sub resolved {                            # a Location against the address it came from (RFC 3986 section 5.2, without a base that has a fragment)
    my ($base, $to) = @_;
    return $to if $to =~ m{^[A-Za-z][A-Za-z0-9+.-]*:};
    my ($origin, $path, $query) = $base =~ m{^(https://[^/?#]+)([^?#]*)(\?[^#]*)?};
    return "https:$to" if $to =~ m{^//};
    return "$origin$path" . ($query // '') . $to if $to =~ /^#/;
    return "$origin$path$to" if $to =~ /^\?/;
    my $joined = $to =~ m{^/} ? $to : ($path =~ s{[^/]*\z}{}r || '/') . $to;
    my ($rest) = $joined =~ /([?#].*)\z/s;
    $joined =~ s/[?#].*\z//s;
    my @out;
    my @parts = split m{/}, $joined, -1;
    for my $at (0 .. $#parts) {
        my $part = $parts[$at];
        if ($part eq '..') { pop @out if @out > 1; push @out, '' if $at == $#parts }
        elsif ($part eq '.') { push @out, '' if $at == $#parts }
        else { push @out, $part }
    }
    return $origin . join('/', @out) . ($rest // '');
}

# Bookmarks. They are files of yours in $DIR/bookmarks: one plain file a
# bookmark, NAME.mark, of two lines, the name it is shown by and its address;
# a folder of bookmarks is a real folder. A file or folder name is plain
# letters, digits, space, dot, underscore and hyphen, never begins with a dot
# or a space, and is at most 64 characters; anything else there is passed
# over, as is a link, something not yours, a file of more than 4 KiB, a line
# that is not in that shape, and an address lzrprf does not fetch (sub
# address). Folders go at most $MARKS_DEEP deep and at most $MARKS_MOST
# bookmarks are read. lzrprf reads them and tells the window the whole tree:
# "marks begin", "mark F FOLDER" for each folder, "mark B N FOLDER\tNAME\tADDRESS"
# for bookmark N, "marks end". The window says "mark open N", "mark remove N"
# or "mark save\tN-or-\tFOLDER\tNAME\tADDRESS", each checked here. A
# bookmark's address came from the window's bar, or was typed into the
# window's own modal [C4]; opening it is a visit like a typed one.
my $MARKS_MOST = 1000;                    # the most bookmarks read: the owner's order of 2026-11-20
my $MARKS_DEEP = 4;                       # how deep folders of bookmarks go: the owner's order of 2026-11-20
my $PART = qr/[A-Za-z0-9_-][A-Za-z0-9 ._-]{0,63}/;    # one name in the bookmarks folder

sub marks_root { kept_in() . '/bookmarks' }    # read, never written, by an incognito window [C16]

# The bookmarks bar shows one folder, "Bookmarks bar" (Chrome's own name for it), and nothing
# else; the star's modal offers it first. Before the bar had a folder of its own it showed the
# bookmarks at the top of the folder, so the first time the folder is read without it, those move
# into it, each by one change of name, and the bar shows what it showed. The folder is made then
# even when there is nothing to move, so a bookmark kept at the top later stays there.
my $BAR = 'Bookmarks bar';                # the owner's order of 2026-11-20

sub marks_into_bar {
    return if $INCOGNITO;                 # [C16]
    my $root = marks_root();
    return unless owned_folder($root);
    my $bar = "$root/$BAR";
    return if -e $bar || -l $bar;
    mkdir $bar, 0700 or return;
    opendir(my $in, $root) or return;
    for my $entry (grep { /^$PART\z/ && /\.mark\z/ } readdir $in) {
        my @is = lstat "$root/$entry" or next;
        rename "$root/$entry", "$bar/$entry" if -f _ && $is[3] == 1 && $is[4] == $<;
    }
    synced();
}

sub owned_folder { my @is = lstat $_[0]; return @is && -d _ && $is[4] == $< }    # a folder of yours, and no link to one

sub marks_read {
    my (@found, @folders);
    marks_walk('', 0, \@found, \@folders) if owned_folder(marks_root());
    return (\@found, \@folders);
}

sub marks_walk {
    my ($folder, $deep, $found, $folders) = @_;
    my $dir = length $folder ? marks_root() . "/$folder" : marks_root();
    for my $entry (order_shown($dir)) {    # in the folder's order (sub order_set)
        last if @$found >= $MARKS_MOST;
        my ($path, $inner) = ("$dir/$entry", length $folder ? "$folder/$entry" : $entry);
        my @is = lstat $path or next;
        if (-d _) {
            next unless $deep < $MARKS_DEEP && $is[4] == $<;
            push @$folders, $inner;
            marks_walk($inner, $deep + 1, $found, $folders);
        } elsif (-f _ && $entry =~ /\.mark\z/ && $is[3] == 1 && $is[4] == $< && $is[7] <= 4096) {
            sysopen(my $file, $path, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or next;
            defined sysread($file, my $text, 4097) or next;
            my ($name, $where) = $text =~ /\A([^\n]{1,800})\n([\x21-\x7e]{1,2100})\n?\z/ or next;
            my ($url) = address($where) or next;
            push @$found, [$path, plain_name($name), $url, $folder];
        }
    }
}

sub plain_name {                          # a name to show: at most $TITLE characters, nothing that acts on the display, never empty
    my ($name) = @_;
    no warnings 'utf8';
    utf8::decode($name) or $name =~ s/[^\x00-\x7f]/?/g;
    $name =~ s/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]//g;
    $name =~ s/^[ \p{M}]+| +$//g;
    $name = substr($name, 0, $TITLE);
    $name = 'Bookmark' unless length $name;
    utf8::encode($name);
    return $name;
}

sub marks_told {
    marks_into_bar();
    my ($found, $folders) = marks_read();
    @MARKS = @$found;
    window('marks begin', (map { "mark F $_" } @$folders), (map { "mark B $_ $MARKS[$_][3]\t$MARKS[$_][1]\t$MARKS[$_][2]" } 0 .. $#MARKS), 'marks end');
}

sub mark_written {                        # a bookmark's two lines into a new file beside its place, then given its place's name in one step
    my ($dir, $file, $name, $url) = @_;
    my $new = "$dir/.new.$$";             # begins with a dot: never read as a bookmark
    unlink $new;
    put($new, O_EXCL, $name, $url) && rename($new, $file) or (unlink($new), return 0);
    synced();
    return 1;
}

sub mark_saved {
    my ($edit, $folder, $name, $where) = @_;
    return idle("$UNKEPT, so no bookmark was added or changed.") if $INCOGNITO;    # [C16]
    my ($url) = address($where);
    return idle('The bookmark was not saved: lzrprf does not fetch that address. An address must be https, a host by its name, port 443, in plain characters without a space.') unless $url;
    my @parts = length $folder ? split(m{/}, $folder, -1) : ();
    return idle("The bookmark was not saved: a folder is at most $MARKS_DEEP deep, and each name in it is letters, digits, space, dot, underscore or hyphen, not beginning with a dot or a space.") if @parts > $MARKS_DEEP || grep { !/^$PART\z/ } @parts;
    my $old = $edit eq '-' ? undef : $MARKS[$edit] // return idle('The bookmark was not saved: it is no longer there.');
    my ($found) = marks_read();
    return idle("The bookmark was not saved: there are $MARKS_MOST bookmarks already.") if !$old && @$found >= $MARKS_MOST;
    my $dir = marks_root();
    for my $part ('', @parts) {
        $dir .= "/$part" if length $part;
        mkdir $dir, 0700 unless -e $dir || -l $dir;
        return idle("The bookmark was not saved: $dir is not a folder of yours.") unless owned_folder($dir);
        marks_into_bar() unless length $part;    # the top folder may be new: the bar's folder is made before anything is kept at the top
    }
    $name = plain_name($name);
    my $file = mark_file($dir, $name, $old ? $old->[0] : undef) // return idle('The bookmark was not saved: too many of that name.');
    return idle('The bookmark could not be written. Nothing was changed.') unless mark_written($dir, $file, $name, $url);
    unlink $old->[0] if $old && $old->[0] ne $file && -f $old->[0] && !-l $old->[0];
    my ($was_in, $was) = $old ? $old->[0] =~ m{\A(.*)/([^/]+)\z} : ();
    order_set($dir, defined $was_in && $was_in eq $dir ? $was : undef, basename($file)) if !$old || $old->[0] ne $file;    # a new bookmark last in its folder; one renamed in its place; one moved last in its new folder
    marks_told();
    return idle(($old ? 'The bookmark was changed: ' : 'The bookmark was added: ') . "$name, $url.");
}

sub mark_removed {
    my ($n) = @_;
    return idle("$UNKEPT, so no bookmark was removed.") if $INCOGNITO;    # [C16]
    my $mark = $MARKS[$n] // return idle('That bookmark is no longer there.');
    my @is = lstat $mark->[0];
    unlink $mark->[0] if @is && -f _;
    my ($dir, $gone) = $mark->[0] =~ m{\A(.*)/([^/]+)\z};
    order_set($dir, $gone) if defined $dir && -f "$dir/.order";    # its name leaves its folder's order, so a later bookmark of that name is added last
    marks_told();
    return idle("The bookmark was removed: $mark->[1].");
}

sub mark_moved {                          # a bookmark's address made the one its page redirects to, after you said so
    my ($n, $url) = @_;
    my $mark = $MARKS[$n] or return 0;
    return 0 if $INCOGNITO;               # [C16]
    my ($dir) = $mark->[0] =~ m{\A(.*)/[^/]+\z} or return 0;
    mark_written($dir, $mark->[0], $mark->[1], $url) or return 0;
    marks_told();
    return 1;
}

# The window's size and place, kept so the next window opens as this one was left: one line in a
# plain file of yours, frame, "X Y W H" in points from the bottom left of the main screen, or "full"
# when it filled the screen (full screen, or as large as the screen lets it), which opens the next
# window as large as the desktop lets it. An incognito window reads it and writes nothing.    # [C16]
sub frame_kept {
    sysopen(my $in, kept_in() . '/frame', O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return 'none';
    my @is = stat $in;
    return 'none' unless -f _ && $is[4] == $<;
    defined sysread($in, my $text, 64) or return 'none';
    return $text =~ /\A(full|-?[0-9]{1,5} -?[0-9]{1,5} [1-9][0-9]{1,4} [1-9][0-9]{1,4})\n?\z/ ? $1 : 'none';
}

sub frame_said {
    my ($frame) = @_;
    return if $INCOGNITO || frame_kept() eq $frame;
    unlink "$DIR/frame.new";
    put("$DIR/frame.new", O_EXCL, $frame) && rename("$DIR/frame.new", "$DIR/frame");
    return;
}

sub checked_kept {                       # the last look for a newer release, as checked keeps it, or "never"
    sysopen(my $in, "$ROOT/checked", O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return 'never';
    my @is = stat $in;
    return 'never' unless -f _ && $is[4] == $<;
    defined sysread($in, my $text, 64) or return 'never';
    return $text =~ /\A([1-9][0-9]{8,10} (?:same|newer) [0-9]{1,6}|[1-9][0-9]{8,10} failed)\n?\z/ ? $1 : 'never';
}

sub checked_said {
    my ($result, $asked) = @_;
    if ($result ne 'none' && !$INCOGNITO) {
        unlink "${\ shared()}/checked.new";
        put("${\ shared()}/checked.new", O_EXCL, time . " $result") && rename("${\ shared()}/checked.new", "${\ shared()}/checked");
    }
    window('checked ' . ($result eq 'none' ? 'none' : $INCOGNITO ? time . " $result" : checked_kept()));
    return 1;
}

sub marks_bar {                           # whether the bookmarks bar is shown: one line "on" in a plain file of yours
    return $HELD_BAR if $INCOGNITO && defined $HELD_BAR;
    sysopen(my $in, kept_in() . '/marksbar', O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return 0;
    my @is = stat $in;
    return 0 unless -f _ && $is[4] == $<;
    defined sysread($in, my $text, 8) or return 0;
    return $text =~ /\Aon\n?\z/ ? 1 : 0;
}

# The order of a bookmarks folder. Each folder may hold one plain file of yours, .order, that names
# what is in it, one name a line, in the order the bar, the folder menus and the bookmarks page show
# it: bookmarks and folders mixed, as Chrome mixes them. Its name begins with a dot, so it is never
# read as a bookmark. A name it holds that is not there is passed over; what is there and not named
# follows the named, by name, as every folder was shown before it had an order. A bookmark added is
# named last; one renamed keeps its place. It is written as every file of the bookmarks is: beside
# its place, then given its name in one step (sub order_set).
my $ORDER = '.order';
my $ORDER_BYTES = 128 * 1024;             # DECLARED(the most of an order that is read: $MARKS_MOST names of at most 64 characters and a line end each is 65,000 bytes; twice that for a folder of folders)

sub order_of {                            # the names an order holds, in order, each once; nothing when there is none
    my ($dir) = @_;
    sysopen(my $in, "$dir/$ORDER", O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return;
    my @is = stat $in;
    return unless -f _ && $is[4] == $< && $is[7] <= $ORDER_BYTES;
    defined sysread($in, my $text, $ORDER_BYTES + 1) or return;
    my %seen;
    return grep { /^$PART\z/ && !$seen{$_}++ } split /\n/, $text;
}

sub order_shown {                         # what a folder shows, in its order: the named first, then the rest by name
    my ($dir) = @_;
    opendir(my $in, $dir) or return;
    my %there = map { $_ => 1 } grep { /^$PART\z/ } readdir $in;
    return ((grep { delete $there{$_} } order_of($dir)), sort keys %there);
}

sub order_set {                           # a folder's order written: what it named, with one old name replaced by the new ones, then the rest by name, then the new ones not placed yet
    my ($dir, $old, @new) = @_;
    opendir(my $in, $dir) or return 0;
    my %there = map { $_ => 1 } grep { /^$PART\z/ } readdir $in;
    my %new = map { $_ => 1 } @new;
    my @names = grep { delete $there{$_} } map { defined $old && $_ eq $old ? @new : $_ } order_of($dir);
    push @names, grep { !$new{$_} && delete $there{$_} } sort keys %there;
    push @names, grep { delete $there{$_} } @new;
    unlink "$dir/$ORDER.new";
    put("$dir/$ORDER.new", O_EXCL, @names) && rename("$dir/$ORDER.new", "$dir/$ORDER") or (unlink("$dir/$ORDER.new"), return 0);
    synced();
    return 1;
}

sub mark_file {                           # the file a bookmark of this name gets in that folder: its own name kept to plain characters, numbered when it is taken; nothing when 999 of it are
    my ($dir, $name, $old) = @_;
    my $base = substr($name =~ s/[^A-Za-z0-9 ._-]/_/gr =~ s/^[ .]+//r, 0, 50) =~ s/ +\z//r;
    $base = 'bookmark' unless length $base;
    my $file = "$dir/$base.mark";
    for (my $n = 2; (defined $old ? $file ne $old : 1) && (-e $file || -l $file); $n++) { return if $n > 999; $file = "$dir/$base $n.mark" }
    return $file;
}

# Importing bookmarks from another browser. "Import bookmarks..." in the cogwheel's menu opens the
# window's wizard, and each of its steps is one line to lzrprf; nothing is read before you chose a
# browser there, and nothing is written before you pressed Import. lzrprf reads the files itself,
# never a container and never the window, and starts no program for it: each a plain file of yours
# and no link, of at most $IMPORT_BYTES, at a fixed place under your home folder:          [C15]
#   Chrome, Edge, Brave, Vivaldi   "Local State" for the names of the profiles, and each profile's "Bookmarks"
#   Firefox                        profiles.ini, and the newest bookmarkbackups/*.jsonlz4 of a profile
#   Safari                         Library/Safari/Bookmarks.plist (macOS lets a program read it only with Full Disk Access)
#   a bookmarks file (HTML)        one you chose: found in Downloads, Desktop or Documents, or typed as a path in your home folder
# Firefox's places.sqlite would need a program (sqlite3) and is not read: its own backups hold the
# same bookmarks. What is read stays in the memory of the process behind the window until Import or
# the next preview. Each bookmark goes through the checks a bookmark you add gets: its name through
# sub plain_name, its address through sub address (one lzrprf does not fetch is skipped and
# counted), at most $MARKS_MOST in all and folders at most $MARKS_DEEP deep (what is beyond is left
# out and counted), and it is written by sub mark_written and named last in its folder's order
# (sub order_set). The source's bookmarks bar goes into "Bookmarks bar", folders and all; the rest
# into a new folder "Imported from" and the source's name. Nothing imported is fetched [C4]: a
# bookmark is fetched when you open it, as one you made.
my $IMPORT_BYTES = 32 * 1024 * 1024;      # DECLARED(the most of one file that is read: Chrome's own file for ten thousand bookmarks is about 3 MB)
my $IMPORT_OUT = 64 * 1024 * 1024;        # DECLARED(the most a Firefox backup may unpack to: twice the most of a file that is read)
my $IMPORT_NODES = 100_000;               # DECLARED(the most bookmarks and folders taken from one file: a hundred times $MARKS_MOST; the rest is left out)
my $IMPORT_DEPTH = 64;                    # DECLARED(the most folders inside folders read from one file: what is deeper is left out; four are kept)
my $IMPORT_FOUND = 20;                    # DECLARED(the most bookmarks files the HTML step offers: the newest)
my %BROWSERS = (chrome => ['Chrome', 'Library/Application Support/Google/Chrome'], edge => ['Edge', 'Library/Application Support/Microsoft Edge'],
    brave => ['Brave', 'Library/Application Support/BraveSoftware/Brave-Browser'], vivaldi => ['Vivaldi', 'Library/Application Support/Vivaldi'],
    firefox => ['Firefox', 'Library/Application Support/Firefox'], safari => ['Safari', 'Library/Safari'], file => ['HTML file', '']);
my @BROWSERS = qw(chrome edge brave firefox safari vivaldi);    # in the wizard's order; Vivaldi is the owner's pick of a sixth
my ($IMPORT, $IMPORT_KEY, @IMPORT_FROM);    # what the last preview read: [the source's name, its bar, the rest]; the browser chosen; its profiles or files: [what the window shows, the file]
my $IMPORT_SEEN = 0;                      # how many bookmarks and folders the file being read has given so far
my %IMPORT_BLOCKED;                       # the browsers whose files macOS kept lzrprf from reading (its privacy protection of another app's data): shown as such, never as not found
my $IMPORT_PROBE = 32;                    # DECLARED(Chrome names its profiles Default and Profile 1, 2, ...: when its Local State cannot be read, this many are looked for by name)

sub import_home { $TRY ? "$ROOT/home" : $HOME }    # "lzrprf try": the test's own folder stands for the home folder

sub import_read {                         # a file's bytes, or nothing and why
    my ($file) = @_;
    sysopen(my $in, $file, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return (undef, $!{EPERM} || $!{EACCES} ? 'refused' : $!{ELOOP} ? 'it is a link, which lzrprf does not follow' : 'missing');
    my @is = stat $in;
    return (undef, 'not a plain file of yours') unless -f _ && $is[4] == $<;
    return (undef, 'larger than 32 MiB') if $is[7] > $IMPORT_BYTES;
    my ($text, $got) = ('', 0);
    while (($got = sysread($in, $text, 1 << 20, length $text)) && length $text <= $IMPORT_BYTES) { }
    return (undef, 'unreadable') unless defined $got && length $text <= $IMPORT_BYTES;
    return $text;
}

sub import_node {                         # one bookmark or folder of a file, or nothing once $IMPORT_NODES were taken
    my ($name, $url, $kids) = @_;
    return if ++$IMPORT_SEEN > $IMPORT_NODES;
    $name //= '';
    utf8::encode($name) if utf8::is_utf8($name);
    return $kids ? { name => $name, kids => $kids } : { name => $name, url => $url // '' };
}

sub import_json {                         # a JSON text, decoded by the JSON code that comes with the system's perl, or nothing
    my ($text) = @_;
    require JSON::PP;
    return eval { JSON::PP->new->utf8->max_depth(2 * $IMPORT_DEPTH + 8)->decode($text) };
}

sub lz4_block {                           # an LZ4 block (the block format of lz4) unpacked, at most $most bytes; nothing for one that is not well formed
    my ($in, $most) = @_;
    my ($at, $end, $out) = (0, length $in, '');
    my $more = sub { my $n = 0; while (1) { return -1 if $at >= $end; my $byte = ord substr($in, $at++, 1); $n += $byte; return $n if $byte != 255 } };
    while ($at < $end) {
        my $token = ord substr($in, $at++, 1);
        my $literals = $token >> 4;
        if ($literals == 15) { my $n = $more->(); return if $n < 0; $literals += $n }
        return if $at + $literals > $end || length($out) + $literals > $most;
        $out .= substr($in, $at, $literals);
        $at += $literals;
        last if $at == $end;              # the last sequence holds literals alone
        return if $at + 2 > $end;
        my $back = unpack 'v', substr($in, $at, 2);
        $at += 2;
        return if !$back || $back > length $out;
        my $length = $token & 15;
        if ($length == 15) { my $n = $more->(); return if $n < 0; $length += $n }
        $length += 4;
        return if length($out) + $length > $most;
        my $from = substr($out, length($out) - $back, $back < $length ? $back : $length);
        $out .= $back >= $length ? $from : substr($from x (int($length / $back) + 1), 0, $length);    # a copy that overlaps itself repeats what it copies
    }
    return $out;
}

sub plist_binary {                        # a binary property list (bplist00) as Perl data, or nothing: strings, numbers, arrays and dictionaries; what else it holds is undef
    my ($text) = @_;
    return unless length $text >= 40 && substr($text, 0, 8) eq 'bplist00';
    my ($size, $refs, $count, $top, $table) = unpack 'x6 C C Q> Q> Q>', substr($text, -32);
    return unless $size >= 1 && $size <= 8 && $refs >= 1 && $refs <= 8 && $count <= length($text) && $top < $count && $table + $count * $size <= length($text) - 32;
    my $int = sub { my ($at, $n) = @_; my $v = 0; $v = $v * 256 + ord substr($text, $at + $_, 1) for 0 .. $n - 1; return $v };
    my $steps = 0;
    my $object; $object = sub {
        my ($ref, $deep) = @_;
        return if $ref >= $count || $deep > $IMPORT_DEPTH * 2 + 8 || ++$steps > 4 * $IMPORT_NODES;
        my $at = $int->($table + $ref * $size, $size);
        return if $at >= length($text) - 32;
        my $marker = ord substr($text, $at, 1);
        my ($kind, $n) = ($marker >> 4, $marker & 15);
        my $body = $at + 1;
        if ($kind != 0 && $kind != 1 && $kind != 2 && $kind != 3 && $kind != 8 && $n == 15) {    # a length of 15 or more follows as a number of its own
            my $head = ord substr($text, $body, 1);
            return unless $head >> 4 == 1;
            my $bytes = 1 << ($head & 15);
            return if $bytes > 8;
            $n = $int->($body + 1, $bytes);
            $body += 1 + $bytes;
        }
        if ($kind == 1) { return $int->($body, 1 << $n) if (1 << $n) <= 8; return }
        if ($kind == 5) { return if $body + $n > length $text; return substr($text, $body, $n) }
        if ($kind == 6) {
            return if $body + 2 * $n > length $text;
            require Encode;
            my $chars = eval { Encode::decode('UTF-16BE', substr($text, $body, 2 * $n)) } // return;
            utf8::encode($chars);
            return $chars;
        }
        if ($kind == 10) { return if $body + $n * $refs > length $text; return [map { $object->($int->($body + $_ * $refs, $refs), $deep + 1) } 0 .. $n - 1] }
        if ($kind == 13) {
            return if $body + 2 * $n * $refs > length $text;
            my %dict;
            for my $k (0 .. $n - 1) {
                my $key = $object->($int->($body + $k * $refs, $refs), $deep + 1);
                $dict{$key} = $object->($int->($body + ($n + $k) * $refs, $refs), $deep + 1) if defined $key && !ref $key;
            }
            return \%dict;
        }
        return;
    };
    return $object->($top, 0);
}

sub html_text {                           # the text of HTML with its entities as characters, in UTF-8
    my ($text) = @_;
    my $char = sub { my $n = $_[0]; return '?' if $n > 0x10ffff || $n >= 0xd800 && $n <= 0xdfff; my $c = chr $n; utf8::encode($c); return $c };
    $text =~ s/&(?:#(\d{1,7})|#[xX]([0-9A-Fa-f]{1,6})|(amp|lt|gt|quot|apos|nbsp));/defined $1 ? $char->($1) : defined $2 ? $char->(hex $2) : { amp => '&', lt => '<', gt => '>', quot => '"', apos => "'", nbsp => ' ' }->{$3}/ge;
    return $text;
}

sub import_html {                         # the Netscape bookmarks file every browser exports: (its bar, the rest)
    my ($text) = @_;
    return unless $text =~ /NETSCAPE-Bookmark-file-1/i;
    my (@stack, $waiting) = ([]);
    my $root = $stack[0];
    while ($text =~ m{<(/?)(DL|H3|A)\b([^>]*)>(?:([^<]*)</(?:H3|A)\s*>)?}gi) {
        my ($close, $tag, $attributes, $inner) = ($1, uc $2, $3, $4 // '');
        if ($tag eq 'DL') {
            if ($close) { pop @stack if @stack > 1 }
            else { push @stack, $waiting ? $waiting->{kids} : $stack[-1]; undef $waiting }
            next;
        }
        next if $close;
        my $name = html_text($inner =~ s/\s+/ /gr);
        if ($tag eq 'H3') {
            my $folder = @stack <= $IMPORT_DEPTH ? import_node($name, undef, []) : undef;
            $waiting = $folder // { kids => [] };    # a folder too deep, or one too many, takes what is in it with it
            $folder->{bar} = 1 if $folder && $attributes =~ /PERSONAL_TOOLBAR_FOLDER\s*=\s*"true"/i;
            push @{ $stack[-1] }, $folder if $folder;
        } else {
            my ($href) = $attributes =~ /\bHREF\s*=\s*"([^"]*)"/i;
            my $mark = import_node($name, html_text($href // '')) or next;
            push @{ $stack[-1] }, $mark;
        }
    }
    my ($bar) = grep { $_->{kids} && $_->{bar} } @$root;
    ($bar) = grep { $_->{kids} && $_->{name} =~ /^(?:Bookmarks ?bar|Bookmarks Toolbar|Favou?rites|BookmarksBar)$/i } @$root unless $bar;    # Safari's export names its bar Favorites and marks it no other way
    return ($bar ? $bar->{kids} : [], [grep { !$bar || $_ != $bar } @$root]);
}

sub import_chromium {                     # Chrome's Bookmarks file, and that of each browser made from Chromium: (its bar, the rest)
    my ($text) = @_;
    my $all = import_json($text);
    return unless ref $all eq 'HASH' && ref $all->{roots} eq 'HASH';
    my $nodes; $nodes = sub {
        my ($list, $deep) = @_;
        return [] unless ref $list eq 'ARRAY' && $deep <= $IMPORT_DEPTH;
        return [map { ref $_ ne 'HASH' ? () : ($_->{type} // '') eq 'folder' ? (import_node($_->{name}, undef, $nodes->($_->{children}, $deep + 1)) // ()) : ($_->{type} // '') eq 'url' ? (import_node($_->{name}, $_->{url}) // ()) : () } @$list];
    };
    my $roots = $all->{roots};
    my $mobile = ref $roots->{synced} eq 'HASH' ? $nodes->($roots->{synced}{children}, 1) : [];
    return ($nodes->(ref $roots->{bookmark_bar} eq 'HASH' ? $roots->{bookmark_bar}{children} : [], 1),
        [@{ ref $roots->{other} eq 'HASH' ? $nodes->($roots->{other}{children}, 1) : [] }, @$mobile ? import_node('Mobile bookmarks', undef, $mobile) // () : ()]);
}

sub import_firefox {                      # a Firefox backup, bookmarkbackups/*.jsonlz4: "mozLz40", a zero byte, the size unpacked in 4 bytes, then one LZ4 block
    my ($text) = @_;
    return unless length $text > 12 && substr($text, 0, 8) eq "mozLz40\0";
    my $size = unpack 'V', substr($text, 8, 4);
    return if $size > $IMPORT_OUT;
    my $json = lz4_block(substr($text, 12), $size) // return;
    return unless length $json == $size;
    my $all = import_json($json);
    return unless ref $all eq 'HASH' && ref $all->{children} eq 'ARRAY';
    my $nodes; $nodes = sub {
        my ($list, $deep) = @_;
        return [] unless ref $list eq 'ARRAY' && $deep <= $IMPORT_DEPTH;
        return [map { ref $_ ne 'HASH' ? () : ($_->{type} // '') eq 'text/x-moz-place-container' ? (import_node($_->{title}, undef, $nodes->($_->{children}, $deep + 1)) // ()) : ($_->{type} // '') eq 'text/x-moz-place' ? (import_node($_->{title}, $_->{uri}) // ()) : () } @$list];
    };
    my %root = map { ref $_ eq 'HASH' && defined $_->{guid} ? ($_->{guid} => $_->{children}) : () } @{ $all->{children} };
    my ($other, $mobile) = ($nodes->($root{unfiled_____}, 1), $nodes->($root{mobile______}, 1));
    return ($nodes->($root{toolbar_____}, 1), [@{ $nodes->($root{menu________}, 1) }, @$other ? import_node('Other bookmarks', undef, $other) // () : (), @$mobile ? import_node('Mobile bookmarks', undef, $mobile) // () : ()]);
}

sub import_safari {                       # Safari's Bookmarks.plist: (its bar, the rest)
    my ($text) = @_;
    my $all = plist_binary($text);
    return unless ref $all eq 'HASH' && ref $all->{Children} eq 'ARRAY';
    my $nodes; $nodes = sub {
        my ($list, $deep) = @_;
        return [] unless ref $list eq 'ARRAY' && $deep <= $IMPORT_DEPTH;
        return [map {
            my $one = $_;
            my $type = ref $one eq 'HASH' ? $one->{WebBookmarkType} // '' : '';
            $type eq 'WebBookmarkTypeList' ? (import_node($one->{Title}, undef, $nodes->($one->{Children}, $deep + 1)) // ())
                : $type eq 'WebBookmarkTypeLeaf' ? (import_node(ref $one->{URIDictionary} eq 'HASH' ? $one->{URIDictionary}{title} : '', $one->{URLString}) // ()) : ()
        } @$list];
    };
    my %root = map { ref $_ eq 'HASH' ? (($_->{Title} // '') => $_) : () } @{ $all->{Children} };
    my $reading = $root{'com.apple.ReadingList'} ? $nodes->($root{'com.apple.ReadingList'}{Children}, 1) : [];
    return ($root{BookmarksBar} ? $nodes->($root{BookmarksBar}{Children}, 1) : [],
        [@{ $root{BookmarksMenu} ? $nodes->($root{BookmarksMenu}{Children}, 1) : [] }, @$reading ? import_node('Reading List', undef, $reading) // () : ()]);
}

sub import_profiles_of {                  # a browser's profiles that hold bookmarks: [the name shown, the file]
    my ($key) = @_;
    my $base = import_home() . '/' . $BROWSERS{$key}[1];
    return ['Safari', "$base/Bookmarks.plist"] if $key eq 'safari';
    if ($key eq 'firefox') {
        my ($ini, $why) = import_read("$base/profiles.ini");
        $IMPORT_BLOCKED{$key} = 1 if !defined $ini && $why eq 'refused';
        return unless defined $ini;
        my (@found, %one);
        for my $line (split /\r?\n/, "$ini\n[end]") {
            if ($line =~ /^\[/) {
                if (defined $one{Path} && $one{Path} !~ m{(?:^|/)\.\.(?:/|$)}) {
                    my $dir = ($one{IsRelative} // '1') eq '1' ? "$base/$one{Path}" : $one{Path};
                    my ($newest) = sort { $b cmp $a } grep { -f $_ && !-l $_ } bsd_glob("$dir/bookmarkbackups/*.jsonlz4");
                    push @found, [plain_name($one{Name} // $one{Path}), $newest] if $newest && index($dir, import_home() . '/') == 0;
                }
                %one = ();
            } elsif ($line =~ /^(Name|Path|IsRelative)=(.{1,500})$/) { $one{$1} = $2 }
        }
        return @found;
    }
    my ($state, $why) = import_read("$base/Local State");
    $IMPORT_BLOCKED{$key} = 1 if !defined $state && $why eq 'refused';
    my $cache = defined $state ? (import_json($state) // {})->{profile} : undef;
    $cache = ref $cache eq 'HASH' && ref $cache->{info_cache} eq 'HASH' ? $cache->{info_cache} : { map { $_ => { name => $_ } } 'Default', map { "Profile $_" } 1 .. $IMPORT_PROBE };    # no Local State to read: its profiles are looked for by their usual names
    my @found = map { [plain_name(do { my $n = ref $cache->{$_} eq 'HASH' ? $cache->{$_}{name} // $_ : $_; utf8::encode($n) if utf8::is_utf8($n); $n }), "$base/$_/Bookmarks"] }
        grep { /^[A-Za-z0-9][A-Za-z0-9 ._-]{0,63}\z/ && -f "$base/$_/Bookmarks" && !-l "$base/$_/Bookmarks" } sort keys %$cache;
    delete $IMPORT_BLOCKED{$key} if @found && defined((import_read($found[0][1]))[0]);    # Local State kept out but the bookmarks themselves readable: not blocked
    return @found;
}

sub import_files {                        # the bookmarks files in Downloads, Desktop and Documents, the newest first: [the name shown, the file]
    my @found;
    for my $where (qw(Downloads Desktop Documents)) {
        opendir(my $in, import_home() . "/$where") or next;    # macOS may not let lzrprf look there: then nothing is found there
        for my $entry (grep { /^[^.].{0,200}\.html?\z/is } readdir $in) {
            my $file = import_home() . "/$where/$entry";
            my @is = lstat $file or next;
            next unless -f _ && $is[4] == $< && $is[7] <= $IMPORT_BYTES;
            sysopen(my $one, $file, O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or next;
            defined sysread($one, my $head, 512) or next;
            push @found, [plain_name("$where/$entry"), $file, $is[9]] if $head =~ /NETSCAPE-Bookmark-file-1/i;
        }
    }
    @found = sort { $b->[2] <=> $a->[2] || $a->[0] cmp $b->[0] } @found;
    return @found[0 .. ($#found < $IMPORT_FOUND - 1 ? $#found : $IMPORT_FOUND - 1)];
}

sub import_sources {
    return import_refused("$UNKEPT, so it imports no bookmarks.") if $INCOGNITO;    # [C16]
    undef $IMPORT;
    window('import begin', (map { my @of = import_profiles_of($_); my $there = $IMPORT_BLOCKED{$_} ? 2 : $_ eq 'safari' ? (-e $of[0][1] || $!{EPERM} || $!{EACCES} ? 1 : 0) : @of ? 1 : 0; "import source $_ $there " . ($_ eq 'safari' ? 1 : scalar @of) . " $BROWSERS{$_}[0]" } @BROWSERS),
        'import source file 1 ' . scalar(my @files = import_files()) . ' A bookmarks file (HTML)', 'import step source');
    return idle('Choose the browser to import bookmarks from. Nothing is read before you choose, and nothing is written before you press Import.');
}

sub import_profiles {
    return import_refused("$UNKEPT, so it imports no bookmarks.") if $INCOGNITO;    # [C16]
    my ($key) = @_;
    $IMPORT_KEY = $key;
    delete $IMPORT_BLOCKED{$key};
    @IMPORT_FROM = $key eq 'file' ? import_files() : import_profiles_of($key);
    return import_refused(import_steps($key)) if $IMPORT_BLOCKED{$key};
    return import_preview($key, 0) if $key ne 'file' && @IMPORT_FROM == 1;
    return import_refused("lzrprf found no profile of $BROWSERS{$key}[0] with bookmarks on this Mac.") if $key ne 'file' && !@IMPORT_FROM;
    window('import begin', (map { "import profile $_ $IMPORT_FROM[$_][0]" } 0 .. $#IMPORT_FROM), 'import step profile');
    return idle($key eq 'file' ? (@IMPORT_FROM ? 'Choose the bookmarks file, or type its path.' : 'No bookmarks file was found in Downloads, Desktop or Documents: type its path.') : "Choose the profile of $BROWSERS{$key}[0] to import from.");
}

sub import_refused { window("import refused $_[0]"); return idle($_[0] =~ s/\t.*//sr) }    # the strip under the bar says the first line; the wizard shows every line

# What the wizard says when macOS keeps a browser's own files from lzrprf (its
# protection of another app's data). lzrprf asks for no more access than it
# has: it never tells you to give it Full Disk Access, since a browser that can
# read every file of yours is the opposite of what this one is for. The way in
# is the browser's own export, said as numbered steps, one a line (the lines
# parted by tabs, as one line to the window). For Chrome there is a second way,
# from the Google account the bookmarks are kept in: Google hands them out as a
# file (Takeout), the same kind of file, and gives no program another door.
sub import_steps {
    my ($key) = @_;
    my $name = $BROWSERS{$key}[0];
    my @export = $key eq 'safari' ? ('In Safari choose File, Export, Bookmarks...')
        : $key eq 'firefox' ? ('In Firefox choose Bookmarks, Manage Bookmarks (Shift Command O).', 'Press Import and Backup, then Export Bookmarks to HTML...')
        : ("In $name choose Bookmarks, Bookmark Manager (Option Command B).", 'Press the three dots at the top right of that page and choose Export bookmarks.');
    push @export, 'Save the file in Downloads, under the name it has.', 'Here choose A bookmarks file (HTML): the file is found by itself, the newest first.';
    my @said = ("macOS keeps the files of $name from $APP, and $APP asks for no more access than it has. Export the bookmarks instead:", map { ($_ + 1) . ". $export[$_]" } 0 .. $#export);
    push @said, 'Or from your Google account, where Chrome keeps them when sync is on: at takeout.google.com choose Chrome alone, download it, and import the Bookmarks.html in it the same way.' if $key eq 'chrome';
    return join "\t", @said;
}

sub import_path {                         # a bookmarks file typed as a path: in your home folder, by a path that does not climb out of it
    return import_refused("$UNKEPT, so it imports no bookmarks.") if $INCOGNITO;    # [C16]
    my ($path) = @_;
    $path =~ s/^\s+|\s+$//g;
    $path =~ s{^~/}{import_home() . '/'}e;
    return import_refused('That is not a path in your home folder. Type it whole, for example ~/Downloads/bookmarks.html.') unless index($path, import_home() . '/') == 0 && $path !~ m{(?:^|/)\.\.?(?:/|$)};
    ($IMPORT_KEY, @IMPORT_FROM) = ('file', [plain_name(substr($path, length(import_home()) + 1)), $path]);
    return import_preview('file', 0);
}

sub import_preview {
    return import_refused("$UNKEPT, so it imports no bookmarks.") if $INCOGNITO;    # [C16]
    my ($key, $n) = @_;
    my $from = $key eq ($IMPORT_KEY // '') ? $IMPORT_FROM[$n] : undef;
    return import_refused('Choose the browser again: that choice is no longer there.') unless $from;
    my ($text, $why) = import_read($from->[1]);
    return import_refused($key eq 'safari' ? import_steps($key) : "lzrprf could not read $from->[0]: $why.") unless defined $text;
    $IMPORT_SEEN = 0;
    my ($bar, $rest) = { chrome => \&import_chromium, edge => \&import_chromium, brave => \&import_chromium, vivaldi => \&import_chromium, firefox => \&import_firefox, safari => \&import_safari, file => \&import_html }->{$key}->($text);
    return import_refused("$from->[0] is not a bookmarks file lzrprf can read.") unless $bar;
    $IMPORT = [$BROWSERS{$key}[0], $bar, $rest, $IMPORT_SEEN > $IMPORT_NODES ? $IMPORT_SEEN - $IMPORT_NODES : 0];
    my $plan = import_plan();
    window('import preview ' . import_counts($plan), 'import step preview');
    return idle("$from->[0]: $plan->{marks} bookmarks read. Nothing is written before you press Import.");
}

sub import_counts { my ($plan) = @_; return join(' ', @$plan{qw(marks folders bar skipped left)}) . "\t$plan->{where}\t" . ($plan->{why} // '') }

sub import_plan {                         # what Import would write, in order: ['F', folder] and ['B', folder, name, address]; with what it counts and leaves out
    my ($label, $bar, $rest, $over) = @$IMPORT;
    my ($found) = marks_read();
    my $root = marks_root();
    my %plan = (steps => [], marks => 0, folders => 0, bar => 0, skipped => 0, left => 0, where => '');
    my ($room, $deep, $full, %used) = ($MARKS_MOST - @$found, 0, 0);
    my $count; $count = sub { my $n = 0; $n += $_->{kids} ? $count->($_->{kids}) : 1 for @{ $_[0] }; return $n };
    my $walk; $walk = sub {
        my ($nodes, $folder, $level, $in_bar) = @_;
        for my $node (@$nodes) {
            if ($node->{kids}) {
                if ($level >= $MARKS_DEEP) { $deep += $count->($node->{kids}); next }
                my $name = substr($node->{name} =~ s/[^A-Za-z0-9 ._-]/_/gr =~ s/^[ .]+//r, 0, 60) =~ s/ +\z//r;
                $name = 'Folder' unless length $name;
                my $base = $name;
                for (my $k = 2; $used{"$folder/$name"}; $k++) { $name = "$base $k" }    # two folders of one name in one place stay two
                $used{"$folder/$name"} = 1;
                push @{ $plan{steps} }, ['F', "$folder/$name"];
                $plan{folders}++;
                $walk->($node->{kids}, "$folder/$name", $level + 1, $in_bar);
            } else {
                my ($url) = address($node->{url});
                if (!$url) { $plan{skipped}++; next }
                if ($room <= 0) { $full++; next }
                $room--;
                push @{ $plan{steps} }, ['B', $folder, plain_name($node->{name}), $url];
                $plan{marks}++;
                $plan{bar}++ if $in_bar;
            }
        }
    };
    $walk->($bar, $BAR, 1, 1);
    if (@$rest) {
        my $own = "Imported from $label";
        for (my $k = 2; -e "$root/$own" || -l "$root/$own"; $k++) { $own = "Imported from $label $k" }
        push @{ $plan{steps} }, ['F', $own];
        $plan{where} = $own;
        $walk->($rest, $own, 1, 0);
    }
    $plan{left} = $deep + $full + $over;
    $plan{why} = join(' ', $deep ? "$deep in folders deeper than $MARKS_DEEP, the most LZRBRWSR keeps." : (), $full ? "$full beyond the $MARKS_MOST bookmarks LZRBRWSR holds in all." : (), $over ? "$over beyond the first $IMPORT_NODES things the file holds." : ());
    return \%plan;
}

sub import_go {
    return import_refused("$UNKEPT, so it imports no bookmarks.") if $INCOGNITO;    # [C16]
    return import_refused('Nothing waits to be imported: choose a browser first.') unless $IMPORT;
    my $plan = import_plan();
    busy("Importing $plan->{marks} bookmarks.");
    my ($root, %order, @order_of) = (marks_root());
    mkdir $root, 0700 unless -e $root || -l $root;
    return import_refused("Nothing was imported: $root is not a folder of yours.") unless owned_folder($root);
    marks_into_bar();
    my ($written, $stopped) = (0, '');
    for my $step (@{ $plan->{steps} }) {
        my $dir = "$root/$step->[1]";
        my ($parent, $name);
        if ($step->[0] eq 'F') {
            mkdir $dir, 0700 unless -e $dir || -l $dir;
            ($stopped = "$dir is not a folder of yours"), last unless owned_folder($dir);
            ($parent, $name) = $dir =~ m{\A(.*)/([^/]+)\z};
        } else {
            my $file = mark_file($dir, $step->[2]) or next;
            ($stopped = "a bookmark could not be written in $dir"), last unless mark_written($dir, $file, $step->[2], $step->[3]);
            $written++;
            ($parent, $name) = ($dir, basename($file));
        }
        push @order_of, $parent unless $order{$parent};
        push @{ $order{$parent} }, $name;
    }
    order_set($_, undef, @{ $order{$_} }) for @order_of;    # each folder's new names last in its order, in the source's order
    undef $IMPORT;
    marks_told();
    $plan->{marks} = $written;
    window('import done ' . import_counts($plan), 'import step done');
    return idle("$written bookmarks were imported" . (length $stopped ? ", then the import stopped: $stopped." : '.'));
}

# The style sheets a page names. Its first run may write a line
# "=sheets /path ..." of up to eight paths on its own host, and each is
# fetched the way a picture is: its line in the log first, then "fetch" to the
# same checked addresses the page came from. One clock of $SHEET_SECONDS is
# for starting them all. A sheet not begun by then, a fetch that failed and an
# answer larger than $SHEET_BYTES each go with length 0. Returns the frame for
# the second run, "=sheets", the length of each, a line end, then the answers
# as the site sent them, and how many had bytes; or nothing when a line of the
# log could not be written.                                              # [C14]
sub sheeted {
    my ($named, $host, $where, $kept) = @_;
    open my $request, '>>', "$DIR/busy" or return;
    flock $request, LOCK_SH or return;    # as in visit: no line of these requests falls into a clearing of the log
    my ($until, @got) = (now() + $SHEET_SECONDS);
    for my $n (0 .. $#$named) {
        if (now() >= $until || !alive()) { push @got, ''; next }    # not begun in time: nothing is fetched for it
        my $url = "https://$host$named->[$n]";
        record("$url -> lzrprf connects to the first that answers of: " . join(', ', map { $_->{text} } @$where), $kept) or return;    # [C5] written down first, connected second
        busy('Fetching style sheet ' . ($n + 1) . " of the page: $url");
        my ($got, $why, $from) = fetch($url, $where);    # [C6] [C7]
        record("$url " . ($why ? "failed: $why" : 'answered: ' . length($got) . " bytes from $from"), $kept) or return;
        push @got, !$why && length $got <= $SHEET_BYTES ? $got : '';
    }
    close $request;
    return (join(' ', '=sheets', map { length } @got) . "\n" . join('', @got), scalar grep { length } @got);
}

sub pixels {                              # what a picture run wrote: [wide, high, each row in base64], or nothing when it is not exactly a picture
    my ($wrote) = @_;
    return unless $wrote =~ s/\n\z//;
    my ($head, @rows) = split /\n/, $wrote, -1;
    my ($w, $h) = ($head // '') =~ /^P$N,$N$/ or return;
    return unless $w >= 1 && $h >= 1 && $w <= 1024 && $h <= 1024 && $w * $h <= $PICTURE_PIXELS && @rows == $h;
    return if grep { !/^p[0-9a-f]+$/ || length != 8 * $w + 1 } @rows;
    return [$w, $h, map { encode_base64(pack('H*', substr($_, 1)), '') } @rows];
}

# The application did not give a page. What is said is one of the fixed
# phrases below. And when the application's maker named an address for
# reports, you are asked whether to send one, shown the whole address first:
# one of two words, the release, the build of macOS. Not the address you
# typed, and nothing of the page. It is sent the way a typed address is, and
# written in the log the same way. The question also says what no request can
# hide: the server that receives it sees your internet address and the time.
# Two words and not the seven phrases, because five of the seven are the
# application's own doing: it could fail in one of five ways on purpose, and
# a report that named the way would carry what the application chose. So a
# report says "page" for all five, and "container" for the two that lzrprf
# and the system decide. Ending at once, before the system was asked about
# it, is one of the five: a process that is gone is "ended", never
# "uncontained", so the application cannot choose the word by how fast it
# ends. One thing stays the application's choice and cannot
# be taken from it: whether it fails on a page at all. A report you send
# therefore tells its maker that some page failed on your computer at that
# moment, and not which.
my %FAULT = (
    unstarted => 'its container could not be started',
    uncontained => 'the system did not say that it was in its container, so the answer was not handed to it',
    ended => 'it ended before it was given the page',
    late => 'it did not finish in time',
    large => 'it wrote more than lzrprf takes',
    unfit => 'what it wrote is not a page',
    undrawn => 'the window could not draw what it wrote',
    changed => 'its program on the disk is another file than when this window opened, as after an update, so it was not started. Quit, and start it again',
);

sub fault {
    my ($which) = @_;
    my $says = "$APP did not show this page: $FAULT{$which}.";
    return idle($says) if $which eq 'changed';    # nothing of the application ran: there is nothing to report
    my ($release, undef, $to) = beside();
    my ($build) = mark() =~ /^macOS build (\w+)/;
    my $word = $which =~ /^un(?:started|contained)$/ ? 'container' : 'page';
    my ($url, $host) = $to && $build ? address("$to?fault=$word&release=$release&macos=$build") : ();
    return idle($says) unless $url;
    return idle($says) unless ask("$says Send a report to its developer? It holds one of two words, the number of the release and this Mac's build of macOS, and nothing else. The server that receives it sees your internet address and the time, as every site does. This is all of it, and it is written in the log: $url", "Don't send", 'Send') == 2;    # [C4]
    idle("$says " . (fixed("you sent a report: $url", $url, $host) ? 'The report was sent.' : $UNSAID ? 'lzrprf tried to send the report. Whether it arrived is not shown: the line that says how it ended could not be written to the log.' : 'The report could not be sent.'));
}

# Where a host is. The name is looked up outside every container, after the
# address is in the log, by the system's perl running the few lines of
# $LOOKUP (the same as sub lookup, without the rest of this file to read
# first), given ten seconds. Not by a fork of this process: the system's
# libraries refuse a lookup in a copy that was not started afresh. The way to
# each address it gave is then asked of the system for all of them at once.
my $LOOKUP = 'use Socket qw(SOCK_STREAM NI_NUMERICHOST NI_NUMERICSERV getaddrinfo getnameinfo); my ($failed, @all) = getaddrinfo($ARGV[0], 443, { socktype => SOCK_STREAM }); print map { (getnameinfo($_->{addr}, NI_NUMERICHOST | NI_NUMERICSERV))[1] . "\n" } $failed ? () : @all;';
# Returns the addresses the name leads to, each with whether it is "own":
# not on the public internet, or reached by a route of its own. At most eight
# are returned: the first eight this computer has a way to. An address it has
# no way to is passed over and is not one of the eight. The first sixteen the
# lookup gave are looked at, and no more.
sub find {
    my ($host) = @_;
    if ($PEER ne '-') {                   # "lzrprf try" only: every name leads to the test's listener
        my ($to, $port) = split /:/, $PEER;
        my ($public, $names) = (0);
        $public = grep { chomp; $_ eq $host } <$names> if open $names, '<', "$ROOT/public";    # the names the test's file "public" lists are taken for hosts on the public internet, to try what is fetched there
        return [{ family => AF_INET, addr => pack_sockaddr_in($port, inet_aton($to)), text => $to, own => !$public && !public($to) }];
    }
    my ($found) = said($FIND_SECONDS, '/usr/bin/perl', '-e', $LOOKUP, $host);
    timed('looked-up');
    my (@where, %had, @numbers, $looked);
    for my $text (grep { /^[0-9A-Fa-f:.]+(?:%[A-Za-z0-9]+)?$/ && !$had{$_}++ } split /\n/, $found) {
        last if ++$looked > $LOOKED;
        my ($failed, $one) = getaddrinfo($text, 443, { socktype => SOCK_STREAM, flags => AI_NUMERICHOST });    # a number is turned into a number: nothing is looked up
        push @numbers, { %$one, text => $text } unless $failed || !$one;
    }
    my @families = do { my %once; grep { !$once{$_}++ } map { $_->{family} } @numbers };
    my @says = said_all(5, (map { route_asked($_->{family}, $_->{text}) } @numbers), map { route_asked($_, 'default') } @families);    # the way to each address and the default way, asked of the system all at once
    my %usual = map { $families[$_] => $says[@numbers + $_] } 0 .. $#families;
    for my $at (0 .. $#numbers) {
        last if @where >= $FOUND;
        my $one = $numbers[$at];
        my $route = route_of($one->{family}, $one->{text}, $says[$at], $usual{ $one->{family} }) or next;    # this computer has no way there at all
        push @where, { %$one, text => $one->{text}, own => $route eq 'own' || !public($one->{text}) };
    }
    return (undef, %had ? 'this computer has no way to that host' : 'no such host') unless @where;
    return \@where;
}

# How this computer would send to an address: "internet" by the way it uses
# for the internet at large, "own" by a route of its own (a network this
# computer is in, another computer's network behind a VPN, this computer
# itself), nothing when there is no way. The address being in a public range
# does not make it public for you: a route can lead it into a network of
# your own, and then you are asked.
sub route_asked { my ($family, $text) = @_; return ['/sbin/route', '-n', 'get', ($family == AF_INET6 ? '-inet6' : ()), $text =~ s/%.*//r] }    # the question to the system about the way to one address
sub route {
    my ($family, $text) = @_;
    my ($says) = said(5, @{ route_asked($family, $text) });
    return route_of($family, $text, $says);
}
sub route_of {                            # the answer, from what the system said of the way to the address and, when it was asked already, of the default way
    my ($family, $text, $says, $usual) = @_;
    my ($to) = $says =~ /^\s*destination: (\S+)/m or return;
    return 'internet' if $to eq 'default' || $says =~ /^\s*mask: default\s*$/m;    # the default route: a mask of no bits at all. For IPv6 the system writes its destination as "::" and not as "default", and only the mask says so
    if ($says =~ /^\s*flags: <[^>]*\bWASCLONED\b/m && $text ne 'default') {
        # macOS keeps a route of its own for every address it spoke to a moment ago, a copy of the route
        # that led there. It is the internet's when it leaves by the same door as the default route.
        ($usual) = said(5, @{ route_asked($family, 'default') }) unless defined $usual;
        my @door = map { my $all = $_; join ' ', map { $all =~ /^\s*$_: (\S+)/m ? $1 : '?' } 'gateway', 'interface' } $says, $usual // '';
        return 'internet' if $door[0] eq $door[1] && $door[0] !~ /\?/ && ($usual // '') =~ /^\s*(?:destination|mask): default\s*$/m;    # the mask again: over IPv6 the default route's destination reads "::"
    }
    my ($mask) = $says =~ /^\s*mask: (\S+)/m or return 'own';
    my $bits = inet_pton($family, $mask) // return 'own';
    return unpack('%32b*', $bits) < 8 ? 'internet' : 'own';    # a route for half of all addresses is how some VPNs carry the whole internet
}

# The one connection to the site, made by lzrprf: to an address that was just
# checked and written down, never to the name again. This is the only place
# in this file that connects to anything outside this computer.          # [C6]
sub reach {
    my ($where, $until) = @_;
    return tor_reach($where->[0]{host}, $until) if $where->[0]{tor};    # [C17] through Tor, and never past it: a Tor that does not answer is a request that fails
    for my $one (@$where) {
        my $left = $until - now();
        last if $left <= 0;
        socket(my $site, $one->{family}, SOCK_STREAM, 0) or next;
        $site->blocking(0);
        connect($site, $one->{addr});     # [C6]
        my $ready = '';
        vec($ready, fileno $site, 1) = 1;
        return ($site, $one->{text}) if select(undef, $ready, undef, $left < 10 ? $left : 10) > 0 && !unpack 'i', getsockopt($site, SOL_SOCKET, SO_ERROR);
    }
    return;
}

# The application's tool, opened by its icon at the right end of the strip.
# lzrprf looks at this computer with the system's own programs: its processes
# (ps), the launchd jobs of your account and of the system (launchctl, and
# the property lists of the three LaunchAgents and LaunchDaemons folders,
# read with plutil), and who signed their programs (codesign). What it saw
# goes to the application in its container, as an answer does for a page: no
# network and no file, so nothing of the look leaves this computer. The
# application answers with a list, and lzrprf holds every line of it to its
# own rules before the window is given it (sub tool_checked, sub tool_may).
# A look changes nothing. A change is made only for a row you ticked and then
# confirmed in the window, where each change is said in lzrprf's own words,
# and each is written in the log first: a launchd job of your account is
# switched off (launchctl disable, then bootout), a process of yours is asked
# to end (TERM). Never a job or a process of the system or of Apple, never
# lzrprf's own, never with a password. A job you switched off is kept in
# ~/.lzrprf/quieted, looked at again at each start and every $TOOL_WATCH
# seconds while a window is open, switched off again when it came back, and
# switched on again when you say so (launchctl enable, then bootstrap). An
# incognito window has no tool: it would write.                     # [C20]
my $TOOL_ROWS = 200;                      # DECLARED([C20] the most rows the application may name: more than a list a person ticks through)
my $TOOL_ACTS = 12;                       # DECLARED([C20] the most changes of one row: a product with a dozen jobs and helpers)
my $TOOL_PROCS = 4000;                    # DECLARED([C20] the most processes of one look that are handed on: several times what a busy Mac runs)
my $TOOL_FILES = 400;                     # DECLARED([C20] the most property lists read in one folder of launchd jobs)
my $TOOL_SIGNED = 80;                     # DECLARED([C20] the most programs whose signature is read anew in one look, each about a twentieth of a second of codesign; what one look left out the next reads)
my $TOOL_ASKED = 40;                      # DECLARED([C20] the most loaded jobs with no property list in the three folders that launchd is asked about one by one)
my $TOOL_WATCH = 300;                     # DECLARED([C20] seconds between two looks at the jobs you switched off, while a window is open)
my $TOOL_LABEL = qr/[A-Za-z0-9][A-Za-z0-9._-]{0,199}/;    # a launchd label lzrprf acts on: one written any other way is listed nowhere and never acted on
my (%TOOL, %TOOL_SIGN, %TOOL_FILE);       # the last look (its processes, jobs and rows); the signatures and the property lists read already, each by its file's time and size
my $TOOL_LOOKED;                          # when the jobs you switched off were last looked at; nothing before the first look of a window

sub tool_stand { my $stand = "$ROOT/toolstand"; return $TRY && -d $stand ? $stand : undef }    # "lzrprf try" only: a folder whose files stand for what the system's programs say, so a test acts on no real job and no real process
sub tool_asked {                          # what one of the system's programs says, and whether it ended well
    my ($name, $seconds, @command) = @_;
    my $stand = tool_stand() // return said($seconds, @command);
    open my $in, '<', "$stand/$name" or return ('', 0);
    local $/;
    return (scalar(<$in>) // '', 1);
}
sub tool_ran {                            # [C20] a change, made by one of the system's programs; a test's stand-in notes it and changes nothing
    my ($note, @command) = @_;
    my $stand = tool_stand() // return (said(10, @command))[1];
    return put("$stand/done", O_APPEND, $note);
}
sub tool_plain {                          # text of the system as one line of at most $most bytes: no control character, and UTF-8 or plain ASCII
    my ($text, $most) = @_;
    utf8::encode($text) if utf8::is_utf8($text);
    $text =~ s/[\x00-\x1f\x7f]/ /g;
    if (length $text > $most) { $text = substr($text, 0, $most); $text =~ s/[\xc0-\xff][\x80-\xbf]*\z// }    # not cut inside a character
    my $copy = $text;
    $text =~ s/[^\x20-\x7e]/?/g unless utf8::decode($copy);
    return $text;
}
sub tool_text {                           # [C20] text of the application, shown as text and nowhere acted on: 1 to $most characters, none a control or format character
    my ($text, $most) = @_;
    no warnings 'utf8';
    my $copy = $text;
    return unless utf8::decode($copy) && length $copy >= 1 && length $copy <= $most && $copy !~ /[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]/;
    return $text;
}
sub tool_places {                         # where launchd jobs are written down: [whose, folder]; the first two are your account's
    if (defined(my $stand = tool_stand())) { return (['gui', "$stand/agents"], ['system', "$stand/daemons"]) }
    return (['gui', "$HOME/Library/LaunchAgents"], ['gui', '/Library/LaunchAgents'], ['system', '/Library/LaunchDaemons']);
}
sub tool_services {                       # of what launchctl prints of a domain: the jobs loaded there, each with its process (0: none runs), and the jobs switched off there
    my ($said) = @_;
    my (%loaded, %off);
    my ($block) = $said =~ /^\tservices = \{\n(.*?)^\t\}/ms;
    for (split /\n/, $block // '') { $loaded{$2} = $1 if /^\s+(\d+)\s+\S+\s+(\S+)\s*$/ }
    my ($set) = $said =~ /^\tdisabled services = \{\n(.*?)^\t\}/ms;
    for (split /\n/, $set // '') { $off{$1} = 1 if /^\s+"([^"]+)" => disabled\s*$/ }
    return (\%loaded, \%off);
}
sub tool_file {                           # a launchd property list: its label, the program it runs, that program's arguments, and when it runs (R at load, K kept alive, I on an interval, C by the calendar)
    my ($file) = @_;
    my @is = stat $file or return;
    return unless -f _ && $is[7] <= 1024 * 1024;
    my $key = "$is[9] $is[7]";
    return @{$TOOL_FILE{$file}[1]} if $TOOL_FILE{$file} && $TOOL_FILE{$file}[0] eq $key;
    my ($text, $ok) = said(5, '/usr/bin/plutil', '-convert', 'json', '-o', '-', '--', $file);
    my $list = $ok ? import_json($text) : undef;
    my @got;
    if (ref $list eq 'HASH') {
        my @args = ref $list->{ProgramArguments} eq 'ARRAY' ? grep { defined && !ref } @{$list->{ProgramArguments}} : ();
        my $flags = join '', map { $list->{$_->[0]} ? $_->[1] : () } [RunAtLoad => 'R'], [KeepAlive => 'K'], [StartInterval => 'I'], [StartCalendarInterval => 'C'];
        my $first = @args ? $args[0] : undef;    # read into a name of its own: $args[0] in a list given to grep would make that element when @args is empty, and the join would warn of it
        @got = ($list->{Label}, (grep { defined && !ref } $list->{Program}, $first, $list->{BundleProgram}, '')[0], join(' ', @args), $flags);
    }
    else {                                # a list with a date or data in it, which is no JSON: its label and its program are asked for one by one
        my @one = map { my ($said, $there) = said(5, '/usr/bin/plutil', '-extract', $_, 'raw', '-o', '-', '--', $file); chomp $said; $there ? $said : undef } 'Label', 'Program', 'ProgramArguments.0';
        @got = ($one[0], $one[1] // $one[2] // '', '', '');
    }
    @got = defined $got[0] && !ref $got[0] && $got[0] =~ /^$TOOL_LABEL\z/ ? ($got[0], tool_plain($got[1], 1000), tool_plain($got[2], 400), $got[3]) : ();
    $TOOL_FILE{$file} = [$key, \@got];
    return @got;
}
sub tool_signed {                         # who signed these programs, as codesign says: [path, the team (or "adhoc", "none", "-"), the identifier]
    my @paths = @_;
    my (%key, @ask);
    for my $path (@paths) {
        my @is = stat $path or next;
        $key{$path} = "$is[9] $is[7]";
        push @ask, $path if @ask < $TOOL_SIGNED && !($TOOL_SIGN{$path} && $TOOL_SIGN{$path}[0] eq $key{$path});
    }
    if (@ask) {
        my %asked = map { $_ => 1 } @ask;
        my ($said) = tool_asked('sign', 60, '/bin/sh', '-c', 'for p; do printf "=%s\n" "$p"; "$0" -dv --verbose=2 "$p" 2>&1; done', '/usr/bin/codesign', @ask);
        for my $part (split /^=/m, $said) {
            my ($path, $rest) = split /\n/, $part, 2;
            next unless defined $path && $asked{$path};
            $rest //= '';
            my ($team) = $rest =~ /^TeamIdentifier=([A-Za-z0-9]{1,20})$/m;
            my ($name) = $rest =~ /^Identifier=([\x21-\x7e]{1,200})$/m;
            $team //= $rest =~ /^Signature=adhoc$/m ? 'adhoc' : $rest =~ /not signed at all/ ? 'none' : '-';
            $TOOL_SIGN{$path} = [$key{$path}, $team, $name // '-'];
        }
    }
    return map { $TOOL_SIGN{$_} && $TOOL_SIGN{$_}[0] eq $key{$_} ? [$_, @{$TOOL_SIGN{$_}}[1, 2]] : () } grep { defined $key{$_} } @paths;
}
sub tool_kept {                           # [C20] the launchd jobs you switched off here: [label, its property list or nothing, when]
    open my $in, '<', "${\ shared()}/quieted" or return [];
    return [map { chomp; my @one = split /\t/, $_, -1; @one == 3 && $one[0] =~ /^$TOOL_LABEL\z/ && $one[1] =~ m{^(?:/[\x20-\x7e]{1,1000})?\z} && $one[2] =~ /^[0-9TZ:-]{1,30}\z/ ? [@one] : () } <$in>];
}
sub tool_keep {                           # [C20] that list, written beside the old one and through to the disk, then given its name in one step
    my ($kept) = @_;
    unlink "${\ shared()}/quieted.new";
    if (!@$kept) { return !-e "${\ shared()}/quieted" || unlink "${\ shared()}/quieted" }
    unless (put("${\ shared()}/quieted.new", O_EXCL, map { join "\t", @$_ } @$kept) && rename "${\ shared()}/quieted.new", "${\ shared()}/quieted") { unlink "${\ shared()}/quieted.new"; return 0 }
    synced(shared());
    return 1;
}

# One look. With $full, everything named above; without, only the jobs you
# switched off, which is all the tool needs to open. What is handed to the
# application is lines of text: "me", "proc", "open" (an app that is open
# now), "job", "sign" and "kept". What lzrprf itself saw is held in %TOOL,
# and a change is made against that, never against the application's word.
sub tool_look {
    my ($full) = @_;
    my (%procs, %jobs, %own, %open, @lines);
    my $kept = tool_kept();
    if ($full) {
        my ($list, $listed) = tool_asked('procs', 10, '/bin/ps', '-axww', '-o', 'pid=,ppid=,uid=,lstart=,comm=');
        return unless $listed;
        for (split /\n/, $list) {
            my ($pid, $ppid, $owner, $began, $path) = /^\s*(\d+)\s+(\d+)\s+(\d+)\s+(\S+\s+\S+\s+\d+\s+[\d:]+\s+\d+)\s+(.*?)\s*$/ or next;
            last if keys %procs >= $TOOL_PROCS;
            $procs{$pid} = { ppid => $ppid, uid => $owner, began => $began =~ s/\s+/ /gr, path => tool_plain($path, 1000), args => '' };
        }
        my ($args) = tool_asked('args', 10, '/bin/ps', '-axww', '-o', 'pid=,args=');
        for (split /\n/, $args) { my ($pid, $rest) = /^\s*(\d+)\s+(.*)$/ or next; $procs{$pid}{args} = tool_plain($rest, 400) if $procs{$pid} }
        for (my $up = $$; $up > 1 && $procs{$up} && !$own{$up}; $up = $procs{$up}{ppid}) { $own{$up} = 1 }    # lzrprf's own: this process and what started it, up to launchd
        my %mine = ($$ => 1);
        for (my $grew = 1; $grew;) { $grew = 0; for (keys %procs) { next if $mine{$_} || !$mine{$procs{$_}{ppid}}; $mine{$_} = $own{$_} = $grew = 1 } }    # and all it started: the window's pages, their keepers, the Tor client
        my ($gui, $gui_said) = tool_asked('jobs', 10, '/bin/launchctl', 'print', "gui/$<");
        return unless $gui_said;
        my ($system) = tool_asked('system', 10, '/bin/launchctl', 'print', 'system');
        my %in = (gui => [tool_services($gui)], system => [tool_services($system)]);
        for my $place (tool_places()) {
            my ($domain, $folder) = @$place;
            opendir(my $dir, $folder) or next;
            my @names = sort grep { /\.plist\z/ && !/[\x00-\x1f\x7f]/ } readdir $dir;
            closedir $dir;
            splice @names, $TOOL_FILES if @names > $TOOL_FILES;
            for my $name (@names) {
                my ($label, $program, $with, $flags) = tool_file("$folder/$name") or next;
                next if $jobs{$domain}{$label};
                my ($loaded, $off) = @{$in{$domain}};
                $jobs{$domain}{$label} = { pid => $loaded->{$label} // 0, state => exists $loaded->{$label} ? ($loaded->{$label} ? 'run' : 'load') : $off->{$label} ? 'off' : 'file',
                    program => $program, file => tool_plain("$folder/$name", 1000), flags => $flags . ($off->{$label} ? 'D' : ''), args => $with };
            }
        }
        my $asked = 0;
        for my $domain ('gui', 'system') {    # what is loaded and written down in none of the three folders: an open app, or a job an app registered from inside itself
            my ($loaded, $off) = @{$in{$domain}};
            for my $label (sort keys %$loaded) {
                next if $jobs{$domain}{$label} || $label =~ /^com\.apple\./ || $label !~ /^$TOOL_LABEL\z/;
                if ($label =~ /^application\.(.+?)\.\d+\.\d+\z/) { $open{$1} = 1; next }
                my ($one) = $asked++ < $TOOL_ASKED ? tool_asked("job.$label", 5, '/bin/launchctl', 'print', ($domain eq 'gui' ? "gui/$<" : 'system') . "/$label") : ('');
                my ($program) = $one =~ /^\tprogram = (.+)$/m;
                $jobs{$domain}{$label} = { pid => $loaded->{$label}, state => $loaded->{$label} ? 'run' : 'load', program => tool_plain($program // '', 1000), file => '', flags => $off->{$label} ? 'D' : '', args => '' };
            }
        }
        my $ours = qr{^/(?:System|bin|sbin|usr(?!/local/)|Library/Apple)/};    # the system's own programs: Apple signed them, and they are never changed here
        my (%want, @want);
        for my $path ((map { $_->{program} } map { values %$_ } values %jobs), map { $_->{path} =~ m{^(/.*?\.app)/} ? $1 : $_->{path} } @procs{sort { $a <=> $b } keys %procs}) {
            push @want, $path if $path =~ m{^/} && $path !~ $ours && !$want{$path}++;
        }
        push @lines, map { "proc $_ $procs{$_}{ppid} $procs{$_}{uid} " . ($procs{$_}{began} =~ tr/ /_/r) . "\t$procs{$_}{path}\t$procs{$_}{args}" } sort { $a <=> $b } keys %procs;
        push @lines, map { "open $_" } sort keys %open;
        for my $domain ('gui', 'system') { push @lines, map { my $job = $jobs{$domain}{$_}; "job $domain $_ $job->{pid} $job->{state}\t$job->{program}\t$job->{file}\t$job->{flags}\t$job->{args}" } sort keys %{$jobs{$domain} // {}} }
        push @lines, map { "sign $_->[0]\t$_->[1]\t$_->[2]" } tool_signed(@want);
    }
    push @lines, map { "kept $_->[0]\t$_->[1]\t$_->[2]" } @$kept;
    %TOOL = (procs => \%procs, jobs => \%jobs, own => \%own, kept => { map { $_->[0] => $_ } @$kept });
    return join '', map { "$_\n" } "me $<", @lines;
}

# lzrprf's own rules for a change the application names, whatever the
# application says of it: what the change is, in lzrprf's own words, or
# nothing when lzrprf does not make it. A process: one of yours that lzrprf
# itself saw in this look, not lzrprf, what it started or what started it,
# and not a program of the system. A launchd job: one of your account that
# lzrprf itself saw, written down in one of your account's two folders or in
# none, and not one of Apple's or an open app. A job switched on again: one
# you switched off here.                                             # [C20]
sub tool_may {
    my ($kind, $what) = @_;
    if ($kind eq 'stop') {
        my $proc = $what =~ /^[1-9][0-9]{0,6}\z/ ? $TOOL{procs}{$what} : undef;
        return unless $proc && $what > 1 && $proc->{uid} == $< && !$TOOL{own}{$what};
        return unless $proc->{path} =~ m{^/} && $proc->{path} !~ m{^/(?:System|bin|sbin|usr(?!/local/)|Library/Apple)/};
        return "the process $what, started $proc->{began}, $proc->{path}";
    }
    return unless $what =~ /^$TOOL_LABEL\z/ && $what !~ /^(?:com\.apple\.|application\.)/i;
    if ($kind eq 'quiet') {
        my $job = $TOOL{jobs}{gui}{$what} or return;
        return if $job->{state} eq 'off';
        my ($folder) = $job->{file} =~ m{^(.*)/[^/]+\z};
        return if $job->{file} ne '' && !grep { $_->[0] eq 'gui' && $_->[1] eq $folder } tool_places();
        return "the launchd job $what of your account" . ($job->{file} ne '' ? ", written down in $job->{file}" : '') . ($job->{program} ne '' ? ", which runs $job->{program}" : '');
    }
    my $kept = $kind eq 'wake' ? $TOOL{kept}{$what} : undef or return;
    return "the launchd job $what, switched off here on $kept->[2]" . ($kept->[1] ne '' ? ", written down in $kept->[1]" : '');
}

# The application's answer, checked: its title, its words, the heading of its
# list, the words of its three buttons (look, switch off, switch on again),
# and its rows, each a tag, a title and a sentence, with the changes it names
# for that row. Text is shown as text. A change is kept only when sub
# tool_may lets it be made, and a row with none left cannot be ticked. An
# answer with one line in no such form is not shown at all.           # [C20]
sub tool_checked {
    my ($wrote) = @_;
    return unless defined $wrote && $wrote =~ s/\n\z//;
    my @lines = split /\n/, $wrote, -1;
    return if @lines > ($TOOL_ACTS + 1) * $TOOL_ROWS + 8;
    my (%said, %rows, @order);
    for (@lines) {
        if (/^(title|head) (.+)\z/s) { defined($said{$1} = tool_text($2, 60)) or return }
        elsif (/^words (.+)\z/s) { defined($said{words} = tool_text($1, 600)) or return }
        elsif (/^button (sense|act|undo) (.+)\z/s) { defined($said{$1} = tool_text($2, 40)) or return }
        elsif (/^row (0|[1-9][0-9]{0,2}) ([^\t]*)\t([^\t]*)\t([^\t]*)\z/s) {
            return if $1 >= $TOOL_ROWS || $rows{$1};
            my %row = (tag => tool_text($2, 24), title => tool_text($3, 100), detail => tool_text($4, 600), acts => []);
            return if grep { !defined } @row{qw(tag title detail)};
            $rows{$1} = \%row;
            push @order, $1;
        }
        elsif (/^(stop|quiet|wake) (0|[1-9][0-9]{0,2}) ([\x21-\x7e]{1,200})\z/) {
            my $row = $rows{$2} or return;
            return if @{$row->{acts}} >= $TOOL_ACTS;
            push @{$row->{acts}}, [$1, $3];
        }
        else { return }
    }
    return unless defined $said{title};
    for my $row (values %rows) {
        my @acts = map { my $fact = tool_may(@$_); defined $fact ? [@$_, $fact] : () } @{$row->{acts}};
        my @wake = grep { $_->[0] eq 'wake' } @acts;
        @acts = @wake ? @wake : ((grep { $_->[0] eq 'quiet' } @acts), grep { $_->[0] eq 'stop' } @acts);    # a job is switched off before its process is asked to end, so launchd does not start it again
        @$row{qw(acts mode)} = (\@acts, @wake ? 'undo' : @acts ? 'act' : 'none');
        $row->{fact} = tool_plain(join('; ', map { ($_->[0] eq 'stop' ? 'Ends ' : $_->[0] eq 'quiet' ? 'Switches off ' : 'Switches on again ') . $_->[2] } @acts), 4000);
    }
    return { %said, rows => \%rows, order => \@order };
}

sub tool_none { window('tool none'); return idle($_[0]) }

# "tool open" and "tool sense", from the window: the look, the application's
# answer to it, and the list the window shows. $said: what lzrprf did a
# moment ago, in its own words, shown over the list.
sub tool_shown {
    my ($how, $said) = @_;
    return tool_none('An incognito window has no tool of the application: it would write what you switch off.') if $INCOGNITO;
    window('tool busy ' . ($how eq 'sense' ? 'Reading the processes and the launchd jobs of this computer' : 'Asking the application'));
    my $look = tool_look($how eq 'sense');
    return tool_none('The system did not list its processes and launchd jobs, so the application was asked nothing.') unless defined $look;
    my ($wrote, $why) = contained('tool', "=tool $how\n$look", undef, 0, 1);    # [C1] [C3] in the page container, as a picture is: no network, no file
    my $list = defined $wrote ? tool_checked($wrote) : undef;
    return tool_none(defined $wrote ? 'This application has no tool, or its answer was not in the form lzrprf takes, so nothing of it is shown.' : "The application's tool was not run: " . ($why // 'it did not start') . '.') unless $list;
    $TOOL{rows} = $list->{rows};
    record("You looked at this computer's processes and launchd jobs with the application's tool: " . @{$list->{order}} . ' rows, nothing changed') if $how eq 'sense' && !defined $said;
    window('tool begin', "tool title $list->{title}", (map { defined $list->{$_} ? "tool $_ $list->{$_}" : () } 'words', 'head'), (map { defined $list->{$_} ? "tool button $_ $list->{$_}" : () } 'sense', 'act', 'undo'),
        (map { my $row = $list->{rows}{$_}; "tool row $_ $row->{mode}\t$row->{tag}\t$row->{title}\t$row->{detail}\t$row->{fact}" } @{$list->{order}}), defined $said ? "tool said $said" : (), 'tool end');
    return;
}

# "tool act I,I,.." and "tool undo I,I,..", from the window, after you ticked
# those rows and, for a switching off, confirmed lzrprf's own words for each.
# A list is acted on once: after it the computer is looked at again.  # [C20]
sub tool_done {
    my ($kind, $picked) = @_;
    my $rows = delete $TOOL{rows};
    return tool_none('That list is no longer the newest look at this computer, so nothing was changed. Look again.') if $INCOGNITO || !$rows;
    window('tool busy ' . ($kind eq 'act' ? 'Switching off what you ticked' : 'Switching on again what you ticked'));
    my (%seen, @did, @not);
    for my $i (split /,/, $picked) {
        my $row = $rows->{$i};
        next if $seen{"row $i"}++ || !$row || $row->{mode} ne $kind;
        for my $act (@{$row->{acts}}) {
            next if $seen{"$act->[0] $act->[1]"}++;
            my ($ok, $says) = $act->[0] eq 'stop' ? tool_stop($act->[1]) : $act->[0] eq 'quiet' ? tool_quiet($act->[1]) : tool_wake($act->[1]);
            push @{$ok ? \@did : \@not}, $says;
        }
    }
    my $said = join ' ', @did ? 'Done: ' . join('; ', @did) . '.' : (), @not ? 'Not done: ' . join('; ', @not) . '.' : ();
    return tool_shown('sense', tool_plain($said, 3000) || 'Nothing you ticked is a change lzrprf makes.');
}
sub tool_stop {                           # [C20] a process of yours is asked to end: looked at again first, and ended only when it is still the one that was listed
    my ($pid) = @_;
    my $fact = tool_may('stop', $pid) or return (0, "process $pid is not one lzrprf ends");
    my $proc = $TOOL{procs}{$pid};
    my ($now) = tool_asked("proc.$pid", 5, '/bin/ps', '-o', 'uid=,lstart=,comm=', '-p', $pid);
    my ($owner, $began, $path) = $now =~ /^\s*(\d+)\s+(\S+\s+\S+\s+\d+\s+[\d:]+\s+\d+)\s+(.*?)\s*$/ or return (1, "process $pid had ended already");
    return (0, "process $pid is no longer the one that was listed") unless $owner == $proc->{uid} && ($began =~ s/\s+/ /gr) eq $proc->{began} && tool_plain($path, 1000) eq $proc->{path};
    record("You ended a process from the application's tool: $fact") or return (0, "process $pid: the log could not be written, so it was left running");    # written down first
    return (tool_ran("TERM $pid"), "process $pid was asked to end") if defined tool_stand();
    kill('TERM', $pid) or return (0, "process $pid could not be asked to end");
    for (my $until = now() + 2; now() < $until && kill(0, $pid);) { Time::HiRes::sleep(0.05) }
    return (1, kill(0, $pid) ? "process $pid was asked to end and is still ending" : "process $pid ended");
}
sub tool_off {                            # [C20] a launchd job of your account, switched off and taken out of launchd; true when launchd no longer holds it
    my ($label) = @_;
    my $off = tool_ran("disable $label", '/bin/launchctl', 'disable', "gui/$</$label");
    tool_ran("bootout $label", '/bin/launchctl', 'bootout', "gui/$</$label");    # of a job that is not loaded there is nothing to take out, and launchctl says so: that is no failure
    for (my $until = now() + 3; now() < $until;) {
        return $off unless (tool_asked("job.$label.after", 5, '/bin/launchctl', 'print', "gui/$</$label"))[1];
        Time::HiRes::sleep(0.2);
    }
    return 0;
}
sub tool_quiet {                          # [C20]
    my ($label) = @_;
    my $fact = tool_may('quiet', $label) or return (0, "launchd job $label is not one lzrprf switches off");
    my $job = $TOOL{jobs}{gui}{$label};
    record("You switched a launchd job off from the application's tool: $fact") or return (0, "launchd job $label: the log could not be written, so it was left as it is");    # written down first
    my $kept = tool_kept();
    @$kept = ((grep { $_->[0] ne $label } @$kept), [$label, $job->{file} =~ m{^/[\x20-\x7e]{1,1000}\z} ? $job->{file} : '', strftime('%Y-%m-%dT%H:%M:%SZ', gmtime)]);
    tool_keep($kept) or return (0, "launchd job $label: the list of what you switched off could not be written, so it was left as it is");
    return tool_off($label) ? (1, "launchd job $label is switched off") : (0, "launchd job $label could not be switched off");
}
sub tool_wake {                           # [C20] a job you switched off here, switched on again: enabled, and loaded again when its property list is still there
    my ($label) = @_;
    my $fact = tool_may('wake', $label) or return (0, "launchd job $label is not one you switched off here");
    my $file = $TOOL{kept}{$label}[1];
    record("You switched a launchd job on again from the application's tool: $fact") or return (0, "launchd job $label: the log could not be written, so it was left switched off");
    my $on = tool_ran("enable $label", '/bin/launchctl', 'enable', "gui/$</$label");
    tool_ran("bootstrap $label", '/bin/launchctl', 'bootstrap', "gui/$<", $file) if $file ne '' && -f $file;
    tool_keep([grep { $_->[0] ne $label } @{tool_kept()}]);
    return $on ? (1, "launchd job $label is switched on again" . ($file ne '' && -f $file ? '' : ', and starts when its app or the next login starts it')) : (0, "launchd job $label could not be switched on again");
}

# The jobs you switched off, looked at again: at the start of a window and
# every $TOOL_WATCH seconds while it is open. One that is loaded again, or
# no longer switched off, was put back by its app or its installer: it is
# switched off again, as you chose, written in the log first, and the window
# lights the tool's icon. Nothing else of the computer is read for this, and
# with nothing switched off nothing is read at all.                   # [C20]
sub tool_due {                            # the seconds until the next such look; nothing when there is nothing to look at
    return if $INCOGNITO || !-s "${\ shared()}/quieted";
    my $left = ($TOOL_LOOKED // now()) + $TOOL_WATCH - now();
    return $left > 1 ? $left : 1;
}
sub tool_watch {
    return if $INCOGNITO || defined $TOOL_LOOKED && now() < $TOOL_LOOKED + $TOOL_WATCH;
    $TOOL_LOOKED = now();
    my $kept = tool_kept();
    return unless @$kept;
    my ($gui, $said) = tool_asked('jobs', 10, '/bin/launchctl', 'print', "gui/$<");
    return unless $said;
    my ($loaded, $off) = tool_services($gui);
    my @back = grep { exists $loaded->{$_} || !$off->{$_} } map { $_->[0] } @$kept;
    @back = grep { record("The launchd job $_, which you switched off, was switched on again by something else, and lzrprf switched it off again") && tool_off($_) } @back;
    window('tool back ' . @back) if @back;
    return;
}

# Tor, on one click (ARCHITECTURE.md §7.11). The client is Arti, the Tor Project's own, built from
# source and put beside the program by the installer, named in the release file like every file
# there (sub paired) and compared again before it starts. It runs only between "tor on" and
# "tor off" from the window, or until the window ends: nothing of it is held before or after. It
# runs in a container of its own: it reads its program, the system's libraries and one folder of
# lzrprf's, $DIR/tor, where it keeps the directory of relays it downloaded; it connects out over
# TCP and listens on the loopback alone. lzrprf hands it the host name over SOCKS5 and carries
# the bytes as for any request; nothing is looked up on this computer, and every site goes out
# under its own SOCKS name, so two sites never share a circuit. A small shell stands between
# lzrprf and the client and ends it when lzrprf's end of a pipe closes, so a window that ends in
# any way ends its Tor too. While Tor is wanted and not ready, nothing is fetched: never directly.
my $TOR_CONTAINER = <<'END';
(version 1)
(deny default)
(allow process-exec (literal (param "BIN")))
(allow process-fork)
(allow signal (target self))
(allow sysctl-read)
(allow file-read* file-map-executable
  (subpath "/usr/lib") (subpath "/System/Library") (subpath "/System/Cryptexes")
  (subpath "/Library/Apple/System/Library") (subpath "/private/var/db/dyld")
  (literal (param "BIN")))
(allow file-read-data (literal "/"))
(allow file-read-metadata (literal "/") (literal "/private") (literal "/private/tmp") (literal "/tmp")
  (literal "/private/var") (literal "/var") (literal "/Users") (literal "/private/etc") (literal "/etc"))
(allow file-read* (literal "/dev/urandom") (literal "/dev/random") (literal "/dev/null"))
(allow file-write-data (literal "/dev/null"))
(allow file-read* file-write* (subpath (param "DATA")))
(allow file-read-metadata (path-ancestors (param "DATA")))
(allow network-outbound (remote tcp "*:*"))
(allow network-bind network-inbound (local tcp "localhost:*"))
END
my $TOR_SECONDS = 90;                     # DECLARED(the most a start may take; a cold start measured 2 to 4 s, a slow network takes longer)
my @TOR_STEPS = (                         # the client's own log lines, each the first of a step the window shows
    [qr/Looking for a consensus|usable directory from cache|good directory from cache|Fetching a consensus/, 1, 10, 'Reading the directory of relays'],
    [qr/Downloading certificates/, 2, 30, 'Checking the directory'],
    [qr/Downloading microdescriptors/, 3, 55, 'Learning the relays'],
    [qr/Marked consensus usable|Directory is complete|enough information to build circuits/, 4, 85, 'Building circuits'],
    [qr/Sufficiently bootstrapped; proxy now functional/, 5, 100, 'Connected to Tor'],
);
sub tor_client {                        # the client, and whether it is a test's stand-in
    if ($TRY && open my $instead, '<', "$ROOT/torclient") { chomp(my $line = <$instead> // ''); return ($line, 1) }    # "lzrprf try" only: the test's stand-in, a perl script
    return (dirname($PROGRAM) . '/arti', 0);
}
sub tor_where { return $TOR ? [{ tor => 1, host => $_[0], text => 'Tor' }] : (undef, 'Tor is on and not connected, so nothing was fetched: not through Tor, and not directly') }
sub tor_on {                              # [C17] started on request only, in its own container, and checked against the release file
    return window('tor on') if $TOR;
    $TOR_WANTED = 1;
    my ($bin, $stand_in) = tor_client();
    my ($named) = map { /^file arti ([0-9a-f]{64})$/ ? $1 : () } release_lines();
    return tor_failed("the Tor client is not beside $APP: this release has none") unless -f $bin && ($stand_in || -x _);    # a stand-in is run by perl
    return tor_failed('the Tor client is another file than the release names') if !$TRY && ($named // '') ne (sum_of($bin) // '');
    my $data = "$DIR/tor";
    mkdir $data, 0700;
    return tor_failed("lzrprf could not make the folder $data") unless -d $data && !-l $data;
    unlink "$data/port", "$data/log";
    open my $cfg, '>', "$data/config.toml" or return tor_failed("lzrprf could not write $data/config.toml");
    print $cfg join("\n", '[proxy]', 'socks_listen = "127.0.0.1:auto"', 'dns_listen = 0', '[logging]', 'console = "info"', '[storage]', qq{cache_dir = "$data/cache"}, qq{state_dir = "$data/state"}, qq{port_info_file = "$data/port"},
        '[address_filter]', 'allow_onion_addrs = true', '[preemptive_circuits]', 'disable_at_threshold = 2', 'initial_predicted_ports = [443]', 'min_exit_circs_for_port = 1', 'prediction_lifetime = "10 minutes"',
        '[circuit_timing]', 'disused_circuit_timeout = "5 minutes"', '[system]', 'max_files = 1024', 'memory.max = "64 MiB"', 'memory.low_water = "48 MiB"', '');
    close $cfg;
    pipe(my $hold, my $guard) or return tor_failed('lzrprf could not start the Tor client');
    open my $log, '>', "$data/log" or return tor_failed("lzrprf could not write $data/log");
    my $pid = fork // return tor_failed('lzrprf could not start the Tor client');
    if (!$pid) {
        close $guard;
        my @client = $stand_in ? ('/usr/bin/perl', $bin) : ('/usr/bin/sandbox-exec', '-D', "BIN=$bin", '-D', "DATA=$data", '-p', $TOR_CONTAINER, $bin);    # a test's stand-in is a script, which the container (one named program, nothing it starts) cannot run: the selftest tries the container on its own
        become($hold, $log, $log, '/bin/sh', '-c', '"$@" & child=$!; read held; kill $child; wait', 'lzrprf-tor', @client, 'proxy', '-c', "$data/config.toml");
    }
    close $hold;
    close $log;
    $guard->autoflush(1);
    $TOR = { pid => $pid, guard => $guard };
    record("you turned Tor on: lzrprf starts the Tor client, $bin, in its own container") or return tor_off('the log could not be written');
    window('tor step 0 0 Starting the Tor client');
    my ($until, $read, $step) = (now() + $TOR_SECONDS, 0, 0);
    while (now() < $until) {
        my $event = hear(0.2);
        return tor_off('the window closed') unless defined $event;
        if ($event eq 'tor off') { return tor_off('you stopped Tor before it connected') }
        push @HELD, $event if length $event;    # the rest is heard once Tor is connected or stopped
        return tor_failed('the Tor client ended') if waitpid($pid, 1) == $pid;    # 1: WNOHANG
        open my $in, '<', "$data/log" or next;
        seek $in, $read, 0;
        while (my $line = <$in>) {
            last unless $line =~ /\n\z/;
            $read += length $line;
            return tor_failed('Tor could not build a circuit') if $line =~ /circuit build retry limit|Unable to bootstrap/;
            for my $one (grep { $_->[1] > $step && $line =~ $_->[0] } @TOR_STEPS) { $step = $one->[1]; window("tor step $one->[1] $one->[2] $one->[3]") }
        }
        if ($step == 5 && open my $port, '<', "$data/port") {
            my ($number) = (join '', <$port>) =~ /"socks"[^\]]*?127\.0\.0\.1:(\d{1,5})"/s;
            next unless $number;
            $TOR->{port} = $number;
            record('Tor is connected: every address is fetched through it from here on, one circuit for each site') or return tor_off('the log could not be written');
            window('tor on');
            return idle('Tor is connected. Every address is fetched through it, one circuit for each site, and nothing is looked up on this Mac.');
        }
    }
    return tor_failed("Tor did not connect in $TOR_SECONDS seconds");
}
sub tor_failed {
    my ($why) = @_;
    tor_off();
    $TOR_WANTED = 1;                      # still wanted: nothing is fetched directly until Tor is turned off
    record("Tor did not connect: $why");
    window("tor failed $why");
    return idle("Tor did not connect: $why. Nothing is fetched until it connects or you turn it off.");
}
sub tor_off {
    my ($why) = @_;
    $TOR_WANTED = 0;
    my $was = $TOR or return defined $why ? (window('tor off'), idle('Tor is off.')) : ();
    $TOR = undef;
    close $was->{guard};                  # the shell between ends the client as its pipe closes
    my $until = now() + 3;
    while (now() < $until) { last if waitpid($was->{pid}, 1) == $was->{pid}; Time::HiRes::sleep(0.05) }
    if (waitpid($was->{pid}, 1) == 0) { kill 'KILL', $was->{pid}; waitpid($was->{pid}, 0) }
    return unless defined $why;
    record("Tor is off: $why");
    window('tor off');
    return idle('Tor is off: every address is fetched directly again.');
}
# One connection through Tor: to the client on the loopback, then SOCKS5 with the host name, and
# the site's host as the user name, so Tor gives each site its own circuit.
sub tor_reach {
    my ($host, $until) = @_;
    return unless $TOR && $TOR->{port} && waitpid($TOR->{pid}, 1) == 0;
    socket(my $tor, AF_INET, SOCK_STREAM, 0) or return;
    connect($tor, pack_sockaddr_in($TOR->{port}, inet_aton('127.0.0.1'))) or return;    # the loopback: this computer, never the internet
    my $said = sub {
        my ($send, $want) = @_;
        syswrite($tor, $send) == length $send or return '' if length $send;
        my $got = '';
        while (length $got < $want) {
            my $ready = '';
            vec($ready, fileno $tor, 1) = 1;
            my $left = $until - now();
            return '' if $left <= 0 || select($ready, undef, undef, $left) <= 0;
            sysread($tor, $got, $want - length $got, length $got) or return '';
        }
        return $got;
    };
    return unless $said->("\x05\x01\x02", 2) eq "\x05\x02";
    return unless $said->(pack('C C/a* C/a*', 1, substr($host, 0, 255), 'lzrbrwsr'), 2) eq "\x01\x00";
    my $head = $said->(pack('C4 C/a* n', 5, 1, 0, 3, $host, 443), 4);
    return unless length $head == 4 && substr($head, 0, 2) eq "\x05\x00";
    my $kind = ord substr($head, 3, 1);
    my $rest = $kind == 1 ? 6 : $kind == 4 ? 18 : $kind == 3 ? 2 + ord $said->('', 1) : return;
    return unless length $said->('', $rest) == $rest;
    $tor->blocking(0);
    return ($tor, 'Tor');
}

# What a site is sent, inside the encryption, for an address: these bytes,
# made from the address and from nothing else but one fixed browser name,
# LZRBRWSR: no version, no other word, the same from every computer and every
# release (some sites answer a request with no browser name only with a
# redirect, so it names one). The request of a page you visit says too which
# answers it takes, in one fixed line (some sites refuse a request that does
# not); a picture, a style sheet, the release file and what a page kept
# running asks for do not carry it. No cookie, no language, no page you came from,
# no number of this computer or of this copy. Every computer that runs lzrprf
# sends the same bytes for the same address, so they tell a site nothing
# about which one you are. curl is
# told to send exactly this (the switches in "fetch"), and selftest compares
# these bytes with the bytes its test site really received.              # [C7]
my $BROWSER = 'LZRBRWSR';                # DECLARED: the one browser name every request carries, the owner's order of 2026-11-20; a fixed word, never a version or anything of this computer
my $PAGE_ACCEPT = 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8';    # DECLARED: the kinds of answer the request of a page you visit takes, the owner's order of 2026-11-21; one fixed line, the same on every computer
sub request {
    my ($url, $page) = @_;                # $page: the request of a page you visit (sub visit), the one that says which answers it takes
    my ($host, $rest) = $url =~ m{^https://([^/]+)(/.*)$} or return '';
    return "GET $rest HTTP/1.1\r\nHost: $host\r\nUser-Agent: $BROWSER\r\n" . ($page ? "Accept: $PAGE_ACCEPT\r\n" : '') . "Accept-Encoding: identity\r\nConnection: close\r\n\r\n";
}

# The request. curl does the https, and it is told the address and nothing
# else: the bytes above. It has no network. It gets one socket file; when it
# comes there, and the system says that it is contained, lzrprf connects to
# the site and carries the bytes both ways, which are encrypted between curl
# and the site. curl is held to https, follows no redirect, tries once, takes
# no setting from a file or a variable, and the certificate must prove the
# host to the system's list of authorities. It keeps nothing for a later
# request, because it can write nothing: each request is a new curl with an
# empty memory, so no cookie, no stored answer and no earlier connection
# comes back to a site.                                                  # [C7]
# One clock runs for the whole request, looked at once a round, and a round
# waits at most a second. No more is carried either way than one request and
# one answer need: a side that sent more than its allowance has nothing more
# passed on, and the request fails. Returns the answer, or why there is
# none, and the address that answered.
# A request of a page kept running ($ask, [C19]) is the same request with at
# most three things more, each made by lzrprf from what it checked: HEAD in
# place of GET, or POST with the page's body (handed to curl on its input) and
# its type of three; and for another host than the page's, the page's Origin.
sub fetch {
    my ($url, $where, $ask, $page) = @_;    # $page: the request of a page you visit, which carries the line Accept (sub request)
    my ($way, $roots) = ("$DIR/way.$$", $PEER ne '-' ? "$ROOT/authority.pem" : $ROOTS);
    my $none = 'the request could not be made';
    my $up = $ask && $ask->{method} eq 'POST' ? $ask->{body} : $ask && defined $ask->{key} ? "Authorization: Bearer $ask->{key}\n" : undef;    # [C19] the body a page's POST carries, all that is carried besides the request; or the key that reads the answer to a support request, as a line curl adds to its request, so that no list of processes shows it (sub support_read)
    my @asked = !$ask ? () : ($ask->{method} eq 'HEAD' ? ('--head') : (), defined $ask->{key} ? ('-H', '@-') : (), $ask->{method} eq 'POST' ? ('--data-binary', '@-', '-H', 'Content-Type:' . ($ask->{type} eq '-' ? '' : " $ask->{type}"), '-H', 'Expect:') : (), defined $ask->{origin} ? ('-H', "Origin: $ask->{origin}") : ());    # [C19]
    unlink $way;
    my $listen = IO::Socket::UNIX->new(Local => $way, Listen => 1) or return (undef, $none);
    pipe(my $from_curl, my $out) or return (undef, $none);
    my ($body_in, $to_curl);
    if (defined $up) { pipe($body_in, $to_curl) or return (undef, $none) }
    my $curl = fork // return (undef, $none);
    if (!$curl) {
        %ENV = ();                        # curl takes no setting from the environment
        my @curl = ($CURL, '-q', '-g', '-s', '-i', '--raw', '--path-as-is', '--proto', '=https', '--tlsv1.2', '--http1.1', '--noproxy', '*', '--no-sessionid', '--ciphers', $TLS_CIPHERS, '--curves', $TLS_CURVES,
            '--cacert', $roots, '--max-time', $FETCH_SECONDS, '--max-filesize', $FETCH_BYTES, '--write-out', "$WROTE%{certs}",
            '-H', "User-Agent: $BROWSER", '-H', $page ? "Accept: $PAGE_ACCEPT" : 'Accept:', '-H', 'Accept-Encoding: identity', '-H', 'Connection: close', @asked,
            '--unix-socket', $way, '--', $url);
        if ($PEER ne '-' && open my $instead, '<', "$ROOT/fetcher") { chomp(@curl = <$instead>) }    # "lzrprf try" only: the test's own program in curl's place, to probe this container too
        become($body_in, $out, undef, '/bin/sh', '-c', $FETCH_LIMITS, 'lzrprf', contain($FETCH, shift @curl, '-D', "WAY=$way", '-D', "ROOTS=$roots"), @curl);    # the memory limit first, then the container
    }
    close $out;
    if (defined $up) {                    # [C19] the body goes to curl as it reads it, never waited for in a write
        close $body_in;
        fcntl($to_curl, POSIX::F_SETFL(), O_NONBLOCK);
        if (!length $up) { close $to_curl; undef $to_curl }
    }
    my ($got, $until, $unreached, $loose, $done, $peer, @links) = ('', now() + $FETCH_SECONDS, 0, 0, 0);    # a link: from, to, bytes held, 1 while "from" is open, bytes carried
    while (now() < $until && length $got <= $FETCH_BYTES && alive() && !grep { $_->[4] > $_->[5] } @links) {
        my ($read, $write) = ('', '');
        vec($read, fileno $from_curl, 1) = 1;
        vec($read, fileno $listen, 1) = 1 unless @links;
        vec($write, fileno $to_curl, 1) = 1 if $to_curl;
        for (@links) {
            vec($read, fileno $_->[0], 1) = 1 if $_->[3] == 1 && length $_->[2] < 262144;
            vec($write, fileno $_->[1], 1) = 1 if length $_->[2];
        }
        select($read, $write, undef, 1) > 0 or next;
        if (!@links && vec($read, fileno $listen, 1)) {
            my $in = $listen->accept or last;
            timed('curl-came');
            if (!inside($curl)) { $loose = 1; last }    # [C3] the system did not say that curl is contained: no connection is made for it
            timed('curl-inside');
            (my $site, $peer) = reach($where, $until);
            if (!$site) { $unreached = 1; last }
            timed('connected');
            $in->blocking(0);
            @links = ([$in, $site, '', 1, 0, $SENT_BYTES + length($up // '')], [$site, $in, '', 1, 0, $WIRE_BYTES]);    # [C19] a page's POST may carry its body more
            next;
        }
        for my $link (@links) {
            my ($from, $to) = @$link;
            if ($link->[3] == 1 && vec($read, fileno $from, 1)) {
                my $n = sysread($from, $link->[2], 65536, length $link->[2]);
                $link->[3] = 0 if defined $n ? !$n : !$!{EAGAIN};
                $link->[4] += $n // 0;
            }
            if (length $link->[2] && $link->[4] <= $link->[5] && vec($write, fileno $to, 1)) {    # nothing more is passed on once more came than the allowance: so no more than the allowance ever is
                my $sent = syswrite($to, $link->[2]);
                substr($link->[2], 0, $sent, '') if $sent;
                @$link[2, 3] = ('', 0) unless defined $sent || $!{EAGAIN};
            }
            if (!$link->[3] && !length $link->[2]) {    # one side has ended and all it sent is passed on
                shutdown($to, 1);
                $link->[3] = 2;
            }
        }
        if ($to_curl && vec($write, fileno $to_curl, 1)) {
            my $sent = syswrite($to_curl, $up);
            substr($up, 0, $sent, '') if $sent;
            if (!length $up || !defined $sent && !$!{EAGAIN}) { close $to_curl; undef $to_curl }
        }
        if (vec($read, fileno $from_curl, 1)) { sysread($from_curl, $got, 65536, length $got) or ($done = 1, last) }
    }
    close $to_curl if $to_curl;
    my $late = now() >= $until;
    my $at = rindex $got, $WROTE;            # curl writes the certificates after the whole answer, so the last such line is curl's own, whatever the answer holds
    my $certs = $at >= 0 ? substr($got, $at + length $WROTE) : '';
    substr($got, $at) = '' if $at >= 0;
    unlink $way;
    my $how = ended($curl, $done ? 2 : 0);    # curl is gone, whatever it was doing, before anything is said about the answer
    my $exit = $how >> 8;
    return (undef, 'the system did not say that curl was in its container') if $loose;
    return (undef, 'the answer is larger than lzrprf takes') if length $got > $FETCH_BYTES || $exit == 63 || @links && $links[1][4] > $WIRE_BYTES;
    return (undef, $none) if @links && $links[0][4] > $links[0][5];
    return (undef, 'could not connect') if $unreached;
    return (undef, 'the site did not answer in time') if $late || $exit == 28;
    return ($got, undef, $peer, $certs) if $how == 0 && length $got && defined $peer;
    return (undef, 'the certificate does not prove the host') if grep { $exit == $_ } 51, 53, 54, 58, 59, 60, 66, 77, 80, 82, 83, 90, 91;
    return (undef, 'no secure connection could be made') if $exit == 35;
    return (undef, $none);
}

sub alive { !$RUN || getppid() == $RUN }  # the window is still there; without it nothing is carried on

sub public {
    my ($address) = @_;
    if (my $four = inet_pton(AF_INET, $address)) { return public4(unpack 'N', $four) }
    my $six = inet_pton(AF_INET6, $address) or return 0;
    my @part = unpack 'n8', $six;
    my $inside = ($part[6] << 16) | $part[7];                                    # where an address of the older kind is carried
    return public4($inside) if !grep({ $_ } @part[0 .. 4]) && $part[5] == 0xffff;
    return public4($inside) if $part[0] == 0x64 && $part[1] == 0xff9b && !grep { $_ } @part[2 .. 5];
    return 0 unless ($part[0] & 0xe000) == 0x2000;                               # only the block the public internet uses
    return 0 if $part[0] == 0x2002 || $part[0] == 0x2001 && ($part[1] < 0x200 || $part[1] == 0xdb8) || ($part[0] & 0xfff0) == 0x3ff0;    # tunnels, special uses, examples
    return 1;
}

sub public4 {
    my ($number) = @_;
    for (qw(0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24
            192.88.99.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/3)) {
        my ($net, $bits) = split m{/};
        return 0 if ($number & (0xffffffff << (32 - $bits) & 0xffffffff)) == unpack 'N', inet_aton($net);
    }
    return 1;
}

# The fixed addresses. Besides what you type, lzrprf fetches five things,
# each only after you asked for it in the window, each written in the log
# first, each sent the way a typed address is: the newest release number
# (below), a report you chose to send (above), after "Install it" the
# installer, from the one or two places the release file names (sub
# installed), a support request you send, and the answer to it when you ask
# to read it (sub support_sent, sub support_read). An address that is not on
# the public internet is not fetched for any.                            # [C4]
sub fixed {
    my ($line, $url, $host, $ask) = @_;   # $ask: a support request sent, or the answer to it read (sub support_sent, sub support_read), the two that are more than a GET of the address alone
    $UNSAID = 0;
    open my $request, '>>', "$DIR/busy" or return;
    flock $request, LOCK_SH or return;
    my ($kept) = keeping();
    record($line, $kept) or return;       # [C5]
    my ($where, $why) = $TOR_WANTED ? tor_where($host) : find($host);
    $why = 'that host is not on the public internet' if $where && $PEER eq '-' && grep { $_->{own} } @$where;
    my ($got, $from);
    if (!$why) {
        record("$url -> lzrprf connects " . ($TOR_WANTED ? "through Tor, one circuit for $host" : 'to the first that answers of: ' . join(', ', map { $_->{text} } @$where)), $kept) or return;    # [C5]
        $UNSAID = 1;
        ($got, $why, $from) = fetch($url, $where, $ask);
    }
    record("$url " . ($why ? "failed: $why" : 'answered: ' . length($got) . " bytes from $from"), $kept) or return;    # nothing of the answer is written, and "sub fault" says the report was tried
    $UNSAID = 0;
    return $why ? undef : $got;
}

# The support member licence. "Enter licence code" in the cogwheel's menu
# opens a field for the code you got when you bought the application. A code
# is 120 letters and digits: 75 bytes written in Crockford's base32, read here
# as they are written, with case, spaces and dashes left aside, O read as 0
# and I and L as 1. One byte says its kind (17: a support member), two the
# month it was bought in (months since January 2026), eight are its own
# number, and 64 are an Ed25519 signature over the words LZRBRWSR-LICENCE-1
# and the eleven bytes before it. lzrprf checks that signature itself, with
# the public key below and the system's perl alone (Math::BigInt and
# Digest::SHA), and fetches nothing for it. A code that checks is kept in one
# plain file of yours, licence, written by lzrprf alone; removing the code
# removes the file. An incognito window offers neither this nor a support
# request: both keep something.                                          # [C16]
my $LICENCE_KEY = 'ed25519 none';         # the public key of the licence codes, as their maker publishes it: "ed25519 " and its 32 bytes in base64. "none" until it is made: a code is then checked here by its form, and by its signature where a support request goes
my $CROCKFORD = '0123456789ABCDEFGHJKMNPQRSTVWXYZ';
my @MONTHS = qw(January February March April May June July August September October November December);
my %LICENCE_WHY = (empty => 'Type or paste your licence code first.', form => 'That is not a licence code: a code has 120 letters and digits, in groups of 5.', kind => 'That code is not a support member licence.', signature => 'That code does not check: a letter may be mistyped. Paste it as it was given to you.');

sub licence_key {                         # the 32 bytes of the public key, or nothing while there is none
    my $line = $LICENCE_KEY;
    if ($TRY && open my $in, '<', "$ROOT/licence-key") { $line = <$in> // ''; chomp $line }    # "lzrprf try" only: the test's own key, with codes it signed itself
    my ($text) = $line =~ m{^ed25519 ([A-Za-z0-9+/]{43}=)$} or return;
    my $raw = decode_base64($text);
    return length $raw == 32 ? $raw : undef;
}

sub licence_read {                        # a code as it was typed: its 75 bytes, or nothing and why ("empty", "form", "kind")
    my ($typed) = @_;
    (my $code = uc($typed // '')) =~ s/[\s-]//g;
    return (undef, 'empty') unless length $code;
    $code =~ tr/OIL/011/;
    return (undef, 'form') unless length $code == 120 && $code =~ /^[0-9A-HJKMNP-TV-Z]+$/;
    my $bytes = pack 'B600', join '', map { sprintf '%05b', index $CROCKFORD, $_ } split //, $code;
    return (undef, 'kind') unless ord $bytes == 17;
    return $bytes;
}

sub licence_written { my ($bytes) = @_; return join '-', unpack '(A5)*', join '', map { substr $CROCKFORD, oct("0b$_"), 1 } unpack '(A5)*', unpack 'B600', $bytes }    # the 75 bytes as the seller writes them: 24 groups of 5
sub licence_month { my ($bytes) = @_; my $month = unpack 'n', substr $bytes, 1, 2; return $MONTHS[$month % 12] . ' ' . (2026 + int($month / 12)) }

sub licence_checked {                     # a code typed: (its bytes, "signed" or "form" for a code checked by its form alone while there is no key), or (nothing, why)
    my ($typed) = @_;
    my ($bytes, $why) = licence_read($typed);
    return (undef, $why) unless $bytes;
    my $key = licence_key() // return ($bytes, 'form');
    return signed($key, 'LZRBRWSR-LICENCE-1' . substr($bytes, 0, 11), substr($bytes, 11)) ? ($bytes, 'signed') : (undef, 'signature');
}

# Ed25519 (RFC 8032, section 5.1.7): the signature (R, S) of a message holds
# when S is below the group's order L and S times the base point equals R plus
# h times the key, h being SHA-512 of R, the key and the message, taken modulo
# L. Here S*B and (L-h)*A are added in one pass over the bits of both
# numbers, and the sum must be R itself, byte for byte. Points are kept in
# extended coordinates (X, Y, Z, T), x = X/Z, y = Y/Z, xy = T/Z.
sub signed {
    my ($key, $message, $signature) = @_;
    require Math::BigInt;
    my $two = Math::BigInt->new(2);
    my $p = $two->copy->bpow(255)->bsub(19);
    my $order = $two->copy->bpow(252)->badd('27742317777372353535851937790883648493');
    my $inverse = sub { $_[0]->copy->bmodpow($p->copy->bsub(2), $p) };
    my $d = Math::BigInt->new(-121665)->bmul($inverse->(Math::BigInt->new(121666)))->bmod($p);
    my $number = sub { Math::BigInt->from_hex(unpack 'H*', scalar reverse $_[0]) };    # 32 bytes, the least first
    my $sum = sub {
        my ($u, $v) = @_;
        my ($m, $n) = ((($u->[1] - $u->[0]) * ($v->[1] - $v->[0])) % $p, (($u->[1] + $u->[0]) * ($v->[1] + $v->[0])) % $p);
        my ($c, $e) = ((2 * $d * $u->[3] * $v->[3]) % $p, (2 * $u->[2] * $v->[2]) % $p);
        my ($f, $g, $h, $k) = ($n - $m, $e - $c, $e + $c, $n + $m);
        return [($f * $g) % $p, ($h * $k) % $p, ($g * $h) % $p, ($f * $k) % $p];
    };
    my $point = sub {                     # 32 bytes as a point of the curve, or nothing
        my $y = $number->($_[0]);
        my $odd = $y->copy->brsft(255)->is_one;
        $y->bmod($two->copy->bpow(255));
        return if $y >= $p;
        my $xx = (($y * $y - 1) * $inverse->(($d * $y * $y + 1) % $p)) % $p;
        my $x = $xx->copy->bmodpow(($p + 3) / 8, $p);
        $x = ($x * $two->copy->bmodpow(($p - 1) / 4, $p)) % $p if ($x * $x - $xx) % $p != 0;
        return if ($x * $x - $xx) % $p != 0 || $x->is_zero && $odd;
        $x = $p - $x if $x->is_odd != $odd;
        return [$x, $y, Math::BigInt->new(1), ($x * $y) % $p];
    };
    my $base = $point->(pack 'H*', '58' . '66' x 31);
    my $held = $point->($key) or return 0;
    my $s = $number->(substr $signature, 32);
    return 0 if $s >= $order;
    my $h = $number->(Digest::SHA::sha512(substr($signature, 0, 32) . $key . $message)) % $order;
    my @adds = (undef, $base, $held, $sum->($base, $held));
    my ($one, $other) = map { substr $_->as_bin, 2 } $s, ($order - $h) % $order;
    $_ = ('0' x (256 - length)) . $_ for $one, $other;
    my $at = [Math::BigInt->new(0), Math::BigInt->new(1), Math::BigInt->new(1), Math::BigInt->new(0)];
    for my $i (0 .. 255) {
        $at = $sum->($at, $at);
        my $which = substr($one, $i, 1) + 2 * substr($other, $i, 1);
        $at = $sum->($at, $adds[$which]) if $which;
    }
    my $z = $inverse->($at->[2]);
    my ($x, $y) = (($at->[0] * $z) % $p, ($at->[1] * $z) % $p);
    $y->badd($two->copy->bpow(255)) if $x->is_odd;
    my $hex = substr $y->as_hex, 2;
    return scalar(reverse pack 'H*', ('0' x (64 - length $hex)) . $hex) eq substr($signature, 0, 32);
}

sub licence_kept {                        # the code kept, as written, and its bytes; nothing when none is kept
    return if $INCOGNITO;
    open my $in, '<', "${\ shared()}/licence" or return;
    my $line = <$in> // '';
    chomp $line;
    my ($bytes) = licence_read($line);
    return unless $bytes;
    return ($line, $bytes);
}

sub licence_told { my (undef, $bytes) = licence_kept(); window($INCOGNITO ? 'licence off' : $bytes ? 'licence kept ' . licence_month($bytes) : 'licence none') }
sub licence_refused { my ($says) = @_; window("licence refused $says"); return idle($says) }

sub licence_set {
    my ($typed) = @_;
    return licence_refused("$UNKEPT, so it keeps no licence code.") if $INCOGNITO;    # [C16]
    busy('Checking the licence code on this Mac.');
    my ($bytes, $how) = licence_checked($typed);
    return licence_refused($LICENCE_WHY{$how}) unless $bytes;
    my $month = licence_month($bytes);
    record('you entered a support member licence code: it is kept in the file licence, and is not written here') or return licence_refused('The licence code was not kept: its line could not be written to the log.');
    unlink "${\ shared()}/licence.new";
    return licence_refused('The licence code was not kept: its file could not be written.') unless put("${\ shared()}/licence.new", O_EXCL, licence_written($bytes)) && rename("${\ shared()}/licence.new", "${\ shared()}/licence");
    synced(shared());
    window("licence kept $month");
    return idle("The licence code is kept: this browser is a support member's, since $month. " . ($how eq 'signed' ? 'It was checked on this Mac. A support request you send carries it, so it is answered first.' : 'Its form was checked on this Mac; its signature is checked where a support request goes, and a request you send carries it, so it is answered first.'));
}

sub licence_removed {
    return licence_refused("$UNKEPT, so it keeps no licence code.") if $INCOGNITO;    # [C16]
    my $had = -e "${\ shared()}/licence";
    unlink "${\ shared()}/licence.new";
    return licence_refused('The licence code could not be removed: its file is still there.') if $had && !unlink "${\ shared()}/licence";
    synced(shared());
    record('you removed the support member licence code, and its file') if $had;
    window('licence none');
    return idle($had ? 'The licence code was removed, and its file with it. Support requests now go without it.' : 'No licence code was kept.');
}

# A support request. "Support request" in the cogwheel's menu opens a box for
# your words, a support question or a feature you would like. It goes to the
# one address the application's release file names for it, the line
# "support", and to no other: never a host the window or a page gives. It is
# a POST of JSON, sent as every fixed request is (sub fixed): its line in the
# log first, through the one place that connects, by curl in its container,
# with the fixed lines of [C7] and the body. The body holds exactly: "text",
# your words and then one line with the number of this release; "licence",
# the code you entered, only when one is kept; and "screenshot", a PNG of the
# window drawn by the window itself into a picture of its own, only when you
# ticked it, which shows the page in it and the address in its bar. Nothing
# else: no address of a page besides what that picture shows, no history, no
# name of this computer or of you. The window lists all
# of it before Send. The log says that a request was sent, never its words.
# The answer names the request's reference and a key, given once; both are
# kept in one plain file of yours, support, so that "Read the answer" can
# read the answer later: a GET of the reference's address under the support
# address, with the key in the line Authorization, which curl takes on its
# input, so no list of processes shows it. A request sent later replaces the
# one kept, and "Forget it" removes the file.                    # [C4] [C7]
my $SUPPORT_TEXT = 4000;                  # DECLARED(the most characters the support address takes in one request, the release line counted)
my $SUPPORT_PICTURE = 2 * 1024 * 1024;    # DECLARED(the largest PNG the support address takes)
my $SUPPORT_MESSAGES = 100;               # DECLARED(the most messages of one request the window is shown)

sub support_address {                     # the support address the release file names: (address, host), or nothing
    return if $INCOGNITO;                 # [C16]
    my ($line) = map { /^support (https:\/\/\S+)$/ ? $1 : () } release_lines();
    my ($url, $host) = address($line // '');
    return unless $url && $url eq $line && $url =~ m{^https://[^/?#]+(?:/[A-Za-z0-9_-]+)+$};    # the line as lzrprf would fetch it, and a plain path with no query: the reference is added to it
    return ($url, $host);
}

sub support_kept { return if $INCOGNITO; open my $in, '<', "${\ shared()}/support" or return; my $line = <$in> // ''; return $line =~ /^([A-Za-z0-9_-]{22}) ([A-Za-z0-9_-]{43})\n?\z/ ? ($1, $2) : () }    # the reference and the key of the request sent last
sub support_told { my (undef, $host) = support_address(); my ($ticket) = support_kept(); my ($release) = beside(); window($INCOGNITO ? 'support off incognito' : $host && defined $release ? "support on $host $release" : 'support off none', 'support kept ' . ($host && $ticket ? $ticket : '-')) }
sub support_failed { my ($says) = @_; window("support failed $says"); return idle($says) }

sub support_words {                       # the words the window sent, in base64 of UTF-8: as text with no control or format character but line ends and tabs, or nothing
    my ($text) = @_;
    return if length $text > 4 * int((4 * $SUPPORT_TEXT + 2) / 3);    # more bytes than the most characters can take, each of four bytes
    require Encode;
    $text = eval { Encode::decode('UTF-8', decode_base64($text), Encode::FB_CROAK()) } // return;
    $text =~ s/\r\n?/\n/g;
    $text =~ s/[\x00-\x08\x0b-\x1f\x7f-\x9f\x{ad}\x{200b}-\x{200f}\x{2028}-\x{202e}\x{2060}-\x{206f}\x{feff}\x{fff9}-\x{fffb}]//g;
    $text =~ s/^\s+|\s+$//g;
    return $text;
}

sub support_picture {                     # a PNG as the window draws one: its signature, IHDR first and IEND last, at most $SUPPORT_PICTURE bytes; or nothing
    my ($text) = @_;
    return unless length $text <= 4 * int(($SUPPORT_PICTURE + 2) / 3) && length($text) % 4 == 0 && $text =~ /^[A-Za-z0-9+\/]+={0,2}$/;
    my $png = decode_base64($text);
    return unless length $png >= 57 && length $png <= $SUPPORT_PICTURE && substr($png, 0, 8) eq "\x89PNG\r\n\x1a\n" && substr($png, 12, 4) eq 'IHDR' && substr($png, -8, 4) eq 'IEND';
    return $png;
}

sub support_answer {                      # what the support address answered: (status, its JSON as Perl data); nothing for an answer in no such form
    my ($got, $method) = @_;
    my ($status, undef, $body) = @{ live_parts($got, $method) // [] } or return;
    require JSON::PP;
    my $data = eval { JSON::PP->new->utf8->max_depth(8)->decode($body) };
    return ($status, ref $data eq 'HASH' ? $data : undef);
}

sub support_problem {                     # why the support address took nothing, in plain words
    my ($status, $data) = @_;
    my ($first) = ref $data && ref $data->{problems} eq 'ARRAY' ? grep { defined && !ref } @{ $data->{problems} } : ();
    return 'it does not take support requests yet' if ($status // '') eq '503';
    return 'too many requests reached it just now; try again in an hour' if ($status // '') eq '429';
    return 'the request is too large' if ($status // '') eq '413';
    return 'it answered ' . ($status // 'in no form lzrprf reads') . (defined $first ? ': ' . tool_plain($first, 200) : '');
}

sub support_sent {
    my ($words, $picture) = @_;
    return support_failed("$UNKEPT, so it sends no support request.") if $INCOGNITO;    # [C16]
    my ($url, $host) = support_address() or return support_failed('This application names no address for support requests, so nothing was sent.');
    my ($release) = beside();
    return support_failed('This application has no release number, so nothing was sent.') unless defined $release;
    my $last = "Release $release";
    my $text = support_words($words) // return support_failed('Your words could not be read, so nothing was sent.');
    return support_failed('Write what the request is about first. Nothing was sent.') unless length $text;
    return support_failed('The words are longer than ' . ($SUPPORT_TEXT - length($last) - 2) . ' characters. Nothing was sent.') if length($text) + 2 + length($last) > $SUPPORT_TEXT;
    my $png;
    if ($picture ne '-') { $png = support_picture($picture) // return support_failed('The picture of the window is not one lzrprf sends, so nothing was sent.') }
    my ($code) = licence_kept();
    require JSON::PP;
    my $json = JSON::PP->new->ascii->allow_nonref;
    my $body = '{"text":' . $json->encode("$text\n\n$last") . (defined $code ? ',"licence":' . $json->encode($code) : '') . (defined $png ? ',"screenshot":"' . encode_base64($png, '') . '"' : '') . '}';
    busy("Sending your support request to $host.");
    my $got = fixed('you sent a support request' . (defined $code ? ', with your licence code' : '') . (defined $png ? ', with a picture of the window' : '') . ": $url", $url, $host, { method => 'POST', body => $body, type => 'application/json' });
    return support_failed($UNSAID ? 'lzrprf tried to send the request. Whether it arrived is not shown: the line that says how it ended could not be written to the log.' : 'The request could not be sent. The log says why.') unless defined $got;
    my ($status, $data) = support_answer($got, 'POST');
    my ($ticket, $key) = $data ? ($data->{ticket} // '', $data->{key} // '') : ('', '');
    return support_failed('The support address did not take the request: ' . support_problem($status, $data) . '.') unless ($status // '') eq '200' && $ticket =~ /^[A-Za-z0-9_-]{22}\z/ && $key =~ /^[A-Za-z0-9_-]{43}\z/;
    unlink "${\ shared()}/support.new";
    my $kept = put("${\ shared()}/support.new", O_EXCL, "$ticket $key") && rename("${\ shared()}/support.new", "${\ shared()}/support");
    synced(shared());
    my $licence = ($data->{licence} // '') =~ /^(none|accepted|refused)\z/ ? $1 : 'none';
    window("support sent $ticket " . ($data->{priority} ? 'priority' : 'plain') . " $licence", 'support kept ' . ($kept ? $ticket : '-'));
    return idle("Your support request was sent. Its reference is $ticket." . ($licence eq 'accepted' ? ' It goes with your licence code, so it is answered first.' : $licence eq 'refused' ? ' Your licence code was not taken, so it goes without priority.' : '') . ($kept ? ' Read the answer later from Support request in the cogwheel\'s menu.' : ' Its key could not be kept, so its answer cannot be read here.'));
}

sub support_read {
    return support_failed("$UNKEPT, so it reads no support request.") if $INCOGNITO;    # [C16]
    my ($url, $host) = support_address() or return support_failed('This application names no address for support requests.');
    my ($ticket, $key) = support_kept() or return support_failed('No support request is kept here.');
    require Encode;
    busy("Reading the answer to your support request from $host.");
    my $got = fixed("you read the answer to your support request: $url/$ticket", "$url/$ticket", $host, { method => 'GET', key => $key });
    return support_failed('The answer could not be read. The log says why.') unless defined $got;
    my ($status, $data) = support_answer($got, 'GET');
    return support_failed('The support address knows no request by this reference and key now.') if ($status // '') eq '404';
    return support_failed('The answer could not be read: ' . support_problem($status, $data) . '.') unless ($status // '') eq '200' && $data && ref $data->{messages} eq 'ARRAY';
    my $state = ($data->{status} // '') =~ /^(open|answered|resolved|rejected)\z/ ? $1 : 'open';
    my $shown = sub { my ($text, $most) = @_; $text = defined $text && !ref $text ? "$text" : ''; $text =~ s/[\x00-\x08\x0b-\x1f\x7f-\x9f\x{ad}\x{200b}-\x{200f}\x{2028}-\x{202e}\x{2060}-\x{206f}\x{feff}]//g; return encode_base64(Encode::encode('UTF-8', substr($text, 0, $most)), '') };    # words of the answer, shown as text and nowhere acted on
    my @messages = grep { ref eq 'HASH' } @{ $data->{messages} };
    splice @messages, 0, @messages - $SUPPORT_MESSAGES if @messages > $SUPPORT_MESSAGES;    # the newest are shown
    my @lines = ("support thread $state " . $shown->($data->{reason}, 300));
    for my $one (@messages) {
        my $author = ($one->{author} // '') =~ /^(user|support|agent)\z/ ? $1 : next;
        my $at = ($one->{at} // '') =~ /^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2})/ ? $1 : '-';
        push @lines, "support message $author $at " . $shown->($one->{body}, $SUPPORT_TEXT);
    }
    window(@lines, 'support thread end');
    return idle("The answer to your support request $ticket is shown: it is $state.");
}

sub support_forgot {
    return support_failed("$UNKEPT, so it keeps no support request.") if $INCOGNITO;    # [C16]
    my $had = -e "${\ shared()}/support";
    unlink "${\ shared()}/support.new";
    return support_failed('The support request could not be forgotten: its file is still there.') if $had && !unlink "${\ shared()}/support";
    synced(shared());
    window('support kept -');
    return idle($had ? 'The support request is forgotten here: its reference and key were removed. Its answer can no longer be read on this Mac.' : 'No support request was kept.');
}

# What the application's maker put beside the program, in a file "release":
# the number of this release, and up to four addresses. Where the newest
# release number is published, where the installer is, where reports go, and
# a second place that holds the same installer ("same"), so that the copy
# from one place can be compared with the copy from the other. A newer
# application also names the SHA-256 of the lzrprf it was installed with
# ("lzrprf"). A program without that file is never checked for a newer one,
# and is never asked about in a report.
sub release_file { $PROGRAM =~ m{^(.*\.app)/Contents/MacOS/} ? "$1/Contents/Resources/release" : dirname($PROGRAM) . '/release' }
sub release_lines { open my $in, '<', release_file() or return; return <$in> }

sub beside {
    my %is = map { /^(release|newest|installer|report|same|lzrprf) (\S+)$/ ? ($1 => $2) : () } release_lines();
    return unless ($is{release} // '') =~ /^\d{1,6}$/;
    my ($same) = address($is{same} // '');
    return ($is{release}, (map { my ($url) = address($is{$_} // ''); $url } 'newest', 'report', 'installer'), exists $is{same} ? $same // '' : undef, $is{lzrprf});    # the last: the SHA-256 of the lzrprf the application was installed with, when the file names it. A second place that is named and is no address counts as one that does not agree: nothing is written
}

# A newer release. The first time, you are asked whether lzrprf may look at
# each start, and your answer is kept in a file. A yes is kept with the
# address it was given for: when a later release names another address, the
# yes does not count for it and you are asked again. With a yes, lzrprf fetches
# one fixed address at each start, where the newest release number is
# published and nothing else. The request holds what "request" above holds:
# the same request from every computer, so it says nothing about you or about
# which release you run, and it is written in the log like any other. When
# the number there is larger than the one beside the program, the window says
# so and offers the installer. "Install it" is the yes: the installer then
# runs at once, in a modal of lzrprf's own in this window, in auto: it shows
# no question, since nobody is there choosing, and every line it prints is
# shown there and kept in install.txt (sub installed).
sub newer {
    my ($asked) = @_;                     # "update-check": Check for updates in the cogwheel's menu was chosen, and that choice is the yes for this one look
    my ($release, $newest, undef, $installer, $same) = beside();
    return $asked && checked_said('none') unless $newest && $installer;
    return newer_looked($release, $newest, $installer, $same, 1) if $asked;
    my $may = '';
    if (open my $in, '<', "${\ shared()}/look") { $may = <$in> // '' }
    $may = $may eq "yes $newest" ? 'yes' : $may =~ /^no\b/ ? 'no' : '';    # a yes for another address is no yes for this one; a no stays a no
    if (!$may) {
        $may = ask("May lzrprf look for a newer release of $APP at each start? It fetches one fixed address, $newest, with the same request from every computer, and writes it in the log like every other. The request does not say who you are or what you read; the host of that address sees your internet address, as every site does.", 'No', 'Yes, look') == 2 ? 'yes' : 'no';
        unlink "${\ shared()}/look";
        my $kept = record($may eq 'yes' ? "you allowed lzrprf to look for a newer release at each start: $newest" : 'no newer release is looked for: the question was answered no, or not at all');    # an answer that lasts is a line first, like a change of what is kept: without its line it is not kept
        my $out;
        $kept &&= sysopen($out, "${\ shared()}/look", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) && print({$out} ($may eq 'yes' ? "yes $newest" : 'no')) && close($out);
        if (!$kept) {                         # no line, or no place to keep it: the answer counts for nothing, now or later, and the question comes again at the next start
            unlink "${\ shared()}/look";
            record('that answer could not be kept: no newer release is looked for now, and you are asked again at the next start');
            $may = 'no';
        }
    }
    return unless $may eq 'yes';
    return newer_looked($release, $newest, $installer, $same, 0);
}

# One look at the published release number, at a start allowed to look or for Check for updates;
# when it was done and what it found is kept in a plain file of yours, checked ("EPOCH RESULT":
# "same N", "newer N" or "failed"), and told to the window as "checked EPOCH RESULT", which shows
# it under Check for updates. An incognito window looks for nothing and keeps nothing.    # [C16]
sub newer_looked {
    my ($release, $newest, $installer, $same, $asked) = @_;
    busy('Looking for a newer release.');
    my ($host) = $newest =~ m{^https://([^/]+)};
    my $got = fixed(($asked ? 'you chose Check for updates: ' : '') . "lzrprf looks for a newer release: $newest", $newest, $host);
    my ($there) = defined $got ? $got =~ m{\AHTTP/1\.1 200 .*?\r\n\r\n(?:[0-9a-f]{1,4}\r\n)?(\d{1,6})\s*(?:0\r\n\r\n)?\z}s : ();    # one number and nothing else, or the answer counts for nothing
    checked_said(!defined $there ? 'failed' : $there > $release ? "newer $there" : "same $release", $asked);
    if ($asked) {                         # that it is the newest stands in the menu, beside Check for updates, and in this window's log: the strip stays as it was
        my $says = !defined $there ? 'lzrprf could not read the newest release number just now. The log says what was fetched.' : $there > $release ? "A newer release of $APP is published: $there." : "You run the newest release of $APP, $release.";
        noted($says);
        defined $there && $there <= $release ? aside($says) : idle($says);
    }
    return unless defined $there && $there > $release;
    return unless ask("A newer release of $APP is published: $there. You run $release. Install it fetches the installer and runs it here, in this window, with no further question: every line it prints is shown and kept in ${\ shared()}/install.txt.", 'Later', 'Install it') == 2;
    installed($there, $installer, $same);
}

# A welcome, once after each install or update. At the first start of a
# release this folder was not welcomed to yet, the window shows a modal: what
# is new in it (the release file's lines "new", at most six) and, every time,
# two short groups, what $APP keeps you from and what it cannot, which stays
# yours to watch, so that every release is begun with the right picture of
# what it does. A site can still do things to you with what you give it: the
# second group says so before anything is opened. "Got it" closes it, and only
# then is the release number written to $DIR/welcomed, a number and nothing
# else; when it cannot be written the welcome comes again at the next start.
# Nothing is fetched for it. An application without a release file shows none,
# and "lzrprf try" only when its folder holds a file "welcome".
my @PROTECTS = (
    'Page scripts: the scripts of a page run sealed in its container, with no network, no file of yours and no other program, so no tracking code, fingerprinting or hidden miner runs either.',
    'Being followed: every site gets the same request from every computer, with no cookie and nothing kept from an earlier visit.',
    'Pages reaching your Mac: each page is drawn in a sealed container with no network, no file of yours and no other program.',
    'Hidden requests: nothing is fetched that you did not ask for, and every address is in your log before it is fetched.',
);
my @CANNOT = (
    'What you send: whatever you type into a site, a password, a card number, your name, goes to that site, to keep or to misuse.',
    'What a site does on its side: a site you sign in to knows it is you, and keeps and shares what you do there on its own servers.',
    'Fake sites and scams: a page can look exactly like your bank. Read the address in the bar before you trust it or type anything.',
    'What you take elsewhere: a file you save and open, or a link you follow in another program, is outside $APP.',
    'Your internet address: every site you open sees it, as with every browser.',
);
sub welcome {
    my ($release) = beside();
    return unless defined $release;
    return if $TRY && !-e "${\ shared()}/welcome";
    my $was = '';
    if (open my $in, '<', "${\ shared()}/welcomed") { $was = <$in> // '' }
    return if $was eq $release;
    my @new = grep { length } map { /^new (.+)$/ ? substr($1 =~ s/[\x00-\x1f\x7f]//gr, 0, 200) : () } release_lines();
    splice @new, 6;
    window("welcome begin $release");
    window(@new ? ("welcome line n What is new in release $release", map { "welcome line b $_" } @new) : ());
    window("welcome line g What $APP keeps you from", (map { "welcome line b $_" } @PROTECTS), "welcome line y What $APP cannot keep you from: yours to watch", map { "welcome line b " . s/\$APP/$APP/gr } @CANNOT);
    window('welcome end');
    my @held;
    while (defined(my $line = hear())) {
        if ($line ne 'welcomed') { push @held, $line; next }
        unlink "${\ shared()}/welcomed";
        my $out;
        sysopen($out, "${\ shared()}/welcomed", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) && print({$out} $release) && close($out);
        unshift @HELD, @held;
        return;
    }
    leave();                              # the window is gone
}

# What "Install it" does, with no key to press after it: the press is the yes.
# What it can reach is only this: the installer at the address the
# application's release file names. lzrprf fetches it the way it fetches a
# typed address, with its line in the log first [C5], through the one place
# that connects [C6], by a curl held to https that follows no redirect and is
# contained [C3], and from the public internet only. When the release file
# names a second place for the same installer, it is fetched from there too,
# and it runs only when the two copies are the same byte for byte: somebody
# who changed the installer in one place would have had to change it in the
# other too. A second place that is named and is no address counts as one
# that does not agree. The installer is written into a folder of its own
# under $DIR, as a plain file, its SHA-256 is shown in the window and written
# in the log, and it is started there, with nothing of lzrprf's own
# environment: env -i, the system's PATH, your home folder, and TERM=dumb,
# in auto, so it asks nothing and needs no terminal. Every line it prints is
# given to the window, which shows it in a modal of its own over everything
# (no page draws there), and appended to $DIR/install.txt. A colour the
# installer asks for in a line becomes one letter the window draws in, and
# every escape and control character is taken out, so nothing it prints acts
# on the window. The window cannot close the modal while it runs; at the end
# it says done or failed. After done, lzrprf takes nothing more in this
# window: the application was replaced, and is started again. lzrprf itself
# replaces nothing: whatever is replaced is replaced by that installer.
my %INK = (31 => 'r', 32 => 'g', 33 => 'y', 34 => 'b', 35 => 'm', 36 => 'c', 37 => 'w', 91 => 'r', 92 => 'g', 93 => 'y', 94 => 'b', 95 => 'm', 96 => 'c', 97 => 'w');    # the colours of a terminal, as one letter each
my $INSTALL_LOG;                          # install.txt in the state folder (sub shared) while an installer runs
sub installed {
    my ($there, $installer, $same) = @_;
    window('install begin');
    sysopen($INSTALL_LOG, "${\ shared()}/install.txt", O_WRONLY | O_CREAT | O_APPEND | O_NOFOLLOW, 0600) or undef $INSTALL_LOG;
    my @is = $INSTALL_LOG ? stat $INSTALL_LOG : ();
    undef $INSTALL_LOG unless @is && -f _ && $is[3] == 1 && $is[4] == $<;
    return install_end(0, "${\ shared()}/install.txt could not be written, so nothing was fetched.") unless $INSTALL_LOG;
    print {$INSTALL_LOG} line("you chose to install release $there"), "\n";    # the time, the run, what happened: as a line of the log
    return install_end(0, 'The second place the release file names is not an address lzrprf fetches. Nothing was fetched.') if defined $same && !length $same;
    my @from = ($installer, defined $same ? $same : ());
    my @copies;
    for my $try (1 .. $INSTALL_TRIES) {       # the copies are compared each time anew: one that differs is never run, it is only fetched again later
        @copies = ();
        for my $url (@from) {
            install_line("Fetching the installer from $url");
            my ($host) = $url =~ m{^https://([^/:]+)};
            my $got = fixed("you chose to install release $there: lzrprf fetches the installer: $url", $url, $host);
            my $body = defined $got ? body_of($got) : undef;
            return install_end(0, "The installer could not be fetched from $url. Nothing was changed.") unless defined $body && length $body;
            push @copies, $body;
        }
        last if @copies < 2 || $copies[0] eq $copies[1] || $try == $INSTALL_TRIES;
        install_line("The two places hold different installers for now. Nothing runs while they differ: a new release is usually being published, and one place can keep its old copy for up to five minutes. Both are fetched again in $INSTALL_WAIT seconds (try $try of $INSTALL_TRIES).");
        Time::HiRes::sleep($TRY ? 0.05 : $INSTALL_WAIT);    # "lzrprf try" waits a moment only: the tries are what is tested, not the clock
    }
    return install_end(0, "The two places hold different installers. Nothing was changed: $from[0] and $from[1].") if @copies == 2 && $copies[0] ne $copies[1];
    my ($folder, $out) = ("${\ shared()}/install.$$");
    mkdir $folder, 0700;
    my @folder = lstat $folder;
    my $file = "$folder/install.sh";
    unlink $file;
    return install_end(0, "The installer could not be written to $file. Nothing was changed.") unless @folder && -d _ && $folder[4] == $< && sysopen($out, $file, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) && print({$out} $copies[0]) && close($out);
    my $sum = Digest::SHA->new(256)->add($copies[0])->hexdigest;
    install_line(@copies == 2 ? 'The installer was fetched from two places, and both hold the same file.' : 'The installer comes from one place.');
    install_line("It is in this file, to read: $file");
    install_line("Its SHA-256: $sum");
    window("install sum $sum");
    record("the installer of release $there has SHA-256 $sum, and runs now in auto: $file") or return install_end(0, $UNWRITTEN);    # [C5]
    return install_end(0, 'lzrprf try: the installer was written and is not run.') if $TRY;
    install_line('It runs now by itself: no question is shown, and each line it prints is shown here.');
    pipe(my $from, my $to) or return install_end(0, 'The installer could not be started. Nothing was changed.');
    my $child = fork // return install_end(0, 'The installer could not be started. Nothing was changed.');
    if (!$child) {
        close $from;
        chdir $folder or POSIX::_exit(127);
        become(undef, $to, $to, '/usr/bin/env', '-i', 'PATH=/usr/bin:/bin:/usr/sbin:/sbin', "HOME=$HOME", 'TERM=dumb', '/bin/sh', 'install.sh', 'auto');
    }
    close $to;
    my ($held, $until) = ('', now() + $INSTALL_SECONDS);
    while ((my $left = $until - now()) > 0) {
        my $ready = '';
        vec($ready, fileno $from, 1) = 1;
        select($ready, undef, undef, $left > 1 ? 1 : $left) > 0 or next;
        my $got = sysread($from, $held, 65536, length $held);
        next if !defined $got && $!{EINTR};
        last unless $got;
        install_line($1) while $held =~ s/\A([^\n]*)\n//;
        install_line(substr($held, 0, $INSTALL_LINE, '')) while length $held > 4 * $INSTALL_LINE;    # a line with no end yet is given in parts once it is this long
    }
    install_line($held) if length $held;
    my $late = now() >= $until;
    my $how = ended($child, 5);
    return install_end(0, "The installer was ended after $INSTALL_SECONDS seconds. What it printed is above.") if $late;
    return install_end(0, 'The installer ended with an error (' . ($how >> 8) . '). What it printed is above.') unless $how == 0;
    install_end(1, "The installer says it is done. Close $APP, or close it and start the new release at once.");
    restarted();
}

# After an install that is done lzrprf takes nothing more in this window, which
# offers two buttons: Close, and Close and restart. "restart" starts the
# application again once this run has ended: a process of its own, outside
# this run's session, waits until lzrprf and the launcher that started it are
# gone (at most 20 seconds), then asks macOS to open the application at the
# place it ran from, which the installer has replaced by then. Nothing else
# is started, and "lzrprf try" starts nothing.
sub restarted {
    busy('The install is done.');
    while (defined(my $line = hear())) {
        next unless $line eq 'restart';
        my ($app) = $PROGRAM =~ m{^(.*\.app)/Contents/MacOS/};
        last unless $app && !$TRY;
        record("you chose to start $APP again after the install: $app") or last;    # [C5]
        my @waits = ($$, getppid());
        my $first = fork;
        if (defined $first && !$first) {
            POSIX::setsid();
            my $second = fork;
            POSIX::_exit(0) if !defined $second || $second;
            for (1 .. 80) { last unless grep { kill 0, $_ } @waits; Time::HiRes::sleep(0.25) }
            # The first profile comes back as the icon starts it: macOS opens the application, whose launcher starts the new lzrprf.
            # Another profile cannot go that road, since the launcher passes nothing on, so this process starts it as the Profiles
            # icon does (sub profile_command): perl, the file $SELF and the program $PROGRAM, with the profile's id alone. The
            # installer has replaced both in place by now, and a fresh perl reads $SELF from the disk, so the new release runs,
            # and it goes through every start check itself, the self-test's mark of the new release among them.
            become(undef, undef, undef, defined $PROFILE ? profile_command($PROFILE) : ('/usr/bin/open', '-n', $app));
        }
        waitpid($first, 0) if $first;
        last;
    }
    leave();
}

sub install_line {                        # one line the installer printed: in the window's modal, with its colour as one letter, and in install.txt
    my ($text) = @_;
    my ($ink) = map { $INK{$_} // () } map { split /;/ } $text =~ /\e\[([0-9;]*)m/g;
    $text =~ s/\e\][^\a\e]*(?:\a|\e\\)?//g;    # a title or a link a terminal would take: nothing of it is shown
    $text =~ s/\e\[[0-9;?]*[ -\/]*[\@-~]//g;
    $text =~ s/\e.?//gs;
    $text =~ s/\A.*\r(?=.)//s;            # a line written over itself: what stands last
    no warnings 'utf8';
    utf8::decode($text) or $text =~ s/[^\x00-\x7f]/?/g;
    $text =~ s/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]//g;
    for my $part ($text =~ /(.{1,$INSTALL_LINE})/gs, length $text ? () : '') {
        utf8::encode($part);
        print STDOUT 'install line ' . ($ink // '-') . " $part\n";    # not "window": when the window is gone the installer is not left without its reader
        print {$INSTALL_LOG} "$part\n" if $INSTALL_LOG;
    }
}

sub install_end {                         # how the install ended, said in the modal, in install.txt and in the log; returns nothing
    my ($done, $words) = @_;
    install_line($words);
    print STDOUT 'install end ' . ($done ? 'done' : 'failed') . " $words\n";
    if ($INSTALL_LOG) { $INSTALL_LOG->flush; $^O eq 'darwin' ? fcntl($INSTALL_LOG, 51, 0) : $INSTALL_LOG->sync; close $INSTALL_LOG; undef $INSTALL_LOG }
    record('the install ' . ($done ? 'is done' : "failed: $words"));
    return;
}

sub body_of {                             # the body of an answer 200, as curl gave it raw: whole, or in chunks that are all there; nothing for anything else
    my ($got) = @_;
    my ($head, $body) = $got =~ m{\AHTTP/1\.1 200 [^\r\n]*\r\n(.*?)\r\n\r\n(.*)\z}s or return;
    return $body unless $head =~ /^transfer-encoding:[ \t]*chunked[ \t]*\r?$/mi;
    my ($whole, $at) = ('', 0);
    while (substr($body, $at) =~ /\A([0-9a-fA-F]{1,8})[^\r\n]*\r\n/) {
        my $n = hex $1;
        $at += length $&;
        return $whole unless $n;
        return unless length($body) >= $at + $n + 2 && substr($body, $at + $n, 2) eq "\r\n";
        $whole .= substr($body, $at, $n);
        $at += $n + 2;
    }
    return;
}

# The window's side. The window is lzrprf's: the text at the end of this file,
# run by the system's own osascript in the window container. It is told what
# to show in lines, and says what you did in lines. Ten kinds of line can come
# from it, each in a shape lzrprf checks, and nothing the application wrote is
# among them: that it is ready, what you typed into the bar when you pressed
# Return, which of two buttons you pressed, that you asked for the log, that
# it could not draw a list, the size of its page, a tab opened, chosen or
# closed or moved ("tab new", "tab select N", "tab close N", "tab move FROM TO"), and an item of the
# cogwheel's menu ("menu clear-history", "menu clear-sessions", "menu home", "menu bookmarks-bar"), a bookmark opened, saved or removed ("mark open N", "mark save ...", "mark remove N", sub mark_saved), its size and place once you have moved or resized it ("frame X Y W H" or "frame full", sub frame_said), and buttons up to three for a question in a modal ("redirect"). Three more come only while the page shown is kept running ("live on"): a click in it ("page click X Y", in the laid page's points after scrolling), a key ("page key NAME" or "page key NAME shift", a printable character or one of the named keys) and text typed while a field of it has the focus ("page text ...", at most $LIVE_TEXT bytes); lzrprf hands each to that page and to nothing else (sub live_input), and tells the window "live on|off 0|1" and "live end WHY" (sub live_told). The words lzrprf says are in a
# strip of their own between the bar and the page, where no page can write:
# the one thing of the application's that lzrprf says there is up to four of
# the other hosts its page names, each in the shape of a host name, and how
# many there are (the last line of "sub visit").
sub window {
    for my $line (@_) {
        print "$line\n" or leave();       # without a window ("lzrprf try" only) this is printed for the test to read
    }
}

sub busy { window('busy ' . $_[0] =~ s/\s+/ /gr) }
sub idle {                                # what lzrprf says, in full; with $short the strip shows that instead ("brief"), and the full words stand where they belong: with what the page is made of, or on the log page
    my ($says, $short) = map { defined ? s/\s+/ /gr : undef } @_[0, 1];
    @{ $TABS[$TAB] }{qw(says brief)} = ($says, $short);
    window("brief $short") if length($short // '');
    window("idle $says");
    return;
}
sub aside {                               # said in full, with the strip left as it was: an answer that belongs elsewhere than the strip
    my ($says, $shut) = @_;
    my ($was, $short) = @{ $TABS[$TAB] }{qw(says brief)};
    window('log shut') if $shut;
    idle($says, length($short // '') ? $short : $was // '');
    @{ $TABS[$TAB] }{qw(says brief)} = ($was, $short);
    return;
}
sub noted { push @SESSION, line($_[0]); return }
sub said_noted { my $says = $TABS[$TAB]{says}; noted($says) if length($says // ''); return }    # what the strip just said of something you did that fetched nothing: a bookmark, a setting, a window    # a line of this window's log alone, in its memory: what happened here and fetched nothing

# The =statement line of a page, which comes right after its =pictures and
# =sheets lines (or its first line): the application's own words, in one sentence, for why it
# shows the page in compatibility-statement mode. At most one such line, of
# 1 to $STATEMENT bytes that are each a plain printable character (0x20 to
# 0x7e), so nothing in it acts on the window; a second one is a line of no kind
# and makes the page unfit, as does one too long or with any other byte. The
# words are shown as they are, as plain text, at the end of the bottom bar
# (sub visit); they are never read for anything. Takes the checked page's
# lines and takes the line off them. Returns its words, '' when there is none,
# or nothing for a line that is not one.
sub stated {
    my ($lines) = @_;
    my $STATEMENT = 200;                  # the most bytes of the words: one sentence the bottom bar holds beside its own
    return '' unless @$lines && $lines->[0] =~ /^=statement/;
    my ($words) = shift(@$lines) =~ /^=statement ([\x20-\x7e]{1,$STATEMENT})\z/ or return;
    return $words;
}

sub hear {                                # the next thing the window says; nothing (undef) when the window is gone, an empty line when it said nothing in time
    my ($seconds, $main) = @_;            # $main: the loop of sub behind, the one place that takes "live", the word that a page kept running answered or is to end (sub live_turn); elsewhere what such a page writes is read and held, and taken there later
    push @HELD, splice @LATER if $main && @LATER;
    return shift @HELD if @HELD;
    my $until = defined $seconds ? now() + $seconds : undef;
    while (1) {
        return 'live' if $main && grep { live_due($_) } @LIVE;
        return shift @EVENTS unless $FROM || $main && (grep { $_->{waiting} } @LIVE) || $main && !@EVENTS && grep { now() < $_->{heard} + $TRY_QUIET } @LIVE;    # "lzrprf try": the test's next line, once every page kept running answered the one before; after the last, the end once every such page was quiet for $TRY_QUIET
        if ($FROM && (my $end = index($FROM_HELD, "\n")) >= 0) {
            my $line = substr($FROM_HELD, 0, $end + 1, '');
            chomp $line;
            print STDERR "$line\n" if $TRY && $line =~ /^(?:test|fault) /;    # "lzrprf try" only: what a test's own text in the window reports
            return $line;
        }
        my ($ready, $wait) = ('', defined $until ? $until - now() : undef);
        return '' if defined $wait && $wait <= 0;    # the time is over, and the window is still there
        vec($ready, fileno $FROM, 1) = 1 if $FROM;
        for my $live (grep { !live_due($_) } @LIVE) {    # a page kept running is heard while the window is waited for, up to its own end of time
            vec($ready, fileno $live->{from}, 1) = 1;
            my ($left, $quiet) = ($live->{until} - now(), $live->{heard} + $TRY_QUIET - now());
            $left = $quiet if !$FROM && $quiet > 0 && $quiet < $left;    # "lzrprf try": up to the end of its quiet, when the test is looked at again
            $wait = $left < 0 ? 0 : $left if !defined $wait || $left < $wait;
        }
        select($ready, undef, undef, $wait) > 0 or next;
        live_read($_) for grep { !live_due($_) && vec($ready, fileno $_->{from}, 1) } @LIVE;
        next unless $FROM && vec($ready, fileno $FROM, 1);
        my $got = sysread($FROM, $FROM_HELD, 65536, length $FROM_HELD);
        return if defined $got ? !$got : !$!{EINTR};    # the window is gone
    }
}

# Pages kept running with their tabs (sub contained). Each is bound to the tab
# it was shown in; at most $LIVE_MOST run at once, and the oldest is ended
# when one more is kept. A page is ended, with "=end" and then for certain,
# when its tab goes elsewhere or is closed, when the sessions are cleared,
# when it was laid out anew, when it wrote anything out of its form, more than
# $LIVE_BYTES in all or more than $PAGE_BYTES in one answer, after
# $LIVE_SECONDS, and when the window closes. Its last good drawing stays.
sub live_of { my ($tab) = @_; my ($live) = grep { $_->{tab} && $_->{tab} == $tab } @LIVE; return $live }

sub live_kept {
    my ($live, $tab, $lines, $paths, $host, $decoded, $shown) = @_;
    my @made;                             # what the page is made of, the U lines of its first list: an answer is checked with them, as the first list was
    for (@$lines) { last unless /^U/; push @made, $_ }
    @$live{qw(tab made paths host pictures shown)} = ($tab, \@made, [@$paths], $host, $decoded // {}, $shown);
    push @LIVE, $live;
    live_end($LIVE[0], 'more pages were kept running than lzrprf keeps') while @LIVE > $LIVE_MOST;
}

sub live_dropped {                        # a run that kept its page and is not shown: ended at once; the words, when there are any, are said
    my ($live, $words) = @_;
    live_end($live, 'it is not shown', 1) if $live;
    return defined $words ? idle($words) : undef;
}

sub live_told {                           # the window is told whether the page shown is kept running, and whether a text field of it has the focus: "live on|off 1|0"
    my $live = live_of($TABS[$TAB]);
    my @now = $live ? ('on', $live->{focus} ? 1 : 0) : ('off', 0);
    return if "@now" eq "@LIVE_TOLD";
    @LIVE_TOLD = @now;
    window("live @now");
}

sub live_end {                            # "=end" for the page, then its keeper and the page are ended, the keeper first (sub contained); $now: at once, and nothing said to the window
    my ($live, $why, $now) = @_;
    @LIVE = grep { $_ != $live } @LIVE;
    return if $live->{ended}++;
    my $gone = 0;
    syswrite($live->{relay}, "=end\n");    # never waited for: a page that reads nothing is ended below all the same
    close $live->{relay};
    my $until = now() + ($now ? 0 : $LIVE_END_SECONDS);
    while (!$gone && (my $left = $until - now()) > 0) {    # the page is given a moment to end by itself: its end is the end of what it writes. The window is never kept waiting for it: once the window says anything, the page is ended at once
        last if $FROM && index($FROM_HELD, "\n") >= 0;
        my $ready = '';
        vec($ready, fileno $live->{from}, 1) = 1;
        vec($ready, fileno $FROM, 1) = 1 if $FROM;
        select($ready, undef, undef, $left) > 0 or next;
        last if $FROM && vec($ready, fileno $FROM, 1) && !vec($ready, fileno $live->{from}, 1);
        next unless vec($ready, fileno $live->{from}, 1);
        my $more = sysread($live->{from}, my $rest, 65536);
        $gone = 1 if defined $more ? !$more : !$!{EINTR};
    }
    kill 'KILL', $live->{keeper};         # the keeper first: it acts on the page's number, and is gone before the system may give that number to another process
    waitpid $live->{keeper}, 0;
    kill 'KILL', $live->{page};
    waitpid $live->{page}, 0;
    close $_ for @$live{qw(from hold)};
    return if $now;
    window("live end $why; " . ($gone ? 'it ended by itself' : 'lzrprf ended it'));
    live_told();
}

sub live_read {                           # what a page kept running wrote, held until it is a whole answer; its end is noted
    my ($live) = @_;
    my $got = sysread($live->{from}, $live->{held}, 65536, length $live->{held});
    return if !defined $got && $!{EINTR};
    $live->{gone} = 1 unless $got;
    $live->{bytes} += $got // 0;
    $live->{heard} = now();
}

sub live_due {                            # a page kept running has a whole answer held (up to a line "=ready"), ended, wrote too much, or its time is over
    my ($live) = @_;
    return 1 if defined $live->{whole} || $live->{gone} || $live->{bytes} > $LIVE_BYTES || length $live->{held} > $PAGE_BYTES || now() >= $live->{until};
    if (defined(my $asked = live_asked($live))) { return $asked ? 1 : 0 }    # [C19] a request, due once it is all there
    if (substr($live->{held}, 0, 7) eq "=ready\n") { $live->{whole} = -1; return 1 }
    my $at = index($live->{held}, "\n=ready\n", $live->{looked} > 7 ? $live->{looked} - 7 : 0);
    $live->{looked} = length $live->{held};
    return 0 if $at < 0;
    $live->{whole} = $at;
    return 1;
}

sub live_turn {
    my @due = grep { live_due($_) } @LIVE;
    live_answered($_) for @due;
}

# A request of a page kept running ([C19]). While it is kept, and while it is
# read before its first list (sub contained), the page may write, in place of
# an answer, one request at a time, and waits for its reply before it writes
# anything else (src/page/scripted.rs):
#
#   =fetch METHOD BODYLEN TYPE URL   then exactly BODYLEN bytes of its body
#       METHOD   GET, HEAD or POST
#       BODYLEN  0 to $LIVE_FETCH_UP, and 0 for GET and HEAD
#       TYPE     "-", or for a POST one of text/plain,
#                application/x-www-form-urlencoded and application/json
#       URL      printable, at most 8192 bytes
#
# The address is checked as one typed into the bar is (sub address: https, a
# host by its name, port 443), the count of the page's requests against
# $LIVE_FETCH_MOST, then it is written down first [C5] and looked up or asked
# of Tor as a typed one [C17]; a host that is not on the public internet is
# refused, as for the fixed addresses, since no question is asked for a page.
# It is fetched by sub fetch, the one place that connects [C6], with the fixed
# request [C7] and only what $ask adds there. Whatever comes of it, the page
# is written exactly one reply, on its input, through the keeper:
#
#   =fetched STATUS HEADLEN BODYLEN  then HEADLEN bytes of "name: value" lines,
#                                    each ending in a line end, then BODYLEN
#                                    bytes of the body
#
# STATUS is the answer's, 200 to 599; the lines are only those of
# content-type and of the five access-control-allow-origin,
# -allow-credentials, -allow-methods, -allow-headers and -expose-headers,
# names in small letters, printable values, at most $LIVE_HEAD_BYTES in all;
# the body is the answer's, its chunks joined, at most $PAGE_BYTES; a HEAD has
# none. A request refused, failed, or answered in another form is told
# "=fetched 0 0 0". A request line of no form ends the page.
sub live_asked {                          # [C19] the request at the front of what the page wrote: nothing when there is none, 0 while it is not all there, else [its line, its body, the bytes it takes], or [its line] when it is of no form
    my ($live) = @_;
    return unless substr($live->{held}, 0, 7) eq '=fetch ';
    my $end = index $live->{held}, "\n";
    if ($end < 0 || $end > $LIVE_FETCH_LINE) { return $end < 0 && length $live->{held} <= $LIVE_FETCH_LINE ? 0 : [''] }
    my $line = substr($live->{held}, 0, $end);
    my ($size) = $line =~ /^=fetch [A-Z]{1,8} (0|[1-9][0-9]{0,5}) / or return [$line];
    return [$line] if $size > $LIVE_FETCH_UP;
    return 0 if length($live->{held}) < $end + 1 + $size;
    return [$line, substr($live->{held}, $end + 1, $size), $end + 1 + $size];
}

my %LIVE_PASSED = map { $_ => 1 } qw(content-type access-control-allow-origin access-control-allow-credentials access-control-allow-methods access-control-allow-headers access-control-expose-headers);    # [C19] the headers a page is handed of an answer: its type, and what the CORS check of its engine reads

sub live_fetched {                        # [C19]
    my ($live, $asked) = @_;
    my ($line, $body, $took) = @$asked;
    return live_end($live, 'it wrote a line of no form') unless defined $took;
    substr($live->{held}, 0, $took, '');
    $live->{looked} = 0;
    my ($method, $size, $type, $to) = $line =~ m{^=fetch (GET|HEAD|POST) (0|[1-9][0-9]{0,5}) (-|text/plain|application/x-www-form-urlencoded|application/json) ([\x21-\x7e]{1,8192})$} or return live_end($live, 'it wrote a line of no form');
    return live_end($live, 'it wrote a line of no form') if $method ne 'POST' && ($size || $type ne '-');
    my ($url, $host) = address($to);
    my ($status, $head, $answer, $why) = (0, '', '');
    my ($kept) = keeping();               # read once, as in visit
    open my $request, '>>', "$DIR/busy" or return live_replied($live, 0, '', '');
    flock $request, LOCK_SH or return live_replied($live, 0, '', '');    # as in visit: no line of this request falls into a clearing of the log
    if (!$url) {
        record("the page $live->{url} asked for an address lzrprf does not fetch; refused", $kept);
        return live_replied($live, 0, '', '');
    }
    record("the page $live->{url} asked for $url ($method" . ($host eq $live->{host} ? '' : ", from $live->{host}") . ')', $kept) or return live_replied($live, 0, '', '');    # [C5] before the name is even looked up
    $why = "the page asked for more than $LIVE_FETCH_MOST addresses" if ++$live->{fetches} > $LIVE_FETCH_MOST;
    my $where;
    ($where, $why) = $TOR_WANTED ? tor_where($host) : find($host) unless $why;    # [C17] with Tor on, nothing is looked up on this computer
    $why = 'that host is not on the public internet' if !$why && $where && $PEER eq '-' && grep { $_->{own} } @$where;    # [C8] no question is asked for a page's request: it is refused
    my ($got, $from);
    if (!$why) {
        record("$url -> lzrprf connects " . ($TOR_WANTED ? "through Tor, one circuit for $host" : 'to the first that answers of: ' . join(', ', map { $_->{text} } @$where)), $kept) or return live_replied($live, 0, '', '');    # [C5] written down first, connected second
        ($got, $why, $from) = fetch($url, $where, { method => $method, type => $type, body => $body, origin => $host eq $live->{host} ? undef : "https://$live->{host}" });    # [C6] [C7]
    }
    if (!$why) {
        my $parts = live_parts($got, $method);
        if ($parts) { ($status, $head, $answer) = @$parts } else { $why = 'the answer is in no form lzrprf hands a page' }
    }
    record("$url " . ($why ? "failed: $why" : "answered $status: " . length($answer) . " bytes to the page from $from"), $kept) or return live_replied($live, 0, '', '');    # an answer whose line could not be recorded is not handed over
    close $request;
    return live_replied($live, $why ? (0, '', '') : ($status, $head, $answer));
}

sub live_parts {                          # [C19] an answer as curl gave it raw: [status, the header lines the page is handed, the body]; nothing when it is in no such form
    my ($got, $method) = @_;
    1 while $got =~ s{\AHTTP/1\.[01] 1[0-9][0-9][^\r\n]*\r\n(?:[^\r\n]+\r\n)*\r\n}{};    # an interim answer goes before the answer
    my ($status, $head, $body) = $got =~ m{\AHTTP/1\.[01] ([2-5][0-9][0-9])[^\r\n]*\r\n((?:[^\r\n]+\r\n)*)\r\n(.*)\z}s or return;
    $body = '' if $method eq 'HEAD';
    if ($head =~ /^transfer-encoding:[ \t]*chunked[ \t]*\r?$/mi && length $body) {
        my ($whole, $at) = ('', 0);
        while (1) {
            substr($body, $at) =~ /\A([0-9a-fA-F]{1,8})[^\r\n]*\r\n/ or return;
            my $n = hex $1;
            $at += length $&;
            last unless $n;
            return unless length($body) >= $at + $n + 2 && substr($body, $at + $n, 2) eq "\r\n";
            $whole .= substr($body, $at, $n);
            $at += $n + 2;
        }
        $body = $whole;
    }
    return if length $body > $PAGE_BYTES;
    my $lines = '';
    for (split /\r\n/, $head) {
        my ($name, $value) = /^([!#\$%&'*+.^_\x60|~0-9A-Za-z-]+):[ \t]*(.*?)[ \t]*$/ or next;    # a token (RFC 9110 5.6.2), its grave accent written as \x60
        $name = lc $name;
        next unless $LIVE_PASSED{$name} && $value =~ /^[\x20-\x7e]*$/;
        my $one = "$name: $value\n";
        last if length($lines) + length($one) > $LIVE_HEAD_BYTES;
        $lines .= $one;
    }
    return [$status, $lines, $body];
}

sub live_replied {                        # [C19] the one reply to a request, through the keeper as it takes it, within $FETCH_SECONDS; a page that does not take it is ended
    my ($live, $status, $head, $body) = @_;
    my $reply = "=fetched $status " . length($head) . ' ' . length($body) . "\n$head$body";
    my $until = now() + $FETCH_SECONDS;
    while (length $reply) {
        my $took = syswrite($live->{relay}, $reply);
        if ($took) { substr($reply, 0, $took, ''); next }
        return live_end($live, 'it does not read what it is given') unless !defined $took && ($!{EAGAIN} || $!{EINTR});
        my ($ready, $left) = ('', $until - now());
        return live_end($live, 'it does not read what it is given') if $left <= 0 || !alive();
        vec($ready, fileno $live->{relay}, 1) = 1;
        select(undef, $ready, undef, $left > 1 ? 1 : $left);
    }
    $live->{heard} = now();
    return;
}

# A line of the window for the page kept running with the selected tab, in a
# form sub behind checked: "click X Y" in CSS pixels of the laid page, where
# the window found the pointer after its own scrolling, at most 200000 each
# way; "key NAME" or "key NAME shift"; "text TEXT", only while a text field of
# the page has the focus, of 1 to $LIVE_TEXT bytes of UTF-8 with no control
# or format character. It is written to the page as "=click", "=key" or
# "=text", at most $LIVE_INPUT bytes, and nothing else ever is; a tab with no
# page kept running takes none.
sub live_input {                          # [C18]
    my ($what) = @_;
    my $live = live_of($TABS[$TAB]) or return;
    return if $what =~ /^click ([0-9]+) ([0-9]+)$/ && ($1 > 200_000 || $2 > 200_000);
    if ($what =~ /^text (.*)\z/s) {
        my $text = $1;
        return unless $live->{focus} && utf8::decode($text) && $text !~ /[\p{Cc}\p{Cf}\p{Zl}\p{Zp}\p{Co}\p{Cs}\p{NChar}]|[^\x{0}-\x{10ffff}]/;
    }
    my $line = "=$what\n";
    return unless length $line <= $LIVE_INPUT + 1;
    my $took = syswrite($live->{relay}, $line);
    return live_end($live, 'it does not read what it is given') unless ($took // 0) == length $line;
    $live->{waiting}++;
}

# An answer of a page kept running, up to its line "=ready", each part only
# when there is one and in this order:
#
#   =focus 1|0          a text field of the page took the focus, or none has it now: whether text typed goes to it
#   =go ADDRESS         an address the page asks to go to: a link followed, or a form sent with GET; it is
#                       checked and fetched exactly as an address typed into the bar (sub go), in the tab shown
#   =statement WORDS    1 to 200 plain printable characters, shown in lzrprf's strip as plain text
#   =again              then the page's lines, as a first list has them after its head: checked by sub checked
#                       with the first list's =pictures paths and U lines in front, at the width it was laid at,
#                       and drawn in place of the drawing before, its decoded pictures placed again
#
# Anything else, a line of no form, a part out of its order, a line that
# begins with "=" among the lines after =again, or lines that sub checked does
# not let through, ends the page; its last good drawing stays. Nothing of an
# answer reaches the window before the whole of it was checked.
sub live_answered {                       # [C18]
    my ($live) = @_;
    while (!$live->{ended} && live_due($live)) {
        if (!defined $live->{whole} && !$live->{gone} && now() < $live->{until} && $live->{bytes} <= $LIVE_BYTES && ref(my $asked = live_asked($live))) {    # [C19] a request of the page, answered before anything it writes after it
            live_fetched($live, $asked);
            next;
        }
        return live_end($live, $live->{gone} ? 'it ended' : now() >= $live->{until} ? 'its time was over' : 'it wrote more than lzrprf takes') unless defined $live->{whole};
        my $at = delete $live->{whole};
        my $answer = $at < 0 ? '' : substr($live->{held}, 0, $at + 1);
        substr($live->{held}, 0, $at < 0 ? 7 : $at + 8, '');
        $live->{looked} = 0;
        $live->{waiting}-- if $live->{waiting};
        my @lines = split /\n/, $answer;
        my ($stage, $focus, $go, $words, $shown) = (0);
        while (@lines && $lines[0] ne '=again') {
            my $line = shift @lines;
            if ($stage < 1 && $line =~ /^=focus ([01])$/) { ($stage, $focus) = (1, $1) }
            elsif ($stage < 2 && $line =~ /^=go ([\x21-\x7e]{1,8192})$/) { ($stage, $go) = (2, $1) }    # the longest the application writes (LONGEST_GO); sub address takes 2000 at most, and says so
            elsif ($stage < 3 && $line =~ /^=statement ([\x20-\x7e]{1,200})$/) { ($stage, $words) = (3, $1) }
            else { return live_end($live, 'it wrote a line of no form') }
        }
        if (shift @lines) {                # "=again"
            return live_end($live, 'it wrote a line of no form') if grep { /^=/ } @lines;
            my $list = join '', map { "$_\n" } '=page', @{ $live->{paths} } ? '=pictures ' . join(' ', @{ $live->{paths} }) : (), @{ $live->{made} }, @lines;
            my ($wide, $title) = ($LAID_WIDE, $TITLED);
            $LAID_WIDE = $live->{wide};
            my ($checked) = checked($list);    # [C9] the same checks as a first list
            ($LAID_WIDE, $TITLED) = ($wide, $title);
            return live_end($live, 'it drew a list that is not fit') unless $checked;
            ($shown) = pictured($checked, $live->{paths}, $live->{host}, undef, undef, $live->{pictures});    # its decoded pictures only: nothing is fetched
            $live->{shown} = $shown;
            $live->{unsent} = 1;           # not yet in the window: a tab not shown keeps its old drawing there until it is chosen again (sub tab_shown)
        }
        $live->{focus} = $focus if defined $focus;
        next unless $live->{tab} == $TABS[$TAB];    # a tab not selected draws when it is chosen again (sub relaid), and follows no address
        if ($shown) { window("relaid $TAB", @$shown, '.'); $live->{unsent} = 0; $DRAWN = 1 }    # where it was read in the page is kept
        live_told();
        idle($words) if defined $words;
        return go($go, 'you followed the page to') if defined $go;    # [C4] a visit like a typed address; it ends this page first (sub visit)
    }
}

# A question, in lzrprf's strip of the window, with two buttons, or with one
# where there is nothing to choose. The first
# button is always the one that fetches, sends, replaces and keeps nothing, or
# keeps less, and it is the answer when the time is over; when the window is
# gone, lzrprf ends instead, and nothing is fetched or sent. Returns 1 or 2.
# Both sides count the questions, and a button says which question it
# answers: a press that comes late, after its question ran out of time, is
# not taken as the answer to the next one.
my $ASKED = 0;
sub ask { my ($words, @buttons) = @_; return asked('ask ' . $words =~ s/\s+/ /gr, @buttons) }

sub asked {                               # a question in a line of its own kind: "ask" in the strip, "redirect" in a modal; up to three buttons
    my ($line, @buttons) = @_;
    $ASKED++;
    window(join "\t", $line, @buttons);
    if (!$FROM) {                         # "lzrprf try" only: the test's answer
        my $press = $ANSWER eq 'allow' ? 2 : $ANSWER =~ s/^([123])// ? $1 : 1;    # a digit for each question in turn; a third button is answered by 3
        window("answered $press");
        return $press;
    }
    my $until = now() + $ANSWER_SECONDS;
    while ((my $left = $until - now()) > 0) {
        my $event = hear($left) // leave();
        return $1 if $event =~ /^button $ASKED ([123])$/ && $1 <= @buttons;
        viewing($event); push @LATER, $event if $event =~ /^tor (?:on|off)$/;    # a new size of the window's page said meanwhile is still its size; the page is laid out at it after the question (sub relaid); Tor turned on or off is heard after it too
    }
    return 1;
}

# What is fetched for a text that was typed. An address is https, a host by its
# name, port 443, and plain characters without a space. lzrprf adds https://
# when no scheme was typed, writes the host in small letters, and leaves out
# what follows a #, which is never sent to a site. Everything else is sent
# exactly as typed, or, when it is not such an address, not at all.
sub address {
    my ($text) = @_;
    $text =~ s/^[ \t]+|[ \t\r\n]+$//g;
    $text =~ s/#.*//s;
    $text = "https://$text" unless $text =~ m{^[A-Za-z][A-Za-z0-9+.-]*://};
    return unless $text =~ m{^https://($NAME)(?::443)?([/?][\x21-\x7e]*)?$}i && length $1 <= 253 && length $text <= 2000;
    my ($host, $rest) = (lc $1, $2 // '/');
    $rest = "/$rest" if $rest =~ /^\?/;
    return ("https://$host$rest", $host);
}

# A host that leads to this computer, into a network of your own, or to a
# place this computer reaches by a route of its own is not the public
# internet. It is fetched only after you said yes to exactly that, in
# lzrprf's strip of the window, and the yes holds for that one request.
# Returns nothing after a yes, and the reason after a no.                # [C8]
sub own_network {
    my ($host, $where, $kept) = @_;
    my $there = join ', ', map { $_->{text} } @$where;
    my $yes = ask("$host is not on the public internet. It leads to $there: this computer, a network of your own, or a place this computer reaches by a route of its own, such as a VPN. What answers there can be a device of yours, such as a router. Fetch it this once?", 'No', 'Yes, this once') == 2;
    record('you ' . ($yes ? 'allowed' : 'refused') . " $host, which is inside your own network ($there)" . ($yes ? ', this once' : ''), $kept) or return 'the log could not be written';
    return $yes ? undef : 'you said no to a host inside your own network';
}

# The log in the window: this window's lines where a page stands, and under
# them the log on this computer when there is one; one sentence on what is
# kept; the button that clears the log whenever there is one; and, while a
# log is kept, the questions that keep less. The log is cleared by that
# button, and that it was cleared is the first line of the new log.     # [C12]
# No button of the window makes lzrprf keep more: a log is chosen, and full
# addresses are chosen, with "lzrprf keep" in a terminal and in no other
# way. The window's process is the one that tells lzrprf which button was
# pressed, so what it could do by itself, if text it draws took it over, is
# what the buttons can do: keep less, and clear.
# Every question here has the button that keeps less, or changes nothing,
# first, and a question nobody answers counts as that one.
sub log_shown {
    $DRAWN = 0;                           # what the window shows from here on is lzrprf's own, over the page: a fault it says now is not of a page the application drew
    $UNEXPIRED = !expire_log() if $UNEXPIRED;
    my ($mode, $days, $unread) = keeping();
    my ($holds, $count, @lines) = holds_log();
    my $rows = sub { map { my ($when, undef, $what) = split /\t/, s/[^\x20-\x7e\t]/?/gr, 3; "log line $when\t" . (length($what // '') > 600 ? substr($what, 0, 600) . ' ...' : $what // '') =~ s/\t/   /gr } @_ };    # the time, what happened; the number of the run stays in the file
    my @mine = @SESSION > 200 ? @SESSION[-200 .. -1] : @SESSION;
    my $says = "Every address lzrprf fetched for $APP in this window is below" . (@SESSION > @mine ? ', its last ' . @mine . ' lines' : '') . '. ' . kept_words($mode, $days, $unread)
        . ($count ? " The log on this computer holds $holds." . ($count > @lines ? ' Below are its last ' . @lines . ' lines.' : '') . " The whole of it: $DIR/log" . ($mode eq 'nothing' ? ' It was written earlier, and nothing more is added to it.' : '') : '')
        . ($UNMARKED ? ' The log could not be marked for Time Machine to leave it out of backups.' : '');
    undef $UNMARKED;                      # said once
    my $more = $INCOGNITO ? ' No button of this window makes lzrprf keep more.' : $mode eq 'nothing' ? " To keep a log, type in Terminal: perl $SELF keep " . (defined $PROFILE ? "--profile $PROFILE " : '') . "hosts. No button of this window makes lzrprf keep more." : '';    # an incognito window keeps nothing whatever is chosen, and is told nothing of profiles [C16]: the words to type would not be of it
    # The log page of the window, over the page shown, which stays as it is under it: these words, then this
    # window's lines, then the last of the log on this computer. "log shut" closes it again.
    window('log begin', "log note $says$more", 'log part This window', $rows->(@mine), $count ? ('log part On this computer', $rows->(@lines)) : (), 'log end');
    if ($count) {                         # the clear, one click away whenever there is a log on this computer
        window("brief $count " . ($count == 1 ? 'line is' : 'lines are') . ' kept on this computer.');
        if (ask($says, 'Keep the log', 'Clear the log') == 2) {
            window('brief Clear the log? This cannot be undone.');
            return aside('The log was kept.') unless ask("Clear the log? It holds $holds. This cannot be undone.", 'Keep', 'Clear') == 2;
            my $cleared = clear_log();
            window('log shut');
            return idle(!$cleared ? 'The log was not cleared: an address is being fetched right now, or the log could not be written. Nothing was removed.' : $mode eq 'nothing' ? 'The log was cleared: there is no log on this computer now.' : 'The log was cleared. Its first line now says so.');
        }
        $says = 'The log is as it was. ' . kept_words($mode, $days, $unread);
    }
    return aside("$says$more") if $mode eq 'nothing';
    window('brief Kept on this computer: ' . ($mode eq 'all' ? 'full addresses.' : 'hosts only.'));
    return aside($says, 1) unless ask($says, 'Close', 'Keep less') == 2;
    choose_keeping($mode, $days);
    window('log shut');
}

# Keeping less, in the window: full addresses can become hosts only, and
# either can become nothing. Each first button keeps less. What is chosen
# holds from the next request on, and deletes and shortens nothing that is
# on the disk already: that is the button "Clear the log".
sub choose_keeping {
    my ($was, $days) = @_;
    my $log = ask('What is kept after this window closes? A log on this computer lets you look back at what was fetched, and so can anyone who reads your files.', 'Keep nothing', $was eq 'all' ? 'Keep a log' : 'Hosts only, as now') == 2;
    my $full = $log && $was eq 'all' && ask('A log of hosts only holds, for each request, the time, the host, the numeric address and how it ended: no path and no query. Full addresses can hold search words, tokens and invitation links.', 'Hosts only', 'Full addresses, as now') == 2;
    my $mode = !$log ? 'nothing' : $full ? 'all' : 'hosts';    # never more than $was: "all" only from "all", "hosts" only from "all" or "hosts"
    my $lock = keep_lock() or return idle("What is kept was not changed: $DIR/keep.lock could not be taken.");
    my ($now, $left) = keeping();         # read again, under the lock: a question can stand open for minutes, and "lzrprf keep" may have run in that time
    if ($MORE{$mode} >= $MORE{$now}) {    # nothing is written that is not less than what is kept at this moment
        return idle('What is kept is as it was. ' . kept_words($now, $left)) if $now eq $was && $left == $days;
        return idle('What is kept was changed elsewhere while this question was open. Nothing was written here. ' . kept_words($now, $left));
    }
    my (undef, $count) = holds_log();
    my $writing = log_lock() or return idle("What is kept was not changed: $DIR/lock could not be taken.");
    return idle("What is kept was not changed: $DIR/keep could not be written.") unless keep_as($mode, $left);    # the days as they are now: never more of them
    my $told = changed('in the window', $now, $left, $writing);
    idle('From the next request on: ' . kept_words(keeping()) . ($count ? " The log on this computer still holds $count lines written before this choice. They are not deleted or shortened: the Log button offers to clear it." : '')
        . ($told ? '' : ' The log on this computer could not be given the line that says so.'));
}

# A change of what is kept is written down itself: among this window's
# lines, and as a line of the log on this computer when there is one or one
# is kept from now on. So a log says where it stops, or where its lines
# became shorter or longer, and whether a button or the command did it.
sub changed {
    my ($how, $was, $before, $lock) = @_;
    my ($mode, $days) = keeping();
    my $named = sub { $_[0] eq 'nothing' ? 'nothing' : ($_[0] eq 'hosts' ? 'hosts only' : 'full addresses') . ($_[1] ? ", $_[1] days" : ', until cleared') };
    my $line = line("what is kept was changed $how: " . $named->($was, $before) . ' -> ' . $named->($mode, $days));
    push @SESSION, $line;
    return 1 if $mode eq 'nothing' && !-e "$DIR/log";
    $lock //= log_lock() or return 0;
    my $new = !-e "$DIR/log";
    my $size = (-s "$DIR/log") // 0;
    if (!put("$DIR/log", O_APPEND, $line)) { $HALF = ((-s "$DIR/log") // 0) > $size; return 0 }
    excluded("$DIR/log") if $new || !$MARKED++;
    return 1;
}

sub log_lock {                            # one writer of the log at a time. A change of what is kept holds it from the setting to its line, so no line of a request falls between the two
    open my $lock, '>>', "$DIR/lock" or return;
    flock $lock, LOCK_EX or return;
    return $lock;
}

sub keep_lock {                           # one writer of the setting at a time: a window's answers, or "lzrprf keep". Held from reading the setting to the line that says it changed
    open my $lock, '>>', "$DIR/keep.lock" or return;
    flock $lock, LOCK_EX or return;
    return $lock;
}

sub holds_log {                           # what the log on the disk holds, in words; the number of its lines; the last 200 of them
    my ($count, $first, $last, @tail) = (0, '', '');
    my $in;
    if (sysopen($in, "$DIR/log", O_RDONLY | O_NOFOLLOW | O_NONBLOCK) && -f $in) {    # a plain file and no link; a pipe put in its place is not waited for
        while (my $line = <$in>) {
            chomp $line;
            $first = $line unless $count++;
            $last = $line;
            push @tail, $line;
            shift @tail if @tail > 200;
        }
    }
    return ('nothing yet', 0) unless $count;
    return (sprintf('%d lines, %.1f MB, from %s to %s', $count, (-s "$DIR/log") / 1048576, map { /^(\S+)/ ? $1 : '?' } $first, $last), $count, @tail);
}

# What is kept, in a plain settings file of yours, "$DIR/keep": "nothing";
# "hosts" or "all" with a number of days, 0 for until you clear it. Only
# lzrprf writes it, outside every container: "lzrprf keep" for you, and the
# process behind the window after an answer there that keeps less (sub
# choose_keeping, sub keep_as). No container can write a file, and no button
# of the window keeps more. Anything else in that place counts as
# "nothing": no file, a link, a file of another owner or with a second name,
# a file that is not plain, more than one short line, a word or a number
# lzrprf does not take. Returns the mode, the days, and whether the file was
# there and not read.                                                   # [C12]
sub keeping {
    return ('nothing', 0, 0) if $INCOGNITO;    # [C16] its log is in its memory only
    sysopen(my $in, "$DIR/keep", O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return ('nothing', 0, -l "$DIR/keep" || -e _);
    my @is = stat $in;
    return ('nothing', 0, 1) unless @is && -f _ && $is[3] == 1 && $is[4] == $< && $is[7] <= 64;
    my $text = '';
    sysread($in, $text, 65) // return ('nothing', 0, 1);
    my ($mode, $days) = $text =~ /^(nothing|hosts|all)(?: ([0-9]{1,4}))?\n?\z/ or return ('nothing', 0, 1);
    return ('nothing', 0, defined $days) if $mode eq 'nothing';
    $days //= $KEPT_DAYS;
    return $days <= $KEPT_MOST ? ($mode, $days + 0, 0) : ('nothing', 0, 1);
}

sub kept_words {                          # what is kept, in one sentence
    my ($mode, $days, $unread) = @_;
    return ($unread ? "$DIR/keep is not a setting lzrprf takes, so: " : '') . 'Nothing is kept after this window closes.' if $mode eq 'nothing';
    return 'Kept on this computer ' . ($days ? "for $days days" : 'until you clear it') . ': ' . ($mode eq 'hosts' ? 'hosts only.' : 'full addresses.');
}

sub keep_as {                             # the settings file, written beside the old one and through to the disk, then given its name in one step
    my ($mode, $days) = @_;
    unlink "$DIR/keep.new";
    sysopen(my $out, "$DIR/keep.new", O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600) or return 0;
    print($out $mode eq 'nothing' ? "nothing\n" : "$mode $days\n") && $out->flush or return 0;
    return 0 unless ($^O eq 'darwin' ? defined fcntl($out, 51, 0) : $out->sync) && close $out;
    rename "$DIR/keep.new", "$DIR/keep" or return 0;
    synced();
    return 1;
}

sub keep_command {                        # "lzrprf keep": what is kept, in words; or a new setting. The one place where more is chosen
    my ($mode, $days) = @_;
    mkdir $DIR, 0700;
    my @folder = lstat $DIR;
    die "lzrprf: $DIR is not a folder of yours\n" unless @folder && -d _ && $folder[4] == $<;
    my $one = defined $PROFILE ? "--profile $PROFILE " : '';    # the profile it was said of, so the words to type again name it too
    my $choices = "lzrprf keep ${one}nothing\n       lzrprf keep ${one}hosts|all [DAYS]     DAYS from 0 (until you clear it) to $KEPT_MOST, $KEPT_DAYS when it is left out\n";
    my $lock = keep_lock() or die "lzrprf: $DIR/keep.lock could not be taken. Nothing was changed.\n";
    my ($was, $before) = keeping();
    my (undef, $count) = holds_log();
    my $untold;
    if (defined $mode) {
        die "usage: $choices" unless $mode =~ /^(?:nothing|hosts|all)\z/ && (!defined $days || $mode ne 'nothing' && $days =~ /^[0-9]{1,4}\z/ && $days <= $KEPT_MOST);
        my $writing = log_lock() or die "lzrprf: $DIR/lock could not be taken. Nothing was changed.\n";
        keep_as($mode, $days // $KEPT_DAYS) or die "lzrprf: $DIR/keep could not be written. Nothing was changed.\n";
        my ($now, $after) = keeping();
        if (($now ne $was || $after != $before) && !changed('by "lzrprf keep"', $was, $before, $writing)) {    # the line that says so could not be written
            if ($now eq 'nothing') { $untold = 1 }    # keeping nothing is never refused
            else {
                my $half = $HALF;
                my $back = keep_as($was, $before);
                my $noted = $back && $half && changed('back by "lzrprf keep", as the line before this one could not be confirmed on the disk', $now, $after, $writing);
                die "lzrprf: the line that says what was changed could not be " . ($half ? 'confirmed on the disk' : 'written') . " in $DIR/log, so "
                    . (!$back ? "the old setting was to be put back, and that failed too: the change stands unsaid. Look at $DIR/keep"
                        : !$half ? 'nothing was changed'
                        : 'the old setting was put back. The log holds the line of the change' . ($noted ? ', and after it the line that it was put back' : ', and not that it was put back')) . ".\n";
            }
        }
        print 'From the next request on: ';
    }
    my ($now) = keeping();
    print kept_words(keeping()) =~ s/this window closes/a window closes/r, "\n";
    print "Full addresses can hold search words, tokens and invitation links.\n" if $now eq 'all';
    print "The log on this computer still holds $count lines written before this choice. They are not deleted or shortened: the Log button of the window offers to clear it.\n" if defined $mode && $count && $now ne 'all' && $now ne $was;
    print "A log written earlier is still on this computer, $count lines. Nothing more is added to it: the Log button of the window offers to clear it.\n" if !defined $mode && $count && $now eq 'nothing';
    print "The log on this computer could not be given the line that says so.\n" if $untold;
    print "To choose: $choices" unless defined $mode;
}

# The log. Every line is kept in the memory of the process behind the window,
# and there only, unless you chose a kept log: then it is added at the end of
# the log on the disk too, cut to its hosts unless you chose full addresses,
# and this returns true only when the system says the line is on the disk.
# Nothing is looked up or fetched whose line could not be recorded, and no
# answer is shown whose line could not.                                  # [C5]
# Nothing in this file changes or removes a line of the log on the disk but
# your button and the days you chose, and the log has no size at which
# anything is dropped. Each line: the time, the number of the run it belongs
# to, what happened. The log stays on this computer. Nothing in this file
# sends it, or any part of it, anywhere.                                 # [C12]
sub record {
    my ($what, $mode) = @_;
    my $line = line($what);
    ($mode) = keeping() unless defined $mode;    # a request reads it once and hands it in: none of its lines is kept at more than that
    my $lock;
    if ($mode ne 'nothing') {
        $lock = log_lock() or return 0;
        my ($now) = keeping();            # read again, under the lock a change of what is kept holds: when less was chosen while this request is open, no line follows the line of that change at more
        $mode = $now if $MORE{$now} < $MORE{$mode};
    }
    if ($mode ne 'nothing') {
        my $new = !-e "$DIR/log";
        put("$DIR/log", O_APPEND, $mode eq 'hosts' ? shortened($line) : $line) or return 0;
        excluded("$DIR/log") if $new || !$MARKED++;    # a new log, and once in each window a log that was there already, such as one an earlier release wrote
    }
    push @SESSION, $line;
    return 1;
}

sub line { strftime('%Y-%m-%dT%H:%M:%SZ', gmtime) . "\t$$\t$_[0]" }    # the time, the run, what happened

# A line of a log of hosts only: every address in it cut to https://host. So
# the disk holds the time, the run, the host, the numeric addresses lzrprf
# connected to and how it ended; no path, no query, no name before an @.
sub shortened { $_[0] =~ s{https://(?:[^/?#\s\@]*\@)?([A-Za-z0-9.-]+)\S*}{https://$1}gr }

# Time Machine leaves out of its backups a file with this mark. That it does
# is Apple's doing and is not tested here. A mark that could not be set
# stops nothing, and the Log button says so once.
sub excluded {
    my ($file) = @_;
    my (undef, $done) = said(5, '/usr/bin/xattr', '-w', '-s', 'com.apple.metadata:com_apple_backup_excludeItem', 'com.apple.backupd', $file);
    $UNMARKED = 1 unless $done;
    return $done;
}

sub put {                                 # lines into a plain file of yours that no link leads elsewhere, and through to the disk
    my ($file, $how, @lines) = @_;
    sysopen(my $out, $file, O_WRONLY | O_CREAT | O_NOFOLLOW | $how, 0600) or return 0;
    my @is = stat $out;
    return 0 unless -f _ && $is[3] == 1 && $is[4] == $<;
    print($out map { /\n\z/ ? $_ : "$_\n" } @lines) && $out->flush or return 0;
    return 0 unless $^O eq 'darwin' ? defined fcntl($out, 51, 0) : $out->sync;    # 51 is F_FULLFSYNC: through the disk's own cache
    return close $out;
}

sub synced { if (open my $folder, '<', $_[0] // $DIR) { $^O eq 'darwin' ? fcntl($folder, 51, 0) : $folder->sync } }    # a change of name, through to the disk too

# Replacing the log: the new log, whose first line says why, is written
# beside the old one and through to the disk, marked for Time Machine, and
# then takes its name in one step. So at no moment is there a log that was
# emptied or shortened without saying so.                                # [C12]
sub replace_log {
    unlink "$DIR/log.new";
    unless (put("$DIR/log.new", O_EXCL, @_)) { unlink "$DIR/log.new"; return 0 }    # what could not be written whole is not left beside the log
    excluded("$DIR/log.new");
    unless (rename "$DIR/log.new", "$DIR/log") { unlink "$DIR/log.new"; return 0 }
    synced();
    return 1;
}

# Clearing: by your button only, and not while a request is between its
# first line and its last. With a kept log the new log's first line says what
# the old one held. When nothing is kept, the log an earlier window or an
# earlier release left is taken away whole.
sub clear_log {
    open my $requests, '>>', "$DIR/busy" or return 0;
    flock $requests, LOCK_EX | LOCK_NB or return 0;
    open my $lock, '>>', "$DIR/lock" or return 0;
    flock $lock, LOCK_EX or return 0;
    my ($holds) = holds_log();
    if ((keeping())[0] eq 'nothing') {
        unlink "$DIR/log.new";            # and what a replacing that failed may have left beside it
        unlink "$DIR/log" or return 0;
        synced();
        push @SESSION, line("you cleared the log: it held $holds");    # no log is left to say so: this window's lines do
        return 1;
    }
    return replace_log(line("you cleared the log: it held $holds"));
}

# The days you chose. At the start of a window, the lines of a kept log that
# are older than that are taken out, the way clearing replaces the log, and
# the new first line says how many and why. With 0 days, or when nothing is
# kept, no line is taken out: a log an earlier release left stays as it is
# until you clear it.                                                    # [C12]
sub expire_log {
    my ($mode, $days) = keeping();
    return 1 if $mode eq 'nothing' || !$days || !-e "$DIR/log";
    open my $requests, '>>', "$DIR/busy" or return 0;
    flock $requests, LOCK_EX | LOCK_NB or return 0;
    open my $lock, '>>', "$DIR/lock" or return 0;
    flock $lock, LOCK_EX or return 0;
    my $before = strftime('%Y-%m-%dT%H:%M:%SZ', gmtime(time - $days * 86400));
    my ($old, @kept) = (0);
    sysopen(my $in, "$DIR/log", O_RDONLY | O_NOFOLLOW | O_NONBLOCK) or return 0;
    return 0 unless -f $in;                # a plain file and no link; a pipe put in its place is not waited for
    while (my $one = <$in>) {
        if ($one =~ /^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)\t/ && $1 lt $before) { $old++ } else { push @kept, $one }    # a line without a time is kept
    }
    close $in;
    return 1 unless $old;
    return replace_log(line("lzrprf took out $old lines older than $days days, as you chose"), @kept);
}

sub show {
    my ($mode, $days, $unread) = keeping();
    print 'What is kept: ', kept_words($mode, $days, $unread) =~ s/this window closes/a window closes/r, $mode eq 'all' ? '' : ' The full lines of a window that is open now are in that window only: press its Log button.', "\n";
    print "when (UTC)\trun\twhat you typed, where lzrprf connected for it, and how it ended\n";
    if (open my $in, '<', "$DIR/log") { print <$in> } else { print "(nothing on this computer)\n" }
}

# The proof for this computer. "selftest" probes this file on this Mac and,
# when every probe was held, writes down the mark of what it tested: the
# build of macOS, the SHA-256 of this file and the SHA-256 of the selftest
# beside it, the file that made the probes. Nothing is shown unless that
# mark is the mark of now. So after macOS was updated, or this file or the
# selftest beside it changed, no page is shown before the probes were made
# again. Where no selftest can be read beside this file, there is no mark,
# and nothing counts as proven.
# When the test held but could not try every check on this Mac, it writes
# the mark followed by ", untested: " and the checks it could not try. Such
# a line counts only after you said yes to starting without exactly those
# checks, for exactly this mark: the window names them and asks, Quit first,
# and your yes is kept as that whole line in the file "untested". A yes to
# another line (other checks, another build, another lzrprf) is not a yes to
# this one, and the question comes again.                                # [C11]
# The file of marks holds up to eight lines, one for each copy of lzrprf that
# was tested on this build of macOS: testing another copy, such as one from
# the public repository, does not take the proof from the one that is
# installed. A line counts only when it is the mark of this file, of now.
sub mark {
    my ($build) = said(5, '/usr/sbin/sysctl', '-n', 'kern.osversion');
    my $self = sum_of($SELF) // return '';
    my $test = sum_of(dirname($SELF) . '/selftest') // return '';    # no selftest to read beside this file: no mark, so nothing counts as proven
    return $build =~ /^(\w+)$/ ? "macOS build $1, lzrprf $self, selftest $test" : '';
}

sub sum_of { sysopen my $in, $_[0], O_RDONLY | O_NOFOLLOW | O_NONBLOCK or return; -f $in or return; binmode $in; return eval { Digest::SHA->new(256)->addfile($in)->hexdigest } }    # what cannot be read to its end has no sum; a plain file and no link, and a pipe put in its place is not waited for

sub proven {
    my $mark = mark();
    my $is = sub {                        # 'plain' for the mark of now; the line, for the mark of now with the checks that could not be tried; '' for neither
        sysopen my $in, "$ROOT/proven", O_RDONLY | O_NONBLOCK or return '';    # a pipe put in its place is not waited for
        return '' unless length $mark && -f $in;
        my @lines = map { scalar(<$in>) // () } 1 .. 8;
        return 'plain' if grep { $_ eq "$mark\n" } @lines;
        my ($line) = grep { /^\Q$mark\E, untested: [\x20-\x7e]{1,600}\n\z/ } @lines;    # as selftest writes it: the question shows all of it, so the yes is to nothing unseen
        return defined $line ? $line =~ s/\n\z//r : '';
