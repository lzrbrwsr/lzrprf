(allow default)
(deny network*)
(deny file-write*)
(allow file-write* (literal "/dev/null"))
(deny process-fork)
(deny process-exec)
(allow process-exec (literal "/usr/bin/osascript"))
(deny lsopen)
(deny appleevent-send)
